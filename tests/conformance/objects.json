[
  {
    "category": "property shorthand",
    "expr": "{name, score}",
    "context": {
      "name": "Alex",
      "score": 7
    },
    "expected": {
      "name": "Alex",
      "score": 7
    }
  },
  {
    "category": "mixed nested shorthand",
    "expr": "{name, stats: {score}, active: true}",
    "context": {
      "name": "Alex",
      "score": 7
    },
    "expected": {
      "name": "Alex",
      "stats": {
        "score": 7
      },
      "active": true
    }
  },
  {
    "category": "object overlay",
    "expr": "base with {score: 9}",
    "context": {
      "base": {
        "name": "Alex",
        "score": 1
      }
    },
    "expected": {
      "name": "Alex",
      "score": 9
    }
  },
  {
    "category": "replication",
    "expr": "{x: 10, start_x: 10} * 3 inc (x, start_x) by 5",
    "context": {},
    "expected": [
      {
        "x": 10,
        "start_x": 10
      },
      {
        "x": 15,
        "start_x": 15
      },
      {
        "x": 20,
        "start_x": 20
      }
    ]
  },
  {
    "category": "replication index and overrides",
    "expr": "{id: i + 1, x: 20} * count inc x by -10 with {active: true, label: \"unit,\" + i}",
    "context": {
      "count": 3
    },
    "expected": [
      {
        "id": 1,
        "x": 20,
        "active": true,
        "label": "unit,0"
      },
      {
        "id": 2,
        "x": 10,
        "active": true,
        "label": "unit,1"
      },
      {
        "id": 3,
        "x": 0,
        "active": true,
        "label": "unit,2"
      }
    ]
  },
  {
    "category": "generator inside array",
    "expr": "[{x: 1} * 2 inc x by 2, {x: 9}] all {alive: true}",
    "context": {},
    "expected": [
      {
        "x": 1,
        "alive": true
      },
      {
        "x": 3,
        "alive": true
      },
      {
        "x": 9,
        "alive": true
      }
    ]
  },
  {
    "category": "template batches",
    "expr": "[batch with {y: 20}, batch with {y: 40}] all {alive: true}",
    "context": {
      "batch": [
        {
          "x": 1
        },
        {
          "x": 2
        }
      ]
    },
    "expected": [
      {
        "x": 1,
        "y": 20,
        "alive": true
      },
      {
        "x": 2,
        "y": 20,
        "alive": true
      },
      {
        "x": 1,
        "y": 40,
        "alive": true
      },
      {
        "x": 2,
        "y": 40,
        "alive": true
      }
    ]
  },
  {
    "category": "grid",
    "expr": "grid 2 x 2 at (10, 20) step (5, 15) with {id: i + 1, type: row + 1, active: true}",
    "context": {},
    "expected": [
      {
        "x": 10,
        "y": 20,
        "start_x": 10,
        "start_y": 20,
        "col": 0,
        "row": 0,
        "id": 1,
        "type": 1,
        "active": true
      },
      {
        "x": 15,
        "y": 20,
        "start_x": 15,
        "start_y": 20,
        "col": 1,
        "row": 0,
        "id": 2,
        "type": 1,
        "active": true
      },
      {
        "x": 10,
        "y": 35,
        "start_x": 10,
        "start_y": 35,
        "col": 0,
        "row": 1,
        "id": 3,
        "type": 2,
        "active": true
      },
      {
        "x": 15,
        "y": 35,
        "start_x": 15,
        "start_y": 35,
        "col": 1,
        "row": 1,
        "id": 4,
        "type": 2,
        "active": true
      }
    ]
  },
  {
    "category": "grid from alias",
    "expr": "grid cols x 1 from (0, 0) step (8, 8)",
    "context": {
      "cols": 2
    },
    "expected": [
      {
        "x": 0,
        "y": 0,
        "start_x": 0,
        "start_y": 0,
        "col": 0,
        "row": 0
      },
      {
        "x": 8,
        "y": 0,
        "start_x": 8,
        "start_y": 0,
        "col": 1,
        "row": 0
      }
    ]
  },
  {
    "category": "empty generator",
    "expr": "{x: 1} * 0",
    "context": {},
    "expected": []
  },
  {
    "category": "empty grid",
    "expr": "grid 0 x 2 at (0, 0) step (1, 1)",
    "context": {},
    "expected": []
  },
  {
    "category": "ordinary nested arrays stay nested",
    "expr": "[[1, 2], [3, 4]]",
    "context": {},
    "expected": [
      [
        1,
        2
      ],
      [
        3,
        4
      ]
    ]
  },
  {
    "category": "overlay preserves scalar array items",
    "expr": "[{x: 1}, 3, null] all {active: true}",
    "context": {},
    "expected": [
      {
        "x": 1,
        "active": true
      },
      3,
      null
    ]
  },
  {
    "category": "lookup",
    "expr": "users[]id",
    "context": {
      "users": [
        {
          "id": 1,
          "name": "A"
        },
        {
          "id": 2,
          "name": "B"
        }
      ],
      "id": 2
    },
    "expected": {
      "id": 2,
      "name": "B"
    }
  },
  {
    "category": "lookup property with string id",
    "expr": "users[]id.name",
    "context": {
      "users": [
        {
          "id": 1,
          "name": "A"
        },
        {
          "id": 2,
          "name": "B"
        }
      ],
      "id": "2"
    },
    "expected": "B"
  },
  {
    "category": "lookup first match",
    "expr": "users[]id.name",
    "context": {
      "users": [
        {
          "id": 1,
          "name": "A"
        },
        {
          "id": 1,
          "name": "B"
        }
      ],
      "id": 1
    },
    "expected": "A"
  },
  {
    "category": "lookup miss",
    "expr": "users[]id ?? null",
    "context": {
      "users": [
        {
          "id": 1
        }
      ],
      "id": 9
    },
    "expected": null
  },
  {
    "category": "quoted punctuation and escapes",
    "expr": "{text: \"a, b: c \\\"quoted\\\"\", items: [{name}]}",
    "context": {
      "name": "A"
    },
    "expected": {
      "text": "a, b: c \"quoted\"",
      "items": [
        {
          "name": "A"
        }
      ]
    }
  },
  {
    "category": "unicode JSON escapes",
    "expr": "{text: \"\\u0041\\uD83D\\uDE00\\b\\f\\/\"}",
    "context": {},
    "expected": {
      "text": "A\ud83d\ude00\b\f/"
    }
  },
  {
    "category": "missing lookup key does not match missing properties",
    "expr": "users[]id ?? null",
    "context": {
      "users": [
        {
          "name": "A"
        },
        {
          "id": null
        }
      ]
    },
    "expected": null
  }
]
