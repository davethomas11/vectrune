            "hp": 3
          },
          "y": 40,
          "alive": true
        },
        {
          "id": 2,
          "x": 15,
          "nested": {
            "hp": 3
          },
          "y": 40,
          "alive": true
        },
        {
          "id": 3,
          "x": 20,
          "nested": {
            "hp": 3
          },
          "y": 40,
          "alive": true
        }
      ],
      "original": [
        {
