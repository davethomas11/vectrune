  {
    "category": "nested lookups and compound updates",
    "statements": [
      "orders = [{ id: 1, items: [{ sku: \"A\", qty: 2 }, { sku: \"B\", qty: 3 }] }]",
      "id = 1",
      "sku = \"B\"",
      "orders[]id.items[]sku.qty += 4",
