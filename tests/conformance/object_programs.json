[
  {
    "category": "local generators, overlays and lookup updates",
    "statements": [
      "local batch = { id: i + 1, x: 10, nested: { hp: 3 } } * 3 inc x by 5",
      "actors = [batch with { y: 20 }, batch with { y: 40 }] all { alive: true }",
      "id = 2",
      "actors[]id.x = 99",
      "actors[]id.nested.hp = 1",
      "result = { actors, original: batch }"
    ],
    "expected": {
      "actors": [
        {
          "id": 1,
          "x": 10,
          "nested": {
            "hp": 3
          },
          "y": 20,
          "alive": true
        },
        {
          "id": 2,
          "x": 99,
          "nested": {
            "hp": 1
          },
          "y": 20,
          "alive": true
        },
        {
          "id": 3,
          "x": 20,
          "nested": {
