#!RUNE
import "skybound_2.rune"

@Test/Beyond/AtlasLocksAndIndependentLevels
type = logic
page = beyond
run:
    invoke initialize
    assert state.phase == "map"
    assert state.scenery.length > 4
    invoke choose_four
    assert state.enter_locked == true
    invoke advance
    assert state.phase == "map"
    invoke choose_one
    invoke advance
    assert state.phase == "playing"
    assert state.level_map == "reedwake"
    assert state.seeds.length == 19
    assert state.avatar.model == "beyond/nix"
    assert state.saga.unlocked == 1

@Test/Beyond/ProgressionAndBestScoresSurviveReplay
type = logic
page = beyond
setup:
    invoke start
run:
    invoke score_seven
    invoke clear_stage
    assert state.phase == "result"
    assert state.saga.unlocked == 2
    assert state.saga.cleared[0] == true
    assert state.saga.best[0] == 7
    invoke advance
    assert state.phase == "map"
    invoke advance
    assert state.collected == 0
    invoke score_three
    invoke clear_stage
    assert state.saga.best[0] == 7
    assert state.saga.unlocked == 2

@Test/Beyond/GlidingAndCheckpointRecovery
type = logic
page = beyond
setup:
    invoke start
run:
    invoke airborne
    invoke tick {"jump":true}
    assert state.gliding == true
    assert state.player.vz > -0.12
    assert state.avatar.model == "beyond/nix_glide"
    invoke tick {}
    assert state.gliding == false
    assert state.player.vz < -0.12
    invoke at_beacon
    invoke tick {}
    assert state.checkpoint_active == true
    invoke lose_heart
    assert state.player.x == 21
    assert state.player.z == 5
    assert state.hearts == 3
    invoke tick {"forward":true}
    assert state.checkpoint.x == 21
    assert state.ui.style == "floating"
    assert state.ui.meters[0].icon == "beyond/hud/heart"
    assert state.ui.meters[0].value == 3
    assert state.pause_ui.meters[0].value == 3

@Test/Beyond/KilnbackArmorAndVulnerabilityWindow
type = logic
page = beyond
setup:
    invoke unlock_all
    invoke choose_two
    invoke enter_stage
run:
    invoke above_kilnback
    invoke tick_boss 9
    assert state.boss_hp == 3
    invoke open_core
    invoke tick_boss 9
    assert state.boss_hp == 2
    assert state.boss_phase == "stagger"
    assert state.player.vz > 0
    invoke tick_boss 9
    assert state.boss_hp == 2
    invoke touch_armor
    invoke tick_boss 7
    assert state.hearts == 3

@Test/Beyond/RegentWaveCanBeJumpedAndDamagesOnGround
type = logic
page = beyond
setup:
    invoke unlock_all
    invoke choose_seven
    invoke enter_stage
run:
    invoke ring_on_ground
    invoke tick_boss 8
    assert state.hearts == 3
    invoke ring_in_air
    invoke tick_boss 9
    assert state.hearts == 3
    assert state.hazards.length == 1
    invoke final_core
    invoke tick_boss 10
    assert state.boss_hp == 0
    assert state.phase == "result"
    assert state.saga.cleared[6] == true
    assert state.boss.visible == false
    assert state.hazards.length == 0

@Test/Beyond/DefeatRetryAndAtlasKeepCampaign
type = logic
page = beyond
setup:
    invoke start
    invoke clear_stage
    invoke advance
    invoke choose_two
    invoke advance
run:
    invoke lose_heart
    invoke lose_heart
    invoke lose_heart
    invoke lose_heart
    assert state.phase == "failed"
    assert state.saga.cleared[0] == true
    assert state.saga.unlocked == 2
    invoke advance
    assert state.phase == "playing"
    assert state.hearts == 4
    assert state.boss_hp == 3
    invoke show_map
    assert state.phase == "map"
    assert state.saga.cleared[0] == true

@Test/Beyond/TelegraphsLockAimAndFinaleDoesNotEraseReplay
type = logic
page = beyond
setup:
    invoke unlock_all
    invoke choose_two
    invoke enter_stage
run:
    invoke ready_arena
    invoke awaken_boss
    assert state.boss_aim.x == 40
    invoke move_from_marker
    invoke tick {}
    assert state.boss_aim.x == 40
    assert state.player.x == 43
    invoke show_map
    invoke choose_three
    invoke enter_stage
    assert state.player.y == 24
    assert state.level_map == "tide"
    invoke show_map
    invoke choose_seven
    invoke enter_stage
    invoke clear_stage
    assert state.saga.cleared[6] == true
    invoke advance
    invoke choose_one
    invoke enter_stage
    assert state.phase == "playing"
    assert state.saga.cleared[6] == true

@Test/Beyond/CanopyHasAnExtendedTreeRoute
type = logic
page = beyond
setup:
    invoke unlock_all
    invoke choose_four
    invoke enter_stage
run:
    assert state.level_map == "canopy"
    assert state.world.width == 48
    assert state.world.height == 40
    assert state.player.y == 31
    assert state.goal.z == 9
    assert state.seeds.length == 19

@Test/Beyond/AuroraAndEmberglassHaveSeparateRoutes
type = logic
page = beyond
setup:
    invoke unlock_all
    invoke choose_five
    invoke enter_stage
run:
    assert state.level_map == "aurora"
    assert state.seeds.length == 21
    assert state.goal.z == 11
    invoke show_map
    invoke choose_six
    invoke enter_stage
    assert state.level_map == "emberglass"
    assert state.seeds.length == 19
    assert state.goal.x == 20
    assert state.boss.visible == false

@Test/Beyond/CompletedFourLevelSaveKeepsItsFinaleAndBestScores
type = logic
page = beyond
run:
    invoke old_completed_save
    invoke initialize
    assert state.saga.cleared.length == 7
    assert state.saga.cleared[0] == true
    assert state.saga.cleared[3] == false
    assert state.saga.cleared[6] == true
    assert state.saga.best[0] == 8
    assert state.saga.best[6] == 6
    assert state.saga.unlocked == 7
    assert state.selected == 3
    invoke initialize
    assert state.saga.best[6] == 6

@Test/Beyond/PartialFourLevelSaveContinuesAtTheNewCanopy
type = logic
page = beyond
run:
    invoke old_partial_save
    invoke initialize
    assert state.saga.unlocked == 4
    assert state.saga.cleared[2] == true
    assert state.saga.cleared[6] == false
    assert state.saga.best[2] == 9
    assert state.selected == 3
    invoke advance
    assert state.level_map == "canopy"
    invoke clear_stage
    assert state.saga.unlocked == 5
    assert state.phase == "result"

@Test/Beyond/DescendingStompBouncesAndFlattenedEnemiesAreHarmless
type = logic
page = beyond
setup:
    invoke start
    invoke stomp_fixture
run:
    invoke tick_enemies 3.7
    assert state.squished == 1
    assert state.hearts == 4
    assert state.player.vz == 0.46
    assert state.enemies[0].model == "beyond/squashed"
    assert state.enemies[0].flat == 24
    invoke stand_on_flat
    invoke tick_enemies 3
    assert state.hearts == 4
    assert state.squished == 1
    assert state.enemies[0].x == 8.032
    invoke expire_flat
    invoke tick_enemies 3
    assert state.enemies[0].visible == false

@Test/Beyond/SideContactHurtsOnceAndAscendingIsNotAStomp
type = logic
page = beyond
setup:
    invoke start
    invoke side_fixture
run:
    invoke tick_enemies 3
    assert state.hearts == 3
    assert state.invulnerable == 75
    assert state.squished == 0
    assert state.enemies[0].flat == 0
    invoke tick_enemies 3
    assert state.hearts == 3

@Test/Beyond/PatrolTurnsAtFractionalBoundsAndHoppersRiseThenLand
type = logic
page = beyond
setup:
    invoke start
    invoke patrol_fixture
run:
    invoke tick_enemies 3
    assert state.enemies[0].direction == -1
    assert state.enemies[0].x == 8.7
    assert state.enemies[1].z > 3.79
    invoke tick_enemies 3
    assert state.enemies[0].x < 8.7
    invoke land_hopper
    invoke tick_enemies 3
    assert state.enemies[1].z == 3
    invoke enter_stage
    assert state.squished == 0
    assert state.enemies.length == 6

@Logic/beyond
action stomp_fixture:
    enemies = []
    call creature 8, 10, 3, "grub", "x", 0.7
    player = {"x": 8, "y": 10, "z": 3.6, "vz": -0.1, "angle": 0, "pitch": 0}
    jump_held = true

action stand_on_flat:
    player.z = 3
    player.vz = 0

action expire_flat:
    enemies[0].flat = 1

action side_fixture:
    call stomp_fixture
    player.z = 3.2
    player.vz = 0.3

action patrol_fixture:
    enemies = []
    call creature 8, 10, 3, "grub", "x", 0.7
    call creature 10, 10, 3, "hopper", "y", 0.5
    enemies[0].x = 8.69
    enemies[1].clock = 17

action land_hopper:
    enemies[1].clock = 35

@Logic/beyond
action old_completed_save:
    saga = {"unlocked": 4, "cleared": [true, true, true, true], "best": [8, 5, 9, 6]}

action old_partial_save:
    saga = {"unlocked": 4, "cleared": [true, true, true, false], "best": [8, 5, 9, 0]}

action unlock_all:
    saga.unlocked = 7

action score_seven:
    collected = 7

action score_three:
    collected = 3

action airborne:
    player.z = 5
    player.vz = -0.25

action at_beacon:
    player = {"x": 21, "y": 18, "z": 5, "angle": 0, "pitch": 0, "vz": 0}

action above_kilnback:
    boss = {"x": 41, "y": 23, "z": 7, "model": "beyond/kilnback", "visible": true, "angle": 0}
    player = {"x": 41, "y": 23, "z": 8.8, "angle": 0, "pitch": 0, "vz": -0.2}
    boss_phase = "telegraph"
    boss_clock = 0

action open_core:
    boss_phase = "rest"

action touch_armor:
    player.z = 7
    boss_phase = "telegraph"
    invulnerable = 0

action ring_on_ground:
    boss_active = true
    boss_phase = "attack"
    boss_clock = 13
    player = {"x": 42.02, "y": 31, "z": 8, "angle": 0, "pitch": 0, "vz": 0}
    invulnerable = 0

action ring_in_air:
    boss_phase = "attack"
    boss_clock = 13
    player = {"x": 42.02, "y": 31, "z": 9, "angle": 0, "pitch": 0, "vz": -0.1}
    invulnerable = 0

action final_core:
    boss_hp = 1
    boss_phase = "rest"
    player = {"x": 39, "y": 31, "z": 9.8, "angle": 0, "pitch": 0, "vz": -0.2}

action ready_arena:
    player = {"x": 40, "y": 23, "z": 7, "angle": 0, "pitch": 0, "vz": 0}

action move_from_marker:
    player.x = 43
