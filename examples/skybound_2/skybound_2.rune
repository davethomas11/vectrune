#!RUNE
import "assets.rune"
import "hud.rune"
import "sound.rune"
import "campaign.rune"
import "levels.rune"
import "movement.rune"
import "enemies.rune"
import "bosses.rune"
import "ux.rune"
import "controls.rune"
import "shell.rune"

@App
name = Skybound 2 - Beyond the Concept
type = pixel-3d
runtime = hybrid
scene = beyond
resolution = [432,270]
tick_rate = 30
port = 3024
shell = beyond_cabinet

@Perspective/beyond
fov = 78

@Scene/beyond
logic = beyond
map = atlas
world = world
camera = camera
perspective = beyond
things = ["avatar","seeds","enemies","scenery","goal","boss","hazards"]
controls = beyond
ui = ui
pause_ui = pause_ui
restart_action = show_map
click_to_start = false
mouse_look = false
persistence = {"key":"skybound-2","state":"saga"}
presentation = {
    "defeat": "EVEN MOTHS NEED ANOTHER TRY",
    "instructions": [
        "WASD MOVE / SPACE JUMP",
        "HOLD SPACE WHILE FALLING TO GLIDE",
        "SHIFT RUN / Q E CAMERA / R CENTER",
        "P PAUSE / B RETURN TO ATLAS"
    ],
    "objective": "RESTORE THE SEVEN SKY LANTERNS",
    "subtitle": "BEYOND THE CONCEPT",
    "title": "SKYBOUND 2",
    "victory": "THE SKY REMEMBERS YOUR LIGHT"
}

