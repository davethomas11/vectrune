@Component/StudioTrackList
view:
    aside .studio-tracks aria-label="Tracks":
        h2 .tracks-heading "Tracks"
        div .voice-tabs:
            button .voice-tab {.active when active_voice == 'lead'} aria-pressed="{active_voice == 'lead'}" click="selectVoice('lead')":
                span .voice-name "Lead"
                span .voice-sound "{lead_instrument}"
            button .voice-tab {.active when active_voice == 'bass'} aria-pressed="{active_voice == 'bass'}" click="selectVoice('bass')":
                span .voice-name "Bass"
                span .voice-sound "{bass_instrument}"
            button .voice-tab {.active when active_voice == 'chords'} aria-pressed="{active_voice == 'chords'}" click="selectVoice('chords')":
                span .voice-name "Chords"
                span .voice-sound "{chords_instrument}"
            button .voice-tab {.active when active_voice == 'drums'} aria-pressed="{active_voice == 'drums'}" click="selectVoice('drums')":
                span .voice-name "Drums"
                span .voice-sound "Percussion"

@Component/NoteEditorPanel
view:
    section .note-editor-panel:
        if editor_mode == 'matrix':
            div .editor-header:
                if active_voice != 'drums':
                    div .instrument-picker:
                        span .editor-label "SOUND:"
                        button .pill-instrument {.active when active_instrument == 'square'} click="setVoiceInstrument('square')":
                            "Square"
                        button .pill-instrument {.active when active_instrument == 'sawtooth'} click="setVoiceInstrument('sawtooth')":
                            "Saw"
                        button .pill-instrument {.active when active_instrument == 'triangle'} click="setVoiceInstrument('triangle')":
                            "Triangle"
                        button .pill-instrument {.active when active_instrument == 'sine'} click="setVoiceInstrument('sine')":
                            "Sine"
                        button .pill-instrument {.active when active_instrument == 'pluck'} click="setVoiceInstrument('pluck')":
                            "Pluck"

                div .duration-picker:
                    span .editor-label "LENGTH:"
                    button .pill-duration {.active when active_duration == ':16'} click="selectDuration(':16')":
                        "1/16"
                    button .pill-duration {.active when active_duration == ':8'} click="selectDuration(':8')":
                        "1/8"
                    button .pill-duration {.active when active_duration == ':4'} click="selectDuration(':4')":
                        "1/4"
                    button .pill-duration {.active when active_duration == ':2'} click="selectDuration(':2')":
                        "1/2"

                div .editor-tools:
                    div .current-note-badge:
                        span .badge-lbl "NOTE:"
                        span .badge-val "{selected_note}"
                        span .badge-sub "{active_duration}"

        # Master timeline
        div .timeline-ruler:
            div .ruler-header-row:
                span .ruler-header "Timeline · {time_signature} · {bars} bars"
                span .ruler-hint "Space to play or pause · Drag the playhead to seek"
                button .bar-tab {.active when selected_bar == 0} click="selectBar(0)" "All bars"
            div .ruler-track:
                div .ruler-scrub {.can-seek when !is_playing} data-studio-seek="progress" role="slider" tabindex="0" aria-label="Playback position in beats" aria-valuemin="0":
                div .ruler-playhead #ruler-playhead data-sync-playhead="progress":
                div .ruler-bars:
                    if bars >= 1:
                        button .ruler-bar-item .bar-tab data-bar-num="1" data-sync-bar="1" aria-pressed="{selected_bar == 1}" {.active-bar when selected_bar == 1} {.active when selected_bar == 1} {.playing-bar when playback_bar == 1} click="selectBar(1)":
                            span .ruler-bar-num "BAR 1"
                    if bars >= 2:
                        button .ruler-bar-item .bar-tab data-bar-num="2" data-sync-bar="2" aria-pressed="{selected_bar == 2}" {.active-bar when selected_bar == 2} {.active when selected_bar == 2} {.playing-bar when playback_bar == 2} click="selectBar(2)":
                            span .ruler-bar-num "BAR 2"
                    if bars >= 3:
                        button .ruler-bar-item .bar-tab data-bar-num="3" data-sync-bar="3" aria-pressed="{selected_bar == 3}" {.active-bar when selected_bar == 3} {.active when selected_bar == 3} {.playing-bar when playback_bar == 3} click="selectBar(3)":
                            span .ruler-bar-num "BAR 3"
                    if bars >= 4:
                        button .ruler-bar-item .bar-tab data-bar-num="4" data-sync-bar="4" aria-pressed="{selected_bar == 4}" {.active-bar when selected_bar == 4} {.active when selected_bar == 4} {.playing-bar when playback_bar == 4} click="selectBar(4)":
                            span .ruler-bar-num "BAR 4"
                    if bars >= 5:
                        button .ruler-bar-item .bar-tab data-bar-num="5" data-sync-bar="5" aria-pressed="{selected_bar == 5}" {.active-bar when selected_bar == 5} {.active when selected_bar == 5} {.playing-bar when playback_bar == 5} click="selectBar(5)":
                            span .ruler-bar-num "BAR 5"
                    if bars >= 6:
                        button .ruler-bar-item .bar-tab data-bar-num="6" data-sync-bar="6" aria-pressed="{selected_bar == 6}" {.active-bar when selected_bar == 6} {.active when selected_bar == 6} {.playing-bar when playback_bar == 6} click="selectBar(6)":
                            span .ruler-bar-num "BAR 6"
                    if bars >= 7:
                        button .ruler-bar-item .bar-tab data-bar-num="7" data-sync-bar="7" aria-pressed="{selected_bar == 7}" {.active-bar when selected_bar == 7} {.active when selected_bar == 7} {.playing-bar when playback_bar == 7} click="selectBar(7)":
                            span .ruler-bar-num "BAR 7"
                    if bars >= 8:
                        button .ruler-bar-item .bar-tab data-bar-num="8" data-sync-bar="8" aria-pressed="{selected_bar == 8}" {.active-bar when selected_bar == 8} {.active when selected_bar == 8} {.playing-bar when playback_bar == 8} click="selectBar(8)":
                            span .ruler-bar-num "BAR 8"

        if editor_mode == 'matrix':
            div .bar-actions:
                button .btn-bar-action .btn-add-bar click="addNewBar" "Add bar"
                button .btn-bar-action click="duplicateCurrentBar" "Duplicate"
                button .btn-bar-action .btn-tool-danger click="deleteCurrentBar" "Delete bar"
                button .btn-bar-action .btn-tool-danger click="clearActiveTrack" "Clear track"

        # 2D Piano Roll Matrix Grid View (Cubase MIDI Editor style)
        if editor_mode == 'matrix':
            div .piano-matrix-rack:
                div .matrix-header:
                    h2 .matrix-title "Piano roll · {active_voice}"
                    div .matrix-note-tools aria-label="Note selection and clipboard":
                        button .step-stretch-btn {.active when studio_note_tool == 'select'} type=button data-studio-note-tool="select" aria-pressed="{studio_note_tool == 'select'}" "Select"
                        button .step-stretch-btn type=button data-studio-note-tool="copy" disabled="{studio_selection_count == 0 and selected_step_id < 0}" aria-keyshortcuts="Control+C Meta+C" "Copy"
                        button .step-stretch-btn {.active when studio_note_tool == 'paste'} type=button data-studio-note-tool="paste" disabled="{studio_clipboard_count == 0}" aria-pressed="{studio_note_tool == 'paste'}" aria-keyshortcuts="Control+V Meta+V" "Paste"
                        if studio_selection_count > 0:
                            span .matrix-sub "{studio_selection_count} selected"
                    if studio_note_tool == 'edit':
                        span .matrix-sub "Tap to add · Drag to move · Drag the edge to resize · Right-click or × to remove"
                    if studio_note_tool == 'select':
                        span .matrix-sub "Tap notes or drag a box to select"
                    if studio_note_tool == 'paste':
                        span .matrix-sub "Tap the grid where the copied notes should start"
                    for step in active_steps:
                        if !step.is_bar and !step.is_rest and selected_step_id == step.id and studio_note_tool == 'edit':
                            div .matrix-length-controls:
                                if step.can_shorten:
                                    button .step-stretch-btn click="stretchStep(step.id, -1)":
                                        "Shorten"
                                if step.can_stretch:
                                    button .step-stretch-btn click="stretchStep(step.id, 1)":
                                        "Lengthen"
                div .matrix-container .matrix-timeline-scroll data-sync-scroll="beat" data-sync-view-bar="{selected_bar}" data-studio-scroll="matrix-{selected_bar}" data-studio-voice="{active_voice}":
                    div .matrix-keys-column:
                        if active_voice == 'drums':
                            button .matrix-key .mkey-drum {.selected-key when selected_note == 'hihat'} click="auditionNote('hihat')":
                                "⚡ HI-HAT"
                            button .matrix-key .mkey-drum {.selected-key when selected_note == 'snare'} click="auditionNote('snare')":
                                "🥁 SNARE"
                            button .matrix-key .mkey-drum {.selected-key when selected_note == 'kick'} click="auditionNote('kick')":
                                "💥 KICK"
                        if active_voice != 'drums':
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'C5'} click="auditionNote('C5')":
                                "C5"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'B4'} click="auditionNote('B4')":
                                "B4"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'A#4'} click="auditionNote('A#4')":
                                "A#4"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'A4'} click="auditionNote('A4')":
                                "A4"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'G#4'} click="auditionNote('G#4')":
                                "G#4"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'G4'} click="auditionNote('G4')":
                                "G4"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'F#4'} click="auditionNote('F#4')":
                                "F#4"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'F4'} click="auditionNote('F4')":
                                "F4"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'E4'} click="auditionNote('E4')":
                                "E4"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'D#4'} click="auditionNote('D#4')":
                                "D#4"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'D4'} click="auditionNote('D4')":
                                "D4"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'C#4'} click="auditionNote('C#4')":
                                "C#4"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'C4'} click="auditionNote('C4')":
                                "C4"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'B3'} click="auditionNote('B3')":
                                "B3"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'A#3'} click="auditionNote('A#3')":
                                "A#3"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'A3'} click="auditionNote('A3')":
                                "A3"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'G#3'} click="auditionNote('G#3')":
                                "G#3"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'G3'} click="auditionNote('G3')":
                                "G3"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'F#3'} click="auditionNote('F#3')":
                                "F#3"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'F3'} click="auditionNote('F3')":
                                "F3"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'E3'} click="auditionNote('E3')":
                                "E3"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'D#3'} click="auditionNote('D#3')":
                                "D#3"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'D3'} click="auditionNote('D3')":
                                "D3"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'C#3'} click="auditionNote('C#3')":
                                "C#3"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'C3'} click="auditionNote('C3')":
                                "C3"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'B2'} click="auditionNote('B2')":
                                "B2"
                            button .matrix-key .mkey-black {.selected-key when selected_note == 'A#2'} click="auditionNote('A#2')":
                                "A#2"
                            button .matrix-key .mkey-white {.selected-key when selected_note == 'A2'} click="auditionNote('A2')":
                                "A2"

                            button .matrix-key .mkey-black {.selected-key when selected_note == 'G#2'} click="auditionNote('G#2')":
                                "G#2"

                            button .matrix-key .mkey-white {.selected-key when selected_note == 'G2'} click="auditionNote('G2')":
                                "G2"

                            button .matrix-key .mkey-black {.selected-key when selected_note == 'F#2'} click="auditionNote('F#2')":
                                "F#2"

                            button .matrix-key .mkey-white {.selected-key when selected_note == 'F2'} click="auditionNote('F2')":
                                "F2"

                            button .matrix-key .mkey-white {.selected-key when selected_note == 'E2'} click="auditionNote('E2')":
                                "E2"

                            button .matrix-key .mkey-white {.selected-key when selected_note == 'D2'} click="auditionNote('D2')":
                                "D2"

                            button .matrix-key .mkey-white {.selected-key when selected_note == 'C2'} click="auditionNote('C2')":
                                "C2"

                            button .matrix-key .mkey-white {.selected-key when selected_note == 'A1'} click="auditionNote('A1')":
                                "A1"

                    div .matrix-note-timeline data-sync-view-bar="{selected_bar}":
                        div .seq-playhead #seq-playhead data-sync-playhead="beat":
                            if !is_playing:
                                span .seq-seek-grip data-studio-seek="beat" title="Drag to set playback position":
                        div .matrix-grid-surface {.surface-drums when active_voice == 'drums'} {.selection-tool when studio_note_tool == 'select'} {.paste-tool when studio_note_tool == 'paste'} style="width: {studio_timeline_width}px;" click="placeMatrixNote(event.offsetX, event.offsetY)":
                            for step in active_steps:
                                if selected_bar == 0 or step.bar_num == selected_bar:
                                    if step.is_bar and selected_bar == 0 and step.lane == 0:
                                        div .matrix-bar-divider style="left: {step.matrix_left}px;" click="selectBar(step.bar_num)":
                                            span .matrix-bar-divider-label "{step.len_label}"
                                    if !step.is_bar and !step.is_rest:
                                        div .matrix-note-block .chip-{step.pitch_class} {.compact-note when step.beats == 0.25} {.selected-step when selected_step_id == step.id or studio_selected_notes[step.id]} {.playing-step-now when playback_step_id == step.id} data-sync-step="{step.id}" data-step-idx="{step.id}" data-studio-note="matrix" title="{step.note} · {step.len_label}" style="top: {step.matrix_top}px; left: {step.matrix_left}px; width: {step.matrix_width}px;" click="selectStep(step.id)" on_contextmenu="deleteStep(step.id)":
                                            div .matrix-note-body:
                                                span .matrix-note-pitch "{step.note}"
                                                span .matrix-note-len "{step.len_label}"
                                            span .note-resize-grip data-studio-resize="true" aria-hidden="true" title="Drag to resize":
                                            button .matrix-delete-btn click="deleteStep(step.id)" title="Delete":
                                                "×"

        # Step Sequencer Strip View
        if editor_mode == 'strip':
            div .step-sequencer-rack:
                div .step-rack-header:
                    div .step-rack-title:
                        h2 .step-title-text "Strip · {active_voice}"
                    div .step-rack-hint:
                        "Edit notes in the piano roll"

                div .step-strip-scroll data-sync-scroll="beat" data-sync-view-bar="{selected_bar}" data-sync-pixels-per-beat="192" data-studio-scroll="strip-{selected_bar}":
                    div .seq-playhead #seq-playhead data-sync-playhead="beat":
                        if !is_playing:
                            span .seq-seek-grip data-studio-seek="beat" title="Drag to set playback position":
                    div .step-strip style="width: {studio_strip_width}px; height: {studio_strip_height}px;":
                        for step in active_steps:
                            if selected_bar == 0 or step.bar_num == selected_bar:
                                if step.is_bar and selected_bar == 0 and step.lane == 0:
                                    div .step-bar-divider style="left: {step.strip_left}px;" aria-hidden="true":
                                if !step.is_bar and !step.is_rest:
                                    div .step-chip .chip-{step.pitch_class} {.playing-step-now when playback_step_id == step.id} data-sync-step="{step.id}" style="left: {step.strip_left}px; width: {step.strip_width}px; top: {step.strip_top}px;":
                                        div .step-num "B{step.bar_num}.{step.step_num}"
                                        div .step-pitch "{step.note}"
                                        div .step-len "{step.len_label}"

        # Interactive Audition Keyboard & Drum Pads
        if editor_mode == 'matrix':
            if active_voice != 'drums':
                div .piano-roll-container:
                    div .piano-roll:
                        button .piano-key .key-white {.selected-key when selected_note == 'C3'} click="auditionNote('C3')":
                            "C3"
                        button .piano-key .key-white {.selected-key when selected_note == 'D3'} click="auditionNote('D3')":
                            "D3"
                        button .piano-key .key-white {.selected-key when selected_note == 'E3'} click="auditionNote('E3')":
                            "E3"
                        button .piano-key .key-white {.selected-key when selected_note == 'F3'} click="auditionNote('F3')":
                            "F3"
                        button .piano-key .key-white {.selected-key when selected_note == 'G3'} click="auditionNote('G3')":
                            "G3"
                        button .piano-key .key-white {.selected-key when selected_note == 'A3'} click="auditionNote('A3')":
                            "A3"
                        button .piano-key .key-white {.selected-key when selected_note == 'B3'} click="auditionNote('B3')":
                            "B3"
                        button .piano-key .key-white {.selected-key when selected_note == 'C4'} click="auditionNote('C4')":
                            "C4"
                        button .piano-key .key-black {.selected-key when selected_note == 'C#4'} click="auditionNote('C#4')":
                            "C#4"
                        button .piano-key .key-white {.selected-key when selected_note == 'D4'} click="auditionNote('D4')":
                            "D4"
                        button .piano-key .key-black {.selected-key when selected_note == 'D#4'} click="auditionNote('D#4')":
                            "D#4"
                        button .piano-key .key-white {.selected-key when selected_note == 'E4'} click="auditionNote('E4')":
                            "E4"
                        button .piano-key .key-white {.selected-key when selected_note == 'F4'} click="auditionNote('F4')":
                            "F4"
                        button .piano-key .key-black {.selected-key when selected_note == 'F#4'} click="auditionNote('F#4')":
                            "F#4"
                        button .piano-key .key-white {.selected-key when selected_note == 'G4'} click="auditionNote('G4')":
                            "G4"
                        button .piano-key .key-black {.selected-key when selected_note == 'G#4'} click="auditionNote('G#4')":
                            "G#4"
                        button .piano-key .key-white {.selected-key when selected_note == 'A4'} click="auditionNote('A4')":
                            "A4"
                        button .piano-key .key-black {.selected-key when selected_note == 'A#4'} click="auditionNote('A#4')":
                            "A#4"
                        button .piano-key .key-white {.selected-key when selected_note == 'B4'} click="auditionNote('B4')":
                            "B4"
                        button .piano-key .key-white {.selected-key when selected_note == 'C5'} click="auditionNote('C5')":
                            "C5"
                        button .piano-key .key-white {.selected-key when selected_note == 'D5'} click="auditionNote('D5')":
                            "D5"
                        button .piano-key .key-white {.selected-key when selected_note == 'E5'} click="auditionNote('E5')":
                            "E5"
                        button .piano-key .key-white {.selected-key when selected_note == 'G5'} click="auditionNote('G5')":
                            "G5"
                        button .piano-key .key-white {.selected-key when selected_note == 'A5'} click="auditionNote('A5')":
                            "A5"

            if active_voice == 'drums':
                div .drum-machine-container:
                    div .drum-pads:
                        button .drum-pad {.selected-key when selected_note == 'kick'} click="auditionNote('kick')":
                            span .drum-icon "💥"
                            span .drum-name "KICK"
                        button .drum-pad {.selected-key when selected_note == 'snare'} click="auditionNote('snare')":
                            span .drum-icon "🥁"
                            span .drum-name "SNARE"
                        button .drum-pad {.selected-key when selected_note == 'hihat'} click="auditionNote('hihat')":
                            span .drum-icon "⚡"
                            span .drum-name "HI-HAT"

