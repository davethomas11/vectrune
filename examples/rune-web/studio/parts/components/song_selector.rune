@Component/SongSelector
view:
    section .song-selector aria-label="Song":
        label .song-title-label for=studio-song-title:
            span .ctrl-label "Song title"
            input #studio-song-title .song-title-input type=text aria-label="Song title" maxlength="80" value="{song_title}" data-studio-song-title="{selected_song}" on_input="renameSong(this.value)"
        div .song-actions:
            button .btn-storage .btn-new-song click="newSong" "New Song"
            select .song-open aria-label="Open song" change="openSong(this.value)":
                option value="" selected=true disabled=true "Open…"
                option value=reload_saved "Reload current saved song"
                if saved_songs.length > 0:
                    optgroup label="Saved songs":
                        for song in saved_songs:
                            option value="{song.key}" "{song.title}"
                optgroup label="Presets":
                    option value=vectraiders "VectRaiders"
                    option value=vectworms "VectWorms"
                    option value=cyber_run "Cyber Run"
                    option value=moonlight "Moonlight Dungeon"
                    option value=victory "Victory Fanfare"
            button .btn-storage click="saveToStorage" "Save"
            button .btn-storage click="exportRune" "Export .rune"
