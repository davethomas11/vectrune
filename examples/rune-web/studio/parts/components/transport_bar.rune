@Component/TransportBar
props: [is_playing?, is_paused?, tempo?, volume?, time_signature?, editor_mode?]
view:
    div .transport-bar:
        div .transport-buttons {.is-playing when is_playing}:
            button .btn-transport-seek type=button data-studio-seek-bar="start" disabled="{is_playing}" aria-label="Back to start" title="Back to start":
                "«"
            button .btn-transport-seek type=button data-studio-seek-bar="-1" disabled="{is_playing}" aria-label="Previous bar" title="Previous bar":
                "‹"
            if !is_playing:
                button .btn-transport .btn-play click="playTrack" aria-keyshortcuts="Space":
                    "▶ Play"
            if is_playing:
                button .btn-transport .btn-pause click="pauseTrack" aria-keyshortcuts="Space":
                    "⏸ Pause"
            button .btn-transport-seek type=button data-studio-seek-bar="1" disabled="{is_playing}" aria-label="Next bar" title="Next bar":
                "›"

        div .tempo-controls:
            span .ctrl-label "Tempo"
            button .btn-tempo click="changeTempo(-4)":
                "-4"
            span .bpm-badge "{tempo} BPM"
            button .btn-tempo click="changeTempo(4)":
                "+4"

        if editor_mode == 'matrix':
            div .time-sig-controls:
                span .ctrl-label "Meter"
                button .btn-timesig {.active when time_signature == '4/4'} click="setTimeSignature('4/4')":
                    "4/4"
                button .btn-timesig {.active when time_signature == '3/4'} click="setTimeSignature('3/4')":
                    "3/4"

        div .mode-controls:
            span .ctrl-label "View"
            button .btn-mode {.active when editor_mode == 'matrix'} click="setEditorMode('matrix')":
                "Piano roll"
            button .btn-mode {.active when editor_mode == 'strip'} click="setEditorMode('strip')":
                "Strip"
