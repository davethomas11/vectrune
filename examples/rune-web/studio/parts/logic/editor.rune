@Logic/studio

action setEditorMode(mode):
    editor_mode = mode

action setLowerTab(tab):
    active_lower_tab = tab

action selectVoice(v):
    if v == "drums" and active_voice != "drums":
        selected_note = "kick"
    if v != "drums" and active_voice == "drums":
        selected_note = "E4"
    active_voice = v
    selected_step_id = -1
    music.sync_steps
    status_message = "Active Voice: " + v
    flash_type = "info"

action setVoiceInstrument(inst):
    music.edit_steps("instrument", inst)

action selectDuration(d):
    active_duration = d

action selectBar(b):
    selected_bar = b
    selected_step_id = -1
    music.sync_steps
    if b == 0:
        status_message = "Viewing all bars"
    if b > 0:
        status_message = "Selected Bar " + b
    flash_type = "info"

action addNewBar:
    music.edit_steps("addBar")

action duplicateCurrentBar:
    music.edit_steps("duplicateBar")

action deleteCurrentBar:
    music.edit_steps("deleteBar")

action auditionNote(note):
    music.edit_steps("audition", note)

action placeMatrixNote(x, y):
    music.edit_steps("matrix", x, y)

action clearActiveTrack:
    if active_voice == "lead":
        lead_track = ""
    if active_voice == "bass":
        bass_track = ""
    if active_voice == "chords":
        chords_track = ""
    if active_voice == "drums":
        drums_track = ""
    selected_step_id = -1
    music.sync_steps
    status_message = "Cleared " + active_voice + " track"

action selectStep(id):
    music.select_step(id)

action stretchStep(id, delta):
    music.edit_steps("stretch", id, delta)

action deleteStep(id):
    music.edit_steps("delete", id)
