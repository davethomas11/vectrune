@Logic/studio

action loadSongLibrary:
    saved_songs = storage.get("rune_studio_song_library")
    if saved_songs == null:
        saved_songs = []

action renameSong(title):
    song_title = title

action newSong:
    call stopTrack
    let number = storage.get("rune_studio_song_number")
    number = (number ?? 0) + 1
    storage.set("rune_studio_song_number", number)
    selected_song = "song_" + number
    song_title = "Untitled " + number
    tempo = 120
    time_signature = "4/4"
    bars = 4
    selected_bar = 0
    selected_step_id = -1
    selected_note = "E4"
    active_duration = ":8"
    active_voice = "lead"
    lead_instrument = "square"
    bass_instrument = "triangle"
    chords_instrument = "sawtooth"
    lead_track = ""
    bass_track = ""
    chords_track = ""
    drums_track = ""
    lead_muted = false
    bass_muted = false
    chords_muted = false
    drums_muted = false
    editor_mode = "matrix"
    active_lower_tab = "tracks"
    music.sync_steps
    status_message = "New song ready. Name it and place notes in the piano roll."

action openSong(key):
    if key == "reload_saved":
        call loadFromStorage
    if key == "vectraiders" or key == "vectworms" or key == "cyber_run" or key == "moonlight" or key == "victory":
        call selectSong key
    for entry in saved_songs:
        if entry.key == key:
            selected_song = entry.id
            call loadFromStorage

action selectSong(name):
    selected_song = name
    if name == "vectraiders":
        song_title = "VectRaiders"
        tempo = 144
        time_signature = "4/4"
        bars = 4
        lead_instrument = "square"
        bass_instrument = "triangle"
        chords_instrument = "sawtooth"
        lead_track = "E4:8 D#4:8 E4:8 B3:8 D4:8 C4:8 A3:4 | E4:8 D#4:8 E4:8 B3:8 D4:8 C4:8 A3:4 | C4:8 D4:8 E4:8 G4:8 A4:4 G4:4 | E4:8 D4:8 C4:8 B3:8 A3:2"
        bass_track = "A2:4 E2:4 A2:4 E2:4 | A2:4 E2:4 A2:4 E2:4 | C3:4 G2:4 C3:4 G2:4 | F2:4 C2:4 E2:4 G#2:4"
        chords_track = "[A3,C4,E4]:2 [A3,C4,E4]:2 | [A3,C4,E4]:2 [A3,C4,E4]:2 | [C4,E4,G4]:2 [C4,E4,G4]:2 | [F3,A3,C4]:2 [E3,G#3,B3]:2"
        drums_track = "kick:4 snare:4 kick:4 snare:4 | kick:4 snare:4 kick:4 snare:4 | kick:8 hihat:8 snare:4 kick:8 hihat:8 snare:4 | kick:4 snare:4 kick:4 snare:4"
    if name == "vectworms":
        song_title = "VectWorms"
        tempo = 136
        time_signature = "4/4"
        bars = 4
        lead_instrument = "pulse"
        bass_instrument = "triangle"
        chords_instrument = "sine"
        lead_track = "C4:8 E4:8 G4:8 A4:8 G4:8 E4:8 C4:8 D4:8 | E4:8 G4:8 A4:8 C5:8 B4:4 G4:4 | A4:8 G4:8 E4:8 C4:8 D4:8 E4:8 D4:4 | C4:2 -:2"
        bass_track = "C2:4 G2:4 C2:4 G2:4 | E2:4 B2:4 E2:4 B2:4 | F2:4 C3:4 G2:4 D3:4 | C2:4 G2:4 C2:2"
        chords_track = "[C4,E4,G4]:2 [C4,E4,G4]:2 | [E4,G4,B4]:2 [E4,G4,B4]:2 | [F4,A4,C5]:2 [G4,B4,D5]:2 | [C4,E4,G4]:2 -:2"
        drums_track = "kick:4 snare:4 kick:8 kick:8 snare:4 | kick:4 snare:4 kick:8 hihat:8 snare:4 | kick:4 snare:4 kick:8 kick:8 snare:4 | kick:4 snare:4 kick:2"
    if name == "cyber_run":
        song_title = "Cyber Run"
        tempo = 152
        time_signature = "4/4"
        bars = 4
        lead_instrument = "sawtooth"
        bass_instrument = "triangle"
        chords_instrument = "sawtooth"
        lead_track = "D4:16 F4:16 A4:16 D5:16 C5:8 A4:8 D4:16 F4:16 A4:16 D5:16 C5:8 A4:8 | D4:16 F4:16 A4:16 D5:16 C5:8 A4:8 D4:16 F4:16 A4:16 D5:16 C5:8 A4:8 | Bb4:8 A4:8 G4:8 F4:8 E4:8 F4:8 G4:4 | D4:8 F4:8 A4:8 D5:4 C5:4 D5:2"
        bass_track = "D2:8 D2:8 A2:8 D2:8 D2:8 A2:8 D2:4 | D2:8 D2:8 A2:8 D2:8 D2:8 A2:8 D2:4 | Bb2:8 Bb2:8 F2:8 Bb2:8 C3:8 C3:8 G2:8 C3:4 | D2:8 D2:8 A2:8 D2:8 D2:2"
        chords_track = "[D4,F4,A4]:2 [C4,E4,G4]:2 | [D4,F4,A4]:2 [C4,E4,G4]:2 | [Bb3,D4,F4]:2 [C4,E4,G4]:2 | [D4,F4,A4]:1"
        drums_track = "kick:4 snare:4 kick:4 snare:4 | kick:4 snare:4 kick:4 snare:4 | kick:8 kick:8 snare:4 kick:8 kick:8 snare:4 | kick:8 hihat:8 snare:8 hihat:8 kick:4 snare:4"
    if name == "moonlight":
        song_title = "Moonlight Dungeon"
        tempo = 108
        time_signature = "3/4"
        bars = 4
        lead_instrument = "square"
        bass_instrument = "triangle"
        chords_instrument = "sine"
        lead_track = "A3:8 C4:8 E4:8 A4:4 G4:8 E4:4 | F4:8 D4:8 B3:8 D4:4 C4:8 A3:2 | E4:8 G4:8 B4:8 D5:4 C5:8 A4:4 | F4:8 E4:8 D#4:8 E4:2 -:4"
        bass_track = "A1:2 E2:4 | D2:2 A1:4 | C2:2 G1:4 | E2:2 E1:4"
        chords_track = "[A3,C4,E4]:2 [A3,C4,E4]:4 | [D3,F3,A3]:2 [D3,F3,A3]:4 | [C3,E3,G3]:2 [C3,E3,G3]:4 | [E3,G#3,B3]:1"
        drums_track = "kick:2 snare:4 | kick:2 snare:4 | kick:2 snare:4 | kick:4 hihat:4 snare:4"
    if name == "victory":
        song_title = "Victory Fanfare"
        tempo = 140
        time_signature = "4/4"
        bars = 3
        lead_instrument = "square"
        bass_instrument = "triangle"
        chords_instrument = "sawtooth"
        lead_track = "C4:8 C4:8 C4:8 C4:4 G3:4 C4:4 | D4:8 D4:8 D4:8 D4:4 A3:4 D4:4 | E4:8 E4:8 F4:8 G4:4 E4:8 D4:4 C4:2"
        bass_track = "C2:4 G2:4 C2:4 G2:4 | D2:4 A2:4 D2:4 A2:4 | E2:4 F2:4 G2:4 C2:2"
        chords_track = "[C4,E4,G4]:1 | [D4,F#4,A4]:1 | [E4,G4,C5]:2 [C4,E4,G4]:2"
        drums_track = "kick:4 snare:4 kick:8 kick:8 snare:4 | kick:4 snare:4 kick:8 kick:8 snare:4 | kick:8 kick:8 snare:8 snare:8 kick:2"

    selected_step_id = -1
    selected_bar = 0
    playback_beat = 0
    playback_bar = 1
    playback_progress = 0
    is_paused = false
    music.sync_steps
    music.compose(selected_song, tempo, lead_track, bass_track, drums_track, time_signature)
    status_message = "Loaded preset: " + song_title + " (" + time_signature + " Time)"
    flash_type = "info"
    if is_playing:
        music.stop
        music.play(selected_song)

action setTimeSignature(sig):
    time_signature = sig
    selected_step_id = -1
    music.sync_steps
    music.compose(selected_song, tempo, lead_track, bass_track, drums_track, time_signature)
    status_message = "Time signature set to " + sig
    flash_type = "info"

action saveToStorage:
    if song_title == "":
        song_title = "Untitled song"
    storage.set("rune_studio_last_song", selected_song)
    storage.set(
        "rune_studio_" + selected_song,
        {
            "title": song_title,
            "tempo": tempo,
            "time_signature": time_signature,
            "bars": bars,
            "lead_instrument": lead_instrument,
            "bass_instrument": bass_instrument,
            "chords_instrument": chords_instrument,
            "lead": lead_track,
            "bass": bass_track,
            "chords": chords_track,
            "drums": drums_track
        }
    )
    call loadSongLibrary
    saved_songs = saved_songs.filter it.id != selected_song
    saved_songs.push({"id": selected_song, "key": "saved:" + selected_song, "title": song_title})
    storage.set("rune_studio_song_library", saved_songs)
    status_message = "Saved " + song_title + " in this browser. EXPORT .RUNE keeps a file copy."
    flash_type = "success"

action loadFromStorage:
    saved = storage.get("rune_studio_" + selected_song)
    if saved != null:
        song_title = saved.title ?? song_title
        tempo = saved.tempo ?? tempo
        time_signature = saved.time_signature ?? time_signature
        bars = saved.bars ?? bars
        lead_instrument = saved.lead_instrument ?? lead_instrument
        bass_instrument = saved.bass_instrument ?? bass_instrument
        chords_instrument = saved.chords_instrument ?? chords_instrument
        selected_bar = 0
        playback_beat = 0
        playback_bar = 1
        playback_progress = 0
        is_paused = false
        lead_track = saved.lead ?? lead_track
        bass_track = saved.bass ?? bass_track
        chords_track = saved.chords ?? chords_track
        drums_track = saved.drums ?? drums_track
        selected_step_id = -1
        music.sync_steps
        status_message = "Restored " + song_title + " from saved browser data."
        flash_type = "success"
        if is_playing:
            music.stop
            music.compose(selected_song, tempo, lead_track, bass_track, drums_track, time_signature)
            music.play(selected_song)
    if saved == null:
        status_message = "No saved browser data found for " + song_title
        flash_type = "warning"

action exportRune:
    code = "# " + song_title + " — Generated with Rune Studio\n\n@Music/" + selected_song + "\ntype = 8bit\ntempo = " + tempo + "\ntime_signature = " + time_signature + "\nbars = " + bars + "\nloop = true\nvolume = 0.2\ninstruments = {" + export_instruments_body + "}\n\nlead:\n    " + lead_export + "\n\nbass:\n    " + bass_export + "\n\nchords:\n    " + chords_export + "\n\ndrums:\n    " + drums_export + "\n" + layer_exports
    download(selected_song + ".rune", code)
    status_message = "Exported " + selected_song + ".rune!"
    flash_type = "success"

action copyCode:
    code = "# " + song_title + " — Generated with Rune Studio\n\n@Music/" + selected_song + "\ntype = 8bit\ntempo = " + tempo + "\ntime_signature = " + time_signature + "\nbars = " + bars + "\nloop = true\nvolume = 0.2\ninstruments = {" + export_instruments_body + "}\n\nlead:\n    " + lead_export + "\n\nbass:\n    " + bass_export + "\n\nchords:\n    " + chords_export + "\n\ndrums:\n    " + drums_export + "\n" + layer_exports
    copy(code)
    status_message = "Copied .rune code to clipboard!"
    flash_type = "success"

