@Style/studio

rules:
    .studio-tracks, .note-editor-panel:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 9px
        min-width = 0
        padding = 0.7rem

    .tracks-heading:
        margin = 0 0 0.55rem
        color = {text_muted}
        font-size = 0.76rem
        font-weight = 650

    .voice-tabs:
        display = grid
        gap = 0.3rem

    .voice-tab:
        display = grid
        gap = 0.1rem
        width = 100%
        background = {card_bg}
        color = #e7f3ff
        border = 1px solid {grid_border}
        border-radius = 6px
        padding = 0.45rem 0.55rem
        text-align = left
        cursor = pointer
        font-family = inherit
        touch-action = manipulation

    .voice-tab.active:
        border-color = {neon_cyan}
        background = #173546

    .voice-tab:hover:
        border-color = {neon_cyan}

    .voice-name:
        font-size = 0.82rem
        font-weight = 700

    .voice-sound:
        color = {text_muted}
        font-size = 0.68rem
        text-transform = capitalize

    .editor-header:
        display = flex
        flex-wrap = wrap
        align-items = center
        gap = 0.4rem 0.8rem
        margin-bottom = 0.5rem

    .editor-label:
        font-size = 0.75rem
        color = {text_muted}
        font-weight = 650
        align-self = center

    .instrument-picker:
        display = flex
        gap = 0.4rem
        align-items = center
        flex-wrap = wrap

    .pill-instrument:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.65rem
        border-radius = 12px
        font-size = 0.75rem
        font-weight = bold
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .pill-instrument:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 8px rgba(0, 229, 255, 0.4)

    .pill-instrument.active:
        background = {neon_cyan}
        color = #000000
        border-color = {neon_cyan}
        box-shadow = 0 0 12px {neon_cyan}

    .duration-picker:
        display = flex
        gap = 0.4rem
        align-items = center
        flex-wrap = wrap

    .pill-duration:
        background = {card_bg}
        color = {neon_lime}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.75rem
        border-radius = 16px
        font-size = 0.8rem
        font-weight = bold
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .pill-duration.active:
        background = {neon_lime}
        color = #000000
        box-shadow = 0 0 12px {neon_lime}
        border-color = {neon_lime}

    .editor-tools:
        display = flex
        gap = 0.5rem
        align-items = center
        flex-wrap = wrap

    .current-note-badge:
        display = flex
        align-items = center
        gap = 0.4rem
        background = {card_bg}
        border = 1px solid {neon_lime}
        border-radius = 6px
        padding = 0.3rem 0.65rem

    .badge-lbl:
        font-size = 0.65rem
        color = {text_muted}
        font-weight = bold

    .badge-val:
        font-size = 0.9rem
        color = {neon_lime}
        font-weight = 900

    .badge-sub:
        font-size = 0.75rem
        color = {neon_cyan}

    .btn-tool:
        background = {card_bg}
        color = #ffffff
        border = 1px solid {grid_border}
        padding = 0.45rem 0.85rem
        border-radius = 6px
        font-size = 0.8rem
        cursor = pointer
        font-family = inherit
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-tool:hover:
        border-color = {neon_cyan}

    .btn-tool-danger:
        color = {neon_pink}
        border-color = rgba(255, 42, 133, 0.4)

    .btn-tool-danger:hover:
        background = {neon_pink}
        color = #000000

    .step-sequencer-rack:
        background = #050814
        border = 1px solid {grid_border}
        border-radius = 10px
        padding = 0.85rem
        margin-bottom = 1rem

    .step-rack-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.6rem
        flex-wrap = wrap
        gap = 0.5rem

    .step-rack-title:
        display = flex
        align-items = center
        gap = 0.5rem

    .step-title-icon:
        font-size = 1rem

    .step-title-text:
        margin = 0
        font-size = 0.8rem
        font-weight = bold
        letter-spacing = 1px
        color = {neon_cyan}
        text-transform = uppercase

    .step-rack-hint:
        font-size = 0.7rem
        color = {text_muted}

    .step-strip-scroll:
        overflow-x = auto
        padding = 0.4rem 0
        -webkit-overflow-scrolling = touch
        position = relative

    .step-strip:
        position = relative

    .step-bar-divider:
        position = absolute
        top = 0
        bottom = 0
        margin-left = -3px
        border-left = 2px solid {neon_amber}
        pointer-events = none

    .step-chip:
        background = {card_bg}
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.35rem 0.15rem
        box-sizing = border-box
        height = 84px
        display = flex
        flex-direction = column
        align-items = center
        justify-content = center
        gap = 0.15rem
        font-family = inherit
        transition = all 0.12s ease
        position = absolute
        top = 0
        user-select = none

    .step-chip.playing-step-now:
        border-color = {neon_cyan} !important
        background = rgba(0, 229, 255, 0.35) !important
        box-shadow = 0 0 18px {neon_cyan} !important
        z-index = 15 !important

    .step-num:
        font-size = 0.6rem
        color = {text_muted}

    .step-pitch:
        font-size = 0.85rem
        font-weight = 900
        color = #ffffff

    .step-len:
        font-size = 0.65rem
        color = {neon_cyan}

    .chip-step-high .step-pitch:
        color = {neon_cyan}

    .chip-step-mid .step-pitch:
        color = {neon_lime}

    .chip-step-mid-low .step-pitch:
        color = {neon_amber}

    .chip-step-bass .step-pitch:
        color = {neon_pink}

    .chip-step-kick .step-pitch:
        color = #ff5500

    .chip-step-snare .step-pitch:
        color = {neon_pink}

    .chip-step-hihat .step-pitch:
        color = #ffd000

    .chip-step-rest:
        border-style = dashed
        opacity = 0.6

    .chip-step-chord:
        border-color = {neon_amber}
        background = rgba(255, 170, 0, 0.15)


    .timeline-ruler:
        background = #080c1a
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.6rem 0.8rem
        margin = 0.45rem 0
        display = flex
        flex-direction = column
        gap = 0.35rem

    .ruler-header-row:
        display = flex
        gap = 0.5rem
        justify-content = space-between
        align-items = center

    .ruler-header:
        font-size = 0.7rem
        font-weight = bold
        color = {text_muted}
        letter-spacing = 1px

    .ruler-hint:
        margin-left = auto
        font-size = 0.65rem
        color = {text_muted}

    .ruler-track:
        position = relative
        width = 100%

    .ruler-scrub:
        height = 22px
        border-bottom = 1px solid {grid_border}
        touch-action = none

    .ruler-scrub.can-seek:
        cursor = ew-resize

    .ruler-playhead::before:
        content = ""
        position = absolute
        left = -4px
        top = 2px
        width = 11px
        height = 11px
        background = {neon_cyan}
        border-radius = 3px

    .ruler-playhead:
        position = absolute
        top = 0
        bottom = 0
        width = 3px
        background = {neon_cyan}
        box-shadow = 0 0 10px {neon_cyan}
        z-index = 20
        pointer-events = none
        left = 0%
        display = block

    .ruler-bars:
        display = flex
        gap = 0.35rem
        width = 100%

    .ruler-bars .ruler-bar-item:
        flex = 1
        min-width = 0
        padding = 0.35rem 0.1rem
        color = {text_muted}
        text-align = center

    .ruler-bar-item:hover:
        border-color = {neon_cyan}
        background = rgba(0, 229, 255, 0.08)

    .ruler-bars .ruler-bar-item.active-bar:
        border-color = {neon_cyan}
        background = rgba(0, 229, 255, 0.18)
        box-shadow = 0 0 10px rgba(0, 229, 255, 0.3)

    .ruler-bars .ruler-bar-item.playing-bar:
        border-color = {neon_lime} !important
        background = rgba(57, 255, 20, 0.22) !important
        box-shadow = 0 0 14px {neon_lime} !important

    .ruler-bar-num:
        font-size = 0.75rem
        font-weight = 900
        color = {neon_cyan}

    .bar-tab:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        transition = all 0.15s ease
        touch-action = manipulation

    .bar-tab:hover:
        color = #ffffff
        border-color = {neon_cyan}

    .bar-tab.active:
        background = {neon_cyan}
        color = #000000
        border-color = {neon_cyan}
        box-shadow = 0 0 10px {neon_cyan}

    .bar-actions:
        display = flex
        gap = 0.4rem
        align-items = center

    .btn-bar-action:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        transition = all 0.15s ease

    .btn-bar-action:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 8px rgba(0, 229, 255, 0.4)

    .btn-add-bar:
        border-color = {neon_lime}
        color = {neon_lime}

    .btn-add-bar:hover:
        border-color = {neon_lime}
        box-shadow = 0 0 10px rgba(57, 255, 20, 0.4)

    .seq-playhead:
        position = absolute
        top = 0
        bottom = 0
        width = 2px
        background = {neon_cyan}
        box-shadow = 0 0 10px {neon_cyan}
        z-index = 25
        pointer-events = none
        left = 0%
        display = block

    .seq-seek-grip:
        position = absolute
        top = 1px
        left = -4px
        width = 13px
        height = 19px
        background = {neon_cyan}
        border-radius = 3px
        pointer-events = auto
        cursor = ew-resize
        touch-action = none

    .piano-matrix-rack:
        background = #050814
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.75rem
        margin = 0.45rem 0

    .matrix-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.5rem
        flex-wrap = wrap
        gap = 0.5rem

    .matrix-title:
        margin = 0
        font-size = 0.8rem
        font-weight = 900
        color = {neon_lime}
        letter-spacing = 1px

    .matrix-sub:
        font-size = 0.7rem
        color = {text_muted}

    .matrix-container:
        display = flex
        border = 1px solid {grid_border}
        border-radius = 6px
        overflow = auto
        max-height = clamp(300px, 48vh, 580px)
        background = #080c1a
        position = relative

    .matrix-keys-column:
        position = sticky
        left = 0
        z-index = 27
        display = flex
        flex-direction = column
        background = #03050c
        border-right = 2px solid {grid_border}
        width = 68px
        flex-shrink = 0

    .matrix-key:
        font-family = inherit
        font-size = 0.65rem
        font-weight = bold
        padding = 0 6px
        border = none
        border-bottom = 1px solid rgba(255, 255, 255, 0.05)
        text-align = right
        cursor = pointer
        transition = all 0.1s ease
        touch-action = manipulation
        height = 28px
        flex-shrink = 0
        box-sizing = border-box
        display = flex
        align-items = center
        justify-content = flex-end

    .mkey-drum:
        height = 48px
        font-size = 0.7rem
        background = #131b2e
        color = {neon_amber}
        justify-content = center

    .mkey-white:
        background = #e2e8f0
        color = #0f172a

    .mkey-black:
        background = #1e293b
        color = {neon_cyan}

    .matrix-key.selected-key:
        background = {neon_cyan} !important
        color = #000000 !important
        box-shadow = 0 0 10px {neon_cyan} !important
        font-weight = 900

    .matrix-note-timeline:
        position = relative
        flex = none

    .matrix-grid-surface:
        position = relative
        height = 1008px
        cursor = crosshair
        background-color = #070b18
        background-image = linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(to right, rgba(0, 229, 255, 0.18) 1px, transparent 1px, transparent 119px, rgba(0, 229, 255, 0.18) 120px), linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px)
        background-size = 100% 28px, 120px 100%, 30px 100%

    .matrix-grid-surface.surface-drums:
        height = 144px
        background-image = linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 1px, transparent 1px), linear-gradient(to right, rgba(0, 229, 255, 0.18) 1px, transparent 1px, transparent 119px, rgba(0, 229, 255, 0.18) 120px), linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px)
        background-size = 100% 48px, 120px 100%, 30px 100%

    .matrix-bar-divider:
        position = absolute
        top = 0
        bottom = 0
        width = 2px
        background = rgba(255, 170, 0, 0.45)
        border-right = 1px dashed rgba(255, 170, 0, 0.75)
        z-index = 8
        cursor = pointer

    .matrix-bar-divider-label:
        position = absolute
        top = 4px
        left = 4px
        font-size = 9px
        font-weight = 900
        color = {neon_amber}
        background = rgba(0, 0, 0, 0.75)
        padding = 1px 4px
        border-radius = 3px
        pointer-events = none

    .note-resize-grip:
        position = absolute
        top = 1px
        bottom = 1px
        right = 0
        width = 8px
        z-index = 21
        background = linear-gradient(to left, rgba(255, 255, 255, 0.38) 2px, transparent 2px)
        cursor = ew-resize
        touch-action = none

    .note-resize-grip:hover:
        background = rgba(255, 255, 255, 0.28)

    .studio-drag-preview:
        position = fixed
        pointer-events = none
        box-sizing = border-box
        z-index = 1000
        background = rgba(0, 229, 255, 0.25)
        border = 2px solid {neon_cyan}
        border-radius = 4px

    .studio-drag-preview.studio-drag-blocked:
        background = rgba(255, 42, 133, 0.25)
        border-color = {neon_pink}

    .matrix-note-block:
        position = absolute
        height = 24px
        box-sizing = border-box
        border-radius = 4px
        border = 1px solid rgba(255, 255, 255, 0.25)
        background = rgba(0, 229, 255, 0.22)
        display = flex
        align-items = center
        justify-content = space-between
        padding = 0 8px 0 2px
        overflow = hidden
        cursor = grab
        transition = transform 0.1s ease, box-shadow 0.1s ease
        touch-action = none
        z-index = 10
        user-select = none

    .matrix-note-block.compact-note:
        padding = 0 5px 0 0

    .compact-note .note-resize-grip:
        width = 5px

    .compact-note .matrix-delete-btn:
        width = 8px
        margin-left = 0

    .surface-drums .matrix-note-block:
        height = 42px

    .matrix-note-block:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 10px rgba(0, 229, 255, 0.5)
        z-index = 15

    .matrix-note-block.selected-step:
        border-color = {neon_lime} !important
        background = rgba(57, 255, 20, 0.35) !important
        box-shadow = 0 0 16px rgba(57, 255, 20, 0.7) !important
        z-index = 20 !important

    .matrix-note-block.playing-step-now:
        border-color = #ffffff !important
        background = {neon_cyan} !important
        box-shadow = 0 0 20px {neon_cyan} !important
        color = #000000 !important
        z-index = 25 !important

    .matrix-note-body:
        display = flex
        flex = 1
        min-width = 0
        align-items = baseline
        gap = 4px
        overflow = hidden
        white-space = nowrap
        pointer-events = none

    .matrix-note-pitch:
        font-size = 11px
        font-weight = 900
        color = #ffffff

    .playing-step-now .matrix-note-pitch:
        color = #000000

    .matrix-note-len:
        font-size = 9px
        color = rgba(255, 255, 255, 0.7)

    .playing-step-now .matrix-note-len:
        color = rgba(0, 0, 0, 0.8)

    .matrix-length-controls:
        display = flex
        gap = 6px
        margin-left = auto

    .matrix-delete-btn:
        background = {neon_pink}
        color = #ffffff
        border = 1px solid rgba(255, 255, 255, 0.4)
        border-radius = 50%
        width = 16px
        height = 16px
        font-size = 11px
        line-height = 1
        display = flex
        align-items = center
        justify-content = center
        cursor = pointer
        padding = 0
        flex-shrink = 0
        z-index = 12
        margin-left = 2px

    .matrix-delete-btn:hover:
        transform = scale(1.2)
        box-shadow = 0 0 8px {neon_pink}

    .chip-step-high.matrix-note-block:
        border-left = 4px solid {neon_cyan}

    .chip-step-mid.matrix-note-block:
        border-left = 4px solid {neon_lime}

    .chip-step-mid-low.matrix-note-block:
        border-left = 4px solid {neon_amber}

    .chip-step-bass.matrix-note-block:
        border-left = 4px solid {neon_pink}

    .chip-step-kick.matrix-note-block:
        border-left = 4px solid #ff5500

    .chip-step-snare.matrix-note-block:
        border-left = 4px solid {neon_pink}

    .chip-step-hihat.matrix-note-block:
        border-left = 4px solid #ffd000

    .chip-step-rest.matrix-note-block:
        border-style = dashed
        opacity = 0.5

    .step-stretch-btn:
        background = rgba(255, 255, 255, 0.1)
        color = #ffffff
        border = 1px solid rgba(255, 255, 255, 0.2)
        border-radius = 3px
        padding = 1px 4px
        font-size = 9px
        cursor = pointer
        transition = all 0.1s ease

    .step-stretch-btn:hover:
        background = {neon_cyan}
        color = #000000

    .piano-roll-container:
        overflow-x = auto
        padding = 0.5rem 0 1rem 0
        margin-top = 0.5rem

    .piano-roll:
        display = flex
        gap = 3px
        min-width = 720px
        padding = 4px

    .piano-key:
        border-radius = 0 0 6px 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        display = flex
        align-items = flex-end
        justify-content = center
        padding-bottom = 8px
        transition = all 0.1s ease
        user-select = none
        touch-action = manipulation

    .key-white:
        background = #e2e8f0
        color = #0f172a
        border = 1px solid #94a3b8
        width = 36px
        height = 110px
        z-index = 1

    .key-white:hover:
        background = #00e5ff
        color = #000000
        box-shadow = 0 0 14px #00e5ff

    .key-white:active:
        background = #39ff14
        transform = translateY(2px)

    .key-black:
        background = #090d1a
        color = #00e5ff
        border = 1px solid #00e5ff
        width = 30px
        height = 75px
        margin-left = -15px
        margin-right = -15px
        z-index = 2
        box-shadow = 0 2px 8px rgba(0, 0, 0, 0.9)

    .key-black:hover:
        background = #ff2a85
        color = #ffffff
        border-color = #ff2a85
        box-shadow = 0 0 14px #ff2a85

    .key-black:active:
        background = #39ff14
        color = #000000
        transform = translateY(2px)

    .piano-key.selected-key:
        background = {neon_lime} !important
        color = #000000 !important
        box-shadow = 0 0 18px {neon_lime} !important
        border-color = {neon_lime} !important
        transform = translateY(2px)
        font-weight = 900 !important

    .drum-machine-container:
        padding = 1rem 0

    .drum-pads:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(130px, 1fr))
        gap = 0.75rem

    .drum-pad:
        background = {card_bg}
        border = 2px solid {grid_border}
        border-radius = 12px
        padding = 1.25rem 0.5rem
        cursor = pointer
        display = flex
        flex-direction = column
        align-items = center
        gap = 0.5rem
        font-family = inherit
        transition = all 0.12s ease
        touch-action = manipulation
        min-height = 90px

    .drum-pad:hover:
        border-color = {neon_pink}
        box-shadow = 0 0 18px {neon_pink}
        transform = translateY(-2px)

    .drum-pad:active:
        background = {neon_pink}
        color = #000000
        transform = scale(0.96)

    .drum-pad.selected-key:
        border-color = {neon_lime} !important
        box-shadow = 0 0 20px {neon_lime} !important
        background = rgba(57, 255, 20, 0.2) !important

    .drum-icon:
        font-size = 1.75rem

    .drum-name:
        font-size = 0.85rem
        font-weight = bold
        color = #ffffff
        letter-spacing = 2px

