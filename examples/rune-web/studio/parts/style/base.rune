@Style/studio

tokens:
    neon_cyan = #00e5ff
    neon_lime = #39ff14
    neon_pink = #ff2a85
    neon_amber = #ffaa00
    chassis_bg = #080b16
    rack_bg = #0d1224
    card_bg = #121830
    grid_border = #202b48
    text_muted = #9aaac0

rules:
    body:
        margin = 0
        padding = 8px
        box-sizing = border-box
        background = {chassis_bg}
        color = #ffffff
        font-family = system-ui, sans-serif

    .studio-cabinet:
        background = {chassis_bg}
        color = #ffffff
        font-family = system-ui, sans-serif
        padding = clamp(0.55rem, 1.4vw, 1.2rem)
        border-radius = 12px
        border = 1px solid {grid_border}
        max-width = 1520px
        margin = 0 auto
        width = 100%
        box-sizing = border-box
        display = grid
        gap = 0.65rem

    .studio-header:
        display = flex
        justify-content = space-between
        align-items = center
        gap = 0.8rem

    .studio-title:
        color = #e7f3ff
        font-size = 1.05rem
        font-weight = 800
        letter-spacing = 2px
        margin = 0

    .btn-fullscreen:
        padding = 0.4rem 0.85rem
        border-radius = 6px
        font-size = 0.75rem
        letter-spacing = 1px
        font-weight = bold
        background = {card_bg}
        border = 1px solid {neon_cyan}
        color = {neon_cyan}
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-fullscreen:hover:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 12px {neon_cyan}

    .status-txt:
        flex = 1
        margin = 0
        padding = 0.2rem 0.3rem
        min-height = 1rem
        font-size = 0.78rem
        color = {text_muted}

    .song-selector:
        display = flex
        align-items = end
        justify-content = space-between
        gap = 0.6rem
        flex-wrap = wrap
        padding = 0.75rem
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 9px

    .song-title-label:
        flex = 1
        min-width = min(100%, 230px)
        display = grid
        gap = 0.25rem

    .song-title-input, .song-open:
        background = {chassis_bg}
        border = 1px solid {grid_border}
        border-radius = 6px
        color = #e7f3ff
        box-sizing = border-box
        min-height = 36px
        padding = 0.4rem 0.6rem
        font-family = inherit
        color-scheme = dark

    .song-title-input:
        font-size = 1rem
        font-weight = 650
        width = 100%

    .song-open:
        font-size = 0.8rem
        max-width = 14rem

    .song-actions:
        display = flex
        flex-wrap = wrap
        gap = 0.35rem

    .btn-storage.btn-new-song:
        background = #263c58
        color = #e7f3ff
        border-color = #486786
        font-weight = 700

    .transport-bar:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 9px
        padding = 0.45rem 0.65rem
        display = flex
        align-items = center
        flex-wrap = wrap
        gap = 0.6rem 1.15rem
        position = sticky
        top = 0
        z-index = 30

    .studio-workspace:
        display = grid
        grid-template-columns = minmax(130px, 172px) minmax(0, 1fr)
        align-items = start
        gap = 0.65rem

    .studio-cabinet :focus-visible:
        outline = 2px solid {neon_cyan}
        outline-offset = 2px

    .transport-buttons:
        display = flex
        gap = 0.5rem

    .btn-transport:
        padding = 0.6rem 1.2rem
        border-radius = 8px
        font-weight = bold
        border = none
        cursor = pointer
        font-family = inherit
        letter-spacing = 1px
        font-size = 0.9rem
        display = flex
        align-items = center
        gap = 0.4rem
        transition = all 0.15s ease
        touch-action = manipulation
        min-height = 42px

    .btn-play:
        background = #8de0a5
        color = #102518

    .btn-play:hover:
        background = #b4edc1

    .btn-pause:
        background = {neon_amber}
        color = #000000

    .btn-transport-seek:
        min-width = 32px
        padding = 0 0.45rem
        border-radius = 6px
        font-family = inherit
        font-size = 1.2rem
        line-height = 1
        border = 1px solid {grid_border}
        background = {card_bg}
        color = #e7f3ff
        cursor = pointer
        touch-action = manipulation

    .btn-transport-seek:hover:
        border-color = {neon_cyan}

    .transport-buttons.is-playing .btn-transport-seek:
        visibility = hidden

    .btn-transport-seek:disabled:
        opacity = 0.45
        cursor = default

    .tempo-controls:
        display = flex
        align-items = center
        gap = 0.6rem

    .ctrl-label:
        font-size = 0.8rem
        color = {text_muted}
        font-weight = bold

    .bpm-badge:
        font-size = 1.1rem
        font-weight = bold
        color = {neon_lime}
        min-width = 80px
        text-align = center

    .btn-tempo:
        background = {card_bg}
        color = #ffffff
        border = 1px solid {grid_border}
        width = 36px
        height = 36px
        border-radius = 6px
        cursor = pointer
        font-weight = bold
        touch-action = manipulation

    .time-sig-controls:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-timesig:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.8rem
        transition = all 0.15s ease

    .btn-timesig.active:
        background = {neon_amber}
        color = #000000
        border-color = {neon_amber}
        box-shadow = 0 0 10px {neon_amber}

    .mode-controls:
        margin-left = auto
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-mode:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        transition = all 0.15s ease

    .btn-mode.active:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 12px {neon_cyan}

    .btn-storage:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.5rem 0.8rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-size = 0.75rem
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation
        min-height = 36px

    .btn-storage:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 10px rgba(0, 229, 255, 0.3)

