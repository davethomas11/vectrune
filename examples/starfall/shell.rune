@Page/starfall_cabinet
title = Starfall Protocol - A signal from a dead station
logic = starfall_cabinet
style = starfall_cabinet
view:
    main .cabinet:
        header .masthead:
            div:
                p .eyebrow "RUNE / PIXEL-3D / EXPEDITION 001"
                h1 "STARFALL PROTOCOL"
            p .tagline "The Ark is going dark. One pilot. One last light."
        section .game-card:
            div .toolbar:
                span .level "KEPLER STATION / ORBIT DECAYING"
                div .buttons:
                    button data-pixel-action="advance" data-pixel-hidden=cinema_skip_hidden "Skip scene / Enter"
                    button data-pixel-pause=true "Pause / P"
                    button data-pixel-mute=true "Sound / V"
                    button data-pixel-fullscreen=true "Fullscreen / F"
            div .game-surface:
                canvas data-rune-pixel-3d=true data-pixel-fit=viewport data-pixel-touch-padding=14 tabindex=0 aria-label="Starfall Protocol, a side-scrolling space adventure. A and D or arrows move, Space jumps, left click or X fires, W or Up aims upward, S or Down ducks. On touch, move the stick up to aim and down to duck. Recover the core and return to your ship."
                button .fullscreen-exit .fullscreen-exit-hud data-pixel-fullscreen=true aria-label="Exit fullscreen" "EXIT"
                div .pause-menu data-pixel-paused=true data-pixel-menu=true hidden=true:
                    h2 "SIGNAL ON HOLD"
                    p "Resume whenever you are ready."
                    button data-pixel-pause=true "Resume expedition / P"
                    button data-pixel-restart=true "Reset to title"
                    button .fullscreen-exit data-pixel-fullscreen=true "Exit fullscreen"
                div .launch data-pixel-hidden=title_hidden:
                    button .primary data-pixel-start=true data-pixel-text=launch_label "Board station / Enter"
            p .status data-pixel-status=true role=status aria-live=polite "Awaiting pilot."
        section .guide aria-label="Pilot briefing":
            div:
                h2 "01 / SUIT UP"
                p "The opening flight and mission briefing precede your landing. Enter or Skip scene advances the story; P pauses cinematics. Your ship lands before controls unlock. A / D or arrows move; Space jumps. Left click or X fires; hold to charge plasma and release to shoot. W / Up aims high. Hold S / Down to duck and fire low; jump to stand. Controller right shoulder or left stick down ducks. On touch, push the movement stick up to aim or down to duck; USE appears near doors and consoles, and DASH appears once unlocked. J still fires as an alternate. Start with four health cells and three lives per attempt. Bosses add permanent health containers. Four rare green 1-UP capsules reward exploring optional ledges; each can be claimed once per expedition. Completed sectors stay saved after game over. P pauses, including landing and takeoff."
            div:
                h2 "02 / OPEN NEW PATHS"
                p "Use E at the glowing Propulsion Crypt portal to find jump jets on their pedestal, then use E at the nearby hatch to enter Hydroponics. Climb Hydroponics past the repair pod, then double jump to the marked upper ledge. Use E at the glowing Dash Crypt portal to recover air dash from its pedestal. Jump, then press Shift / K to cross the greenhouse breach. Defeat Rootheart and collect its relay to save the sector and open a shortcut back to cargo. Controller B dashes and Y uses hatches; touch has DASH and USE buttons."
            div:
                h2 "03 / BRING IT HOME"
                p "Return with Hydroponics air dash: use jets to climb the western ledges, then jump and dash left across the wide gap to plasma. Charge a shot to breach the violet seal. In the Gravity Foundry, inspect the overhead carrier, then climb back to the service workshop for the magnetic glove. Jump to grab its underside and press Space to release, and use E at consoles to switch gravity. Restore its relay to open the Reactor Crypt. Defeat the Warden, then fight hunters and deck crawlers as you bring its core home."
            div:
                h2 "04 / FOLLOW SIDE SIGNALS"
                p "Pause with P, controller Start, or the touch PAUSE button to view the exploration map. V toggles sound. Purple hatches mark optional routes. The Signal Archive on the western middle ledge combines jets and dash for a faster-charging plasma capacitor. The Observatory in eastern containment needs the magnetic glove and a gravity-assisted ascent; its armor adds two health cells. Both upgrades stay saved. Beyond the Observatory armor, descend into the optional Void Curator chamber for another permanent health container. Enemies brighten before firing, and red edge cues show incoming damage direction."
        footer:
            p "MADE WITH RUNE / PIXEL-3D"
            p "Keyboard / controller / touch. Completed sectors and their gear are saved."

@Logic/starfall_cabinet
state:
    label = "Starfall Protocol"

@Style/starfall_cabinet
rules:
    :root:
        color-scheme = dark
    *:
        box-sizing = border-box
    body:
        margin = 0
        background = #080d1b
        color = #e1f5ef
        font-family = system-ui, sans-serif
    .cabinet:
        max-width = 1120px
        margin = auto
        padding = clamp(16px, 3vw, 40px)
    .masthead:
        display = flex
        align-items = end
        justify-content = space-between
        flex-wrap = wrap
        gap = 20px
        margin-bottom = 24px
    .eyebrow:
        color = #58efd5
        font-size = 10px
        font-weight = 800
        letter-spacing = 3px
        margin = 0 0 12px
    h1:
        font-size = clamp(26px, 4vw, 48px)
        letter-spacing = -2px
        line-height = 1
        margin = 0
    .tagline:
        color = #8c9db8
        max-width = 240px
        font-size = 13px
        line-height = 1.7
        margin = 0
    .game-card:
        border = 1px solid #34435d
        border-radius = 10px
        overflow = hidden
        background = #10182e
        box-shadow = 0 16px 60px #00000060
    .toolbar:
        display = flex
        align-items = center
        justify-content = space-between
        flex-wrap = wrap
        padding = 10px 14px
        gap = 10px
    .level:
        color = #8c9db8
        font-size = 10px
        letter-spacing = 2px
    .buttons:
        display = flex
        gap = 6px
        flex-wrap = wrap
    button:
        -webkit-tap-highlight-color = transparent
        cursor = pointer
        border = 1px solid #34435d
        border-radius = 4px
        background = #18233b
        color = #e1f5ef
        padding = 10px 14px
        min-height = 44px
        font = inherit
        font-size = 12px
        font-weight = 700
    button:hover:
        background = #283953
    button:focus-visible:
        outline = 2px solid #58efd5
        outline-offset = 3px
    .game-surface:
        position = relative
        background = #060b1b
        touch-action = none
        overscroll-behavior = none
        user-select = none
        -webkit-user-select = none
        -webkit-touch-callout = none
    .game-surface *:
        user-select = none
        -webkit-user-select = none
        -webkit-touch-callout = none
    canvas:
        display = block
        width = 100%
        height = auto
        aspect-ratio = 8 / 5
        image-rendering = pixelated
        touch-action = none
        outline-offset = -3px
    .launch:
        position = absolute
        z-index = 7
        bottom = max(32px, calc(env(safe-area-inset-bottom) + 12px))
        left = 0
        right = 0
        display = flex
        align-items = center
        justify-content = center
        flex-wrap = wrap
        gap = 12px 24px
        padding = 8px
        font-size = 12px
        color = #8c9db8
    .primary:
        background = #58efd5
        border-color = #58efd5
        color = #080d1b
        padding = 14px 28px
    .primary:hover:
        background = #b2fff0
    .status:
        text-align = center
        color = #8c9db8
        font-size = 11px
        padding = 0 12px 10px
    .guide:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(230px, 1fr))
        gap = 28px
        margin-top = 36px
    .guide h2:
        color = #58efd5
        font-size = 11px
        letter-spacing = 2px
    .guide p:
        color = #8c9db8
        font-size = 13px
        line-height = 1.8
    footer:
        display = flex
        justify-content = space-between
        flex-wrap = wrap
        gap = 12px
        border-top = 1px solid #283953
        margin-top = 24px
        padding-top = 16px
        color = #7b8aa3
        font-size = 10px
    .pause-menu:
        position = absolute
        z-index = 8
        inset = 0 0 auto 0
        display = flex
        flex-direction = row
        flex-wrap = wrap
        align-items = center
        justify-content = center
        text-align = center
        gap = 8px
        padding = 8px
        background = #10182ecc
    .pause-menu h2:
        display = none
    .pause-menu p:
        display = none
    [hidden]:
        display = none !important
    .rune-embedded-game .masthead, .rune-embedded-game .guide, .rune-embedded-game footer:
        display = none
    .rune-embedded-game .cabinet:
        padding = 8px
    .fullscreen-exit:
        display = none
    .game-surface:fullscreen .fullscreen-exit, .game-surface.rune-pixel3d-expanded .fullscreen-exit:
        display = inline-block
    .fullscreen-exit-hud:
        position = absolute
        z-index = 9
        top = max(12px, env(safe-area-inset-top))
        right = calc(max(12px, env(safe-area-inset-right)) + 52px)
        width = 52px
        height = 44px
        padding = 4px
        font-size = 11px
        background = #142432dd
    .game-surface:fullscreen canvas[data-pixel-fit=viewport], .game-surface.rune-pixel3d-expanded canvas[data-pixel-fit=viewport]:
        width = 100% !important
        height = 100% !important
        max-width = none !important
        max-height = none !important
        aspect-ratio = auto
    .game-surface:has(.pause-menu:not([hidden])) .rune-control-touch button:
        visibility = hidden
        pointer-events = none
