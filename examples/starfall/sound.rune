# Original E Phrygian score: low pedals, semitone tension and sparse metal echoes.
@Music/sf_orbit
type = synth
tempo = 72
time_signature = 4/4
bars = 8
loop = true
volume = 0.065
instruments = {"lead":"bell","harmony":"strings","bass":"triangle","drums":"drums"}
lead:
    E4:2 -:4 F4:4 |
    -:2 B3:4 -:4 |
    E4:2 Bb3:2 |
    F4:4 E4:4 -:2 |
    -:2 E4:4 G4:4 |
    F4:2 -:4 B3:4 |
    Bb3:2 F4:4 E4:4 |
    -:1
harmony:
    [E3,G3,B3]:1 |
    [E3,F3,B3]:1 |
    [E3,G3,Bb3]:1 |
    [D3,F3,A3]:1 |
    [E3,G3,B3]:1 |
    [F3,A3,B3]:1 |
    [E3,F3,Bb3]:1 |
    [E3,B3]:1
bass:
    E2:4 -:8 E2:8 B1:4 E2:4 |
    E2:2 F2:4 E2:4 |
    E2:4 -:8 E2:8 Bb1:4 E2:4 |
    D2:2 B1:2 |
    E2:4 -:8 E2:8 B1:4 E2:4 |
    F2:2 E2:2 |
    Bb1:4 E2:4 F2:4 E2:4 |
    E2:2 -:2
drums:
