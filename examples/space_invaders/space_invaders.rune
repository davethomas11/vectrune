#!RUNE

import "parts"

@App
name = VectRaiders
version = 1.0
type = REST
port = 3000

@Frontend
type = rune-web
path = %ROOT%
page = space-invaders

@Page/space-invaders
title = VectRaiders
style = invaders
logic = invaders
view:
    main .arcade-cabinet:
        header .cabinet-header:
            h1 .cabinet-title "VECTRAIDERS"
            div .stats-bar:
                span "SCORE: {score}"
                span "LIVES: {lives}"
                span "ALIENS: {alien_count}"

        div .arena-viewport:
            div .game-arena:
                div .arena-grid

                # Player Cannon
                div .player style="left: calc({player.x} * 100% / 480);":
                    div .player-canon

                # Player Lasers
                div .bullet <- bullet in bullets:
                    style = "left: calc({bullet.x} * 100% / 480); top: calc({bullet.y} * 100% / 460);"

                # Alien Lasers
                div .alien-bullet <- ab in alien_bullets:
                    style = "left: calc({ab.x} * 100% / 480); top: calc({ab.y} * 100% / 460);"

                # Invader Grid
                div .alien .type-{alien.type} style="left: calc({alien.x} * 100% / 480); top: calc({alien.y} * 100% / 460); display: {alien.alive ? 'flex' : 'none'};" <- alien in aliens:
                    "👾"

                # Explosions & Particles
                div .particle <- p in particles:
                    style = "left: calc({p.x} * 100% / 480); top: calc({p.y} * 100% / 460); opacity: calc({p.life} / {p.max_life}); width: {p.size}px; height: {p.size}px; background: {p.color}; box-shadow: 0 0 6px {p.color};"

                # Game State Overlay
                if status != "playing":
                    div .overlay:
                        h2 .overlay-title "{game_message}"
                        button .start-btn click=start on_pointerdown=start "PLAY NOW"

        # Arcade Controls for Touch and Mouse
        div .arcade-controls:
            button .ctrl-btn on_pointerdown=startLeft on_pointerup=stopMove on_pointerleave=stopMove click=moveLeft "◀ LEFT"
            button .ctrl-btn .fire-btn on_pointerdown=fire click=fire "⚡ FIRE"
            button .ctrl-btn on_pointerdown=startRight on_pointerup=stopMove on_pointerleave=stopMove click=moveRight "RIGHT ▶"

        p .controls-hint "KEYBOARD: [A / ◀] LEFT  •  [D / ▶] RIGHT  •  [SPACE] FIRE"
