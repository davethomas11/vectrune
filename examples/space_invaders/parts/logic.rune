@Logic/invaders
timer = tick 40ms

keys:
    ArrowLeft -> moveLeft
    ArrowRight -> moveRight
    Space -> fire
    KeyA -> moveLeft
    KeyD -> moveRight

state:
    player = { "x": 220, "y": 420 }
    bullets = []
    alien_bullets = []
    alien_dir = 1
    alien_speed = 3
    alien_count = 18
    move_dir = 0
    score = 0
    lives = 3
    status = "ready"
    game_message = "VECTRAIDERS"

action startLeft:
    stop when status != "playing"
    move_dir = -1
    player.x = clamp(player.x - 18, 10, 434)

action startRight:
    stop when status != "playing"
    move_dir = 1
    player.x = clamp(player.x + 18, 10, 434)

action stopMove:
    move_dir = 0

action moveLeft:
    stop when status != "playing"
    player.x = clamp(player.x - 20, 10, 434)

action moveRight:
    stop when status != "playing"
    player.x = clamp(player.x + 20, 10, 434)

action fire:
    stop when status != "playing"
    stop when bullets.length >= 3
    bullets.push({ "x": player.x + 16, "y": 405, "alive": true })

action start:
    score = 0
    lives = 3
    alien_count = 18
    alien_dir = 1
    move_dir = 0
    player.x = 220
    bullets = []
    alien_bullets = []
    restore aliens
    status = "playing"
    game_message = ""

action tick:
    stop when status != "playing"

    # Smooth continuous movement when on-screen buttons are pressed
    if move_dir < 0:
        player.x = clamp(player.x - 12, 10, 434)
    if move_dir > 0:
        player.x = clamp(player.x + 12, 10, 434)

    # 1. Update player bullets
    for b in bullets:
        b.y -= 12
    bullets = bullets.filter it.y > 0 and it.alive

    # 2. Update alien bullets
    for ab in alien_bullets:
        ab.y += 7
    alien_bullets = alien_bullets.filter it.y < 460 and it.alive

    # 3. Check alien bullet collision with player
    for ab in alien_bullets:
        if collide(ab, player, 20, 16):
            ab.alive = false
            lives -= 1
            if lives <= 0:
                status = "game_over"
                game_message = "GAME OVER"
                stop

    # 4. Move aliens and detect boundary reversal
    change_dir = false
    for a in aliens:
        if a.alive:
            a.x += alien_dir * alien_speed
            if a.x > 430 or a.x < 20:
                change_dir = true
            if a.y > 400:
                status = "game_over"
                game_message = "GRID BREACHED! GAME OVER"
                stop

    if change_dir:
        alien_dir = -alien_dir
        for a in aliens:
            a.y += 16

    # 5. Check player bullet collisions with aliens
    for b in bullets:
        for a in aliens:
            if a.alive and b.alive:
                if collide(b, a, 22, 18):
                    a.alive = false
                    b.alive = false
                    score += 20
                    alien_count -= 1

    # 6. Occasional alien return fire
    if random(1, 22) == 1:
        for a in aliens:
            if a.alive and random(1, 5) == 1:
                alien_bullets.push({ "x": a.x + 12, "y": a.y + 16, "alive": true })
                stop

    # 7. Check victory condition
    if alien_count <= 0:
        status = "victory"
        game_message = "VECTOR GRID SAVED! YOU WIN!"
        stop
