@Style/invaders
tokens:
    neon_green = #00ff88
    neon_cyan = #00e5ff
    neon_pink = #ff2a85
    neon_yellow = #ffd000
    cabinet_bg = #0a0d1a
    arena_bg = #04060d

rules:
    .arcade-cabinet:
        max-width = 540px
        width = 100%
        box-sizing = border-box
        margin = 1.25rem auto
        background = #0d1124
        border = 3px solid #00ff88
        border-radius = 16px
        padding = 1.25rem
        box-shadow = 0 0 35px rgba(0, 255, 136, 0.25), inset 0 0 20px rgba(0, 0, 0, 0.8)
        font-family = "Courier New", monospace, sans-serif
        color = #ffffff
        user-select = none
        touch-action = manipulation

    .cabinet-header:
        text-align = center
        margin-bottom = 0.75rem
        border-bottom = 2px solid rgba(0, 255, 136, 0.3)
        padding-bottom = 0.6rem

    .cabinet-title:
        font-size = 1.75rem
        font-weight = 900
        letter-spacing = 4px
        color = #00ff88
        text-shadow = 0 0 10px #00ff88, 0 0 20px #00ff88
        margin = 0 0 0.5rem 0

    .stats-bar:
        display = flex
        justify-content = space-between
        font-size = 0.95rem
        font-weight = bold
        letter-spacing = 2px
        color = #00e5ff

    .stat-label:
        color = #8892b0

    .arena-viewport:
        position = relative
        width = 480px
        max-width = 100%
        aspect-ratio = 480 / 460
        margin = 0 auto
        overflow = hidden
        display = flex
        justify-content = center
        align-items = flex-start

    .game-arena:
        position = absolute
        top = 0
        left = 50%
        width = 480px
        height = 460px
        min-width = 480px
        transform-origin = top center
        transform = translateX(-50%)
        background = #04060d
        border = 2px solid #233554
        border-radius = 8px
        overflow = hidden
        box-shadow = inset 0 0 40px rgba(0, 0, 0, 0.9)
        pointer-events = none

    .arena-grid:
        position = absolute
        top = 0
        left = 0
        width = 100%
        height = 100%
        background-image = linear-gradient(rgba(0, 255, 136, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 255, 136, 0.04) 1px, transparent 1px)
        background-size = 24px 24px
        pointer-events = none

    .player:
        position = absolute
        bottom = 16px
        width = 36px
        height = 20px
        background = #00ff88
        border-radius = 4px 4px 1px 1px
        box-shadow = 0 0 15px #00ff88
        transition = left 0.04s ease-out
        pointer-events = none

    .player-canon:
        position = absolute
        top = -6px
        left = 15px
        width = 6px
        height = 8px
        background = #ffffff
        border-radius = 2px

    .alien:
        position = absolute
        width = 28px
        height = 22px
        border-radius = 4px
        display = flex
        align-items = center
        justify-content = center
        font-size = 14px
        font-weight = bold
        transition = top 0.1s linear, left 0.1s linear
        pointer-events = none

    .alien.type-1:
        background = #ff2a85
        box-shadow = 0 0 10px #ff2a85
        color = #ffffff

    .alien.type-2:
        background = #00e5ff
        box-shadow = 0 0 10px #00e5ff
        color = #04060d

    .alien.type-3:
        background = #ffd000
        box-shadow = 0 0 10px #ffd000
        color = #04060d

    .bullet:
        position = absolute
        width = 4px
        height = 12px
        background = #ffffff
        border-radius = 2px
        box-shadow = 0 0 8px #00e5ff, 0 0 14px #ffffff
        pointer-events = none

    .alien-bullet:
        position = absolute
        width = 4px
        height = 10px
        background = #ff2a85
        border-radius = 2px
        box-shadow = 0 0 8px #ff2a85
        pointer-events = none

    .overlay:
        position = absolute
        top = 0
        left = 0
        width = 100%
        height = 100%
        background = rgba(4, 6, 13, 0.88)
        display = flex
        flex-direction = column
        align-items = center
        justify-content = center
        z-index = 20
        pointer-events = auto

    .overlay-title:
        font-size = 1.6rem
        font-weight = 900
        letter-spacing = 3px
        margin-bottom = 1rem
        text-align = center
        color = #ffd000
        text-shadow = 0 0 15px #ffd000
        padding = 0 1rem

    .start-btn:
        background = #00ff88
        color = #04060d
        border = none
        padding = 0.85rem 2.25rem
        font-size = 1.15rem
        font-weight = bold
        letter-spacing = 2px
        border-radius = 8px
        cursor = pointer
        box-shadow = 0 0 20px rgba(0, 255, 136, 0.6)
        touch-action = manipulation
        pointer-events = auto
        transition = all 0.15s ease

    .start-btn:hover:
        background = #33ffa3
        box-shadow = 0 0 30px rgba(0, 255, 136, 0.9)
        transform = scale(1.05)

    .start-btn:active:
        transform = scale(0.97)

    .arcade-controls:
        position = relative
        z-index = 100
        display = flex
        justify-content = space-between
        width = 100%
        gap = 0.75rem
        margin-top = 1.1rem
        box-sizing = border-box
        pointer-events = auto

    .ctrl-btn:
        position = relative
        z-index = 101
        pointer-events = auto
        flex = 1
        min-height = 54px
        background = #1a233a
        color = #00ff88
        border = 2px solid #233554
        padding = 0.75rem 0.5rem
        font-size = 1.05rem
        font-weight = bold
        border-radius = 8px
        cursor = pointer
        transition = all 0.1s ease
        touch-action = manipulation
        user-select = none
        display = flex
        align-items = center
        justify-content = center

    .ctrl-btn:hover:
        border-color = #00ff88
        box-shadow = 0 0 12px rgba(0, 255, 136, 0.3)

    .ctrl-btn:active:
        background = #00ff88
        color = #04060d
        transform = scale(0.95)

    .ctrl-btn.fire-btn:
        flex = 1.4
        background = #ff2a85
        color = #ffffff
        border-color = #ff2a85
        box-shadow = 0 0 15px rgba(255, 42, 133, 0.4)
        font-size = 1.2rem

    .ctrl-btn.fire-btn:hover:
        background = #ff4d99
        box-shadow = 0 0 25px rgba(255, 42, 133, 0.7)

    .ctrl-btn.fire-btn:active:
        background = #ff1a75
        transform = scale(0.95)

    .controls-hint:
        text-align = center
        margin-top = 0.75rem
        font-size = 0.8rem
        color = #64748b
        letter-spacing = 1px

responsive:
    (max-width: 520px):
        .arcade-cabinet:
            padding = 0.5rem
            margin = 0.5rem auto
            border-width = 2px
            border-radius = 12px
        .cabinet-title:
            font-size = 1.35rem
            letter-spacing = 2px
        .stats-bar:
            font-size = 0.8rem
            letter-spacing = 1px
        .arena-viewport:
            width = calc(100vw - 2rem)
            max-width = 100%
        .game-arena:
            transform = translateX(-50%) scale(calc((100vw - 2rem) / 480))
        .arcade-controls:
            gap = 0.4rem
            margin-top = 0.6rem
            position = relative
            z-index = 100
        .ctrl-btn:
            min-height = 54px
            font-size = 1rem
            padding = 0.75rem 0.25rem
        .ctrl-btn.fire-btn:
            flex = 1.3
            font-size = 1.15rem
        .controls-hint:
            font-size = 0.7rem
