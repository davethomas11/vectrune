@Style/invaders
tokens:
    neon_green = #00ff88
    neon_cyan = #00e5ff
    neon_pink = #ff2a85
    neon_yellow = #ffd000
    cabinet_bg = #0a0d1a
    arena_bg = #04060d

rules:
    .arcade-cabinet:
        max-width = 540px
        margin = 1.5rem auto
        background = #0d1124
        border = 3px solid #00ff88
        border-radius = 16px
        padding = 1.25rem
        box-shadow = 0 0 35px rgba(0, 255, 136, 0.25), inset 0 0 20px rgba(0, 0, 0, 0.8)
        font-family = "Courier New", monospace, sans-serif
        color = #ffffff
        user-select = none

    .cabinet-header:
        text-align = center
        margin-bottom = 1rem
        border-bottom = 2px solid rgba(0, 255, 136, 0.3)
        padding-bottom = 0.75rem

    .cabinet-title:
        font-size = 1.75rem
        font-weight = 900
        letter-spacing = 4px
        color = #00ff88
        text-shadow = 0 0 10px #00ff88, 0 0 20px #00ff88
        margin = 0 0 0.5rem 0

    .stats-bar:
        display = flex
        justify-content = space-between
        font-size = 1rem
        font-weight = bold
        letter-spacing = 2px
        color = #00e5ff

    .stat-label:
        color = #8892b0

    .game-arena:
        position = relative
        width = 480px
        height = 460px
        margin = 0 auto
        background = #04060d
        border = 2px solid #233554
        border-radius = 8px
        overflow = hidden
        box-shadow = inset 0 0 40px rgba(0, 0, 0, 0.9)

    .arena-grid:
        position = absolute
        top = 0
        left = 0
        width = 100%
        height = 100%
        background-image = linear-gradient(rgba(0, 255, 136, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 255, 136, 0.04) 1px, transparent 1px)
        background-size = 24px 24px
        pointer-events = none

    .player:
        position = absolute
        bottom = 16px
        width = 36px
        height = 20px
        background = #00ff88
        border-radius = 4px 4px 1px 1px
        box-shadow = 0 0 15px #00ff88
        transition = left 0.05s ease-out

    .player-canon:
        position = absolute
        top = -6px
        left = 15px
        width = 6px
        height = 8px
        background = #ffffff
        border-radius = 2px

    .alien:
        position = absolute
        width = 28px
        height = 22px
        border-radius = 4px
        display = flex
        align-items = center
        justify-content = center
        font-size = 14px
        font-weight = bold
        transition = top 0.1s linear, left 0.1s linear

    .alien.type-1:
        background = #ff2a85
        box-shadow = 0 0 10px #ff2a85
        color = #ffffff

    .alien.type-2:
        background = #00e5ff
        box-shadow = 0 0 10px #00e5ff
        color = #04060d

    .alien.type-3:
        background = #ffd000
        box-shadow = 0 0 10px #ffd000
        color = #04060d

    .bullet:
        position = absolute
        width = 4px
        height = 12px
        background = #ffffff
        border-radius = 2px
        box-shadow = 0 0 8px #00e5ff, 0 0 14px #ffffff

    .alien-bullet:
        position = absolute
        width = 4px
        height = 10px
        background = #ff2a85
        border-radius = 2px
        box-shadow = 0 0 8px #ff2a85

    .overlay:
        position = absolute
        top = 0
        left = 0
        width = 100%
        height = 100%
        background = rgba(4, 6, 13, 0.88)
        display = flex
        flex-direction = column
        align-items = center
        justify-content = center
        z-index = 20

    .overlay-title:
        font-size = 1.6rem
        font-weight = 900
        letter-spacing = 3px
        margin-bottom = 1rem
        text-align = center
        color = #ffd000
        text-shadow = 0 0 15px #ffd000

    .start-btn:
        background = #00ff88
        color = #04060d
        border = none
        padding = 0.75rem 2rem
        font-size = 1.1rem
        font-weight = bold
        letter-spacing = 2px
        border-radius = 6px
        cursor = pointer
        box-shadow = 0 0 20px rgba(0, 255, 136, 0.6)

    .start-btn:hover:
        background = #33ffa3
        box-shadow = 0 0 30px rgba(0, 255, 136, 0.9)

    .arcade-controls:
        display = flex
        justify-content = center
        gap = 1rem
        margin-top = 1.25rem

    .ctrl-btn:
        background = #1a233a
        color = #00ff88
        border = 2px solid #233554
        padding = 0.75rem 1.25rem
        font-size = 1rem
        font-weight = bold
        border-radius = 8px
        cursor = pointer
        transition = all 0.1s ease

    .ctrl-btn:hover:
        border-color = #00ff88
        box-shadow = 0 0 12px rgba(0, 255, 136, 0.3)

    .ctrl-btn:active:
        background = #00ff88
        color = #04060d

    .ctrl-btn.fire-btn:
        background = #ff2a85
        color = #ffffff
        border-color = #ff2a85
        box-shadow = 0 0 15px rgba(255, 42, 133, 0.4)
        padding-left = 1.75rem
        padding-right = 1.75rem

    .ctrl-btn.fire-btn:hover:
        background = #ff4d99
        box-shadow = 0 0 25px rgba(255, 42, 133, 0.7)

    .controls-hint:
        text-align = center
        margin-top = 0.75rem
        font-size = 0.8rem
        color = #64748b
        letter-spacing = 1px
