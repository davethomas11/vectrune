@Style/invaders
tokens:
    neon_green = #00ff88
    neon_cyan = #00e5ff
    neon_pink = #ff2a85
    neon_yellow = #ffd000
    cabinet_bg = #0a0d1a
    arena_bg = #04060d
    card_bg = #0d1124
    grid_border = #233554
    text_muted = #8892b0
    btn_bg = #1a233a

presets:
    game-entity:
        abs = true
        pointer-events = none

    arcade-btn:
        position = relative
        pointer-events = auto
        cursor = pointer
        touch-action = manipulation
        user-select = none
        weight = bold
        center = xy
        transition = all 0.1s ease

rules:
    body:
        margin = 0
        padding = 8px
        box-sizing = border-box
        background = {cabinet_bg}

    .arcade-cabinet:
        max-width = min(540px, calc((100svh - 272px) * 480 / 460 + 32px))
        width = 100%
        box-sizing = border-box
        margin = 0 auto
        background = {card_bg}
        border = 3px solid {neon_green}
        round = 16px
        padding = 0.75rem
        box-shadow = 0 0 35px {neon_green / 25%}, inset 0 0 20px rgba(0, 0, 0, 0.8)
        font-family = "Courier New", monospace, sans-serif
        color = #ffffff
        user-select = none
        touch-action = manipulation

    .cabinet-header:
        text-align = center
        margin-bottom = 0.75rem
        border-bottom = 2px solid {neon_green / 30%}
        padding-bottom = 0.6rem

    .cabinet-title:
        font-size = 1.75rem
        weight = 900
        letter-spacing = 4px
        color = {neon_green}
        text-glow = {neon_green} 10px 20px
        margin = 0 0 0.5rem 0

    .stats-bar:
        display = flex
        justify-content = space-between
        font-size = 0.95rem
        weight = bold
        letter-spacing = 2px
        color = {neon_cyan}

    .stat-label:
        color = {text_muted}

    # Rendering maps the 480 by 460 game coordinates into this fluid rectangle.
    .arena-viewport:
        position = relative
        container-type = inline-size
        display = block
        width = 100%
        height = auto
        aspect = 480 / 460
        margin = 0 auto
        overflow = hidden

    .game-arena:
        abs = inset
        size = 100%
        box-sizing = border-box
        background = {arena_bg}
        border = 2px solid {grid_border}
        round = 8px
        overflow = hidden
        box-shadow = inset 0 0 40px rgba(0, 0, 0, 0.9)
        pointer-events = none

    .arena-grid:
        use = (game-entity)
        abs = 0 0
        size = 100%
        background-image = linear-gradient({neon_green / 4%} 1px, transparent 1px), linear-gradient(90deg, {neon_green / 4%} 1px, transparent 1px)
        background-size = 5% 5.217391%

    .player:
        use = (game-entity)
        bottom = 3.478261%
        size = 7.5% 4.347826%
        background = {neon_green}
        round = 4px 4px 1px 1px
        glow = {neon_green} 15px
        transition = left 0.04s ease-out

    .player-canon:
        position = absolute
        top = -30%
        left = 41.666667%
        size = 16.666667% 40%
        background = #ffffff
        round = 2px

    .alien:
        use = (game-entity)
        size = 5.833333% 4.782609%
        round = 4px
        center = xy
        font-size = clamp(6px, 2.916667cqw, 14px)
        weight = bold
        transition = top 0.1s linear, left 0.1s linear

    .alien.type-1:
        background = {neon_pink}
        glow = {neon_pink} 10px
        color = #ffffff

    .alien.type-2:
        background = {neon_cyan}
        glow = {neon_cyan} 10px
        color = {arena_bg}

    .alien.type-3:
        background = {neon_yellow}
        glow = {neon_yellow} 10px
        color = {arena_bg}

    .bullet:
        use = (game-entity)
        size = 0.833333% 2.608696%
        background = #ffffff
        round = 2px
        box-shadow = 0 0 8px {neon_cyan}, 0 0 14px #ffffff

    .alien-bullet:
        use = (game-entity)
        size = 0.833333% 2.173913%
        background = {neon_pink}
        round = 2px
        glow = {neon_pink} 8px

    .particle:
        use = (game-entity)
        round = 50%
        transform = translate(-50%, -50%)
        pointer-events = none
        z-index = 15
        will-change = transform, opacity

    .overlay:
        abs = inset
        size = 100%
        background = {arena_bg / 88%}
        center = xy
        flex-direction = column
        z-index = 20
        pointer-events = auto

    .overlay-title:
        font-size = 1.6rem
        weight = 900
        letter-spacing = 3px
        margin-bottom = 1rem
        text-align = center
        color = {neon_yellow}
        text-glow = {neon_yellow} 15px
        padding = 0 1rem

    .start-btn:
        use = (arcade-btn)
        background = {neon_green}
        color = {arena_bg}
        border = none
        padding = 0.85rem 2.25rem
        font-size = 1.15rem
        letter-spacing = 2px
        round = 8px
        glow = {neon_green / 60%} 20px
        transition = all 0.15s ease
        &:hover:
            background = #33ffa3
            glow = {neon_green / 90%} 30px
            transform = scale(1.05)
        &:active:
            transform = scale(0.97)

    .arcade-controls:
        position = relative
        z-index = 100
        display = flex
        justify-content = space-between
        width = 100%
        gap = 0.75rem
        margin-top = 1.1rem
        box-sizing = border-box
        pointer-events = auto

    .ctrl-btn:
        use = (arcade-btn)
        flex = 1
        min-height = 54px
        background = {btn_bg}
        color = {neon_green}
        border = 2px solid {grid_border}
        padding = 0.75rem 0.5rem
        font-size = 1.05rem
        round = 8px
        &:hover:
            border-color = {neon_green}
            glow = {neon_green / 30%} 12px
        &:active:
            background = {neon_green}
            color = {arena_bg}
            transform = scale(0.95)
        &.fire-btn:
            flex = 1.4
            background = {neon_pink}
            color = #ffffff
            border-color = {neon_pink}
            glow = {neon_pink / 40%} 15px
            font-size = 1.2rem
            &:hover:
                background = #ff4d99
                glow = {neon_pink / 70%} 25px
            &:active:
                background = #ff1a75
                transform = scale(0.95)

    .controls-hint:
        text-align = center
        margin-top = 0.75rem
        font-size = 0.8rem
        color = #64748b
        letter-spacing = 1px

responsive:
    (max-width: 520px):
        .arcade-cabinet:
            padding = 0.5rem
            margin = 0 auto
            border-width = 2px
            border-radius = 12px
        .cabinet-title:
            font-size = 1.35rem
            letter-spacing = 2px
        .stats-bar:
            font-size = 0.8rem
            letter-spacing = 1px
        .arcade-controls:
            gap = 0.4rem
            margin-top = 0.6rem
            position = relative
            z-index = 100
        .ctrl-btn:
            min-height = 54px
            font-size = 1rem
            padding = 0.75rem 0.25rem
        .ctrl-btn.fire-btn:
            flex = 1.3
            font-size = 1.15rem
        .controls-hint:
            font-size = 0.7rem

    (max-height: 480px):
        .arcade-cabinet:
            max-width = min(420px, calc((100svh - 175px) * 480 / 460 + 24px))
            padding = 0.5rem
        .cabinet-title:
            font-size = 1rem
            margin-bottom = 0.25rem
        .cabinet-header:
            margin-bottom = 0.4rem
            padding-bottom = 0.4rem
        .stats-bar:
            font-size = 0.65rem
            letter-spacing = 0
        .arcade-controls:
            margin-top = 0.5rem
            gap = 0.25rem
        .ctrl-btn:
            min-height = 44px
            font-size = 0.7rem
            padding = 0.5rem 0.1rem
        .ctrl-btn.fire-btn:
            font-size = 0.75rem
        .controls-hint:
            display = none
