#!RUNE
@App
name = Tested API
type = REST
port = 3000

@Route/GET/health
run:
    respond 200 "OK"

@Schema/User
name = string
role = string

@Route/POST/users
run:
    user = parse-json body
    validate user #User
    set-memory user user
    respond 201 user

@Memory
user = { "name": "Guest", "role": "reader" }

@Route/PUT/users/current
run:
    user = parse-json body
    validate user #User
    set-memory user user
    respond 200 user

@Route/GET/users/current
run:
    user = get-memory user
    respond 200 user
