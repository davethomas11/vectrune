#!RUNE
import "app.rune"

@TestSuite
setup:
    expected = { defaultName: "Guest" }

@TestFixture/User
setup:
    alice = { name: "Alice", role: "admin" }
teardown:
    clear-memory

@Test/Health
run:
    req = { method: "GET", path: "/health" }
    res = test-request req
    assert res.status == 200
    assert res.text == "OK"

@Test/UserCreation
run:
    req = { method: "POST", path: "/users", body: { name: "Alice", role: "admin" } }
    res = test-request req
    assert res.status == 201
    assert res.body.name == "Alice"
    assert res.body.role == "admin"

@Test/InvalidUser
run:
    req = { method: "POST", path: "/users", body: { name: "Alice" } }
    res = test-request req
    assert res.status == 400
    assert res.text contains "role"

@Test/UserLifecycle
fixtures = [User]
run:
    req = { method: "POST", path: "/users", body: alice }
    created = test-request req
    assert created.status == 201
    req = { path: "/users/current" }
    fetched = test-request req
    assert fetched.body.name == "Alice"
    updatedUser = { name: "Alice", role: "developer" }
    req = { method: "PUT", path: "/users/current", body: updatedUser }
    updated = test-request req
    assert updated.status == 200
    assert updated.body.role == "developer"

@Test/MemoryIsFresh
run:
    req = { path: "/users/current" }
    res = test-request req
    assert res.body.name == expected.defaultName
