# Rune Studio — Sound & Music Presets

@Sound/laser
wave = sawtooth
freq = 880 -> 110
duration = 120ms
volume = 0.25
curve = exponential

@Sound/hit
wave = square
freq = 180 -> 40
duration = 90ms
volume = 0.35

@Sound/explosion
wave = noise
filter = lowpass 800 -> 60
duration = 350ms
volume = 0.45

@Sound/step
wave = square
notes = 110, 98, 87, 82
duration = 80ms
volume = 0.2

@Sound/coin
wave = sine
sequence = D5:80ms, A5:200ms
volume = 0.25

@Sound/gameover
wave = sawtooth
sequence = E4:150ms, D4:150ms, C4:250ms, G3:450ms
duration = 600ms
volume = 0.3

@Sound/victory
wave = triangle
sequence = C5:120ms, E5:120ms, G5:120ms, C6:240ms
duration = 600ms
volume = 0.3

@Music/vectraiders
type = 8bit
tempo = 144
loop = true
volume = 0.18

lead:
    E4:8 D#4:8 E4:8 B3:8 D4:8 C4:8 A3:4           # Bar 1: Alien theme
    E4:8 D#4:8 E4:8 B3:8 D4:8 C4:8 A3:4           # Bar 2: Motif reprise
    C4:8 D4:8 E4:8 G4:8 A4:4 G4:4                 # Bar 3: Ascending run
    E4:8 D4:8 C4:8 B3:8 A3:2                      # Bar 4: Minor cadence

bass:
    A2:4 E2:4 A2:4 E2:4                           # Bar 1: Driving pulse
    A2:4 E2:4 A2:4 E2:4                           # Bar 2
    C3:4 G2:4 C3:4 G2:4                           # Bar 3
    F2:4 C2:4 E2:4 G#2:4                          # Bar 4

drums:
    kick:4 snare:4 kick:4 snare:4                 # Bar 1
    kick:4 snare:4 kick:4 snare:4                 # Bar 2
    kick:8 hihat:8 snare:4 kick:8 hihat:8 snare:4 # Bar 3: Roll
    kick:4 snare:4 kick:4 snare:4                 # Bar 4

@Music/vectworms
type = 8bit
tempo = 136
loop = true
volume = 0.18

lead:
    C4:8 E4:8 G4:8 A4:8 G4:8 E4:8 C4:8 D4:8       # Bar 1: Bouncy opening
    E4:8 G4:8 A4:8 C5:8 B4:4 G4:4                 # Bar 2: Peak melody
    A4:8 G4:8 E4:8 C4:8 D4:8 E4:8 D4:4           # Bar 3: Playful turn
    C4:2 -:2                                      # Bar 4: Rest & resolve

bass:
    C2:4 G2:4 C2:4 G2:4                           # Bar 1: Walking groove
    E2:4 B2:4 E2:4 B2:4                           # Bar 2
    F2:4 C3:4 G2:4 D3:4                           # Bar 3
    C2:4 G2:4 C2:2 -:4                            # Bar 4

drums:
    kick:4 snare:4 kick:8 kick:8 snare:4          # Bar 1: Syncopated beat
    kick:4 snare:4 kick:8 hihat:8 snare:4         # Bar 2
    kick:4 snare:4 kick:8 kick:8 snare:4          # Bar 3
    kick:4 snare:4 kick:2                         # Bar 4

@Music/cyber_run
type = 8bit
tempo = 152
loop = true
volume = 0.18

lead:
    D4:16 F4:16 A4:16 D5:16 C5:8 A4:8             # Bar 1: Arp rush
    D4:16 F4:16 A4:16 D5:16 C5:8 A4:8             # Bar 2: Repeat
    Bb4:8 A4:8 G4:8 F4:8 E4:8 F4:8 G4:4           # Bar 3: Cascade
    D4:8 F4:8 A4:8 D5:4 C5:4 D5:2                 # Bar 4: Climax

bass:
    D2:8 D2:8 A2:8 D2:8 D2:8 A2:8 D2:4            # Bar 1: Octave drive
    D2:8 D2:8 A2:8 D2:8 D2:8 A2:8 D2:4            # Bar 2
    Bb2:8 Bb2:8 F2:8 Bb2:8 C3:8 C3:8 G2:8 C3:4    # Bar 3: Power chords
    D2:8 D2:8 A2:8 D2:8 D2:2                      # Bar 4

drums:
    kick:4 snare:4 kick:4 snare:4                 # Bar 1: Four on floor
    kick:4 snare:4 kick:4 snare:4                 # Bar 2
    kick:8 kick:8 snare:4 kick:8 kick:8 snare:4   # Bar 3: Double kick
    kick:8 hihat:8 snare:8 hihat:8 kick:4 snare:4 # Bar 4

@Music/moonlight
type = 8bit
tempo = 108
loop = true
volume = 0.18

lead:
    A3:8 C4:8 E4:8 A4:4 G4:8 E4:4                 # Bar 1: Eerie opening
    F4:8 D4:8 B3:8 D4:4 C4:8 A3:2                 # Bar 2: Descent
    E4:8 G4:8 B4:8 D5:4 C5:8 A4:4                 # Bar 3: Echoes
    F4:8 E4:8 D#4:8 E4:2 -:4                      # Bar 4: Mystery rest

bass:
    A1:2 E2:2                                     # Bar 1: Sustained sub
    D2:2 A1:2                                     # Bar 2
    C2:2 G1:2                                     # Bar 3
    E2:2 E1:2                                     # Bar 4

drums:
    kick:2 snare:4 hihat:4                        # Bar 1: Sparse beat
    kick:2 snare:4 hihat:4                        # Bar 2
    kick:2 snare:4 hihat:4                        # Bar 3
    kick:4 hihat:4 snare:2                        # Bar 4

@Music/victory
type = 8bit
tempo = 140
loop = true
volume = 0.18

lead:
    C4:8 C4:8 C4:8 C4:4 G3:4 C4:4                 # Bar 1: Trumpet call
    D4:8 D4:8 D4:8 D4:4 A3:4 D4:4                 # Bar 2: Lift
    E4:8 E4:8 F4:8 G4:4 E4:8 D4:4 C4:2            # Bar 3: Resolution

bass:
    C2:4 G2:4 C2:4 G2:4                           # Bar 1
    D2:4 A2:4 D2:4 A2:4                           # Bar 2
    E2:4 F2:4 G2:4 C2:2                           # Bar 3

drums:
    kick:4 snare:4 kick:8 kick:8 snare:4          # Bar 1
    kick:4 snare:4 kick:8 kick:8 snare:4          # Bar 2
    kick:8 kick:8 snare:8 snare:8 kick:2          # Bar 3: Grand roll

