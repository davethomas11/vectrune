@Style/studio

tokens:
    neon_cyan = #00e5ff
    neon_lime = #39ff14
    neon_pink = #ff2a85
    neon_amber = #ffaa00
    chassis_bg = #080b16
    rack_bg = #0d1224
    card_bg = #121830
    grid_border = #202b48
    text_muted = #7e8c9f

rules:
    body:
        margin = 0
        padding = 8px
        box-sizing = border-box
        background = {chassis_bg}
        color = #ffffff
        font-family = "Courier New", monospace, sans-serif

    .studio-cabinet:
        background = {chassis_bg}
        color = #ffffff
        font-family = "Courier New", monospace, sans-serif
        padding = 1.25rem
        border-radius = 16px
        border = 2px solid {grid_border}
        box-shadow = 0 0 40px rgba(0, 229, 255, 0.15), inset 0 0 20px rgba(0, 0, 0, 0.8)
        max-width = 980px
        margin = 0 auto
        width = 100%
        box-sizing = border-box
        transition = all 0.2s ease

    .studio-header:
        display = flex
        justify-content = space-between
        align-items = center
        border-bottom = 2px solid {grid_border}
        padding-bottom = 1rem
        margin-bottom = 1.25rem
        flex-wrap = wrap
        gap = 1rem

    .header-brand:
        display = flex
        flex-direction = column
        gap = 0.25rem

    .header-controls:
        display = flex
        align-items = center
        gap = 0.6rem
        flex-wrap = wrap

    .studio-title:
        color = {neon_cyan}
        font-size = 1.5rem
        font-weight = 900
        letter-spacing = 3px
        margin = 0
        text-shadow = 0 0 12px {neon_cyan}

    .studio-subtitle:
        color = {text_muted}
        font-size = 0.8rem
        letter-spacing = 1px
        margin = 0

    .btn-fullscreen:
        padding = 0.4rem 0.85rem
        border-radius = 6px
        font-size = 0.75rem
        letter-spacing = 1px
        font-weight = bold
        background = {card_bg}
        border = 1px solid {neon_cyan}
        color = {neon_cyan}
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-fullscreen:hover:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 12px {neon_cyan}

    .status-pill:
        padding = 0.4rem 0.85rem
        border-radius = 20px
        font-size = 0.75rem
        letter-spacing = 1px
        background = {card_bg}
        border = 1px solid {grid_border}
        color = {neon_lime}

    .song-selector:
        display = flex
        gap = 0.5rem
        margin-bottom = 1.25rem
        flex-wrap = wrap

    .song-tab:
        background = {rack_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.5rem 1rem
        border-radius = 8px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.85rem
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation

    .song-tab:hover:
        color = #ffffff
        border-color = {neon_cyan}

    .song-tab.active:
        background = {neon_cyan}
        color = #000000
        border-color = {neon_cyan}
        box-shadow = 0 0 15px {neon_cyan}

    .transport-bar:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem
        margin-bottom = 1.25rem
        display = flex
        justify-content = space-between
        align-items = center
        flex-wrap = wrap
        gap = 1rem

    .transport-buttons:
        display = flex
        gap = 0.5rem

    .btn-transport:
        padding = 0.6rem 1.2rem
        border-radius = 8px
        font-weight = bold
        border = none
        cursor = pointer
        font-family = inherit
        letter-spacing = 1px
        font-size = 0.9rem
        display = flex
        align-items = center
        gap = 0.4rem
        transition = all 0.15s ease
        touch-action = manipulation
        min-height = 42px

    .btn-play:
        background = {neon_lime}
        color = #000000
        box-shadow = 0 0 15px rgba(57, 255, 20, 0.5)

    .btn-play:hover:
        transform = scale(1.05)
        box-shadow = 0 0 25px {neon_lime}

    .btn-pause:
        background = {neon_amber}
        color = #000000

    .btn-stop:
        background = {neon_pink}
        color = #ffffff

    .tempo-controls:
        display = flex
        align-items = center
        gap = 0.6rem

    .ctrl-label:
        font-size = 0.8rem
        color = {text_muted}
        font-weight = bold

    .bpm-badge:
        font-size = 1.1rem
        font-weight = bold
        color = {neon_lime}
        min-width = 80px
        text-align = center

    .btn-tempo:
        background = {card_bg}
        color = #ffffff
        border = 1px solid {grid_border}
        width = 36px
        height = 36px
        border-radius = 6px
        cursor = pointer
        font-weight = bold
        touch-action = manipulation

    .time-sig-controls:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-timesig:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.8rem
        transition = all 0.15s ease

    .btn-timesig.active:
        background = {neon_amber}
        color = #000000
        border-color = {neon_amber}
        box-shadow = 0 0 10px {neon_amber}

    .mode-controls:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-mode:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        transition = all 0.15s ease

    .btn-mode.active:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 12px {neon_cyan}

    .storage-actions:
        display = flex
        gap = 0.4rem
        flex-wrap = wrap

    .btn-storage:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.5rem 0.8rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-size = 0.75rem
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation
        min-height = 36px

    .btn-storage:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 10px rgba(0, 229, 255, 0.3)

