@Style/studio

rules:
    .tracks-container:
        display = flex
        flex-direction = column
        gap = 1rem
        margin-bottom = 1.25rem

    .track-rack:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem
        transition = all 0.18s ease
        cursor = pointer

    .track-rack:hover:
        border-color = rgba(0, 229, 255, 0.5)

    .track-rack.active-rack:
        border = 2px solid {neon_cyan}
        box-shadow = 0 0 25px rgba(0, 229, 255, 0.35)
        background = rgba(0, 229, 255, 0.05)

    .pill-active-track:
        color = {neon_cyan}
        background = rgba(0, 229, 255, 0.2)
        border = 1px solid {neon_cyan}
        border-radius = 12px
        padding = 0.2rem 0.6rem
        font-size = 0.65rem
        font-weight = bold
        letter-spacing = 1px
        box-shadow = 0 0 10px rgba(0, 229, 255, 0.4)

    .track-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.75rem
        flex-wrap = wrap
        gap = 0.5rem

    .track-meta:
        display = flex
        align-items = center
        gap = 0.6rem
        flex-wrap = wrap

    .track-icon:
        font-size = 1.25rem

    .track-name:
        font-size = 1rem
        font-weight = bold
        color = #ffffff
        margin = 0

    .track-actions:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-track-mute:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.6rem
        border-radius = 6px
        font-size = 0.75rem
        cursor = pointer
        font-weight = bold
        font-family = inherit
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-track-mute.btn-muted:
        background = #ef4444 !important
        color = #ffffff !important
        border-color = #ef4444 !important
        box-shadow = 0 0 10px #ef4444 !important

    .btn-edit-track:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.75rem
        border-radius = 6px
        font-size = 0.75rem
        cursor = pointer
        font-family = inherit
        font-weight = bold
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-edit-track:hover:
        background = {neon_cyan}
        color = #000000
        border-color = {neon_cyan}
        box-shadow = 0 0 10px {neon_cyan}

    .btn-editing:
        background = {neon_cyan} !important
        color = #000000 !important
        box-shadow = 0 0 12px {neon_cyan} !important
        border-color = {neon_cyan} !important

    .badge-wave:
        font-size = 0.7rem
        padding = 0.2rem 0.5rem
        border-radius = 4px
        text-transform = uppercase
        letter-spacing = 1px
        font-weight = bold

    .badge-square:
        background = rgba(0, 229, 255, 0.2)
        color = {neon_cyan}
        border = 1px solid {neon_cyan}

    .badge-triangle:
        background = rgba(57, 255, 20, 0.2)
        color = {neon_lime}
        border = 1px solid {neon_lime}

    .badge-noise:
        background = rgba(255, 42, 133, 0.2)
        color = {neon_pink}
        border = 1px solid {neon_pink}

    .badge-saw:
        background = rgba(255, 170, 0, 0.2)
        color = {neon_amber}
        border = 1px solid {neon_amber}

    .track-score-box:
        background = #03050c
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.75rem
        color = #e2e8f0
        font-family = "Courier New", monospace
        font-size = 0.85rem
        line-height = 1.5
        white-space = pre-wrap
        word-break = break-word

    .active-score-box:
        border-color = {neon_cyan}
        box-shadow = 0 0 12px rgba(0, 229, 255, 0.25)
        background = #060b18

    .sfx-section:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem
        margin-bottom = 1.25rem

    .sfx-heading:
        font-size = 0.95rem
        color = {neon_pink}
        letter-spacing = 2px
        margin = 0 0 0.75rem 0
        font-weight = bold

    .sfx-pads:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(110px, 1fr))
        gap = 0.5rem

    .pad-btn:
        background = {card_bg}
        color = #ffffff
        border = 1px solid {grid_border}
        padding = 0.75rem 0.5rem
        border-radius = 8px
        cursor = pointer
        font-family = inherit
        font-size = 0.8rem
        letter-spacing = 1px
        display = flex
        flex-direction = column
        align-items = center
        gap = 0.25rem
        transition = all 0.1s ease
        touch-action = manipulation
        min-height = 54px

    .pad-btn:hover:
        border-color = {neon_pink}
        box-shadow = 0 0 12px {neon_pink}
        transform = scale(1.03)

    .pad-btn:active:
        transform = scale(0.96)
        background = {neon_pink}
        color = #000000

    .export-section:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem

    .export-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.75rem

    .code-preview:
        background = #02040a
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 1rem
        font-family = "Courier New", monospace
        font-size = 0.8rem
        color = {neon_lime}
        overflow-x = auto
        white-space = pre-wrap
        max-height = 240px

    .lower-tabs-cabinet:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1.25rem
        margin-top = 1.25rem
        box-shadow = 0 8px 32px rgba(0, 0, 0, 0.4)

    .lower-tab-bar:
        display = flex
        gap = 0.5rem
        border-bottom = 2px solid {grid_border}
        padding-bottom = 0.75rem
        margin-bottom = 1rem
        flex-wrap = wrap

    .lower-tab-btn:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.55rem 1rem
        border-radius = 8px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.8rem
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation

    .lower-tab-btn:hover:
        color = #ffffff
        border-color = {neon_cyan}

    .lower-tab-btn.active:
        background = {neon_cyan}
        color = #000000
        border-color = {neon_cyan}
        box-shadow = 0 0 12px {neon_cyan}

    .lower-tab-content:
        min-height = 120px

fullscreen:
    body:
        margin = 0
        padding = 0
        background = #020308
        overflow = auto
    .studio-cabinet:
        position = fixed
        top = 0
        left = 0
        width = 100vw
        height = 100vh
        max-width = 100vw
        border-radius = 0
        border = none
        min-height = 100vh
        box-shadow = none
        padding = 1.25rem 2rem
        z-index = 99999
        overflow-y = auto
        box-sizing = border-box
    .piano-roll-container:
        padding = 1rem 0
    .track-rack:
        border-color = rgba(0, 229, 255, 0.4)

responsive:
    (max-width: 768px):
        .studio-cabinet:
            padding = 0.75rem
            border-radius = 12px
        .studio-header:
            flex-direction = column
            align-items = flex-start
            gap = 0.75rem
        .header-controls:
            width = 100%
            justify-content = space-between
        .transport-bar:
            flex-direction = column
            align-items = stretch
            gap = 0.75rem
        .transport-buttons:
            justify-content = space-between
        .tempo-controls:
            justify-content = space-between
        .storage-actions:
            flex-wrap = wrap
        .song-selector:
            overflow-x = auto
            flex-wrap = nowrap
            padding-bottom = 0.5rem
        .piano-roll-container:
            overflow-x = auto
            padding-bottom = 0.5rem
        .step-strip-scroll:
            padding-bottom = 0.5rem
        .piano-key:
            min-width = 38px
            height = 90px
        .drum-pads:
            grid-template-columns = repeat(3, 1fr)

    (max-width: 480px):
        .studio-title:
            font-size = 1.2rem
        .studio-subtitle:
            font-size = 0.7rem
        .btn-transport:
            padding = 0.5rem 0.8rem
            font-size = 0.8rem
        .btn-storage:
            flex = 1
            text-align = center
            font-size = 0.7rem
            padding = 0.4rem 0.5rem
        .voice-tabs:
            flex-direction = column
            width = 100%
        .duration-picker:
            width = 100%
            justify-content = space-between

