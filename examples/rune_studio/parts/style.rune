@Style/studio

tokens:
    neon_cyan = #00e5ff
    neon_lime = #39ff14
    neon_pink = #ff2a85
    neon_amber = #ffaa00
    chassis_bg = #080b16
    rack_bg = #0d1224
    card_bg = #121830
    grid_border = #202b48
    text_muted = #7e8c9f

.studio-cabinet:
    background = var(--chassis_bg)
    color = #ffffff
    font-family = "Courier New", monospace, sans-serif
    padding = 1.25rem
    border-radius = 16px
    border = 2px solid var(--grid_border)
    box-shadow = 0 0 40px rgba(0, 229, 255, 0.15), inset 0 0 20px rgba(0, 0, 0, 0.8)
    max-width = 960px
    margin = 0 auto
    width = 100%
    box-sizing = border-box

.studio-header:
    display = flex
    justify-content = space-between
    align-items = center
    border-bottom = 2px solid var(--grid_border)
    padding-bottom = 1rem
    margin-bottom = 1.25rem
    flex-wrap = wrap
    gap = 1rem

.studio-title:
    color = var(--neon_cyan)
    font-size = 1.5rem
    font-weight = 900
    letter-spacing = 3px
    margin = 0
    text-shadow = 0 0 12px var(--neon_cyan)

.studio-subtitle:
    color = var(--text_muted)
    font-size = 0.8rem
    letter-spacing = 1px
    margin = 0.25rem 0 0 0

.status-pill:
    padding = 0.4rem 0.85rem
    border-radius = 20px
    font-size = 0.75rem
    letter-spacing = 1px
    background = var(--card_bg)
    border = 1px solid var(--neon_cyan)
    color = var(--neon_cyan)

.song-selector:
    display = flex
    gap = 0.5rem
    margin-bottom = 1.25rem
    flex-wrap = wrap

.song-tab:
    background = var(--rack_bg)
    color = var(--text_muted)
    border = 1px solid var(--grid_border)
    padding = 0.5rem 1rem
    border-radius = 8px
    cursor = pointer
    font-family = inherit
    font-weight = bold
    font-size = 0.85rem
    letter-spacing = 1px
    transition = all 0.15s ease

.song-tab:hover:
    color = #ffffff
    border-color = var(--neon_cyan)

.song-tab.active:
    background = var(--neon_cyan)
    color = #000000
    box-shadow = 0 0 16px var(--neon_cyan)
    border-color = var(--neon_cyan)

.transport-bar:
    background = var(--rack_bg)
    border = 1px solid var(--grid_border)
    border-radius = 12px
    padding = 1rem
    display = flex
    align-items = center
    justify-content = space-between
    margin-bottom = 1.25rem
    flex-wrap = wrap
    gap = 1rem

.transport-buttons:
    display = flex
    gap = 0.5rem

.btn-transport:
    padding = 0.6rem 1.2rem
    border-radius = 8px
    border = none
    font-weight = bold
    cursor = pointer
    font-family = inherit
    letter-spacing = 1px
    font-size = 0.9rem
    display = flex
    align-items = center
    gap = 0.4rem
    transition = all 0.15s ease

.btn-play:
    background = var(--neon_lime)
    color = #000000
    box-shadow = 0 0 15px color-mix(in srgb, var(--neon_lime) 50%, transparent)

.btn-play:hover:
    transform = scale(1.05)
    box-shadow = 0 0 25px var(--neon_lime)

.btn-pause:
    background = var(--neon_amber)
    color = #000000

.btn-stop:
    background = var(--neon_pink)
    color = #ffffff

.tempo-controls:
    display = flex
    align-items = center
    gap = 0.6rem

.bpm-badge:
    font-size = 1.1rem
    font-weight = bold
    color = var(--neon_lime)
    min-width = 80px
    text-align = center

.btn-tempo:
    background = var(--card_bg)
    color = #ffffff
    border = 1px solid var(--grid_border)
    width = 32px
    height = 32px
    border-radius = 6px
    cursor = pointer
    font-weight = bold

.storage-actions:
    display = flex
    gap = 0.4rem

.btn-storage:
    background = var(--card_bg)
    color = var(--neon_cyan)
    border = 1px solid var(--grid_border)
    padding = 0.5rem 0.8rem
    border-radius = 6px
    cursor = pointer
    font-family = inherit
    font-size = 0.75rem
    letter-spacing = 1px
    transition = all 0.15s ease

.btn-storage:hover:
    border-color = var(--neon_cyan)
    box-shadow = 0 0 10px rgba(0, 229, 255, 0.3)

.tracks-container:
    display = flex
    flex-direction = column
    gap = 1rem
    margin-bottom = 1.25rem

.track-rack:
    background = var(--rack_bg)
    border = 1px solid var(--grid_border)
    border-radius = 12px
    padding = 1rem

.track-header:
    display = flex
    justify-content = space-between
    align-items = center
    margin-bottom = 0.75rem

.track-meta:
    display = flex
    align-items = center
    gap = 0.6rem

.track-name:
    font-size = 1rem
    font-weight = bold
    color = #ffffff
    margin = 0

.badge-wave:
    font-size = 0.7rem
    padding = 0.2rem 0.5rem
    border-radius = 4px
    text-transform = uppercase
    letter-spacing = 1px
    font-weight = bold

.badge-square:
    background = rgba(0, 229, 255, 0.2)
    color = var(--neon_cyan)
    border = 1px solid var(--neon_cyan)

.badge-triangle:
    background = rgba(57, 255, 20, 0.2)
    color = var(--neon_lime)
    border = 1px solid var(--neon_lime)

.badge-noise:
    background = rgba(255, 42, 133, 0.2)
    color = var(--neon_pink)
    border = 1px solid var(--neon_pink)

.track-score-box:
    background = #03050c
    border = 1px solid var(--grid_border)
    border-radius = 8px
    padding = 0.75rem
    color = #e2e8f0
    font-family = "Courier New", monospace
    font-size = 0.85rem
    line-height = 1.5
    white-space = pre-wrap
    word-break = break-word

.sfx-section:
    background = var(--rack_bg)
    border = 1px solid var(--grid_border)
    border-radius = 12px
    padding = 1rem
    margin-bottom = 1.25rem

.sfx-heading:
    font-size = 0.95rem
    color = var(--neon_pink)
    letter-spacing = 2px
    margin = 0 0 0.75rem 0
    font-weight = bold

.sfx-pads:
    display = grid
    grid-template-columns = repeat(auto-fit, minmax(110px, 1fr))
    gap = 0.5rem

.pad-btn:
    background = var(--card_bg)
    color = #ffffff
    border = 1px solid var(--grid_border)
    padding = 0.75rem 0.5rem
    border-radius = 8px
    cursor = pointer
    font-family = inherit
    font-size = 0.8rem
    letter-spacing = 1px
    display = flex
    flex-direction = column
    align-items = center
    gap = 0.25rem
    transition = all 0.1s ease

.pad-btn:hover:
    border-color = var(--neon_pink)
    box-shadow = 0 0 12px var(--neon_pink)
    transform = scale(1.03)

.pad-btn:active:
    transform = scale(0.96)
    background = var(--neon_pink)
    color = #000000

.export-section:
    background = var(--rack_bg)
    border = 1px solid var(--grid_border)
    border-radius = 12px
    padding = 1rem

.export-header:
    display = flex
    justify-content = space-between
    align-items = center
    margin-bottom = 0.75rem

.code-preview:
    background = #02040a
    border = 1px solid var(--grid_border)
    border-radius = 8px
    padding = 1rem
    font-family = "Courier New", monospace
    font-size = 0.8rem
    color = var(--neon_lime)
    overflow-x = auto
    white-space = pre-wrap
    max-height = 240px

