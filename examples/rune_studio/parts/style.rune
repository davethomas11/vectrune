@Style/studio

tokens:
    neon_cyan = #00e5ff
    neon_lime = #39ff14
    neon_pink = #ff2a85
    neon_amber = #ffaa00
    chassis_bg = #080b16
    rack_bg = #0d1224
    card_bg = #121830
    grid_border = #202b48
    text_muted = #7e8c9f

rules:
    body:
        margin = 0
        padding = 8px
        box-sizing = border-box
        background = {chassis_bg}
        color = #ffffff
        font-family = "Courier New", monospace, sans-serif

    .studio-cabinet:
        background = {chassis_bg}
        color = #ffffff
        font-family = "Courier New", monospace, sans-serif
        padding = 1.25rem
        border-radius = 16px
        border = 2px solid {grid_border}
        box-shadow = 0 0 40px rgba(0, 229, 255, 0.15), inset 0 0 20px rgba(0, 0, 0, 0.8)
        max-width = 980px
        margin = 0 auto
        width = 100%
        box-sizing = border-box
        transition = all 0.2s ease

    .studio-header:
        display = flex
        justify-content = space-between
        align-items = center
        border-bottom = 2px solid {grid_border}
        padding-bottom = 1rem
        margin-bottom = 1.25rem
        flex-wrap = wrap
        gap = 1rem

    .header-brand:
        display = flex
        flex-direction = column
        gap = 0.25rem

    .header-controls:
        display = flex
        align-items = center
        gap = 0.6rem
        flex-wrap = wrap

    .studio-title:
        color = {neon_cyan}
        font-size = 1.5rem
        font-weight = 900
        letter-spacing = 3px
        margin = 0
        text-shadow = 0 0 12px {neon_cyan}

    .studio-subtitle:
        color = {text_muted}
        font-size = 0.8rem
        letter-spacing = 1px
        margin = 0

    .btn-fullscreen:
        padding = 0.4rem 0.85rem
        border-radius = 6px
        font-size = 0.75rem
        letter-spacing = 1px
        font-weight = bold
        background = {card_bg}
        border = 1px solid {neon_cyan}
        color = {neon_cyan}
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-fullscreen:hover:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 12px {neon_cyan}

    .status-pill:
        padding = 0.4rem 0.85rem
        border-radius = 20px
        font-size = 0.75rem
        letter-spacing = 1px
        background = {card_bg}
        border = 1px solid {grid_border}
        color = {neon_lime}

    .song-selector:
        display = flex
        gap = 0.5rem
        margin-bottom = 1.25rem
        flex-wrap = wrap

    .song-tab:
        background = {rack_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.5rem 1rem
        border-radius = 8px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.85rem
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation

    .song-tab:hover:
        color = #ffffff
        border-color = {neon_cyan}

    .song-tab.active:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 16px {neon_cyan}
        border-color = {neon_cyan}

    .transport-bar:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem
        display = flex
        align-items = center
        justify-content = space-between
        margin-bottom = 1.25rem
        flex-wrap = wrap
        gap = 1rem

    .transport-buttons:
        display = flex
        gap = 0.5rem

    .btn-transport:
        padding = 0.6rem 1.2rem
        border-radius = 8px
        border = none
        font-weight = bold
        cursor = pointer
        font-family = inherit
        letter-spacing = 1px
        font-size = 0.9rem
        display = flex
        align-items = center
        gap = 0.4rem
        transition = all 0.15s ease
        touch-action = manipulation
        min-height = 42px

    .btn-play:
        background = {neon_lime}
        color = #000000
        box-shadow = 0 0 15px rgba(57, 255, 20, 0.5)

    .btn-play:hover:
        transform = scale(1.05)
        box-shadow = 0 0 25px {neon_lime}

    .btn-pause:
        background = {neon_amber}
        color = #000000

    .btn-stop:
        background = {neon_pink}
        color = #ffffff

    .tempo-controls:
        display = flex
        align-items = center
        gap = 0.6rem

    .ctrl-label:
        font-size = 0.8rem
        color = {text_muted}
        font-weight = bold

    .bpm-badge:
        font-size = 1.1rem
        font-weight = bold
        color = {neon_lime}
        min-width = 80px
        text-align = center

    .btn-tempo:
        background = {card_bg}
        color = #ffffff
        border = 1px solid {grid_border}
        width = 36px
        height = 36px
        border-radius = 6px
        cursor = pointer
        font-weight = bold
        touch-action = manipulation

    .time-sig-controls:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-timesig:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.8rem
        transition = all 0.15s ease

    .btn-timesig.active:
        background = {neon_amber}
        color = #000000
        border-color = {neon_amber}
        box-shadow = 0 0 10px {neon_amber}

    .mode-controls:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-mode:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        transition = all 0.15s ease

    .btn-mode.active:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 12px {neon_cyan}

    .storage-actions:
        display = flex
        gap = 0.4rem
        flex-wrap = wrap

    .btn-storage:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.5rem 0.8rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-size = 0.75rem
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation
        min-height = 36px

    .btn-storage:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 10px rgba(0, 229, 255, 0.3)

    .note-editor-panel:
        background = {rack_bg}
        border = 2px solid {neon_cyan}
        box-shadow = 0 0 20px rgba(0, 229, 255, 0.2)
        border-radius = 12px
        padding = 1.25rem
        margin-bottom = 1.25rem

    .editor-header:
        display = flex
        flex-direction = column
        gap = 0.85rem
        margin-bottom = 1rem
        border-bottom = 1px solid {grid_border}
        padding-bottom = 1rem

    .editor-label:
        font-size = 0.75rem
        color = {text_muted}
        font-weight = bold
        letter-spacing = 1px
        align-self = center

    .voice-tabs:
        display = flex
        gap = 0.5rem
        flex-wrap = wrap

    .voice-tab:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.5rem 0.9rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.85rem
        transition = all 0.15s ease
        touch-action = manipulation

    .voice-tab.active:
        background = {neon_cyan}
        color = #000000
        border-color = {neon_cyan}
        box-shadow = 0 0 12px {neon_cyan}

    .instrument-picker:
        display = flex
        gap = 0.4rem
        align-items = center
        flex-wrap = wrap

    .pill-instrument:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.65rem
        border-radius = 12px
        font-size = 0.75rem
        font-weight = bold
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .pill-instrument:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 8px rgba(0, 229, 255, 0.4)

    .btn-chord-toggle:
        background = {card_bg}
        color = {neon_amber}
        border = 1px solid {neon_amber}
        padding = 0.4rem 0.75rem
        border-radius = 6px
        cursor = pointer
        font-size = 0.75rem
        font-weight = bold
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-chord-toggle.chord-active:
        background = {neon_amber}
        color = #000000
        box-shadow = 0 0 14px {neon_amber}

    .duration-picker:
        display = flex
        gap = 0.4rem
        align-items = center
        flex-wrap = wrap

    .pill-duration:
        background = {card_bg}
        color = {neon_lime}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.75rem
        border-radius = 16px
        font-size = 0.8rem
        font-weight = bold
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .pill-duration.active:
        background = {neon_lime}
        color = #000000
        box-shadow = 0 0 12px {neon_lime}
        border-color = {neon_lime}

    .editor-tools:
        display = flex
        gap = 0.5rem
        align-items = center
        flex-wrap = wrap

    .current-note-badge:
        display = flex
        align-items = center
        gap = 0.4rem
        background = {card_bg}
        border = 1px solid {neon_lime}
        border-radius = 6px
        padding = 0.3rem 0.65rem

    .badge-lbl:
        font-size = 0.65rem
        color = {text_muted}
        font-weight = bold

    .badge-val:
        font-size = 0.9rem
        color = {neon_lime}
        font-weight = 900

    .badge-sub:
        font-size = 0.75rem
        color = {neon_cyan}

    .btn-tool:
        background = {card_bg}
        color = #ffffff
        border = 1px solid {grid_border}
        padding = 0.45rem 0.85rem
        border-radius = 6px
        font-size = 0.8rem
        cursor = pointer
        font-family = inherit
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-tool:hover:
        border-color = {neon_cyan}

    .btn-tool-danger:
        color = {neon_pink}
        border-color = rgba(255, 42, 133, 0.4)

    .btn-tool-danger:hover:
        background = {neon_pink}
        color = #000000

    .step-sequencer-rack:
        background = #050814
        border = 1px solid {grid_border}
        border-radius = 10px
        padding = 0.85rem
        margin-bottom = 1rem

    .step-rack-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.6rem
        flex-wrap = wrap
        gap = 0.5rem

    .step-rack-title:
        display = flex
        align-items = center
        gap = 0.5rem

    .step-title-icon:
        font-size = 1rem

    .step-title-text:
        font-size = 0.8rem
        font-weight = bold
        letter-spacing = 1px
        color = {neon_cyan}
        text-transform = uppercase

    .step-rack-hint:
        font-size = 0.7rem
        color = {text_muted}

    .step-strip-scroll:
        overflow-x = auto
        padding = 0.4rem 0.2rem
        -webkit-overflow-scrolling = touch

    .step-strip:
        display = flex
        gap = 6px
        align-items = stretch
        min-width = min-content

    .step-card-bar:
        display = flex
        align-items = center
        justify-content = center
        background = rgba(255, 170, 0, 0.1)
        border-left = 2px dashed {neon_amber}
        border-right = 2px dashed {neon_amber}
        padding = 0 0.5rem
        border-radius = 4px
        min-width = 44px

    .step-bar-label:
        font-size = 0.65rem
        font-weight = bold
        color = {neon_amber}
        letter-spacing = 1px
        writing-mode = vertical-lr

    .step-chip:
        background = {card_bg}
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.4rem 0.5rem
        display = flex
        flex-direction = column
        align-items = center
        gap = 0.15rem
        cursor = pointer
        font-family = inherit
        min-width = 52px
        transition = all 0.12s ease
        touch-action = manipulation
        position = relative

    .step-chip:hover:
        border-color = {neon_cyan}
        transform = translateY(-2px)

    .step-chip.selected-step:
        border-color = {neon_lime} !important
        background = rgba(57, 255, 20, 0.18) !important
        box-shadow = 0 0 16px rgba(57, 255, 20, 0.4) !important
        transform = scale(1.06)

    .step-num:
        font-size = 0.6rem
        color = {text_muted}

    .step-pitch:
        font-size = 0.85rem
        font-weight = 900
        color = #ffffff

    .step-len:
        font-size = 0.65rem
        color = {neon_cyan}

    .step-delete-btn:
        position = absolute
        top = -4px
        right = -4px
        width = 16px
        height = 16px
        border-radius = 50%
        background = {neon_pink}
        color = #ffffff
        border = none
        padding = 0
        font-size = 11px
        display = flex
        align-items = center
        justify-content = center
        line-height = 1
        cursor = pointer
        z-index = 10

    .step-delete-btn:hover:
        transform = scale(1.2)

    .chip-step-high .step-pitch:
        color = {neon_cyan}

    .chip-step-mid .step-pitch:
        color = {neon_lime}

    .chip-step-mid-low .step-pitch:
        color = {neon_amber}

    .chip-step-bass .step-pitch:
        color = {neon_pink}

    .chip-step-kick .step-pitch:
        color = #ff5500

    .chip-step-snare .step-pitch:
        color = {neon_pink}

    .chip-step-hihat .step-pitch:
        color = #ffd000

    .chip-step-rest:
        border-style = dashed
        opacity = 0.6

    .chip-step-chord:
        border-color = {neon_amber}
        background = rgba(255, 170, 0, 0.15)

    .badge-poly:
        position = absolute
        bottom = -5px
        right = 4px
        font-size = 8px
        font-weight = 900
        background = {neon_amber}
        color = #000000
        padding = 1px 4px
        border-radius = 4px
        letter-spacing = 0.5px

    .timeline-ruler:
        background = #080c18
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.6rem 0.8rem
        margin = 0.75rem 0
        display = flex
        flex-direction = column
        gap = 0.35rem

    .ruler-header:
        font-size = 0.7rem
        font-weight = bold
        color = {text_muted}
        letter-spacing = 1px

    .ruler-bars:
        display = grid
        grid-template-columns = repeat(4, 1fr)
        gap = 0.5rem

    .ruler-bar-item:
        background = {card_bg}
        border = 1px solid {grid_border}
        border-radius = 6px
        padding = 0.4rem 0.5rem
        display = flex
        flex-direction = column
        align-items = center
        gap = 2px

    .ruler-bar-num:
        font-size = 0.75rem
        font-weight = 900
        color = {neon_cyan}

    .ruler-sub:
        font-size = 0.65rem
        color = {text_muted}

    .piano-matrix-rack:
        background = #050814
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.75rem
        margin = 0.75rem 0

    .matrix-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.5rem
        flex-wrap = wrap
        gap = 0.5rem

    .matrix-title:
        font-size = 0.8rem
        font-weight = 900
        color = {neon_lime}
        letter-spacing = 1px

    .matrix-sub:
        font-size = 0.7rem
        color = {text_muted}

    .matrix-container:
        display = flex
        border = 1px solid {grid_border}
        border-radius = 6px
        overflow = hidden

    .matrix-keys-column:
        display = flex
        flex-direction = column
        background = #03050c
        border-right = 2px solid {grid_border}
        width = 54px
        flex-shrink = 0

    .matrix-key:
        font-family = inherit
        font-size = 0.65rem
        font-weight = bold
        padding = 3px 6px
        border = none
        border-bottom = 1px solid rgba(255, 255, 255, 0.05)
        text-align = right
        cursor = pointer
        transition = all 0.1s ease
        touch-action = manipulation
        height = 24px
        display = flex
        align-items = center
        justify-content = flex-end

    .mkey-white:
        background = #e2e8f0
        color = #0f172a

    .mkey-black:
        background = #1e293b
        color = {neon_cyan}

    .matrix-timeline-scroll:
        flex = 1
        overflow-x = auto
        background = #080c1a
        padding = 0.5rem

    .matrix-grid-surface:
        min-width = 600px

    .matrix-strip:
        display = flex
        gap = 0.4rem
        align-items = center

    .piano-roll-container:
        overflow-x = auto
        padding = 0.5rem 0 1rem 0
        margin-top = 0.5rem

    .piano-roll:
        display = flex
        gap = 3px
        min-width = 720px
        padding = 4px

    .piano-key:
        border-radius = 0 0 6px 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        display = flex
        align-items = flex-end
        justify-content = center
        padding-bottom = 8px
        transition = all 0.1s ease
        user-select = none
        touch-action = manipulation

    .key-white:
        background = #e2e8f0
        color = #0f172a
        border = 1px solid #94a3b8
        width = 36px
        height = 110px
        z-index = 1

    .key-white:hover:
        background = #00e5ff
        color = #000000
        box-shadow = 0 0 14px #00e5ff

    .key-white:active:
        background = #39ff14
        transform = translateY(2px)

    .key-black:
        background = #090d1a
        color = #00e5ff
        border = 1px solid #00e5ff
        width = 30px
        height = 75px
        margin-left = -15px
        margin-right = -15px
        z-index = 2
        box-shadow = 0 2px 8px rgba(0, 0, 0, 0.9)

    .key-black:hover:
        background = #ff2a85
        color = #ffffff
        border-color = #ff2a85
        box-shadow = 0 0 14px #ff2a85

    .key-black:active:
        background = #39ff14
        color = #000000
        transform = translateY(2px)

    .piano-key.selected-key:
        background = {neon_lime} !important
        color = #000000 !important
        box-shadow = 0 0 18px {neon_lime} !important
        border-color = {neon_lime} !important
        transform = translateY(2px)
        font-weight = 900 !important

    .drum-machine-container:
        padding = 1rem 0

    .drum-pads:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(130px, 1fr))
        gap = 0.75rem

    .drum-pad:
        background = {card_bg}
        border = 2px solid {grid_border}
        border-radius = 12px
        padding = 1.25rem 0.5rem
        cursor = pointer
        display = flex
        flex-direction = column
        align-items = center
        gap = 0.5rem
        font-family = inherit
        transition = all 0.12s ease
        touch-action = manipulation
        min-height = 90px

    .drum-pad:hover:
        border-color = {neon_pink}
        box-shadow = 0 0 18px {neon_pink}
        transform = translateY(-2px)

    .drum-pad:active:
        background = {neon_pink}
        color = #000000
        transform = scale(0.96)

    .drum-pad.selected-key:
        border-color = {neon_lime} !important
        box-shadow = 0 0 20px {neon_lime} !important
        background = rgba(57, 255, 20, 0.2) !important

    .drum-icon:
        font-size = 1.75rem

    .drum-name:
        font-size = 0.85rem
        font-weight = bold
        color = #ffffff
        letter-spacing = 2px

    .tracks-container:
        display = flex
        flex-direction = column
        gap = 1rem
        margin-bottom = 1.25rem

    .track-rack:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem
        transition = all 0.18s ease
        cursor = pointer

    .track-rack:hover:
        border-color = rgba(0, 229, 255, 0.5)

    .track-rack.active-rack:
        border = 2px solid {neon_cyan}
        box-shadow = 0 0 25px rgba(0, 229, 255, 0.35)
        background = rgba(0, 229, 255, 0.05)

    .pill-active-track:
        color = {neon_cyan}
        background = rgba(0, 229, 255, 0.2)
        border = 1px solid {neon_cyan}
        border-radius = 12px
        padding = 0.2rem 0.6rem
        font-size = 0.65rem
        font-weight = bold
        letter-spacing = 1px
        box-shadow = 0 0 10px rgba(0, 229, 255, 0.4)

    .track-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.75rem
        flex-wrap = wrap
        gap = 0.5rem

    .track-meta:
        display = flex
        align-items = center
        gap = 0.6rem
        flex-wrap = wrap

    .track-icon:
        font-size = 1.25rem

    .track-name:
        font-size = 1rem
        font-weight = bold
        color = #ffffff
        margin = 0

    .track-actions:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-track-mute:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.6rem
        border-radius = 6px
        font-size = 0.75rem
        cursor = pointer
        font-weight = bold
        font-family = inherit
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-track-mute.btn-muted:
        background = #ef4444 !important
        color = #ffffff !important
        border-color = #ef4444 !important
        box-shadow = 0 0 10px #ef4444 !important

    .btn-edit-track:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.75rem
        border-radius = 6px
        font-size = 0.75rem
        cursor = pointer
        font-family = inherit
        font-weight = bold
        letter-spacing = 1px
        transition = all 0.15s ease
        touch-action = manipulation

    .track-actions:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-track-mute:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.6rem
        border-radius = 6px
        font-size = 0.75rem
        cursor = pointer
        font-weight = bold
        font-family = inherit
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-track-mute.btn-muted:
        background = #ef4444 !important
        color = #ffffff !important
        border-color = #ef4444 !important
        box-shadow = 0 0 10px #ef4444 !important

    .btn-edit-track:hover:
        background = {neon_cyan}
        color = #000000
        border-color = {neon_cyan}
        box-shadow = 0 0 10px {neon_cyan}

    .btn-editing:
        background = {neon_cyan} !important
        color = #000000 !important
        box-shadow = 0 0 12px {neon_cyan} !important
        border-color = {neon_cyan} !important

    .badge-wave:
        font-size = 0.7rem
        padding = 0.2rem 0.5rem
        border-radius = 4px
        text-transform = uppercase
        letter-spacing = 1px
        font-weight = bold

    .badge-square:
        background = rgba(0, 229, 255, 0.2)
        color = {neon_cyan}
        border = 1px solid {neon_cyan}

    .badge-triangle:
        background = rgba(57, 255, 20, 0.2)
        color = {neon_lime}
        border = 1px solid {neon_lime}

    .badge-noise:
        background = rgba(255, 42, 133, 0.2)
        color = {neon_pink}
        border = 1px solid {neon_pink}

    .badge-saw:
        background = rgba(255, 170, 0, 0.2)
        color = {neon_amber}
        border = 1px solid {neon_amber}

    .track-score-box:
        background = #03050c
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 0.75rem
        color = #e2e8f0
        font-family = "Courier New", monospace
        font-size = 0.85rem
        line-height = 1.5
        white-space = pre-wrap
        word-break = break-word

    .active-score-box:
        border-color = {neon_cyan}
        box-shadow = 0 0 12px rgba(0, 229, 255, 0.25)
        background = #060b18

    .sfx-section:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem
        margin-bottom = 1.25rem

    .sfx-heading:
        font-size = 0.95rem
        color = {neon_pink}
        letter-spacing = 2px
        margin = 0 0 0.75rem 0
        font-weight = bold

    .sfx-pads:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(110px, 1fr))
        gap = 0.5rem

    .pad-btn:
        background = {card_bg}
        color = #ffffff
        border = 1px solid {grid_border}
        padding = 0.75rem 0.5rem
        border-radius = 8px
        cursor = pointer
        font-family = inherit
        font-size = 0.8rem
        letter-spacing = 1px
        display = flex
        flex-direction = column
        align-items = center
        gap = 0.25rem
        transition = all 0.1s ease
        touch-action = manipulation
        min-height = 54px

    .pad-btn:hover:
        border-color = {neon_pink}
        box-shadow = 0 0 12px {neon_pink}
        transform = scale(1.03)

    .pad-btn:active:
        transform = scale(0.96)
        background = {neon_pink}
        color = #000000

    .export-section:
        background = {rack_bg}
        border = 1px solid {grid_border}
        border-radius = 12px
        padding = 1rem

    .export-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.75rem

    .code-preview:
        background = #02040a
        border = 1px solid {grid_border}
        border-radius = 8px
        padding = 1rem
        font-family = "Courier New", monospace
        font-size = 0.8rem
        color = {neon_lime}
        overflow-x = auto
        white-space = pre-wrap
        max-height = 240px

fullscreen:
    body:
        margin = 0
        padding = 0
        background = #020308
        overflow = auto
    .studio-cabinet:
        position = fixed
        top = 0
        left = 0
        width = 100vw
        height = 100vh
        max-width = 100vw
        border-radius = 0
        border = none
        min-height = 100vh
        box-shadow = none
        padding = 1.25rem 2rem
        z-index = 99999
        overflow-y = auto
        box-sizing = border-box
    .piano-roll-container:
        padding = 1rem 0
    .track-rack:
        border-color = rgba(0, 229, 255, 0.4)

responsive:
    (max-width: 768px):
        .studio-cabinet:
            padding = 0.75rem
            border-radius = 12px
        .studio-header:
            flex-direction = column
            align-items = flex-start
            gap = 0.75rem
        .header-controls:
            width = 100%
            justify-content = space-between
        .transport-bar:
            flex-direction = column
            align-items = stretch
            gap = 0.75rem
        .transport-buttons:
            justify-content = space-between
        .tempo-controls:
            justify-content = space-between
        .time-sig-controls:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-timesig:
        background = {card_bg}
        color = {text_muted}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.8rem
        transition = all 0.15s ease

    .btn-timesig.active:
        background = {neon_amber}
        color = #000000
        border-color = {neon_amber}
        box-shadow = 0 0 10px {neon_amber}

    .mode-controls:
        display = flex
        align-items = center
        gap = 0.4rem

    .btn-mode:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.4rem 0.65rem
        border-radius = 6px
        cursor = pointer
        font-family = inherit
        font-weight = bold
        font-size = 0.75rem
        transition = all 0.15s ease

    .btn-mode.active:
        background = {neon_cyan}
        color = #000000
        box-shadow = 0 0 12px {neon_cyan}

    .storage-actions:
            flex-wrap = wrap
        .song-selector:
            overflow-x = auto
            flex-wrap = nowrap
            padding-bottom = 0.5rem
        .piano-roll-container:
            overflow-x = auto
            padding-bottom = 0.5rem
        .step-strip-scroll:
            padding-bottom = 0.5rem
        .piano-key:
            min-width = 38px
            height = 90px
        .drum-pads:
            grid-template-columns = repeat(3, 1fr)

    (max-width: 480px):
        .studio-title:
            font-size = 1.2rem
        .studio-subtitle:
            font-size = 0.7rem
        .btn-transport:
            padding = 0.5rem 0.8rem
            font-size = 0.8rem
        .btn-storage:
            flex = 1
            text-align = center
            font-size = 0.7rem
            padding = 0.4rem 0.5rem
        .voice-tabs:
            flex-direction = column
            width = 100%
        .instrument-picker:
        display = flex
        gap = 0.4rem
        align-items = center
        flex-wrap = wrap

    .pill-instrument:
        background = {card_bg}
        color = {neon_cyan}
        border = 1px solid {grid_border}
        padding = 0.35rem 0.65rem
        border-radius = 12px
        font-size = 0.75rem
        font-weight = bold
        cursor = pointer
        transition = all 0.15s ease
        touch-action = manipulation

    .pill-instrument:hover:
        border-color = {neon_cyan}
        box-shadow = 0 0 8px rgba(0, 229, 255, 0.4)

    .btn-chord-toggle:
        background = {card_bg}
        color = {neon_amber}
        border = 1px solid {neon_amber}
        padding = 0.4rem 0.75rem
        border-radius = 6px
        cursor = pointer
        font-size = 0.75rem
        font-weight = bold
        transition = all 0.15s ease
        touch-action = manipulation

    .btn-chord-toggle.chord-active:
        background = {neon_amber}
        color = #000000
        box-shadow = 0 0 14px {neon_amber}

    .duration-picker:
            width = 100%
            justify-content = space-between
