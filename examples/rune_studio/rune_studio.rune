#!RUNE

import "parts"

@App
name = RuneStudio
version = 1.0
type = REST
port = 3001

@Frontend
type = rune-web
path = %ROOT%
page = studio

@Page/studio
title = Rune Studio — 8-Bit Chiptune DAW
style = studio
logic = studio
view:
    main .studio-cabinet:
        StudioHeader
        SongSelector
        TransportBar
        NoteEditorPanel
        div .tracks-container:
            TrackRack voice_id=lead voice_name="VOICE 1: SQUARE LEAD" icon="🎹" badge_class="badge-square" badge_text="Square 50%" score_text="{lead_track}"
            TrackRack voice_id=bass voice_name="VOICE 2: TRIANGLE BASS" icon="🎸" badge_class="badge-triangle" badge_text="Triangle Sub" score_text="{bass_track}"
            TrackRack voice_id=drums voice_name="VOICE 3: PERCUSSION / DRUMS" icon="🥁" badge_class="badge-noise" badge_text="Noise & Pitch" score_text="{drums_track}"
        SfxAuditionPad
        RuneCodeExport
