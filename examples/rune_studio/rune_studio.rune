#!RUNE

import "parts"

@App
name = RuneStudio
version = 1.0
type = REST
port = 3001

@Frontend
type = rune-web
path = %ROOT%
page = studio

@Page/studio
title = Rune Studio — 8-Bit Chiptune DAW
style = studio
logic = studio
view:
    main .studio-cabinet:
        StudioHeader
        SongSelector
        TransportBar
        NoteEditorPanel
        LowerContentTabs
