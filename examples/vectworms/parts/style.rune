@Style/vectworms
tokens:
    neon_lime = #39ff14
    neon_cyan = #00e5ff
    neon_magenta = #ff007f
    neon_amber = #ffaa00
    cabinet_bg = #060812
    card_bg = #0c1022
    arena_bg = #02040a
    grid_border = #1c2742
    text_muted = #7e8c9f
    btn_bg = #161e36

presets:
    game-entity:
        abs = true
        pointer-events = none

    arcade-btn:
        position = relative
        pointer-events = auto
        cursor = pointer
        touch-action = manipulation
        user-select = none
        weight = bold
        center = xy
        transition = all 0.1s ease

rules:
    body:
        margin = 0
        padding = 8px
        box-sizing = border-box
        background = {cabinet_bg}

    .arcade-cabinet:
        max-width = min(540px, calc((100svh - 272px) * 480 / 480 + 32px))
        width = 100%
        box-sizing = border-box
        margin = 0 auto
        background = {card_bg}
        border = 3px solid {neon_lime}
        round = 16px
        padding = 0.75rem
        box-shadow = 0 0 35px {neon_lime / 25%}, inset 0 0 20px rgba(0, 0, 0, 0.8)
        font-family = "Courier New", monospace, sans-serif
        color = #ffffff
        user-select = none
        touch-action = manipulation

    .cabinet-header:
        text-align = center
        margin-bottom = 0.75rem
        border-bottom = 2px solid {neon_lime / 30%}
        padding-bottom = 0.6rem

    .cabinet-title:
        font-size = 1.75rem
        weight = 900
        letter-spacing = 4px
        color = {neon_lime}
        text-glow = {neon_lime} 10px 20px
        margin = 0 0 0.5rem 0

    .stats-bar:
        display = flex
        justify-content = space-between
        font-size = 0.95rem
        weight = bold
        letter-spacing = 2px
        color = {neon_cyan}

    .stat-label:
        color = {text_muted}

    .arena-viewport:
        position = relative
        container-type = inline-size
        display = block
        width = 100%
        height = auto
        aspect = 480 / 480
        margin = 0 auto
        overflow = hidden

    .game-arena:
        abs = inset
        size = 100%
        box-sizing = border-box
        background = {arena_bg}
        border = 2px solid {grid_border}
        round = 8px
        overflow = hidden
        box-shadow = inset 0 0 40px rgba(0, 0, 0, 0.95)
        pointer-events = none

    .arena-grid:
        use = (game-entity)
        abs = 0 0
        size = 100%
        background-image = radial-gradient({grid_border / 40%} 1px, transparent 1px)
        background-size = 20px 20px
        opacity = 0.45

    .player-zone:
        use = (game-entity)
        left = 0
        right = 0
        top = 75%
        bottom = 0
        border-top = 1px dashed {neon_cyan / 25%}
        background = {neon_cyan / 3%}

    .player:
        use = (game-entity)
        size = 6.25% 4.166667%
        transform = translate(-50%, -50%)
        center = xy
        transition = transform 0.05s linear
        z-index = 10

    .player-cannon:
        size = 100%
        background = {neon_cyan}
        round = 4px
        box-shadow = 0 0 14px {neon_cyan}, inset 0 0 4px #ffffff

    .bullet:
        use = (game-entity)
        size = 0.833333% 2.5%
        transform = translate(-50%, -50%)
        background = #ffffff
        round = 2px
        box-shadow = 0 0 8px {neon_cyan}, 0 0 14px #ffffff
        z-index = 8

    .mushroom:
        use = (game-entity)
        size = 3.75% 3.75%
        round = 50%
        transform = translate(-50%, -50%)
        background = {neon_amber}
        box-shadow = 0 0 10px {neon_amber / 60%}
        center = xy
        font-size = 0.65rem
        font-weight = bold
        color = #000000
        z-index = 5

    .mushroom.damaged:
        opacity = 0.6
        box-shadow = 0 0 4px {neon_amber / 30%}

    .worm:
        use = (game-entity)
        size = 4.166667% 4.166667%
        round = 50%
        transform = translate(-50%, -50%)
        background = {neon_lime}
        box-shadow = 0 0 12px {neon_lime}
        center = xy
        z-index = 6
        transition = all 0.04s linear

    .worm.is-head:
        background = {neon_magenta}
        box-shadow = 0 0 16px {neon_magenta}, inset 0 0 6px #ffffff
        z-index = 7

    .particle:
        use = (game-entity)
        round = 50%
        transform = translate(-50%, -50%)
        pointer-events = none
        z-index = 15
        will-change = transform, opacity

    .overlay:
        abs = inset
        size = 100%
        background = {arena_bg / 88%}
        center = xy
        flex-direction = column
        z-index = 20
        pointer-events = auto

    .overlay-title:
        font-size = 1.6rem
        weight = 900
        letter-spacing = 3px
        margin-bottom = 1rem
        text-align = center
        color = {neon_lime}
        text-glow = {neon_lime} 15px
        padding = 0 1rem

    .start-btn:
        use = (arcade-btn)
        background = {neon_lime}
        color = {arena_bg}
        border = none
        padding = 0.85rem 2.25rem
        font-size = 1.15rem
        letter-spacing = 2px
        round = 8px
        glow = {neon_lime / 60%} 20px
        transition = all 0.15s ease
        &:hover:
            background = #5aff38
            glow = {neon_lime / 90%} 30px
            transform = scale(1.05)
        &:active:
            transform = scale(0.97)

    .arcade-controls:
        position = relative
        z-index = 100
        display = flex
        justify-content = space-between
        align-items = center
        width = 100%
        gap = 0.75rem
        margin-top = 1.1rem
        box-sizing = border-box
        pointer-events = auto

    .dpad-grid:
        display = grid
        grid-template-columns = repeat(3, 44px)
        grid-template-rows = repeat(2, 44px)
        gap = 4px

    .ctrl-btn:
        use = (arcade-btn)
        min-height = 44px
        background = {btn_bg}
        color = {neon_lime}
        border = 2px solid {grid_border}
        font-size = 0.95rem
        round = 8px
        &:hover:
            border-color = {neon_lime}
            glow = {neon_lime / 30%} 12px
        &:active:
            background = {neon_lime}
            color = {arena_bg}
            transform = scale(0.95)

    .fire-btn:
        use = (arcade-btn)
        flex = 1
        max-width = 160px
        min-height = 92px
        background = {neon_magenta}
        color = #ffffff
        border-color = {neon_magenta}
        glow = {neon_magenta / 40%} 15px
        font-size = 1.25rem
        round = 12px
        letter-spacing = 2px
        &:hover:
            background = #ff3399
            glow = {neon_magenta / 70%} 25px
        &:active:
            background = #e60073
            transform = scale(0.95)

    .controls-hint:
        text-align = center
        margin-top = 0.75rem
        font-size = 0.8rem
        color = #64748b
        letter-spacing = 1px

responsive:
    (max-width: 520px):
        .arcade-cabinet:
            padding = 0.5rem
            margin = 0 auto
            border-width = 2px
            border-radius = 12px
        .cabinet-title:
            font-size = 1.35rem
            letter-spacing = 2px
        .stats-bar:
            font-size = 0.8rem
            letter-spacing = 1px
        .arcade-controls:
            gap = 0.4rem
            margin-top = 0.6rem
            position = relative
            z-index = 100
        .fire-btn:
            min-height = 80px
            font-size = 1.1rem
        .controls-hint:
            font-size = 0.7rem
