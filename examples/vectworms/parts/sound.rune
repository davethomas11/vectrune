# VectWorms Arcade Sound & Chiptune Music Engine

@Sound/laser
wave = sawtooth
freq = 740 -> 180
duration = 100ms
volume = 0.22
curve = exponential

@Sound/hit
wave = square
freq = 240 -> 60
duration = 80ms
volume = 0.3

@Sound/explosion
wave = noise
filter = lowpass 950 -> 70
duration = 300ms
volume = 0.4

@Sound/gameover
wave = sawtooth
sequence = D4:140ms, C#4:140ms, C4:220ms, F#3:400ms
duration = 550ms
volume = 0.3

@Sound/victory
wave = triangle
sequence = G4:100ms, B4:100ms, D5:100ms, G5:250ms
duration = 550ms
volume = 0.3

@Music/vectworms
type = 8bit
tempo = 136
loop = true
volume = 0.18

lead:
    C4:8 E4:8 G4:8 A4:8 G4:8 E4:8 C4:8 D4:8       # Bar 1: Bouncy opening
    E4:8 G4:8 A4:8 C5:8 B4:4 G4:4                 # Bar 2: Peak melody
    A4:8 G4:8 E4:8 C4:8 D4:8 E4:8 D4:4           # Bar 3: Playful turn
    C4:2 -:2                                      # Bar 4: Rest & resolve

bass:
    C2:4 G2:4 C2:4 G2:4                           # Bar 1: Walking groove
    E2:4 B2:4 E2:4 B2:4                           # Bar 2
    F2:4 C3:4 G2:4 D3:4                           # Bar 3
    C2:4 G2:4 C2:2 -:4                            # Bar 4

drums:
    kick:4 snare:4 kick:8 kick:8 snare:4          # Bar 1: Syncopated beat
    kick:4 snare:4 kick:8 hihat:8 snare:4         # Bar 2
    kick:4 snare:4 kick:8 kick:8 snare:4          # Bar 3
    kick:4 snare:4 kick:2                         # Bar 4
