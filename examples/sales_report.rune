#!RUNE

@App
name = One-line Sales Reports
type = REST
port = 3000

@Route/GET /report
run:
    sales = csv.read "sales_report.csv"
    report = summarize sales by region sum amount
    respond 200 report

@Route/GET /averages
run:
    sales = csv.read "sales_report.csv"
    report = summarize sales by region avg amount
    respond 200 report

@Route/GET /counts
run:
    sales = csv.read "sales_report.csv"
    report = summarize sales by region
    respond 200 report

@Route/GET /medians
run:
    sales = csv.read "sales_report.csv"
    report = summarize sales by region median amount
    respond 200 report

@Route/GET /customers
run:
    sales = csv.read "sales_report.csv"
    report = summarize sales by region distinct customer
    respond 200 report

@Route/GET /first-customers
run:
    sales = csv.read "sales_report.csv"
    report = summarize sales by region first customer
    respond 200 report

@Route/GET /last-customers
run:
    sales = csv.read "sales_report.csv"
    report = summarize sales by region last customer
    respond 200 report

@Route/POST /report
run:
    parse-json
    report = summarize body by region sum amount
    respond 200 report
