# Game-owned HUD icons. Dots stay transparent over the 3D scene.
@Palette/marble_hud
colors = {
    ".": "transparent",
    "c": "#68e1e8",
    "g": "#f7d68b",
    "k": "#142b38",
    "o": "#d59968",
    "s": "#67838d",
    "t": "#277eab",
    "w": "#e5fbdf"
}

@Sprite/marble/hud/marble_full
palette = marble_hud
size = [9,9]
origin = [0,0]
pixels:
    "..kkkkk.."
    ".kccwcck."
    "kcwwccctk"
    "kcwcccctk"
    "kcccccctk"
    "kcccctttk"
    "kcttttttk"
    ".ktttttk."
    "..kkkkk.."

