        call ramp 2.25, "marble/slope_glass"
        call deck 2.25, "marble/deck_glass"
        call gap 3.5, 2.25
        call deck 2.25, "marble/deck_glass"
        call corner 90
        call half_pipe
        call deck 2.25, "marble/deck_glass"
        call gap 4, 2.25
        call deck 2.5, "marble/deck_finish"
        call corner -90
        call ramp 1.75, "marble/slope_spine"
        call deck 2.5, "marble/deck_finish"
        call finish_path
        call sentry_at 18, 1.2, 3, 0
        call sentry_at 60, 1.2, 3, 90
        call sentry_at 108, 0.95, 3, 180
        call sentry_at 113, 1.5, 3, 270
        call spike_at 28, -1.5
        call spike_at 61, -2.3
        call spike_at 61, 2.3
        call spike_at 102, -1
        call spike_at 102, 0
        call spike_at 102, 1
    if level == 3:
