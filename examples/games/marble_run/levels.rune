        call gap 3.5, 2.25
        call deck 2.5, "marble/deck_finish"
        call corner -90
        call half_pipe
        call deck 2.25, "marble/deck_glass"
        call gap 3.5, 2.25
        call deck 2.5, "marble/deck_finish"
        call corner 90
        call ramp 1.75, "marble/slope_spine"
        call corner 90
        call deck 2, "marble/deck_ridge"
        call gap 4, 2
        call deck 2.5, "marble/deck_finish"
        call corner -90
        call ramp 1.75, "marble/slope_spine"
        call deck 2.5, "marble/deck_finish"
        call finish_path
        call sentry_at 18, 1.2, 3.5, 0
        call sentry_at 60, 1.2, 3.5, 90
        call sentry_at 106, 0.8, 3.5, 180
