        call sentry_at 18, 1, 4.5, 0
        call sentry_at 60, 1.2, 4.5, 50
        call sentry_at 90, 1.3, 4.5, 100
        call sentry_at 108, 0.8, 4.5, 150
        call sentry_at 150, 1.2, 4.5, 200
        call sentry_at 194, 0.8, 4.5, 250
        call sentry_at 240, 0.8, 4.5, 300
        call spike_at 28, 1.2
        call spike_at 60, 0
        call spike_at 104, -1
        call spike_at 104, 0
        call spike_at 104, 1
