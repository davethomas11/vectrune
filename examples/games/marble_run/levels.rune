        checkpoint_z = 14
        call begin_path
        call deck 2, "marble/deck_ridge"
        call ramp 1.75, "marble/slope_spine"
        call deck 1.75, "marble/deck_spine"
        call gap 4, 1.75
        call deck 2, "marble/deck_ridge"
        call corner 90
        call half_pipe
        call deck 1.75, "marble/deck_spine"
        call gap 4.25, 1.75
        call deck 2, "marble/deck_ridge"
        call corner 90
        call ramp 1.75, "marble/slope_spine"
        call deck 2, "marble/deck_ridge"
        call corner -90
        call half_pipe
        call deck 1.5, "marble/deck_storm"
        call gap 4.5, 1.5
        call deck 2, "marble/deck_ridge"
        call ramp 1.5, "marble/slope_storm"
        call deck 2, "marble/deck_ridge"
        call finish_path
        call sentry_at 18, 1, 4, 0
        call sentry_at 70, 1, 4, 72
        call sentry_at 110, 0.8, 4, 144
        call sentry_at 138, 1.2, 4, 216
        call sentry_at 178.5, 1.1, 4, 288
        call spike_at 28, 1.2
        call spike_at 60, 0
        call spike_at 104, -1
        call spike_at 104, 0
        call spike_at 104, 1
        call spike_at 137, -2.3
        call spike_at 137, 2.3
        call spike_at 171, -0.9
        call spike_at 171, 0
        call spike_at 171, 0.9

    if level == 4:
