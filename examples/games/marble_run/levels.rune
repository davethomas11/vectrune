        call spike_at 150, 2.3
        call spike_at 192, -1
        call spike_at 192, 0
        call spike_at 192, 1
        call spike_at 236, -1
        call spike_at 236, 0
        call spike_at 236, 1

# The path cursor authors both rendered geometry and oriented collision planes.
action begin_path:
    build_x = 0
    build_y = 0
    build_z = start_height
    build_angle = 0
    build_s = 0

action lane(length,slope,half,kind):
    route.push(
        {
            "x": build_x,
            "y": build_y,
            "z": build_z,
            "angle": build_angle,
            "dx": cos(build_angle),
            "dy": sin(build_angle),
            "s": build_s,
            "length": length,
            "slope": slope,
            "half": half,
            "kind": kind
        }
    )
    build_x += cos(build_angle)*length
    build_y += sin(build_angle)*length
    build_z += slope*length
    build_s += length
    waypoints.push({"x": build_x, "y": build_y, "s": build_s, "kind": kind})

action plane(length,slope,half,pipe):
    dx = cos(build_angle)
    dy = sin(build_angle)
    surfaces.push(
        {
            "x": build_x,
            "y": build_y,
            "z": build_z,
            "angle": build_angle,
            "dx": dx,
            "dy": dy,
            "length": length,
            "slope": slope,
            "half": half,
            "pipe": pipe,
            "min_x": min(build_x, build_x + dx * length) - abs(dy) * half - 0.000001,
            "max_x": max(build_x, build_x + dx * length) + abs(dy) * half + 0.000001,
            "min_y": min(build_y, build_y + dy * length) - abs(dx) * half - 0.000001,
            "max_y": max(build_y, build_y + dy * length) + abs(dx) * half + 0.000001
        }
    )

action deck(half,model):
    call plane 8, 0, half, false
    track.push({"x": build_x, "y": build_y, "z": build_z, "angle": build_angle, "model": model})
    call lane 8, 0, half, "deck"

action ramp(half,model):
    call plane 16, -0.25, half, false
    track.push(
        {
            "x": build_x + cos(build_angle) * 16,
            "y": build_y + sin(build_angle) * 16,
            "z": build_z - 4,
            "angle": build_angle + 180,
            "model": model
        }
    )
    call lane 16, -0.25, half, "ramp"

action gap(width,half):
    gaps.push({"s": build_s, "landing": build_s + width})
    scenery.push(
        {
            "x": build_x - cos(build_angle) + sin(build_angle) * (half - 0.1),
            "y": build_y - sin(build_angle) - cos(build_angle) * (half - 0.1),
            "z": build_z,
            "model": "marble/pillar"
        }
    )
    scenery.push(
        {
            "x": build_x - cos(build_angle) - sin(build_angle) * (half - 0.1),
            "y": build_y - sin(build_angle) + cos(build_angle) * (half - 0.1),
            "z": build_z,
            "model": "marble/pillar"
        }
    )
    call lane width, 0, half, "gap"

action corner(turn):
    # An eight-tile square gives room to slow down and cut the inside of the bend.
    center_x = build_x+cos(build_angle)*4
    center_y = build_y+sin(build_angle)*4
    surfaces.push(
        {
            "x": center_x - 4,
            "y": center_y,
            "z": build_z,
            "angle": 0,
            "dx": 1,
            "dy": 0,
            "min_x": center_x - 4.000001,
            "max_x": center_x + 4.000001,
            "min_y": center_y - 4.000001,
            "max_y": center_y + 4.000001,
            "length": 8,
            "slope": 0,
            "half": 4,
            "pipe": false
        }
    )
    track.push({"x": center_x, "y": center_y, "z": build_z, "model": "marble/corner"})
    call lane 4, 0, 4, "turn"
    build_angle += turn
    track.push(
        {
            "x": build_x,
            "y": build_y,
            "z": build_z + 0.03,
            "angle": build_angle,
            "model": "marble/arrow"
        }
    )
    call lane 4, 0, 4, "turn"
    corner_count += 1

action half_pipe:
    call plane 16, 0, 3, true
    for slab in range(0,2):
        track.push(
            {
                "x": build_x + cos(build_angle) * slab * 8,
                "y": build_y + sin(build_angle) * slab * 8,
                "z": build_z,
                "angle": build_angle,
                "model": "marble/deck"
            }
        )
    # Four matching planes on each bank approximate a rounded U with a flat trough.
    for strip in range(0,4):
        for band in range(0,4):
            for sign in [-1,1]:
                across = sign*(0.5+band*0.625)
                along = strip*4+2
                track.push(
                    {
                        "x": build_x + cos(build_angle) * along - sin(build_angle) * across,
                        "y": build_y + sin(build_angle) * along + cos(build_angle) * across,
                        "z": build_z + band * band * 0.125,
                        "angle": build_angle + sign * 90,
                        "model": "marble/pipe_bank_" + band
                    }
                )
    call lane 16, 0, 3, "pipe"
    pipe_count += 1

action route_point(distance):
    for segment in route:
        if distance >= segment.s && distance <= segment.s+segment.length:
            along = distance-segment.s
            route_x = segment.x+segment.dx*along
            route_y = segment.y+segment.dy*along
            route_z = segment.z+segment.slope*along
            route_angle = segment.angle
            route_pipe = segment.kind == "pipe"

action finish_path:
    course_length = build_s
    call route_point build_s-3
    goal.x = route_x
    goal.y = route_y
    goal.z = route_z
    call route_point checkpoint_x
    checkpoint_y = route_y
    checkpoint_world_x = route_x

action sentry_at(distance,span,speed,phase):
    call route_point distance
    enemies.push(
        {
            "x": route_x,
            "y": route_y,
            "z": route_z,
            "home_x": route_x,
            "home_y": route_y,
            "home_z": route_z,
            "axis_x": -sin(route_angle),
            "axis_y": cos(route_angle),
            "pipe": route_pipe,
            "angle": route_angle,
            "s": distance,
            "span": span,
            "speed": speed,
            "phase": phase,
            "model": "marble/sentry",
            "visible": true,
            "dissolve": 0
        }
    )

action spike_at(distance,across):
    call route_point distance
    hazard_x = route_x-sin(route_angle)*across
    hazard_y = route_y+cos(route_angle)*across
    call surface_at hazard_x, hazard_y
    spikes.push(
        {
            "x": hazard_x,
            "y": hazard_y,
            "z": floor_z,
            "s": distance,
            "across": across,
            "model": "marble/spikes"
        }
    )
