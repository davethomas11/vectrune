@Logic/marble_run
action define_course:
    track = []
    surfaces = []
    scenery = []
    enemies = []
    spikes = []
    gaps = []
    route = []
    waypoints = []
    corner_count = 0
    pipe_count = 0
    max_speed = min(0.38,0.34+(level-1)*0.02)
    if level == 1:
        level_name = "01 / COPPER CASCADE"
        start_height = 10
        checkpoint_x = 36.5
        checkpoint_z = 6
        call begin_path
        call deck 3, "marble/deck"
        call ramp 3, "marble/slope"
        call deck 3, "marble/deck"
        call gap 3, 3
        call deck 4, "marble/landing"
        call corner 90
        call half_pipe
        call ramp 4, "marble/wide_slope"
        call deck 4, "marble/landing"
        call finish_path
        call sentry_at 18, 1.6, 2, 0
        call sentry_at 41.5, 1.6, 2, 120
        call sentry_at 74, 1.5, 2, 240
        call spike_at 28, 1.8
        call spike_at 86, -2.5
        call spike_at 86, 2.5
    if level == 2:
