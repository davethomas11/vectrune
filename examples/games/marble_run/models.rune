@Palette/marble
colors = {
    "b": "#277eab",
    "c": "#68e1e8",
    "d": "#5f3157",
    "g": "#f7d68b",
    "o": "#d59968",
    "p": "#ba5871",
    "s": "#344f61",
    "t": "#668b87",
    "w": "#e5fbdf"
}

@Model/marble/ball
palette = marble
unit = 1
shapes:
