@Logic/marble_run
state:
    progress = {"unlocked": 1, "cleared": 0}
    course_segment = -1
    death_timer = 0
    death_age = 0
    death_phase = "none"
    flash = 0
    title_props = []
    menu_ticks = 0
    menu_nav_held = false
    menu_confirm_held = false
    title_actions_hidden = false
    selector_hidden = true
    selector_unavailable = false
    launch_hidden = true
    pause_hidden = true
    selected_level = 1
    selection_name = "COPPER CASCADE"
    selection_description = ""
    selection_locked = false
    course_cards = []
    course_names = [
        "COPPER CASCADE",
        "GLASS SPINE",
        "TEMPEST RIDGE",
        "AURORA SWITCHBACK",
        "EMBER FOUNDRY",
        "CELESTIAL CROWN"
    ]
    course_descriptions = [
        "Learn the charge, first corner and blue banks.",
        "Narrow blue ramps, bank spikes and a zigzag.",
        "Return legs, trough hazards and three gaps.",
        "Reverse direction through four aurora bends.",
        "Four jumps and a furnace of spike rows.",
        "Five gaps, seven sentries and the final crown."
    ]

action setup_title:
    menu_ticks = 0
    menu_nav_held = false
    menu_confirm_held = false
    title_props = [
        {"x": 10, "y": 8, "z": 1.2, "model": "marble/corner", "scale": 0.7},
        {"x": 10, "y": 8, "z": 3, "model": "marble/ball", "scale": 3},
        {"x": 10, "y": 8, "z": 4.65, "model": "marble/stripe", "scale": 2}
    ]
    for i in range(0,8):
        title_props.push(
            {
                "x": 10 + cos(i * 45) * 3,
                "y": 8 + sin(i * 45) * 3,
                "z": 2.8,
                "model": "marble/mote",
                "scale": 2
            }
        )

action open_selector:
    stop when status == "playing"
    selected_level = level
    status = "level_select"
    menu_nav_held = false
    menu_confirm_held = false
    music.play "marble_title"
    call update_menu
    call update_view

action select_course(number):
    stop when status != "level_select"
    selected_level = clamp(floor(number),1,level_count)
    sound.play "marble_menu"
    call update_menu
    call update_view

action play_selected:
    stop when status != "level_select" || selected_level > progress.unlocked
    level = selected_level
    unlocked_level = progress.unlocked
    completed_levels = level-1
    call begin_level

action tick_menu(input):
    menu_ticks += 1
    title_props[1].angle = menu_ticks*2
    title_props[1].z = 3+sin(menu_ticks*2)*0.15
    title_props[2].x = 10+sin(menu_ticks*2)*1.5
    title_props[2].z = 3+cos(menu_ticks*2)*1.5
    if status == "level_select":
        direction = (input.right || input.back ? 1 : 0)-(input.left || input.forward ? 1 : 0)+(input.move_x ? input.move_x : 0)-(input.move_y ? input.move_y : 0)
        if abs(direction) > 0.5 && !menu_nav_held:
            call select_course selected_level+(direction > 0 ? 1 : -1)
        menu_nav_held = abs(direction) > 0.5
    if !!input.jump && !menu_confirm_held:
        call advance
    menu_confirm_held = !!input.jump

action update_menu:
    selected_level = clamp(selected_level,1,level_count)
    selection_name = course_names[selected_level-1]
    selection_description = course_descriptions[selected_level-1]
    selection_locked = selected_level > progress.unlocked
    course_cards = []
    for number in range(1,level_count+1):
        label = "0"+number+" / "+course_names[number-1]
        label += number > progress.unlocked ? " / LOCKED" : (number <= progress.cleared ? " / CLEAR" : " / READY")
        course_cards.push({"label": label, "selected": number == selected_level})
