@Sound/marble_jump
wave = triangle
sequence = C4:40ms, G4:40ms, C5:60ms
volume = 0.1

@Sound/marble_charge
wave = sine
sequence = C4:120ms, E4:120ms, G4:120ms, C5:120ms, E5:120ms, G5:120ms, C6:80ms
volume = 0.09

@Sound/marble_blast
wave = noise
sequence = G3:50ms, C3:70ms, G2:100ms
volume = 0.12

@Sound/marble_hurt
wave = triangle
sequence = E4:70ms, C4:70ms, G3:100ms
volume = 0.12

@Sound/marble_checkpoint
wave = sine
sequence = C5:80ms, E5:80ms, G5:140ms
volume = 0.12

@Sound/marble_win
wave = triangle
sequence = C5:100ms, E5:100ms, G5:100ms, C6:250ms
volume = 0.13

