@Controls/starfall
keys:
    KeyA -> left
    ArrowLeft -> left
    KeyD -> right
    ArrowRight -> right
    Space -> jump
    KeyJ -> fire
    KeyX -> fire
    KeyW -> aim_up
    ArrowUp -> aim_up
    KeyS -> duck
    ArrowDown -> duck
    ShiftLeft -> dash
    ShiftRight -> dash
    KeyK -> dash
    KeyE -> use
commands:
    Enter -> host.advance
    KeyP -> host.pause
    KeyF -> host.fullscreen
    KeyV -> host.mute
mouse:
    Left -> fire
gamepad:
    Axis0 -> {"input":"move_x","deadzone":0.18}
    Axis1 -> {"input":"duck_axis","deadzone":0.35}
    Button0 -> jump
    Button2 -> fire
    Button4 -> aim_up
    Button5 -> duck
    Button6 -> {"command":"host.pause"}
    Button1 -> dash
    Button3 -> use
    Button8 -> {"command":"host.advance"}
    Button9 -> {"command":"host.pause"}
touch = {
    "buttons": [
        {
            "anchor": "bottom-right",
            "command": "host.advance",
            "id": "skip",
            "label": "SKIP",
            "offset": [12,12],
            "size": 48,
            "visible": "cinema_skip_ready"
        },
        {
            "id": "jump",
            "input": "jump",
            "label": "JUMP",
            "offset": [80,14],
            "size": 56,
            "visible": "touch_ready"
        },
        {
            "id": "fire",
            "input": "fire",
            "label": "FIRE",
            "offset": [12,14],
            "size": 56,
            "visible": "touch_ready"
        },
        {
            "anchor": "top-right",
            "aria_label": "Pause game",
            "command": "host.pause",
            "id": "pause",
            "label": "II",
            "offset": [12,12],
            "size": 44
        },
        {
            "id": "dash",
            "input": "dash",
            "label": "DASH",
            "offset": [12,82],
            "size": 48,
            "visible": "touch_dash_ready"
        },
        {
            "id": "use",
            "input": "use",
            "label": "USE",
            "offset": [80,82],
            "size": 48,
            "visible": "touch_use_ready"
        }
    ],
    "joystick": {"down":"duck","size":76,"up":"aim_up","visible":"touch_ready","x":"move_x"},
    "visible": "touch_ui_visible"
}
