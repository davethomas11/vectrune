@Logic/starfall
action build_station:
    world = {
        "width": 128,
        "height": 21,
        "depth": 20,
        "seed": 701,
        "biome": "meadow",
        "materials": [
            "sf/hull",
            "sf/edge",
            "sf/plasma",
            "sf/reactor",
            "sf/temple_stone",
            "sf/temple_trim"
        ],
        "cells": [],
        "spawn": player
    }
    world = voxel_world(
        world.width,
        world.height,
        world.depth,
        world.materials,
        {"seed": world.seed, "biome": world.biome, "spawn": world.spawn, "renderDistance": 128}
    )
    # One continuous, reversible route. Real gaps interrupt the lower deck.
    call deck 4, 19, 3, 2
    call deck 26, 49, 3, 2
    call deck 78, 4, 3, 4
    # Climb the vestibule, then descend five tiles into the buried sanctuary.
    # Every step can be climbed again with the already recovered jump jets.
    call deck 82, 5, 5, 6
    call deck 87, 5, 8, 6
    call deck 92, 4, 5, 6
    call deck 96, 31, 3, 6
    call deck 122, 4, 4, 6
    world = voxel_fill(world, [96,1,3], [31,1,15], 5)
    world = voxel_fill(world, [94,2,18], [34,7,1], 5)
    world = voxel_fill(world, [127,5,1], [1,4,18], 5)
    # Ascending return route: the first 4-tile rise needs jump jets.
    call deck 39, 7, 7, 2
    call deck 30, 6, 10, 2
    call deck 21, 6, 13, 2
    # Thirteen empty tiles separate plasma from the upper approach.
    # Jump jets reach the approach; Hydroponics air dash reaches the far perch.
    # A missed crossing drops safely onto the original landing deck.
    call deck 4, 4, 13, 2
    # Optional service loft beyond the seal: climb away from the main deck.
    call deck 65, 3, 7, 2
    call deck 71, 4, 11, 2
    # Gate spans the entire playable plane; it cannot be jumped around.
    if !gate_open:
        world = voxel_fill(world, [62,5,3], [1,4,16], 3)
    if !foundry_cleared:
        world = voxel_fill(world, [78,5,3], [1,4,16], 6)
    scenery = [{"x": 62.5, "y": 7.8, "z": 3, "model": "sf/gate_frame"}]
    scenery = entity_group(scenery)
    scenery.push({"x": 22.5, "y": 6.2, "z": 13, "model": "sf/dash_gap_left"})
    # Background trusses and stars sit behind the movement plane.
    for x in range(6, 108, 8):
        scenery.push({"x": x, "y": 3, "z": 2, "model": "sf/truss"})
    for i in range(0, 65):
        scenery.push(
            {
                "x": 4 + (i * 17) % 104,
                "y": 1,
                "z": 4 + (i * 7) % 16,
                "model": "sf/star",
                "scale": i % 3 == 0 ? 1.4: 0.6
            }
        )
    scenery.push({"x": 52, "y": 1, "z": 13, "model": "sf/planet"})
    for x in [96,104,112,123]:
        scenery.push({"x": x, "y": 3.5, "z": 3, "model": "sf/temple_pillar"})
        scenery.push({"x": x, "y": 4.5, "z": 5, "model": "sf/temple_brazier"})
    scenery.push({"x": 111, "y": 2.5, "z": 7, "model": "sf/temple_sigil"})
    scenery.push({"x": 124, "y": 7, "z": 4, "model": "sf/temple_altar"})
    pickups = [
        {
            "x": 49,
            "y": 7,
            "z": 3.5,
            "base": 3.5,
            "kind": "jets",
            "model": "sf/jets",
            "visible": false
        },
        {
            "x": 6,
            "y": 7,
            "z": 13.5,
            "base": 13.5,
            "kind": "plasma",
            "model": "sf/plasma_cell",
            "visible": true
        },
        {
            "x": 124,
            "y": 7,
            "z": 5.5,
            "base": 5.5,
            "kind": "core",
            "model": "sf/core",
            "visible": false
        }
    ]
    pickups = entity_group(pickups)
    call place_oneup "containment",73,11.6
    beacons = [
        {"x": 35, "y": 7, "z": 3, "model": "sf/beacon", "active": false},
        {"x": 69, "y": 7, "z": 3, "model": "sf/beacon", "active": false},
        {"x": 90, "y": 7, "z": 8, "model": "sf/beacon", "active": false}
    ]
    beacons = entity_group(beacons)
    portals = [
        {
            "x": 52,
            "y": 6.3,
            "z": 3,
            "model": "sf/garden_hatch",
            "kind": "garden_entry",
            "label": "ENTER HYDROPONICS",
            "title": "HYDROPONICS",
            "visible": true
        },
        {
            "x": 37,
            "y": 6.3,
            "z": 3,
            "model": "sf/shortcut_hatch",
            "kind": "garden_shortcut",
            "label": "HYDROPONICS SHORTCUT",
            "title": "HYDROPONICS LINK",
            "visible": garden_cleared
        }
    ]
    portals = entity_group(portals)
    portals.push(
        {
            "x": 69,
            "y": 6.3,
            "z": 3,
            "model": "sf/foundry_hatch",
            "kind": "foundry_entry",
            "label": "ENTER GRAVITY FOUNDRY",
            "title": "GRAVITY FOUNDRY",
            "visible": true
        }
    )
    portals.push(
        {
            "x": 58,
            "y": 6.3,
            "z": 3,
            "model": "sf/foundry_hatch",
            "kind": "foundry_shortcut",
            "label": "FOUNDRY SHORTCUT",
            "title": "FOUNDRY LINK",
            "visible": foundry_cleared
        }
    )
    scenery.push({"x": 78.5, "y": 7.8, "z": 3, "model": "sf/foundry_bulkhead"})
    portals.push(
        {
            "x": 33,
            "y": 6.3,
            "z": 10,
            "model": "sf/bonus_hatch",
            "kind": "archive_entry",
            "label": "OPTIONAL / SIGNAL ARCHIVE",
            "title": "SIGNAL ARCHIVE",
            "visible": true
        }
    )
    portals.push(
        {
            "x": 74,
            "y": 6.3,
            "z": 3,
            "model": "sf/bonus_hatch",
            "kind": "observatory_entry",
            "label": "OPTIONAL / GRAVITY OBSERVATORY",
            "title": "GRAVITY OBSERVATORY",
            "visible": true
        }
    )
    portals.push(
        {
            "x": 49,
            "y": 6.5,
            "z": 3,
            "model": "sf/rift_gate0",
            "kind": "jets_entry",
            "label": "ENTER PROPULSION CRYPT",
            "title": "PROPULSION CRYPT",
            "visible": true
        }
    )
    enemies = entity_group()
    call drone 19, 4, 2
    call drone 43, 4, 3
    call drone 55, 4, 1
    call drone 57, 4, 2
    call drone 72, 4, 2
    call drone 80, 4, 1
    boss = {
        "x": 114,
        "y": 7,
        "z": 3,
        "model": "sf/warden",
        "visible": true,
        "hp": 48,
        "max_hp": 48,
        "hit_ticks": 0,
        "home": 114,
        "target": 103,
        "angle": 180
    }
    boss_warning = {"x": 103, "y": 9.2, "z": 3.05, "model": "sf/warden_warning", "visible": false}

action deck(x, width, top, material):
    world = voxel_fill(world, [x,5,top-2], [width,4,1], material == 6 ? 5 : 1)
    world = voxel_fill(world, [x,5,top-1], [width,4,1], material)

action drone(x, z, span):
    enemies.push(
        {
            "x": x,
            "y": 7,
            "z": z,
            "home": x,
            "base": z,
            "span": span,
            "hp": 3,
            "hit_ticks": 0,
            "visible": true,
            "model": "sf/drone",
            "cooldown": 45
        }
    )
