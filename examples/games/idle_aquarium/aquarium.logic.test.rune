@Test/Aquarium/MenuDoesNotStopIdleIncome
type = logic
page = aquarium
run:
    invoke initialize
    invoke toggle_menu
    assert state.menu_open == true
    assert state.ui.grid.layout == "sidebar"
    assert state.ui.grid.items.length == 10
    assert state.ui.grid.dismissAction == "close_menu"
    assert state.ui.grid.textScale == 2
    assert state.menu_index == 0
    invoke menu_move 1
    assert state.menu_index == 2
    assert state.ui.grid.items[2].selected == true
    invoke menu_move -1
    assert state.menu_index == 0
    assert state.ui.grid.items[1].disabled == true
    invoke age 30
    assert state.progress.pearls == 31
    invoke toggle_menu
    assert state.menu_open == false
    assert state.quick_hidden == false
    invoke close_menu
    assert state.menu_open == false

@Test/Aquarium/FishNamesAgeAndProfiles
type = logic
page = aquarium
run:
    invoke initialize
    assert state.progress.buddies.length == 3
    assert state.progress.buddies[0].name == "Sunny"
    invoke inspect_fish 0
    assert state.profile_open == true
    assert state.profile_species == "Clownfish"
    assert state.ui.callout.dismissAction == "close_profile"
    invoke open_name_keyboard
    assert state.keyboard_open == true
    assert state.ui.keyboard.value == "Sunny"
    invoke cancel_name_keyboard
    assert state.keyboard_open == false
    assert state.profile_open == true
    invoke rename_fish {"name":"  Captain Bubbles  "}
    assert state.profile_name == "Captain Bubbles"
    invoke rename_fish {"name":" "}
    assert state.profile_name == "Captain Bubbles"
    assert state.name_error == "Choose a name from 1 to 24 characters."
    invoke rename_fish {"name":"This fish name is much too long"}
    assert state.profile_name == "Captain Bubbles"
    assert state.name_error == "Choose a name from 1 to 24 characters."
    invoke age 60
    assert state.progress.buddies[0].age == 2
    invoke grant_pearls
    invoke buy_fish
    assert state.progress.buddies.length == 4
    assert state.progress.buddies[3].age == 0
    assert state.progress.buddies[0].name == "Captain Bubbles"
    invoke initialize
    assert state.progress.buddies[0].age == 2
    assert state.progress.buddies[0].name == "Captain Bubbles"
    assert state.profile_open == false
    invoke inspect_fish 100
    assert state.profile_open == false
    invoke toggle_menu
    invoke feed
    assert state.menu_open == false
    invoke toggle_menu
    invoke grow_reef
    assert state.menu_open == false

