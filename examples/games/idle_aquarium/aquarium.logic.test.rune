@Test/Aquarium/EightDirectionsFootAnimationAndObstacleSteering
type = logic
page = aquarium
run:
    invoke initialize
    invoke clear_walkway
    invoke move_critters
    assert state.crabs[0].x > 20
    assert state.crabs[0].y == 30
    invoke walk_direction 1
    invoke move_critters
    assert state.crabs[0].x > 20
    assert state.crabs[0].y > 30
    invoke animate_feet
    assert state.feet[0].z != state.feet[1].z
    invoke walk_direction 2
    invoke move_critters
    assert state.crabs[0].x == 20
    assert state.crabs[0].y > 30
    invoke walk_direction 3
    invoke move_critters
    assert state.crabs[0].x < 20
    assert state.crabs[0].y > 30
    invoke walk_direction 4
    invoke move_critters
    assert state.crabs[0].x < 20
    assert state.crabs[0].y == 30
    invoke walk_direction 5
    invoke move_critters
    assert state.crabs[0].x < 20
    assert state.crabs[0].y < 30
    invoke walk_direction 6
    invoke move_critters
    assert state.crabs[0].x == 20
    assert state.crabs[0].y < 30
    invoke walk_direction 7
    invoke move_critters
    assert state.crabs[0].x > 20
    assert state.crabs[0].y < 30
    invoke block_walkway
    invoke move_critters
    assert state.crabs[0].direction != 0
    assert state.crabs[0].moving == true
    invoke resting_crab
    invoke move_critters
    assert state.crabs[0].x == 20
    assert state.crabs[0].y == 30
    assert state.crabs[0].moving == false

@Test/Aquarium/BlockedPurchasesExplainFailureWithoutSpending
type = logic
page = aquarium
run:
    invoke initialize
    invoke grant_pearls
    invoke block_all_sand
    invoke open_flower_shop
    invoke buy_floral 0
    assert state.progress.pearls == 100000
    assert state.garden.length == 0
    assert state.shop == "flowers"
    assert state.ui.grid.footer == "No clear planting spot. Expand the tank for more room."
    invoke open_critter_shop
    invoke buy_critter 0
    assert state.progress.pearls == 100000
    assert state.crabs.length == 1
    assert state.shop == "critters"
    assert state.ui.grid.footer == "No clear landing spot. Expand the tank for more room."
    invoke buy_critter -1
    assert state.ui.grid.footer == "Choose a critter variety from the picker."

@Logic/aquarium
state:
    planted_x = 0
    planted_y = 0

action remember_garden:
    planted_x = garden[0].x
    planted_y = garden[0].y

action clear_walkway:
    obstacles = []
    crabs = [crabs[0]]
    call walk_direction 0

action walk_direction(direction):
    local crab = crabs[0]
    crab.x = 20
    crab.y = 30
    crab.direction = direction
    crab.rest = 0
    crab.burst = 100

action block_walkway:
    call walk_direction 0
    obstacles = [{"x":21,"y":30,"radius":0.88}]

action resting_crab:
    call walk_direction 0
    local crab = crabs[0]
    crab.rest = 20

action block_all_sand:
    obstacles = [{"x":20,"y":30,"radius":100}]

action nearly_hungry:
    ticks = 29
    progress.buddies[0].hunger = 599

action nearly_starved:
    ticks = 59
    progress.buddies[0].hunger = 899

action nearly_old:
    ticks = 29
    progress.buddies[0].age = 2699

action dying_eater:
    ticks = 29
    progress.buddies[0].hunger = 899
    fish[0].target = 0
    fish[0].munch_ticks = 47
    fish[0].munch_duration = 48
    food[0].owner = 0
    food[0].chewing = true

action hungry_eater:
    progress.buddies[0].hunger = 600

action fresh_corpse:
    ticks = 29
    progress.buddies[2].dead = true
    progress.buddies[2].death_age = 119

action scavenging_setup:
    ticks = 0
    progress.pearls = 32
    progress.buddies[2].death_age = 200
    progress.buddies[0].hunger = 700
    call animate
    fish[0].x = fish[2].x
    fish[0].y = fish[2].y
    fish[0].z = fish[2].z
    fish[0].snack_wait = 0

action final_bite:
    progress.buddies[2].bites = 5
    progress.buddies[0].hunger = 700
    fish[0].snack_wait = 0

action all_dead:
    for buddy in progress.buddies:
        buddy.dead = true
    progress.pearls = 0

action age(count):
    for i in range(0,count):
        call tick {}

action grant_pearls:
    progress.pearls = 100000

action fill_tank:
    for i in range(0,20):
        call buy_fish
        call grow_reef

action before_festival:
    ticks = 1349

action end_festival:
    ticks = 1799

action saved_reef:
    progress = {"pearls":1234,"fish":8,"reef":3,"earned":2000,"palette":2}

action one_snack:
    for pellet in food:
        pellet.visible = false
        pellet.owner = -1
    for f in fish:
        f.target = -1
        f.snack_wait = 900
    fish[0].x = 20
    fish[0].y = 30
    fish[0].z = 6
    fish[0].snack_wait = 0
    food[0].visible = true
    food[0].x = 22
    food[0].y = 30
    food[0].z = 6
    food[0].home_x = 22
    food[0].home_y = 30
