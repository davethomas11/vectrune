    invoke collect_treasure
    assert state.progress.pearls == 25

@Test/Aquarium/ReefBoostAndJellyUnlock
type = logic
page = aquarium
run:
    invoke initialize
    invoke grow_reef
    assert state.progress.pearls == 0
    assert state.progress.reef == 1
    assert state.reef.length == 9
    assert state.income == 3
    invoke grow_reef
    assert state.progress.reef == 1
    invoke grant_pearls
    invoke grow_reef
    assert state.reef_cost == 270
    invoke grow_reef
    assert state.progress.reef == 3
