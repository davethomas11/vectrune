@Test/Aquarium/FishChaseAndConsumeOnce
type = logic
page = aquarium
run:
    invoke initialize
    invoke feed
    invoke tick {}
    assert state.fish[0].snacking == false
    assert state.food[0].visible == true
    assert state.eaten == 0
    invoke one_snack
    invoke age 10
    assert state.fish[0].snacking == true
    assert state.fish[0].x > 20
    assert state.fish[0].x < 20.5
    assert state.fish[0].munch_ticks == 0
    assert state.food[0].visible == true
    invoke age 60
    assert state.fish[0].munch_ticks > 0
    assert state.food[0].chewing == true
    assert state.food[0].visible == true
    assert state.food[0].scale < 1.3
    assert state.eaten == 0
    invoke age 60
    assert state.eaten == 1
    assert state.food[0].visible == false
    assert state.fish[0].snack_wait > 0
    invoke age 30
    assert state.eaten == 1
    assert state.fish[0].snacking == false

