    invoke grow_reef
    assert state.progress.fish == 18
    assert state.progress.reef == 5
    invoke cycle_lights
    assert state.progress.palette == 1
    assert state.lights[0].color == "#ff5db5"
    invoke cycle_lights
    invoke cycle_lights
    assert state.progress.palette == 0

