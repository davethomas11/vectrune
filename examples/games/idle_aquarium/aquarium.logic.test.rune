    assert state.income == 6

@Test/Aquarium/FeedCostsLivingFriendsAndCannotStack
type = logic
page = aquarium
run:
    invoke initialize
    invoke feed
    assert state.progress.pearls == 26
    assert state.income == 3
    assert state.food.length == 18
    invoke age 30
    assert state.progress.pearls >= 29
    assert state.progress.pearls <= 72
    assert state.eaten == 0
    assert state.fed_ticks == 870
    invoke feed
    assert state.fed_ticks == 870
    assert state.feed_cooldown == 1170
    invoke age 870
    assert state.fed_ticks == 0
    assert state.income == 1.5
    assert state.feed_locked == true
    invoke age 300
    assert state.feed_locked == false

@Test/Aquarium/TreasureRechargesAndFestivalMultiplies
type = logic
page = aquarium
run:
    invoke initialize
    invoke collect_treasure
    assert state.treasure[1].visible == false
    invoke age 599
    invoke collect_treasure
    assert state.treasure_ticks == 599
    invoke age 1
    assert state.treasure[1].visible == true
    invoke collect_treasure
    assert state.treasure_ticks == 0
    invoke before_festival
    invoke tick {}
    assert state.party == true
    assert state.income == 4.5
    invoke feed
    assert state.income == 9
    invoke end_festival
    invoke tick {}
    assert state.party == false
    assert state.income == 3

@Test/Aquarium/CapacityAndLighting
type = logic
page = aquarium
run:
    invoke initialize
    invoke grant_pearls
    invoke fill_tank
    assert state.progress.fish == 18
    assert state.fish.length == 18
    assert state.progress.reef == 5
    assert state.fish_full == true
    assert state.reef_full == true
    assert state.progress.pearls >= 0
