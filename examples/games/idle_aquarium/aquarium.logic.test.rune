    assert state.tank[0].scale == 1
    assert state.camera.y > 0
    invoke grow_tank
    assert state.progress.pearls == 97000
    assert state.tank_capacity == 30
    assert state.tank_scale == 1.25
    invoke grow_tank
    assert state.progress.pearls == 97000
    invoke fill_tank
