#!RUNE
import "idle_aquarium.rune"

@Test/Aquarium/WelcomeAndIdleIncome
type = logic
page = aquarium
run:
    invoke initialize
    assert state.progress.pearls == 30
    assert state.fish.length == 3
    assert state.lights.length == 4
    assert state.bubbles.length == 24
    assert state.visitor[0].visible == false
    invoke age 30
    assert state.progress.pearls == 31
    assert state.progress.earned == 1
    assert state.progress.income_remainder == 1

@Test/Aquarium/AtmosphericMusicKeepsDrifting
type = logic
page = aquarium
run:
    invoke initialize
    assert mock.audio[0].operation == "music.stop"
    assert mock.audio[1].operation == "music.play"
    assert mock.audio[1].args[0] == "glowtide_drift"
    invoke toggle_menu
    invoke feed
    invoke age 30
    assert mock.audio.length == 2

@Test/Aquarium/AdoptionAndSpendingGuards
type = logic
page = aquarium
run:
    invoke initialize
    invoke buy_fish
    assert state.progress.pearls == 30
    assert state.progress.fish == 3
    invoke collect_treasure
    assert state.progress.pearls == 70
    invoke buy_fish
    assert state.progress.pearls == 25
    assert state.progress.fish == 4
    assert state.fish.length == 4
    assert state.fish_cost == 66
    assert state.fish[3].model == "aqua/puffer"
    invoke buy_fish
