@Logic/neon_circuit

action set_title_lights:
    title_lights = [
        {"x": 15.2, "y": 13.7, "z": 2.8, "color": "#389eff", "radius": 6.5, "intensity": 0.53},
        {"x": 21.1, "y": 10.6, "z": 3.4, "color": "#ff369f", "radius": 5.8, "intensity": 0.57},
        {"x": 9.8, "y": 7.8, "z": 2.4, "color": "#5ced68", "radius": 5.4, "intensity": 0.48},
        {"x": 25.7, "y": 8.4, "z": 3.1, "color": "#ffc83c", "radius": 5.2, "intensity": 0.47}
    ]

action set_select_lights(colors):
    lights = [
        {"x": 12.5, "y": 10, "z": 3.6, "color": "#77ddef", "radius": 4.8, "intensity": 0.42},
        {"x": select_boss.x - 1.1, "y": 9.5, "z": 4.4, "color": "#e1e5ff", "radius": 4.5, "intensity": 0.16},
        {"x": select_boss.x + 2, "y": 7.8, "z": 4.3, "color": colors[0], "radius": 5.8, "intensity": 0.52}
    ]

action set_stage_lights(spawn, colors):
    local key_x = spawn.x + 2.7
    local fill_x = spawn.x + 5.5
    lamps = [
        {"x": key_x, "y": 8.85, "z": spawn.z, "model": "nc/lamp"},
        {"x": fill_x, "y": 8.85, "z": spawn.z, "model": "nc/lamp"}
    ]
    lights = [
        {"x": key_x, "y": 9.65, "z": spawn.z + 1.15, "color": colors[0], "radius": 5.2, "intensity": 0.8},
        {"x": fill_x, "y": 9.7, "z": spawn.z + 1.15, "color": colors[1], "radius": 5, "intensity": 0.76},
        {"x": level_width * 0.26, "y": 9.3, "z": 3.9, "color": colors[1], "radius": 9.5, "intensity": 0.35},
        {"x": level_width * 0.64, "y": 9.3, "z": 3.5, "color": colors[0], "radius": 9.5, "intensity": 0.38}
    ]
    for i in range(0, min(2, checkpoints.length)):
        local cp = checkpoints[i]
        lights.push({"x": cp.x, "y": 8.7, "z": cp.z + 1.1, "color": "#67eafa", "radius": 6.2, "intensity": 0.54})
    if boss_gate_x >= 0:
        lights.push({"x": boss_gate_x, "y": 9.4, "z": 4, "color": "#ff634e", "radius": 6.4, "intensity": 0.53})
    if boss_entity.alive:
        lights.push({"x": boss_entity.x, "y": 9.6, "z": boss_entity.z + 1.6, "color": colors[1], "radius": 8, "intensity": 0.51})

action start_overload_light:
    lights = [
        {"x": boss_entity.x, "y": 9.6, "z": boss_entity.z + 1.15, "color": "#ff9430", "radius": 8.5, "intensity": 0.95}
    ]

action update_overload_light:
    lights[0].intensity = 0.46 + 0.49 * (1 - (boss_defeat_ticks % 12) / 12)

action shift_overload_light(progress):
    lights[0].y = 9.6 - progress * 5.8
    lights[0].z = boss_entity.z + 1.15 + (escape_deck_z + 1.75 - boss_entity.z - 1.15) * progress
    lights[0].intensity = 0.85 * (1 - progress)

action set_deck_lights:
    lights = [
        {"x": power_capsule.x, "y": power_capsule.y, "z": escape_deck_z + 1.55, "color": "#35eeff", "radius": 6.5, "intensity": 0.9},
        {"x": player.x, "y": player.y, "z": escape_deck_z + 1.25, "color": "#85bcff", "radius": 4.2, "intensity": 0.38}
    ]

    for i in range(0, 6):
        local x = power_capsule.x + 8 + (escape_entry_x - power_capsule.x - 8) * i / 5
        lights.push({"x": x, "y": 3.7, "z": escape_deck_z + 1.35, "color": "#ff2845", "radius": 12, "intensity": 0.3})

action update_deck_lights:
    lights[1].x = player.x
    lights[1].y = player.y
    # A gentle pulse under one flash per second keeps the route readable.
    local peak = escape_time_limit - escape_ticks <= 450 ? 0.8 : 0.68
    local pulse = (1 + cos(escape_ticks * 8)) * 0.5
    for i in range(2, lights.length):
        lights[i].intensity = 0.2 + (peak - 0.2) * pulse
