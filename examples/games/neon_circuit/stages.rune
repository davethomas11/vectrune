action build_select_arena:
    volt_return_props = []
    sector_return_props = []
    return_challenge = null
    master_active = false
    master_props = []
    lights = []
    lamps = []
    escape_active = false
    escape_first_person = false
    view_weapon = null
    escape_floor = []
    built = side_level("lvl_01_fg", "lvl_01_bg")
    world = built.world
    world = voxel_fill(world, [2, 4, 2], [36, 6, 15], 0)
    world = voxel_fill(world, [2, 5, 1], [36, 4, 1], 1)
    world = voxel_fill(world, [2, 6, 1], [36, 2, 1], 11)
    scenery = []
    for sc in built.scenery:
        if sc.y < 4:
            scenery.push(sc)
    title_scenery = []
    title_monument = {"visible": false}
    level_map = "sky_title"
    barriers = []
    barriers_fx = []
    hazards = []
    hazards_fx = []
    ladders = []
    ladder_caps = []
    boss_doors = []
    boss_door_locked = false
    boss_door_opened = false
    boss_gate_x = -1
    boss_shutter_fx = {"visible": false}
    checkpoints = []
    pickups = []
    enemies = []
    shots = []
    enemy_shots = []
    effects = []
    boss_entity = {"visible": false, "alive": false, "hp": 0, "max_hp": 1, "dissolve": 0}
    boss_satellites = []
    victory_item = {"visible": false, "x": 14, "y": 7, "z": 4, "model": "nc/victory_orb", "angle": 0, "scale": 1}
    avatar = {"x": 12.5, "y": 7, "z": 2.0, "model": "nc/hero_idle", "angle": 0, "visible": true}
    weapon_model = {"visible": false}
    respawn_beam = {"visible": false}
    select_pedestal = {"x": 21.5, "y": 7, "z": 2.0, "model": "nc/pedestal", "scale": 1.15, "visible": true}
    call refresh_select_preview
    camera = {"x": 17.5, "y": 17.5, "z": 3.4, "angle": 270, "pitch": -3}

action refresh_select_preview:
    st = stages[selected_stage]
    select_boss = {
        "x": 21.5,
        "y": 7,
        "z": 2.9,
        "model": st.model,
        "angle": select_spin,
        "scale": 1.2,
        "visible": true
    }
    call set_select_lights st.light_colors
    selected_title = st.code + " " + st.name
    selected_sector = st.sector
    selected_hint = st.hint
    beaten = campaign.defeated[st.code] == true
    selected_status_label = beaten ? "DEFEATED" : (st.tier == 1 ? "TIER 1 INTRO" : "TIER 2 MASTER")
    call refresh_ui

action load_stage(stage_idx):
    volt_return_props = []
    sector_return_props = []
    return_challenge = null
    master_active = false
    master_props = []
    current_stage = stage_idx
    selected_stage = stage_idx
    st = stages[stage_idx]
    built = side_level(st.fg, st.bg, {"margin_z": 24})
    world = built.world
    level_width = built.width
    level_height = built.height
    scenery = built.scenery
    barriers = built.barriers
    barriers_fx = []
    hazards = built.hazards
    hazards_fx = []
    ladders = built.ladders
    ladder_caps = []
    for lad in ladders:
        has_above = false
        for other in ladders:
            if abs(other.x - lad.x) < 0.2 && abs(other.z - (lad.z + 1)) < 0.2:
                has_above = true
        if !has_above:
            ladder_caps.push({"x": lad.x, "z": lad.z + 1.0, "rung_z": lad.z})
    boss_doors = built.boss_doors
    boss_door_locked = false
    boss_door_opened = false
    boss_gate_x = built.boss_doors.length > 0 ? built.boss_doors[0].x : -1
    boss_shutter_fx = {
        "x": boss_gate_x >= 0 ? boss_gate_x + 0.5 : 0,
        "y": 7.0,
        "z": 2.0,
        "model": "nc/boss_shutter",
        "angle": 0,
        "scale": 1.0,
        "visible": boss_gate_x >= 0
    }
    on_ladder = false
    climb_phase = 0
    death_ticks = 0
    pan_ticks = 0
    respawn_ticks = 0
    respawn_beam = {"x": built.spawn.x, "y": 7, "z": built.spawn.z, "model": "nc/teleport_beam", "angle": 0, "scale": 1, "visible": false}
    power_capsule = {"x": built.spawn.x, "y": 7, "z": built.spawn.z - 0.2, "model": "nc/power_capsule", "angle": 0, "scale": 1.15, "visible": false}
    escape_floor = []
    escape_flip_ticks = 0
    escape_ticks = 0
    escape_active = false
    escape_first_person = false
    view_weapon = null
    checkpoints = built.checkpoints
    pickups = built.pickups
    enemies = built.entities
    for e in enemies:
        e.base_model = e.model
        e.charge_ticks = 0
        e.fire_ticks = 0
        e.hurt_ticks = 0
        e.scale = 1.0
        e.angle = 0
        e.dissolve = 0
    shots = []
    enemy_shots = []
    effects = []
    player = {"x": built.spawn.x, "y": 7, "z": built.spawn.z, "angle": 0, "pitch": 0, "vz": 0}
    checkpoint = {"x": built.spawn.x, "z": built.spawn.z}
    facing = 1
    velocity = 0
    grounded = true
    jumps = 0
    jump_held = false
    coyote_ticks = 0
    jump_buffer = 0
    cam_shake = 0
    dash_ticks = 0
    dash_ready = true
    dash_held = false
    prev_w_held = false
    next_w_held = false
    wheel_held = false
    wheel_open = false
    wheel_cooldown = 0
    wheel_last_dir = 0
    wheel_ticks = 0
    cooldown = 0
    invulnerable = 0
    hurt_ticks = 0
    health = max_health
    weapon_energy = 28
    boss_active = false
    boss_defeated_now = false
    boss_defeat_ticks = 0
    victory_ticks = 0
    boss_phase = 0
    boss_clock = 0
    boss_state = "idle"
    boss_state_ticks = 0
    boss_hurt_ticks = 0
    boss_land_ticks = 0
    boss_grounded = true
    boss_entity = {"visible": false, "alive": false, "hp": 0, "max_hp": 1, "dissolve": 0}
    boss_satellites = []
    if built.boss != null:
        boss_entity = built.boss
        boss_entity.vz = 0
        boss_entity.angle = 212
        boss_entity.scale = 1.0
        boss_entity.dissolve = 0
        boss_satellites = [
            {"x": boss_entity.x - 1.1, "y": 7.1, "z": boss_entity.z + 1.1, "model": "nc/boss_pod", "angle": 0, "scale": 0.9, "dissolve": 0, "visible": true},
            {"x": boss_entity.x + 1.1, "y": 6.9, "z": boss_entity.z + 1.1, "model": "nc/boss_pod", "angle": 180, "scale": 0.9, "dissolve": 0, "visible": true},
            {"x": boss_entity.x, "y": 7.25, "z": boss_entity.z + 0.95, "model": "nc/boss_ring", "angle": 0, "scale": 0.85, "dissolve": 0, "visible": true}
        ]
    call set_stage_lights built.spawn, st.light_colors
    victory_item = {"visible": false, "x": player.x, "y": 7, "z": player.z + 2, "model": "nc/victory_orb", "angle": 0, "scale": 1}
    title_scenery = []
    title_monument = {"visible": false}
    select_pedestal = {"visible": false}
    select_boss = {"visible": false}
    avatar = {"x": player.x, "y": 7, "z": player.z, "model": "nc/hero_idle", "angle": 0, "visible": true}
    weapon_model = {"x": player.x + 0.20, "y": 7, "z": player.z + 0.7, "model": "nc/gun_buster", "angle": 0, "visible": true}
    level_map = st.sky
    status = "playing"
    notice_text = st.code + " " + st.name + " // " + st.sector
    notice_ticks = 110
    camera = {"x": max(10, player.x + 4), "y": 19, "z": max(4, player.z + 2.5), "angle": 270, "pitch": 0}
    call play_stage_music st.music
    call sync_weapon_model
    call refresh_ui
