# --- HERO MODELS: AXEL-09 (Cyber Reploid, fine 0.0625 grid, 4-frame run + dash + jump + duck) ---
@Model/nc/hero_idle
palette = nc
contact_shadow = 0.72
unit = 0.0625
blocks:
    {"from": [-4, -4, 0], "size": [5, 3, 2], "color": "C"}
    {"from": [-4, 1, 0], "size": [5, 3, 2], "color": "C"}
