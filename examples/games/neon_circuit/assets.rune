# Hot Neon Cyberpunk Palette, Textures, Sprites, and High-Detail 3D Models
# Every character, boss, and background structure combines box, sphere, cylinder, and ramp shapes.
@Palette/nc
colors = {
    ".": "transparent",
    "k": "#090814",
    "d": "#141328",
    "s": "#22203f",
    "m": "#373463",
    "g": "#5c578f",
    "h": "#8f8bbd",
    "w": "#edf3ff",
    "c": "#3ce2eb",
    "C": "#1b9db5",
    "b": "#124c6b",
    "p": "#e34a8d",
    "P": "#9e245c",
    "q": "#521436",
    "l": "#4cd986",
    "L": "#1f7d47",
    "y": "#ebc14b",
    "Y": "#a87e22",
    "o": "#e87846",
    "O": "#913b1b",
    "v": "#9f6ae8",
    "V": "#5b2ea6",
    "r": "#e84a64",
    "R": "#8f1d35",
    "i": "#9ae8f0",
    "t": "#35c7a7",
    "a": "#354e6d",
    "A": "#587e9e",
    "e": "#5d5249",
    "n": "#274c45",
    "N": "#3c675d",
    "u": "#423358"
}

