@Test/NeonCircuit/WeaponWheelHotKeyAndNumberSelect
type = logic
page = neon_circuit
setup:
    invoke initialize
    invoke load_stage 0
run:
    assert state.wheel_ticks == 0
    assert state.wheel_open == false
    assert state.ui.wheel.active == false
    assert state.ui.slots.length == 0
    invoke tick {"weapon_wheel": true}
    assert state.wheel_open == true
    assert state.ui.wheel.active == true
    assert state.active_weapon == "buster"
    assert state.player.x == 3.5
    invoke tick {"weapon_wheel": true, "right": true}
    assert state.player.x == 3.5
    invoke equip_1
    assert state.active_weapon == "buster"
    invoke tick {"weapon_wheel": false}
    assert state.wheel_open == false
    invoke on_boss_defeated
    invoke wait_ticks 120
    invoke return_to_core_for_test
    invoke finish_boss_victory
    invoke load_stage 0
    assert state.campaign.weapons.volt == true
    assert state.active_weapon == "volt"
    invoke equip_1
    assert state.active_weapon == "buster"
    invoke tick {"weapon_wheel": true}
    assert state.wheel_open == true
    assert state.active_weapon == "buster"
    invoke tick {"weapon_wheel": true, "right": true}
    assert state.active_weapon == "volt"
    invoke tick {"weapon_wheel": true, "left": true}
    assert state.active_weapon == "buster"
    invoke equip_2
    assert state.active_weapon == "volt"
    invoke tick {"weapon_wheel": false}
    assert state.wheel_open == false
    assert state.active_weapon == "volt"

@Logic/neon_circuit
action unlock_volt_for_test:
    campaign.weapons.volt = true

action place_boss_for_death_test:
    boss_entity.x = boss_entity.home_x - 2
    boss_death_spot_for_test = boss_entity.x

action expire_deck_timer_for_test:
    escape_ticks = escape_time_limit - 1
    enemies[0].alive = false
    enemies[0].visible = false
    call tick {}

action enter_pit_for_test:
    lives = 1
    player.x = 26.5
    player.z = 2
    for i in range(0, 18):
        if status == "playing":
            call tick {"right": true}

action cross_covered_pit_for_test:
    pit_cover_tiles = []
    for panel in escape_floor:
        if panel.model == "nc/glass_pit_cover" && panel.x >= 27 && panel.x < 31 && panel.y == 3 && panel.pitch == 0:
            pit_cover_tiles.push(panel.x)
    player.x = 26.5
    player.y = 2.5
    for i in range(0, 20):
        call tick {"right": true}

action walk_boss_into_platform_for_test:
    world = voxel_fill(world, [109, 5, 2], [1, 4, 3], 1)
    boss_active = true
    boss_state = "patrol"
    boss_entity.dir = 1
    boss_entity.x = 108.2
    boss_entity.z = 2
    call step_boss

action drop_boss_onto_platform_for_test:
    boss_grounded = false
    boss_entity.x = 109.5
    boss_entity.z = 5.15
    boss_entity.vz = -0.3
    call step_boss

action bump_boss_into_ceiling_for_test:
    world = voxel_fill(world, [106, 5, 5], [3, 4, 1], 1)
    boss_entity.x = 107.5
    boss_entity.z = 3.03
    call move_boss_z 0.35

action advance_escape_audio_to_for_test(remaining):
    escape_ticks = escape_time_limit - remaining - 1
    call tick {}

action return_to_core_for_test:
    player.x = power_capsule.x + 1.6
    player.y = power_capsule.y
    if escape_first_person:
        call tick {"aim_up": true}
    else:
        call tick {"left": true}

action sample_walkway_for_test:
    walkway_materials = []
    for y in range(5, 9):
        walkway_materials.push(voxel_get(world, 10, y, 1))

action test_side_wall_cover:
    original_floor_material = voxel_get(world, 10, 8, 1)
    player.x = 11.3
    player.z = 2.7
    enemy_shots = [{"x": 10.8, "y": 7, "z": 3.5, "vx": 0.5, "vz": 0, "life": 5}]
    call step_enemy_shots

action test_deck_wall_cover:
    deck_wall_material = voxel_get(world, 10, 1, escape_deck_z)
    deck_wall_center = voxel_get(world, 10, 1, escape_deck_z + 1)
    player.x = 10.5
    player.y = 2.5
    call tick {"aim_up": true}
    call tick {"aim_up": true}
    invulnerable = 0
    enemy_shots = [{"x": 10.5, "y": 1.65, "z": escape_deck_z + 0.8, "vx": 0, "vy": 0.35, "life": 5}]
    call step_escape_shots

action test_deck_corner_cover:
    player.x = 11.5
    player.y = 2.5
    # Both endpoints are clear. The shot crosses the corner of a raised
    # platform before leaving its row and reaching the player's hit radius.
    enemy_shots = [{"x": 10.92, "y": 3.01, "z": escape_deck_z + 0.8, "vx": 0.25, "vy": -0.025, "life": 5}]
    call step_escape_shots

action test_deck_clear_shot:
    enemy_shots = [{"x": 10.75, "y": 2.5, "z": escape_deck_z + 0.8, "vx": 0.25, "vy": 0, "life": 5}]
    call step_escape_shots

action test_deck_enemy_motion:
    player.x = 9.5
    player.y = 9.5
    enemies[0].x = 9.5
    enemies[0].y = 6.5
    enemies[0].cd = 30
    call step_escape_enemies

action test_deck_explosion:
    enemies[0].x = player.x + 1.65
    enemies[0].y = player.y
    enemies[0].hp = 1
    cooldown = 0
    call tick {"right": true, "fire": true}
