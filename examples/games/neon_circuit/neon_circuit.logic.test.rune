    invoke wait_ticks 20
    assert state.player.z == state.escape_deck_z
    invoke load_stage 6
    invoke on_boss_defeated
    invoke wait_ticks 149
    invoke tick {"weapon_wheel":true,"turn_right":true}
    assert state.ui.wheel.active == true
    assert state.camera.angle == 180
    assert state.escape_ticks == 0
    invoke tick {"jump":true}
    assert state.player.z > state.escape_deck_z
    assert state.camera.z > 15.6
    invoke wait_ticks 20
    assert state.player.z == state.escape_deck_z

