    invoke wait_ticks 120
    invoke return_to_core_for_test
    invoke load_stage 0
    invoke on_boss_defeated
    invoke wait_ticks 120
    invoke return_to_core_for_test
    invoke load_stage 6
    invoke tick {"jump": true}
    assert state.jumps == 1
    invoke tick {}
    invoke tick {"jump": true}
    assert state.jumps == 2
    invoke tick {"dash": true}
    assert state.dash_ticks > 0

@Test/NeonCircuit/EscapeAudioBuildsWithCountdown
type = logic
page = neon_circuit
setup:
    invoke initialize
    invoke load_stage 0
run:
    invoke on_boss_defeated
    assert mock.audio contains {"operation":"music.play","args":["nc_boss_victory"]}
    assert mock.audio contains {"operation":"sound.play","args":["nc_glass_raise",null]}
    invoke wait_ticks 110
    assert state.escape_flip_ticks == 35
    invoke tick {}
    assert mock.audio contains {"operation":"sound.play","args":["nc_escape_fall",null]}
    invoke wait_ticks 9
    assert state.music_track == "nc_escape"
    assert state.escape_music_tempo == 132
    assert mock.audio contains {"operation":"sound.play","args":["nc_escape_land",null]}
    assert mock.audio contains {"operation":"music.play","args":["nc_escape",0,0.45]}
    invoke wait_ticks 24
    assert state.escape_next_alarm == 114
    assert mock.audio contains {"operation":"sound.play","args":["nc_escape_alarm",null]}
    invoke wait_ticks 126
    assert state.escape_music_tempo == 135
    assert mock.audio contains {"operation":"music.tempo","args":[135]}
    invoke advance_escape_audio_to_for_test 300
    assert state.escape_ticks == 1950
    assert state.escape_music_tempo == 174
    assert state.escape_next_alarm == 1975
    assert mock.audio contains {"operation":"sound.play","args":["nc_escape_alarm_urgent",null]}
    assert mock.audio contains {"operation":"music.tempo","args":[174]}
    invoke advance_escape_audio_to_for_test 75
    assert state.escape_music_tempo == 189
    assert state.escape_next_alarm == 2190
    invoke expire_deck_timer_for_test
    assert state.music_track == ""
    assert mock.audio contains {"operation":"music.stop","args":[]}
    invoke retry_escape
    assert state.escape_music_tempo == 132
    assert state.escape_next_alarm == 24
    assert state.music_track == "nc_escape"

@Test/NeonCircuit/MasterEscapeZoomsIntoAxel
type = logic
page = neon_circuit
setup:
    invoke initialize
    invoke load_stage 6
run:
    invoke on_boss_defeated
    invoke wait_ticks 120
    assert state.status == "escape_zoom"
    assert state.camera.pitch == -85
    assert state.avatar.visible == true
    assert state.music_track == "nc_escape"
    invoke wait_ticks 16
    assert state.camera.z < 23
    assert state.ui.cinema.fade > 0
    assert state.escape_first_person == false
    invoke wait_ticks 4
    assert state.ui.cinema.fade == 1
    assert state.escape_first_person == true
    assert state.avatar.visible == false
    assert state.camera.x == state.player.x
    assert state.camera.y == state.player.y
    assert state.camera.angle == 180
    invoke wait_ticks 9
    assert state.status == "playing"
    assert state.escape_ticks == 0
    assert state.ui.reticle == true
    assert state.view_weapon.sprite == "nc/return_buster"
    invoke tick {"aim_up": true, "fire": true}
    assert state.camera.x < state.escape_entry_x
    assert state.camera.x == state.player.x
    assert state.camera.angle == 180
    assert state.shots[0].vx < 0
    invoke tick {"left": true}
    assert state.player.y > 2.5
    invoke tick {"turn_right": true}
    assert state.camera.angle == 185
    invoke expire_deck_timer_for_test
    assert state.status == "escape_retry"
    invoke retry_escape
    assert state.camera.angle == 180
    assert state.escape_first_person == true
    assert state.avatar.visible == false
    invoke return_to_core_for_test
    assert state.status == "boss_victory"
    assert state.avatar.visible == true
    assert state.camera.pitch == -85
    assert state.view_weapon == null

@Test/NeonCircuit/EscapeWheelAndJumpInBothViews
type = logic
page = neon_circuit
setup:
