#!RUNE
import "neon_circuit.rune"

@Test/NeonCircuit/TitleAndStageSelectorHints
type = logic
page = neon_circuit
run:
    invoke initialize
    assert state.status == "title"
    assert state.title_lights.length == 4
    assert state.stages.length == 12
    invoke advance
    assert state.status == "select"
    assert state.lights[2].color == "#20e9ff"
    assert state.ui.grid.items.length == 12
    assert state.selected_title == "01 VOLT VIPER"
    assert state.selected_hint == "INTRO UNIT - UNLOCKS: VOLT SURGE (AIR DASH + RELAY CHARGE)"
    invoke pick_stage 6
    assert state.selected_title == "07 STORM VALKYRIE"
    assert state.lights[2].color == "#ffdb64"
    assert state.selected_hint == "NEEDS: VOLT SURGE + MAG CLAW (RELAY + AIR DASH + DOUBLE JUMP)"
    invoke pick_stage 11
    assert state.selected_title == "12 OMEGA OVERLORD"
    assert state.selected_hint == "NEEDS: ALL 6 INTRO SKILLS (VOLT, CRYO, MAG, NOVA, PHASE, SAW)"

@Test/NeonCircuit/AllTwelveSideMapLevelsLoad
type = logic
page = neon_circuit
setup:
    invoke initialize
run:
    invoke load_stage 0
    assert state.status == "playing"
    assert state.world.storage == "chunked"
    assert state.lights.length == 8
    invoke sample_walkway_for_test
    assert state.walkway_materials == [1,11,11,1]
    assert state.level_width == 120
    assert state.boss_entity.alive == true
    assert state.ui.wheel.items.length == 7
    assert state.ui.slots.length == 0
    invoke load_stage 1
    assert state.level_map == "sky_02"
    invoke load_stage 2
    assert state.level_map == "sky_03"
    invoke load_stage 3
    assert state.level_map == "sky_04"
    invoke load_stage 4
    assert state.level_map == "sky_05"
    invoke load_stage 5
    assert state.level_map == "sky_06"
    invoke load_stage 6
    assert state.barriers.length > 0
    invoke load_stage 7
    assert state.hazards.length > 0
    invoke load_stage 8
    assert state.barriers.length > 0
    invoke load_stage 9
    assert state.barriers.length > 0
    invoke load_stage 10
    assert state.barriers.length > 0
    assert state.hazards.length > 0
    invoke load_stage 11
    assert state.barriers.length > 0
    assert state.hazards.length > 0

@Test/NeonCircuit/BossDeathAnimationAndVictoryCeremony
type = logic
page = neon_circuit
setup:
    invoke initialize
    invoke load_stage 0
run:
    assert state.campaign.weapons.volt == false
    invoke place_boss_for_death_test
    invoke on_boss_defeated
    assert state.status == "boss_dying"
    assert state.music_track == "nc_boss_victory"
    assert state.campaign.defeated["01"] == false
    assert state.campaign.weapons.volt == false
    assert state.effects.length > 0
    invoke tick {}
    assert state.boss_entity.dissolve > 0
    invoke wait_ticks 35
    assert state.status == "boss_dying"
    assert state.boss_entity.x == state.boss_death_spot_for_test
    assert state.escape_floor[4].z > 0
    assert state.escape_floor[4].pitch == -90
    invoke wait_ticks 39
    assert state.status == "escape_flip"
    assert state.camera.terrainPose.angle == 0
    invoke wait_ticks 22
    assert state.status == "escape_flip"
    assert state.camera.terrainPose.angle < -40
    assert state.camera.terrainPose.angle > -45
    assert state.avatar.pitch > 160
    assert state.escape_floor[0].pitch > -90
    assert state.escape_floor[0].pitch < 0
    assert state.avatar.model == "nc/hero_jump"
    invoke wait_ticks 23
    assert state.status == "playing"
    assert state.escape_active == true
    assert state.camera.pitch == -85
    assert state.camera.angle == 270
    assert state.camera.terrainPose.angle == -90
    assert state.avatar.pitch == 0
    assert state.avatar.z == state.escape_deck_z
    assert state.escape_floor[0].pitch == 0
    assert state.escape_floor.length > 0
    assert state.power_capsule.visible == true
    assert state.power_capsule.x == 3.5
    assert state.enemies[0].alive == true
    assert state.enemies[0].z == state.escape_deck_z
    assert state.campaign.weapons.volt == false
    invoke tick {"left": true}
    assert state.player.x < state.escape_entry_x
    assert state.avatar.model == "nc/hero_run0"
    invoke return_to_core_for_test
    assert state.status == "boss_victory"
    assert state.campaign.defeated["01"] == true
    assert state.campaign.weapons.volt == true
    assert state.active_weapon == "volt"
    assert state.power_capsule.model == "nc/power_capsule_open"
    assert state.victory_item.visible == true
    assert state.avatar.model == "nc/hero_victory"
    assert state.ui.panel.title == "VICTORY // VOLT VIPER DEFEATED!"
    invoke finish_boss_victory
    assert state.status == "stage_clear"
    assert state.power_capsule.visible == false
    invoke load_stage 2
    assert state.escape_active == false
    assert state.escape_floor.length == 0
    assert state.defeated_count == 1

@Test/NeonCircuit/GlassDeckMovementAndWallCover
type = logic
page = neon_circuit
setup:
    invoke initialize
    invoke load_stage 0
run:
    invoke test_side_wall_cover
    assert state.enemy_shots.length == 0
    assert state.health == 8
    invoke on_boss_defeated
    invoke wait_ticks 120
    invoke test_deck_wall_cover
    assert state.original_floor_material == state.deck_wall_material
    assert state.deck_wall_material > 0
    assert state.deck_wall_center == 11
    assert state.enemy_shots.length == 0
    assert state.health == 8
    assert state.player.y == 2.35
    invoke test_deck_corner_cover
    assert state.enemy_shots.length == 0
    assert state.health == 8
    invoke test_deck_clear_shot
    assert state.health == 7
    invoke test_deck_enemy_motion
    assert state.enemies[0].y > 6.5
    assert state.enemies[0].x == 9.5
    invoke tick {"duck": true, "fire": true}
    assert state.player.y > 9.5
    assert state.shots[0].vy > 0
    invoke tick {"aim_up": true}
    assert state.player.y == 9.5
    invoke tick {"right": true, "duck": true}
    assert state.escape_angle == 45
    assert state.player.x > 9.5
    assert state.player.y > 9.5
    assert state.player.x < 9.75
    assert state.player.y < 9.75
    invoke tick {"move_x": 0.6, "duck_axis": -0.3}
    assert state.escape_angle > 333
    assert state.escape_angle < 334
    invoke tick {"move_x": 0.6, "move_up": 0.3}
    assert state.escape_angle > 333
    assert state.escape_angle < 334
    invoke test_deck_explosion
    assert state.enemies[0].alive == false
    assert state.effects.length == 17
    assert state.effects[1].y != state.enemies[0].y

@Test/NeonCircuit/EscapeTimeoutRetriesFromTheDeck
type = logic
page = neon_circuit
setup:
    invoke initialize
    invoke load_stage 0
run:
    invoke on_boss_defeated
    invoke wait_ticks 120
    assert state.escape_time_limit == 2250
    assert state.escape_ticks == 0
    assert state.lights[2].color == "#ff2845"
    invoke wait_ticks 20
    assert state.lights[2].intensity < 0.25
    invoke expire_deck_timer_for_test
    assert state.status == "escape_retry"
    assert state.escape_failure == "TIME UP"
    assert state.lives == 2
    assert state.ui.panel.choices[0] == "TRY AGAIN"
    assert state.escape_ticks == 2250
    invoke tick {}
    assert state.escape_ticks == 2250
    invoke advance
    assert state.status == "playing"
    assert state.escape_active == true
    assert state.escape_ticks == 0
    assert state.lives == 2
    assert state.player.x == state.escape_entry_x
    assert state.camera.pitch == -85
    assert state.boss_entity.alive == false
    assert state.enemies[0].alive == true
    assert state.campaign.weapons.volt == false
    invoke expire_deck_timer_for_test
    assert state.lives == 1
    invoke retry_escape
    invoke expire_deck_timer_for_test
    assert state.lives == 0
    assert state.status == "gameover"
    assert state.ui.heading == "GAME OVER"
    assert state.ui.panel.choices[0] == "RETRY SECTOR"
    invoke advance
    assert state.status == "playing"
    assert state.lives == 3
    assert state.escape_active == false
    assert state.boss_entity.alive == true

@Test/NeonCircuit/MagDoubleJumpAndVoltDash
