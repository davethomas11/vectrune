# COSMO — a monster with idle, step, punch and duck poses.
@Palette/cosmo
colors = {
    ".": "transparent",
    "a": "#f8da94",
    "b": "#7a69a8",
    "d": "#40386d",
    "e": "#a8fff0",
    "h": "#d5b8ef",
    "k": "#182540"
}

