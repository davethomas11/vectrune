# SLIME — a monster with idle, step, punch and duck poses.
@Palette/slime
colors = {
    ".": "transparent",
    "a": "#efffbd",
    "b": "#5bc8c5",
    "d": "#2b7385",
    "e": "#fff0aa",
    "h": "#b8f4df",
    "k": "#183844"
}

