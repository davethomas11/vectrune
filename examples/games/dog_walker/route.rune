@Logic/dog_walker
action lay_route:
    street = []
    properties = []
    spots = []
    walkers = []
    chase_signs = []
    street.push({"x": -24, "y": 0, "model": "walk/road"})
    street.push({"x": -12, "y": 0, "model": "walk/road"})
    for block in range(0,9):
        street.push({"x": block * 12, "y": 0, "model": "walk/road"})
        street.push({"x": block * 12 + 2, "y": 0, "z": -0.08, "model": "walk/stripe"})
        street.push({"x": block * 12 + 8, "y": 0, "z": -0.08, "model": "walk/stripe"})
        for side in [-1,1]:
            address = block*12+(side > 0 ? 6 : 3)
            properties.push(
                {
                    "x": address,
                    "y": side * 9.9,
                    "angle": side < 0 ? 180: 0,
                    "model": block % 2 == 0 ? "walk/house": "walk/bungalow"
                }
            )
            properties.push({"x": address + 4.1, "y": side * (block % 2 == 0 ? 7.7: 12.2), "model": "walk/tree"})
    for i in range(0,12):
        side = i % 2 == 0 ? 1 : -1
        lawn = i % 3 == 2 || i == 4 || i == 6 || i == 9 || i == 10
        curb = 8+i*8.05
        spots.push(
            {
                "x": curb,
                "y": side * (lawn ? 6.35: 3.3),
                "kind": lawn ? "lawn": "hydrant",
                "used": false,
                "model": lawn ? "walk/lawn_spot": "walk/hydrant"
            }
        )
        walkers.push(
            {
                "x": curb + 1.65,
                "y": side * 8.9,
                "home_x": curb + 1.65,
                "home_y": side * 8.9,
                "angle": 0,
                "timer": 0,
                "reveal": 0,
                "visible": false,
                "model": "walk/neighbor"
            }
        )
        chase_signs.push({"x": curb, "y": 0, "z": 2, "visible": false, "model": "walk/alert"})
    for block in range(0,9):
        spots.push(
            {
                "x": block * 12 + 1,
                "y": block % 2 == 0 ? 4.8: -4.8,
                "kind": "lamp",
                "used": false,
                "model": "walk/lamp"
            }
        )
    street.push({"x": park_x, "y": 0, "model": "walk/park"})
    properties.push({"x": park_x, "y": 0, "model": "walk/gate"})
    properties.push({"x": park_x + 8, "y": -8.2, "model": "walk/tree"})
    properties.push({"x": park_x + 22, "y": 8.6, "model": "walk/tree"})
    properties.push({"x": park_x + 18, "y": -8.6, "model": "walk/lamp"})
    targets = []
    for lane in [-4,0,4]:
        targets.push({"x": park_x + 17, "y": lane, "model": "walk/park_ring"})
