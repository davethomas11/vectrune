@Logic/crypt
state:
    music_track = ""

action play_score(track):
    music.stop
    music_track = track
    music.play track

# Original minor-key title melody, with a gentle pulse beneath the class menu.
@Music/crypt_title
type = 8bit
tempo = 84
time_signature = 4/4
bars = 4
loop = true
volume = 0.07
lead:
    A4:4 E5:8 D5:8 C5:4 B4:4 |
    G4:4 B4:8 D5:8 E5:4 D5:4 |
    F4:4 A4:8 C5:8 E5:4 C5:4 |
    E4:4 G#4:4 B4:4 A4:4
bass:
    A2:2 E3:2 |
    G2:2 D3:2 |
    F2:2 C3:2 |
    E2:2 A2:2
drums:
    kick:4 -:4 hihat:4 -:4 |
    kick:4 -:4 hihat:4 -:4 |
    kick:4 -:4 hihat:4 -:4 |
    kick:4 hihat:4 -:4 -:4

