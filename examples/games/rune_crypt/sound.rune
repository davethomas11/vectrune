@Sound/sword
wave = noise
filter = lowpass 1600 -> 120
duration = 120ms
volume = 0.2

@Sound/rune
wave = triangle
sequence = E5:50ms, B5:50ms, E6:80ms
volume = 0.2

@Sound/shard
wave = sine
sequence = A5:50ms, E6:70ms
volume = 0.15

@Sound/warning
wave = square
sequence = D4:60ms, A4:100ms
volume = 0.1

@Sound/dodge
wave = noise
filter = lowpass 900 -> 100
duration = 100ms
volume = 0.1

@Sound/secret
wave = triangle
sequence = C5:70ms, G5:70ms, C6:160ms
volume = 0.15

@Sound/blessing
wave = triangle
sequence = C5:80ms, E5:80ms, G5:140ms
volume = 0.15

@Sound/hurt
wave = sawtooth
sequence = A2:60ms, E2:60ms
volume = 0.15
