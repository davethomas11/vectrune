# Coordinates are [x, y, z]; z points up. Four solid steps rise along local +y.
# One unit is a quarter tile; the footprint is centered on the instance.
@Model/world/stairs
palette = crypt
unit = 0.25
blocks:
    {"from":[-2,-2,0],"size":[4,1,1],"color":"s"}
    {"from":[-2,-1,0],"size":[4,1,2],"color":"l"}
    {"from":[-2,0,0],"size":[4,1,3],"color":"s"}
    {"from":[-2,1,0],"size":[4,1,4],"color":"l"}

