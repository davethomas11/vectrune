@Logic/beyond
action blank_world:
    world = {
        "width": 48,
        "height": 40,
        "depth": 20,
        "seed": 2702,
        "biome": "meadow",
        "materials": [
            "beyond/moss",
            "beyond/stone",
            "beyond/kiln",
            "beyond/tide",
            "beyond/storm",
            "beyond/gold",
            "beyond/canopy",
            "beyond/aurora",
            "beyond/emberglass",
            "beyond/soil",
            "beyond/kiln_wall",
            "beyond/moonstone",
            "beyond/bark",
            "beyond/ice_cliff",
            "beyond/glassbrick",
            "beyond/stormstone"
        ],
        "cells": [],
        "spawn": player
    }
    world = voxel_world(
        world.width,
        world.height,
        world.depth,
        world.materials,
        {"seed": world.seed, "biome": world.biome, "spawn": world.spawn, "renderDistance": 128}
    )

action island(x, y, width, height, top, material):
    # Match the island's exposed lower course to its surface biome.
    base = material == 1
        ? 10
        : (material == 3 ? 11: (material == 4 ? 12: (material == 7 ? 13: (material == 8 ? 14: (material == 9 ? 15: (material == 5 ? 16: 2))))))
    if width >= 5 && height >= 5 && top >= 4:
        world = voxel_fill(world, [x+1, y+1, top-3], [width-2, height-2, 1], base)
    world = voxel_fill(world, [x, y, top-2], [width, height, 1], base)
    world = voxel_fill(world, [x, y, top-1], [width, height, 1], material)

action seed(x, y, z):
    seeds.push(
        {
            "x": x,
            "y": y,
            "z": z + 0.45,
            "base": z + 0.45,
            "model": "beyond/seed",
            "angle": 0,
            "visible": true
        }
    )

action build_level:
    call blank_world
    seeds = []
    seeds = entity_group(seeds)
    scenery = []
    scenery = entity_group(scenery)
    enemies = entity_group()
    boss.visible = false
    boss_hp = 0
    goal.visible = !stages[selected].boss
