    "...kkk..."
    "..kyyyk.."
    ".kykkkyk."
    "kyyyyyyyk"
    "kyk+k+kyk"
    "kyk+++kyk"
    "kyk+++kyk"
    "kyyyyyyyk"
    ".kkyyykk."
