# Map sections supply the sky. The traversable terrain is built as voxels below.
@Map/cinder
sky = {"seed":861,"zenith":"#261d49","horizon":"#d77350","cloud":"#fbb176","speed":0.23}
legend = {".":{}}
grid:
    "."

@Map/glass
sky = {"seed":261,"zenith":"#12244b","horizon":"#547caf","cloud":"#91d7dc","speed":0.13}
legend = {".":{}}
grid:
    "."

@Map/tempest
sky = {"seed":4487,"zenith":"#12152f","horizon":"#6b4274","cloud":"#b07aae","speed":0.72}
legend = {".":{}}
grid:
    "."

@Logic/signal_run
action load_mission:
    flying = false
    boarding_point = {"x":2.5,"y":11.65,"z":2}
    player = {"x":boarding_point.x,"y":boarding_point.y,"z":boarding_point.z,"angle":0,"pitch":0,"vz":0}
    if mission == 1:
        level_map = "cinder"
        planet = "CINDER / MINING COLONY"
        briefing = "The colony went quiet. Its beacon says EVACUATION COMPLETE.|Lumen: 'Then why is somebody still knocking?'|Cross the trench bridge and climb to the amber mining beacon."
        job = "Recover the flight log"
        recovered = "Nobody evacuated. The blockade forged the log."
        relay = {"x":34.5,"y":8.5,"z":5,"model":"signal/beacon"}
        drones = [{"x":7.5,"y":8.5,"z":2.55,"hp":2,"phase":38},{"x":14.5,"y":3.5,"z":3.65,"hp":2,"phase":45},{"x":19.5,"y":10.5,"z":5.6,"hp":2,"phase":52},{"x":28.5,"y":8.5,"z":5.55,"hp":2,"phase":48},{"x":32.5,"y":12.5,"z":5.65,"hp":2,"phase":64}]
        repairs = [{"x":7.5,"y":10.5,"z":2},{"x":13.5,"y":8.5,"z":2},{"x":24.5,"y":8.5,"z":5}]
        call build_cinder
    if mission == 2:
        level_map = "glass"
        planet = "GLASS / ICE ARCHIVE"
        briefing = "The missing miners are alive. The blockade hid their distress calls.|Their real transmission is in the ice archive's upper gallery.|Take the glowing stairs or explore the service tunnel beneath."
        job = "Recover the distress signal"
        recovered = "I hear them. Take me to Tempest and I can open a route."
        relay = {"x":34.5,"y":8.5,"z":5,"model":"signal/beacon"}
        drones = [{"x":8.5,"y":8.8,"z":6.05,"hp":2,"phase":40},{"x":13.5,"y":8.5,"z":2.35,"hp":2,"phase":30},{"x":16.5,"y":9,"z":6.2,"hp":3,"phase":54},{"x":26.5,"y":8.5,"z":5.45,"hp":2,"phase":51},{"x":31.5,"y":12.5,"z":2.55,"hp":2,"phase":62}]
        repairs = [{"x":10.5,"y":10.5,"z":2},{"x":15.5,"y":7.5,"z":5},{"x":24.5,"y":8.5,"z":5}]
        call build_glass
    if mission == 3:
        level_map = "tempest"
        planet = "TEMPEST / ORBITAL RELAY"
        briefing = "The Warden guards the blockade's last relay above the storm basin.|Lumen: 'Give me one open channel. I'll guide every ship out.'|Climb the causeway, disable the Warden and transmit the signal."
        job = "Disable the Relay Warden"
        recovered = "The corridor is open. Colony ships are lifting off!"
        relay = {"x":34.5,"y":8.5,"z":6,"model":"signal/beacon"}
        drones = [{"x":9.5,"y":5.5,"z":2.8,"hp":2,"phase":35},{"x":11.5,"y":13.5,"z":3.3,"hp":2,"phase":48},{"x":24.5,"y":12.5,"z":6.6,"hp":2,"phase":58},{"x":29.5,"y":8.85,"z":6.7,"hp":8,"phase":55,"warden":true}]
        repairs = [{"x":8.5,"y":10.5,"z":2},{"x":13.5,"y":9.5,"z":3},{"x":19.5,"y":5.5,"z":6},{"x":25.5,"y":8.5,"z":6}]
        call build_tempest
    shuttle = {"x":2.5,"y":8.5,"z":2,"angle":270,"model":"signal/shuttle"}
    landmarks = [relay, shuttle]
    call prepare_drones
    for pack in repairs:
        pack.model = "signal/repair"
        pack.visible = true
    bolts = []
    tracers = []
    shield = 100
    energy = 8
    recharge = 0
    fire_delay = 0
    hit_grace = 0
    flash = 0
    clock = 0
    notice_ticks = 0
    notice = ""
    claimed = false
    warden_down = false
    use_held = false
    jump_held = false
    weapon = {"sprite":"signal/blaster","bob":0,"x":38,"y":4}

# Each volume has two walkable head-height layers, with 1-based material IDs.
action build_world(ground, rock):
    world = voxel_world(38, 25, 15, [ground, rock, "signal/panel", "signal/deck", "signal/stripe"], {"renderDistance":46})
    world = voxel_fill(world, [0,0,0], [38,25,2], 1)
    world = voxel_fill(world, [0,0,2], [38,1,2], 2)
    world = voxel_fill(world, [0,24,2], [38,1,2], 2)
    world = voxel_fill(world, [0,1,2], [1,23,2], 2)
    world = voxel_fill(world, [37,1,2], [1,23,2], 2)
    world = voxel_fill(world, [1,7,1], [4,6,1], 4)
    for y in [7,12]:
        world = voxel_fill(world, [1,y,1], [4,1,1], 5)

action build_cinder:
    call build_world "signal/dust", "signal/basalt"
    # The trench runs underneath the bridge. The eastern terraces lead to a ledge.
    world = voxel_fill(world, [9,1,1], [4,23,1], 0)
    world = voxel_fill(world, [9,7,1], [4,3,1], 4)
    world = voxel_fill(world, [9,7,2], [4,1,1], 5)
    world = voxel_fill(world, [9,9,2], [4,1,1], 5)
    world = voxel_fill(world, [5,4,2], [3,2,3], 3)
    world = voxel_fill(world, [5,11,2], [2,3,2], 2)
    world = voxel_fill(world, [14,5,2], [2,2,2], 2)
    world = voxel_fill(world, [17,4,2], [6,9,3], 2)
    world = voxel_fill(world, [17,7,4], [6,3,1], 4)
    call stairs 14, 7, 3, 3
    world = voxel_fill(world, [21,5,5], [1,2,3], 3)
    world = voxel_fill(world, [21,11,5], [1,1,3], 3)
    # Beyond the ledge, a broad smelting yard has a lower service ramp and cover.
    world = voxel_fill(world, [23,4,2], [13,12,3], 2)
    world = voxel_fill(world, [23,7,4], [13,4,1], 4)
    world = voxel_fill(world, [25,6,5], [2,1,3], 3)
    world = voxel_fill(world, [28,10,5], [1,3,2], 3)
    world = voxel_fill(world, [32,5,5], [2,2,4], 3)
    world = voxel_fill(world, [24,16,2], [4,1,3], 3)
    world = voxel_fill(world, [24,17,2], [4,1,2], 3)
    world = voxel_fill(world, [24,18,2], [4,1,1], 5)
    world = voxel_fill(world, [16,16,2], [3,4,3], 2)

action build_glass:
    call build_world "signal/ice", "signal/ice_wall"
    # An elevated deck crosses the same x/y cells as the lower service route.
    world = voxel_fill(world, [7,7,4], [13,4,1], 4)
    world = voxel_fill(world, [20,5,4], [3,7,1], 4)
    world = voxel_fill(world, [7,7,5], [13,1,1], 5)
    world = voxel_fill(world, [7,10,5], [13,1,1], 5)
    call stairs 4, 8, 2, 3
    # A second stair behind the gallery joins the ground route at its far end.
    world = voxel_fill(world, [20,12,2], [3,1,3], 3)
    world = voxel_fill(world, [20,13,2], [3,1,2], 3)
    world = voxel_fill(world, [20,14,2], [3,1,1], 5)
    for x in [8,13,18]:
        world = voxel_fill(world, [x,6,2], [1,1,7], 3)
        world = voxel_fill(world, [x,11,2], [1,1,7], 3)
    world = voxel_fill(world, [7,6,9], [16,6,1], 4)
    world = voxel_fill(world, [11,8,9], [3,2,1], 0)
    world = voxel_fill(world, [8,3,2], [8,2,3], 2)
    world = voxel_fill(world, [9,13,2], [6,2,2], 2)
    world = voxel_fill(world, [23,7,4], [13,4,1], 4)
    world = voxel_fill(world, [31,5,4], [5,3,1], 4)
    world = voxel_fill(world, [31,11,4], [5,3,1], 4)
    for x in [24,29,35]:
        world = voxel_fill(world, [x,6,2], [1,1,7], 3)
        world = voxel_fill(world, [x,11,2], [1,1,7], 3)
    world = voxel_fill(world, [23,6,9], [13,6,1], 4)
    world = voxel_fill(world, [26,6,9], [3,4,1], 0)
    world = voxel_fill(world, [32,14,2], [4,1,3], 3)
    world = voxel_fill(world, [32,15,2], [4,1,2], 3)
    world = voxel_fill(world, [32,16,2], [4,1,1], 5)
    world = voxel_fill(world, [24,15,2], [4,2,2], 2)

action build_tempest:
    call build_world "signal/storm_floor", "signal/storm_wall"
    world = voxel_fill(world, [6,4,2], [2,2,2], 2)
    world = voxel_fill(world, [9,11,2], [2,2,1], 3)
    world = voxel_fill(world, [17,4,2], [6,9,4], 3)
    world = voxel_fill(world, [17,4,5], [6,9,1], 4)
    call stairs 13, 7, 3, 4
    for y in [4,12]:
        world = voxel_fill(world, [17,y,6], [1,1,4], 2)
        world = voxel_fill(world, [22,y,6], [1,1,5], 3)
        world = voxel_fill(world, [17,y,10], [6,1,1], 4)
    world = voxel_fill(world, [22,5,6], [1,2,2], 5)
    world = voxel_fill(world, [23,5,2], [13,10,4], 3)
    world = voxel_fill(world, [23,5,5], [13,10,1], 4)
    world = voxel_fill(world, [25,5,6], [2,2,4], 2)
    world = voxel_fill(world, [27,11,6], [2,2,3], 3)
    world = voxel_fill(world, [31,5,6], [2,2,4], 2)
    world = voxel_fill(world, [33,11,6], [1,2,4], 3)
    world = voxel_fill(world, [25,14,6], [10,1,1], 5)
    world = voxel_fill(world, [28,17,2], [5,4,3], 2)
    world = voxel_fill(world, [11,4,2], [1,2,3], 2)
    world = voxel_fill(world, [11,10,2], [1,1,3], 2)

action stairs(x, y, width, count):
    for step in range(0, count):
        world = voxel_fill(world, [x + step,y,2], [1,width,step + 1], 3)
        world = voxel_fill(world, [x + step,y,step + 2], [1,width,1], 5)
