#!RUNE
import "signal_run.rune"

# Position the pilot at objectives to test the campaign independently of input timing.
@Logic/signal_run
action land_for_test:
    call advance
    call reach_landing_gate
    call advance

action reach_landing_gate:
    gate_index = gates.length - 1
    gate = gates[gate_index]
    player.x = gate.x
    player.y = gate.y
    player.z = gate.z - 1.25
    call tick {"use":true}

action at_beacon:
    player.x = relay.x - 0.75
    player.y = relay.y
    player.z = relay.z
    player.vz = 0
    player.angle = 0
    player.pitch = 0

action at_shuttle:
    player.x = boarding_point.x
    player.y = boarding_point.y
    player.z = boarding_point.z
    player.vz = 0
    player.angle = 180
    player.pitch = 0

action face_first_drone:
    player.x = 3.5
    player.y = 8.5
    player.angle = 0

action align_to_warden:
    boss = drones[drones.length - 1]
    player.x = boss.x - 2
    player.y = boss.y
    player.z = 6
    player.angle = 0
    player.pitch = atan2(boss.z + boss.scale * 0.54 - player.z - 1.25, 2)

action deplete_suit:
    shield = 1
    bolts = [{"x":player.x,"y":player.y,"z":player.z + 1,"vx":0,"vy":0,"vz":0,"damage":12,"life":2,"visible":true}]

@Test/SignalRun/LandingAndFirstPulse
type = logic
page = signal_run
run:
    assert state.status == "title"
    invoke advance
    assert state.status == "story"
    invoke advance
    assert state.status == "intro"
    assert state.flying == true
    invoke land_for_test
    assert state.status == "playing"
    assert state.level_map == "cinder"
    invoke face_first_drone
    invoke tick {"forward":true,"fire":true}
    assert state.player.x > 3.5
    assert state.energy == 7
    assert state.drones[0].hp == 1
    invoke tick {"fire":true}
    assert state.energy == 7

@Test/SignalRun/SignalsUnlockThreePlanetRoute
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
    invoke land_for_test
run:
    invoke at_shuttle
    invoke tick {"use":true}
    assert state.mission == 1
    invoke at_beacon
    invoke tick {"use":true}
    assert state.claimed == false
    invoke tick
    invoke tick {"use":true}
    assert state.claimed == true
    invoke at_shuttle
    invoke tick
    invoke tick {"use":true}
    assert state.status == "departing"
    invoke advance
    assert state.level_map == "signal_space"
    assert state.mission == 2
    assert state.status == "story"
    invoke advance
    invoke land_for_test
    invoke at_beacon
    invoke tick {"use":true}
    assert state.claimed == true
    invoke at_shuttle
    invoke tick
    invoke tick {"use":true}
    assert state.status == "departing"
    invoke advance
    assert state.level_map == "signal_space"
    assert state.mission == 3
    invoke advance
    invoke land_for_test
    invoke at_beacon
    invoke tick {"use":true}
    assert state.claimed == false
    invoke align_to_warden
    invoke fire_pulse
    invoke fire_pulse
    invoke fire_pulse
    invoke fire_pulse
    invoke fire_pulse
    invoke fire_pulse
    invoke fire_pulse
    invoke fire_pulse
    assert state.drones[3].hp == 0
    assert state.warden_down == true
    assert state.energy == 0
    invoke at_beacon
    invoke tick
    invoke tick {"use":true}
    assert state.claimed == true
    invoke at_shuttle
    invoke tick
    invoke tick {"use":true}
    assert state.status == "departing"
    invoke advance
    assert state.status == "won"
    invoke advance
    assert state.level_map == "signal_space"
    assert state.mission == 1
    assert state.status == "title"

@Test/SignalRun/RetryKeepsTheCurrentPlanet
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
    invoke land_for_test
    invoke at_beacon
    invoke tick {"use":true}
    invoke at_shuttle
    invoke tick
    invoke tick {"use":true}
    invoke advance
    invoke advance
    invoke land_for_test
run:
    invoke deplete_suit
    invoke tick
    assert state.status == "gameover"
    invoke advance
    assert state.status == "playing"
    assert state.level_map == "glass"
    assert state.shield == 100
    assert state.energy == 8
    assert state.claimed == false
    assert state.bolts.length == 0


@Logic/signal_run
action enter_archive:
    mission = 2
    call load_mission
    player.x = 3.5
    player.y = 8.5

action below_gallery:
    player.x = 10.5
    player.y = 8.5
    player.z = 2
    player.vz = 0

action check_deck_cover:
    call trace_clear {"x":10.5,"y":8.5,"z":3.25}, {"x":10.5,"y":8.5,"z":6.1}

action walk_east(frames):
    for frame in range(0, frames):
        call tick {"forward":true}

@Test/SignalRun/MousePitchAndJump
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
    invoke land_for_test
run:
    invoke tick {"look_x":75,"look_y":-50}
    assert state.player.angle == 12
    assert state.player.pitch == 8
    invoke tick {"look_y":-10000,"jump":true}
    assert state.player.pitch == 70
    assert state.player.z > 2.3

@Test/SignalRun/ArchiveHasTwoWalkableFloors
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
    invoke land_for_test
    invoke enter_archive
run:
    invoke walk_east 44
    assert state.player.x > 8.5
    assert state.player.z == 5
    invoke below_gallery
    invoke walk_east 20
    assert state.player.x > 12.5
    assert state.player.z == 2
    invoke check_deck_cover
    assert state.line_clear == false


@Logic/signal_run
action dock_wall_test:
    player.x = 0.8
    player.y = 26
    player.z = 12.5
    ship_speed = -0.4
    call tick {"back":true}

action elapse(frames):
    for frame in range(0, frames):
        call tick {}

action drone_floor_test:
    test_drone = drones[0]
    call check_space test_drone.x, test_drone.y, 1.8, 0.68, 0.9

@Test/SignalRun/FlightGatesAndHull
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
run:
    assert state.flying == true
    assert state.gate_index == 0
    invoke elapse 81
    assert state.status == "playing"
    assert state.gate_index == 1
    invoke tick {"use":true}
    assert state.flying == true
    invoke dock_wall_test
    assert state.ship_blocked == true
    assert state.shield == 90
    invoke damage_pilot 90
    assert state.status == "gameover"
    invoke advance
    assert state.status == "intro"
    assert state.cinema_kind == "launch"

@Test/SignalRun/DronesMoveAndDissolve
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
    invoke land_for_test
run:
    invoke face_first_drone
    invoke tick {"fire":true}
    assert state.tracers.length > 0
    assert state.drones[0].x < 7.5
    invoke fire_pulse
    invoke tick
    assert state.drones[0].hp == 0
    assert state.drones[0].visible == true
    assert state.drones[0].death > 0
    invoke drone_floor_test
    assert state.space_clear == false
    invoke elapse 24
    assert state.drones[0].visible == false
    assert state.drones[0].z >= 2


@Logic/signal_run
state:
    blocked_spawns = 0

action verify_spawns:
    blocked_spawns = 0
    for map_number in range(1, 4):
        mission = map_number
        call load_flight
        call count_blocked_drones
        call load_mission
        call count_blocked_drones

action count_blocked_drones:
    for drone in drones:
        call check_space drone.x, drone.y, drone.z, drone.radius, drone.height
        if !space_clear:
            blocked_spawns += 1

@Test/SignalRun/DroneBodiesSpawnInOpenSpace
type = logic
page = signal_run
run:
    invoke verify_spawns
    assert state.blocked_spawns == 0


@Test/SignalRun/LandingMovesFromOrbitToSurface
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
    invoke advance
    invoke reach_landing_gate
run:
    assert state.status == "landing"
    assert state.level_map == "signal_space"
    assert state.cinema_caption == "ORBIT / PLANETARY APPROACH"
    assert state.view_camera.x > 60
    invoke tick {"forward":true,"fire":true}
    assert state.energy == 8
    assert state.player.x == 74
    invoke elapse 39
    assert state.level_map == "cinder"
    assert state.cinema_caption == "ATMOSPHERIC ENTRY"
    assert state.view_camera.x < 30
    assert state.shuttle.visible == false
    invoke elapse 80
    assert state.cinema_caption == "TOUCHDOWN"
    assert state.view_camera.x < 2
    assert state.cinema_ship.z < 2.75
    invoke elapse 22
    assert state.status == "landing"
    assert state.cinema_caption == "HATCH OPENING"
    assert state.cinema_ship.model == "signal/shuttle_open"
    invoke elapse 45
    assert state.cinema_caption == "PILOT DISEMBARKING"
    assert state.cinema_ramp.scale == 1
    assert state.cinema_pilot.visible == true
    assert state.cinema_pilot.y > 10
    assert state.cinema_pilot.z > 2
    invoke elapse 30
    assert state.cinema_pilot.y == state.boarding_point.y
    assert state.cinema_pilot.z == 2
    assert state.cinema_pilot.model == "signal/pilot_idle"
    invoke elapse 25
    assert state.status == "playing"
    assert state.shuttle.visible == true
    assert state.cinema_objects.length == 0
    assert state.view_camera.x == state.player.x
    assert state.player.x == state.cinema_pilot.x
    assert state.player.y == state.cinema_pilot.y
    assert state.player.angle == state.cinema_pilot.angle
    assert state.view_weapon.sprite == "signal/blaster"

@Test/SignalRun/DepartureLiftsOffBeforeAdvancing
type = logic
page = signal_run
setup:
    invoke advance
    invoke advance
    invoke land_for_test
    invoke at_beacon
    invoke tick {"use":true}
    invoke at_shuttle
    invoke tick
    invoke tick {"use":true}
run:
    assert state.status == "departing"
    assert state.cinema_ship.z == 2
    assert state.cinema_pilot.visible == true
    assert state.cinema_pilot.y == state.boarding_point.y
    invoke elapse 52
    assert state.cinema_ramp.scale == 1
    assert state.cinema_ship.z == 2
    assert state.cinema_pilot.z > 2
    assert state.cinema_pilot.y < 11
    invoke elapse 40
    assert state.cinema_pilot.visible == false
    assert state.cinema_ramp.visible == false
    assert state.cinema_ship.z == 2
    invoke elapse 50
    assert state.status == "departing"
    assert state.cinema_caption == "ASCENDING TO ORBIT"
    assert state.cinema_ship.z > 5
    assert state.cinema_ship.model == "signal/shuttle"
    invoke elapse 49
    assert state.view_camera.y < 25
    assert state.view_camera.z < 13.75
    invoke tick
    assert state.status == "story"
    assert state.mission == 2
    assert state.level_map == "signal_space"
