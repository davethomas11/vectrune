# E1M1: Sector 01 - Perimeter Infiltration
# Legend: # = panel wall, T = tech wall, S = switch, X = exit, . = floor
@Map/e1m1
floor = "#1b1918"
ceiling = "#121417"
legend = {"#":{"wall":"wall/panel"},"T":{"wall":"wall/tech"},"S":{"wall":"wall/switch"},"X":{"wall":"wall/exit"},".":{}}
grid:
    "################"
    "#......#.......#"
    "#..##..#...##..#"
    "#..#.......#...#"
    "#..#...S...#...#"
    "#......#...#...#"
    "#..##..#...##..#"
    "#......#.......X"
    "################"

# E1M2: Sector 02 - The Reactor Core
# Legend: # = reactor wall, T = tech wall, S = switch, X = exit, . = floor
@Map/e1m2
floor = "#1c120c"
ceiling = "#0d1014"
legend = {"#":{"wall":"wall/reactor"},"T":{"wall":"wall/tech"},"S":{"wall":"wall/switch"},"X":{"wall":"wall/exit"},".":{}}
grid:
    "################"
    "#......#...T...S"
    "#..##..#...#...#"
    "#..#...#...#...#"
    "#..#...##.##...#"
    "#..#.......#...#"
    "#..####.####...#"
    "X......#.......#"
    "################"

# E1M3: Sector 03 - The Command Vault
# Legend: # = command bulkhead, T = panel wall, S = switch, X = exit, . = floor
@Map/e1m3
floor = "#0d1622"
ceiling = "#070c12"
legend = {"#":{"wall":"wall/command"},"T":{"wall":"wall/panel"},"S":{"wall":"wall/switch"},"X":{"wall":"wall/exit"},".":{}}
grid:
    "################"
    "#......##......#"
    "#.####.##.####.#"
    "#.#..........#.#"
    "#.#...T..S...#.#"
    "#.#..........#.#"
    "#.####....####.#"
    "#......##......X"
    "################"

