#!VECT
# Bake shaded cuboid models into five poses and eight directional views.
# Run from any directory: vectrune /path/to/generate_guards.vect
# Angles use Rune degrees; output paths resolve beside this script.
W = 32
H = 48
colors = {"armor":[83,111,128],"dark":[32,46,59],"helmet":[72,116,80],"visor":[107,242,210],"gun":[45,52,62],"hot":[255,178,57],"pain":[221,78,57]}
chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
palette = {".":"transparent"}
lookup = {}
count = 0
# Preserve the original baker's ties-to-even color quantization explicitly.
action round_even(value):
    base = floor(value)
    if value - base == 0.5:
        return base + base % 2
    return round(value)

for name in keys(colors):
    rgb = colors[name]
    for light, side in [1, 0.65, 0.82, 0.52, 1.2, 0.45]:
        char = chars[count]
        count += 1
        lookup[name + "/" + side] = char
        color = "#"
        for component in rgb:
            color += hex(min(255, round_even(component * light)), 2)
        palette[char] = color

faces = [
    [1,3,7,5],
    [0,4,6,2],
    [2,6,7,3],
    [0,1,5,4],
    [4,5,7,6],
    [0,2,3,1],
]

# center X/Y/Z, half extents X/Y/Z, material. Feet plant on the floor.
action render(pose, direction):
    ca = cos(direction * 45)
    sa = sin(direction * 45)
    canvas = repeat(".", W * H)
    depth = repeat(-1e9, W * H)
    stride = pose == "walk0" ? 0.085 : (pose == "walk1" ? -0.085 : 0)
    armor = pose == "pain" ? "pain" : "armor"
    boxes = [
        [stride,-0.14,0.08,0.16,0.095,0.08,"dark"],
        [-stride,0.14,0.08,0.16,0.095,0.08,"dark"],
        [stride,-0.14,0.27,0.085,0.08,0.17,armor],
        [-stride,0.14,0.27,0.085,0.08,0.17,armor],
        [0,0,0.47,0.12,0.22,0.07,"dark"],
        [0,0,0.65,0.14,0.22,0.14,armor],
        [0.145,0,0.67,0.018,0.13,0.08,"dark"],
        [0,-0.27,0.72,0.14,0.075,0.1,armor],
        [0,0.27,0.72,0.14,0.075,0.1,armor],
        [0.06 - stride,-0.28,0.53,0.09,0.07,0.11,armor],
        [0.12,0.26,0.56,0.13,0.065,0.08,armor],
        [0,0,0.88,0.14,0.15,0.1,"helmet"],
        [0.145,0,0.90,0.018,0.13,0.025,"visor"],
        [0.28,0.21,0.58,0.22,0.055,0.055,"gun"],
        [0.50,0.21,0.58,0.025,0.065,0.065,pose == "attack" ? "hot" : "dark"],
    ]
    if pose == "dead":
        boxes = [
            [0,0,0.10,0.30,0.20,0.10,"dark"],
            [0.12,0,0.16,0.20,0.20,0.07,"armor"],
            [0.43,0,0.12,0.12,0.14,0.10,"helmet"],
            [-0.38,-0.12,0.06,0.16,0.09,0.06,"armor"],
            [-0.38,0.12,0.06,0.16,0.09,0.06,"armor"],
        ]
    for box in boxes:
        verts = []
        for i in range(8):
            x = box[0] + (i % 2 == 1 ? box[3] : -box[3])
            y = box[1] + (floor(i / 2) % 2 == 1 ? box[4] : -box[4])
            z = box[2] + (i >= 4 ? box[5] : -box[5])
            verts.push([W / 2 + (-sa * x + ca * y) * 38, H - 1 - z * 44, ca * x + sa * y])
        for face, side in faces:
            triangles = [[face[0],face[1],face[2]],[face[0],face[2],face[3]]]
            for tri in triangles:
                a = verts[tri[0]]
                b = verts[tri[1]]
                c = verts[tri[2]]
                denom = (b[1] - c[1]) * (a[0] - c[0]) + (c[0] - b[0]) * (a[1] - c[1])
                if abs(denom) < 1e-8:
                    continue
                min_y = max(0, floor(min(a[1], b[1], c[1])))
                max_y = min(H, ceil(max(a[1], b[1], c[1])))
                min_x = max(0, floor(min(a[0], b[0], c[0])))
                max_x = min(W, ceil(max(a[0], b[0], c[0])))
                for py in range(min_y, max_y):
                    for px in range(min_x, max_x):
                        u = ((b[1] - c[1]) * (px + 0.5 - c[0]) + (c[0] - b[0]) * (py + 0.5 - c[1])) / denom
                        v = ((c[1] - a[1]) * (px + 0.5 - c[0]) + (a[0] - c[0]) * (py + 0.5 - c[1])) / denom
                        w = 1 - u - v
                        if min(u, v, w) < -1e-6:
                            continue
                        d = u * a[2] + v * b[2] + w * c[2]
                        index = py * W + px
                        if d >= depth[index]:
                            depth[index] = d
                            canvas[index] = lookup[box[6] + "/" + side]
    rows = []
    for y in range(H):
        rows.push(canvas.slice(y * W, (y + 1) * W).join(""))
    return rows

lines = ["# Generated by generate_guards.vect: shaded 3D models, eight views per pose.", "@Palette/guard3d", "colors = " + json.stringify(palette), ""]
for pose in ["walk0", "walk1", "attack", "pain", "dead"]:
    for direction in range(8):
        lines.push("@Sprite/guard3d/" + pose + "/" + direction)
        lines.push("palette = guard3d")
        lines.push("size = [32, 48]")
        lines.push("origin = [16, 48]")
        lines.push("pixels:")
        for row in render(pose, direction):
            lines.push("    \"" + row + "\"")
        lines.push("")
file.write("guards.rune", lines.join("\n"))
stdio -> "Generated 40 shaded guard views in {script_dir}/guards.rune"
