#!RUNE
# Compact cabinet for the teaching site and standalone browser play.
import "vect_breach.rune"

@App
shell = site_breach

@Page/site_breach
title = Vect Breach — Three sectors. One way out.
logic = site_breach
style = site_breach
view:
    main .cabinet:
        header:
            h1 "{label}"
            p "THREE SECTORS. ONE WAY OUT."
        div .game-surface:
            canvas data-rune-pixel-3d=true tabindex=0 aria-label="Vect Breach. Click or Enter to begin. WASD move, mouse or arrow keys aim, left click or Space fire, E use terminals and elevators."
        p .status data-pixel-status=true role=status aria-live=polite "Click the game or press Enter to begin."
        div .toolbar:
            button data-pixel-pause=true "Pause · P"
            button data-pixel-mute=true "Sound · M"
            button data-pixel-fullscreen=true "Fullscreen"
            button data-pixel-start=true "Restart"
        p .controls "WASD move · Mouse / ← → aim · Click / Space fire · E use · Esc release mouse. Keyboard and mouse required."

@Logic/site_breach
state:
    label = "VECT BREACH"

@Style/site_breach
rules:
    :root:
        color-scheme = dark
    *:
        box-sizing = border-box
    body:
        margin = 0
        background = #0d0f12
        color = #e4e0d4
        font-family = ui-monospace, SFMono-Regular, Consolas, monospace
    .cabinet:
        max-width = 1000px
        margin = auto
        padding = 12px
    header:
        display = flex
        align-items = center
        justify-content = space-between
        flex-wrap = wrap
        gap = 12px
        margin-bottom = 10px
    h1:
        margin = 0
        font-size = 22px
        color = #f6cc44
    header p:
        margin = 0
        font-size = 10px
        color = #a9b5bf
    .game-surface:
        display = flex
        justify-content = center
        background = #060709
        border = 1px solid #664433
    canvas:
        display = block
        width = 100%
        max-width = max(160px, calc(160svh - 304px))
        height = auto
        aspect-ratio = 8 / 5
        image-rendering = pixelated
        cursor = crosshair
    canvas:focus-visible, button:focus-visible:
        outline = 3px solid #f6cc44
        outline-offset = 2px
    .game-surface:fullscreen:
        border = 0
        align-items = center
    .game-surface:fullscreen canvas:
        width = min(100vw, 160vh)
        max-width = none
        max-height = 100vh
    .status, .controls:
        font-size = 11px
        line-height = 1.6
        color = #c4beae
        margin = 10px 0
    .status:
        color = #f6cc44
    .toolbar:
        display = flex
        flex-wrap = wrap
        gap = 8px
    button:
        font = inherit
        font-size = 11px
        cursor = pointer
        min-height = 44px
        padding = 10px 14px
        background = #301e18
        color = #e4e0d4
        border = 1px solid #8c6150
        border-radius = 4px
    button:hover:
        background = #4a2b20
