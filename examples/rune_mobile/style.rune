@Style/mobile
rules:
    *:
        box-sizing = border-box
    body:
        margin = 0
        background = #101827
        color = #f5f7fb
        font-family = system-ui, sans-serif
        -webkit-text-size-adjust = 100%
    main:
        max-width = 520px
        margin = 0 auto
        padding = calc(24px + env(safe-area-inset-top, 0px)) calc(20px + env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) calc(20px + env(safe-area-inset-left, 0px))
    header:
        padding = 24px 0
    h1:
        font-size = clamp(2rem, 9vw, 3rem)
        line-height = 1.08
        letter-spacing = -0.04em
        margin = 16px 0
    h2:
        font-size = 1.15rem
    p:
        line-height = 1.6
    .eyebrow:
        color = #8fe4cd
        font-size = 0.72rem
        font-weight = 700
        letter-spacing = 0.12em
    .intro, footer:
        color = #b6c2d4
    nav, .controls:
        display = flex
        gap = 12px
    nav:
        margin-bottom = 24px
    button:
        min-height = 48px
        min-width = 48px
        border = 1px solid #495b72
        border-radius = 14px
        padding = 12px 18px
        background = #1c2a3e
        color = #f5f7fb
        font = inherit
        font-weight = 600
        cursor = pointer
        touch-action = manipulation
    button:focus-visible:
        outline = 3px solid #8fe4cd
        outline-offset = 3px
    button.active, button.primary:
        background = #8fe4cd
        color = #101827
        border-color = #8fe4cd
    .card:
        background = #182437
        border = 1px solid #34465e
        border-radius = 24px
        padding = 24px
        margin-bottom = 16px
    #count:
        font-size = 5rem
        font-weight = 700
        text-align = center
        margin = 20px 0
        font-variant-numeric = tabular-nums
    .controls button:
        flex = 1
    .text-button:
        display = block
        margin = 16px auto 0
        background = transparent
    footer:
        font-size = 0.8rem
        text-align = center
