# Monster March — an original four-bar chiptune for a very large pedestrian.
# Uses the same declarative synthesizer as VectRaiders and VectWorms.

@Music/monster_city
type = 8bit
tempo = 116
time_signature = 4/4
bars = 4
loop = true
volume = 0.11
lead:
    E4:8 -:8 G4:8 E4:8 A4:4 G4:8 E4:8 |
    D4:8 E4:8 G4:4 E4:4 -:4 |
    C4:8 E4:8 G4:8 A4:8 B4:4 A4:8 G4:8 |
    F#4:8 E4:8 D4:8 B3:8 E4:4 -:4
bass:
    E2:8 E2:8 -:8 E2:8 B1:4 D2:4 |
    C2:4 G1:4 C2:4 D2:4 |
    D2:4 A1:4 D2:8 D2:8 A1:4 |
    B1:4 F#2:4 B1:8 D2:8 E2:4
drums:
    [kick,hihat]:4 [snare,hihat]:4 [kick,hihat]:8 kick:8 snare:4 |
    kick:4 snare:4 [kick,hihat]:4 snare:4 |
    [kick,hihat]:4 snare:4 kick:8 hihat:8 snare:4 |
    kick:4 snare:4 kick:8 snare:8 snare:8 hihat:8

@Sound/monster_roar
wave = sawtooth
sequence = E2:90ms, G2:60ms, E2:90ms, B1:150ms
volume = 0.10

@Sound/monster_smash
wave = noise
filter = lowpass 700 -> 65
duration = 130ms
volume = 0.16

@Sound/monster_collapse
wave = noise
filter = lowpass 1400 -> 40
duration = 400ms
volume = 0.20

@Sound/monster_stomp
wave = noise
filter = lowpass 240 -> 40
duration = 70ms
volume = 0.08

@Sound/monster_rifle
wave = square
freq = 1100 -> 420
duration = 30ms
volume = 0.035

@Sound/monster_cannon
wave = triangle
freq = 180 -> 35
duration = 180ms
volume = 0.12

@Sound/monster_damage
wave = sawtooth
freq = 260 -> 65
duration = 90ms
volume = 0.10

@Sound/monster_explosion
wave = noise
filter = lowpass 2200 -> 70
duration = 280ms
volume = 0.18

@Sound/monster_victory
wave = triangle
sequence = E4:80ms, G4:80ms, B4:80ms, E5:200ms
volume = 0.14

@Sound/monster_gameover
wave = square
sequence = E4:100ms, D4:100ms, B3:140ms, E3:260ms
volume = 0.12

# Monster Parade — a welcoming, bouncy title-screen melody.
@Music/monster_title
type = 8bit
tempo = 104
time_signature = 4/4
bars = 4
loop = true
volume = 0.08
lead:
    C4:8 E4:8 G4:4 E4:8 G4:8 C5:4 |
    B4:8 G4:8 E4:4 D4:4 -:4 |
    F4:8 A4:8 C5:4 A4:8 G4:8 F4:4 |
    E4:8 G4:8 D4:8 E4:8 C4:4 -:4
bass:
    C2:4 G2:4 C2:4 G2:4 |
    E2:4 B2:4 E2:4 B2:4 |
    F2:4 C3:4 F2:4 C3:4 |
    G2:4 D3:4 C2:4 -:4
drums:
    kick:4 hihat:4 snare:4 hihat:4 |
    kick:4 hihat:4 snare:4 -:4 |
    kick:4 hihat:4 snare:4 hihat:4 |
    kick:4 hihat:4 snare:8 hihat:8 -:4

# Tiny Treasures — a lighter, laid-back shop loop.
@Music/monster_shop
type = 8bit
tempo = 92
time_signature = 4/4
bars = 4
loop = true
volume = 0.07
lead:
    A4:8 -:8 C5:8 E5:8 D5:4 C5:4 |
    G4:8 -:8 B4:8 D5:8 C5:4 B4:4 |
    F4:8 -:8 A4:8 C5:8 B4:4 A4:4 |
    E4:8 G4:8 B4:8 D5:8 C5:4 -:4
bass:
    A2:4 E3:4 A2:4 E3:4 |
    G2:4 D3:4 G2:4 D3:4 |
    F2:4 C3:4 F2:4 C3:4 |
    E2:4 B2:4 A2:4 -:4
drums:
    hihat:4 -:4 snare:4 -:4 |
    kick:4 -:4 hihat:4 -:4 |
    hihat:4 -:4 snare:4 -:4 |
    kick:4 hihat:4 -:4 -:4

@Sound/menu_move
wave = triangle
freq = 660 -> 880
duration = 35ms
volume = 0.045

@Sound/menu_confirm
wave = triangle
sequence = C5:35ms, E5:55ms
volume = 0.065

@Sound/menu_buy
wave = triangle
sequence = C5:45ms, E5:45ms, G5:45ms, C6:100ms
volume = 0.09

@Sound/menu_denied
wave = square
sequence = D3:55ms, C3:85ms
volume = 0.05

@Sound/power_pickup
wave = triangle
sequence = C5:50ms, E5:50ms, G5:50ms, C6:100ms
volume = 0.10

@Sound/power_charge
wave = triangle
freq = 90 -> 880
duration = 1900ms
volume = 0.045

@Sound/power_breath
wave = noise
filter = lowpass 2000 -> 700
duration = 400ms
volume = 0.10

@Sound/power_zap
wave = sawtooth
freq = 1500 -> 160
duration = 90ms
volume = 0.07

@Sound/power_aftershock
wave = noise
filter = lowpass 1600 -> 35
duration = 600ms
volume = 0.18

@Sound/power_end
wave = triangle
sequence = E5:60ms, C5:100ms
volume = 0.055

@Sound/combat_block
wave = triangle
freq = 440 -> 110
duration = 55ms
volume = 0.045

@Sound/combat_special
wave = triangle
sequence = E4:40ms, B4:40ms, E5:100ms
volume = 0.09
