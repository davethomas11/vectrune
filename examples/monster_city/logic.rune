@Logic/monster
state:
    status = "ready"
    profile = {"coins":0,"owned":["kaiju"],"skin":"kaiju","level":1,"seed":0,"best_score":0}
    skins = [{"id":"kaiju","name":"MOSS","cost":0},{"id":"ember","name":"EMBER","cost":120},{"id":"frost","name":"FROST","cost":240},{"id":"volt","name":"VOLT","cost":300},{"id":"coral","name":"CORAL","cost":360},{"id":"golem","name":"GOLEM","cost":420},{"id":"cyclops","name":"CYCLOPS","cost":480},{"id":"mantis","name":"MANTIS","cost":540},{"id":"drake","name":"DRAKE","cost":600},{"id":"yeti","name":"YETI","cost":660},{"id":"slime","name":"SLIME","cost":720},{"id":"mecha","name":"MECHA","cost":800},{"id":"cosmo","name":"COSMO","cost":900},{"id":"thorn","name":"THORN","cost":1000},{"id":"obsidian","name":"OBSIDIAN","cost":1100},{"id":"tide","name":"TIDE","cost":1200},{"id":"nova","name":"NOVA","cost":1400}]
    store_page = 0
    store_pages = 6
    level = 1
    difficulty = 1
    reward = 0
    fire_rate = 60
    tank_rate = 95
    menu = null
    aircraft = []
    score = 0
    health = 100
    destroyed = 0
    clock = 0
    cooldown = 0
    flash = 0
    monster = {"x":8,"y":118,"sprite":"kaiju/idle","scale":3,"flip":false}
    buildings = [{"x":62,"y":110,"sprite":"tower/blue","scale":2,"hp":3},{"x":124,"y":110,"sprite":"tower/rust","scale":2,"hp":3},{"x":186,"y":110,"sprite":"tower/blue","scale":2,"hp":3},{"x":248,"y":110,"sprite":"tower/rust","scale":2,"hp":3},{"x":310,"y":110,"sprite":"tower/blue","scale":2,"hp":3}]
    skyline = [{"x":0,"y":92,"sprite":"skyline","scale":2},{"x":64,"y":76,"sprite":"skyline","scale":3},{"x":178,"y":98,"sprite":"skyline","scale":2},{"x":248,"y":76,"sprite":"skyline","scale":3}]
    soldiers = [{"x":110,"y":170,"sprite":"soldier","scale":2,"visible":true,"hp":1},{"x":210,"y":170,"sprite":"soldier","scale":2,"visible":true,"hp":1},{"x":322,"y":170,"sprite":"soldier","scale":2,"visible":true,"hp":1}]
    tanks = [{"x":170,"y":174,"sprite":"tank","scale":2,"visible":true,"hp":2},{"x":338,"y":174,"sprite":"tank","scale":2,"visible":true,"hp":2}]
    shots = []
    dust = []

# Save only the profile. Scenes, projectiles and transient UI are rebuilt.
action initialize:
    profile.coins = clamp(profile.coins, 0, 999999)
    profile.level = clamp(profile.level, 1, 9999)
    profile.best_score = clamp(profile.best_score, 0, 99999999)
    profile.seed = clamp(profile.seed, 0, 2147483647)
    if profile.seed <= 0:
        profile.seed = random(1, 1000000000)
    valid_owned = ["kaiju"]
    for skin in skins:
        is_owned = profile.owned.any(id => id == skin.id)
        if skin.id != "kaiju" && is_owned == true:
            valid_owned.push(skin.id)
    profile.owned = valid_owned
    if !profile.owned.any(id => id == profile.skin):
        profile.skin = "kaiju"
    call openTitle

action openTitle:
    call resetCombat
    call clearPowers
    crates = []
    music.stop
    music.play "monster_title"
    status = "ready"
    level = profile.level
    monster.sprite = profile.skin + "/idle"
    menu = {"title":"MONSTER CITY","subtitle":"ATTACK OF THE KAJU","note":"EARN COINS - UNLOCK YOUR NEXT MONSTER","buttons":[{"label":"PLAY CITY " + profile.level,"action":"start"},{"label":"MONSTER SHOP","action":"openStore"},{"label":"RESET TO CITY 1","action":"requestLevelReset"}]}

action requestLevelReset:
    stop when status != "ready"
    status = "reset"
    menu = {"title":"RESET TO CITY 1","subtitle":"COINS AND SKINS WILL BE KEPT","note":"ONLY YOUR CITY PROGRESS WILL RESET","buttons":[{"label":"CANCEL","action":"openTitle"},{"label":"RESET TO CITY 1","action":"confirmLevelReset"}]}

action confirmLevelReset:
    stop when status != "reset"
    profile.level = 1
    call openTitle

action openStore:
    call resetCombat
    call clearPowers
    crates = []
    music.stop
    music.play "monster_shop"
    status = "store"
    store_page = 0
    call renderStore

# Three cards per page. Adding skins automatically increases the page count.
action renderStore:
    store_pages = (skins.length - skins.length % 3) / 3
    if skins.length % 3 > 0:
        store_pages += 1
    store_page = clamp(store_page, 0, store_pages - 1)
    menu = {"id":"store-" + store_page,"title":"MONSTER SHOP","subtitle":"COINS " + profile.coins + " - PAGE " + (store_page + 1) + " OF " + store_pages,"cards":[],"note":"SELECT A MONSTER TO BUY OR EQUIP","buttons":[]}
    for skin, index in skins:
        if index >= store_page * 3 && index < store_page * 3 + 3:
            owned = profile.owned.any(id => id == skin.id)
            detail = owned ? "OWNED - EQUIP" : skin.cost + " COINS - BUY"
            if profile.skin == skin.id:
                detail = "EQUIPPED"
            move = special_defs.find(m => m.skin == skin.id)
            menu.cards.push({"name":skin.name,"sprite":skin.id + "/idle","detail":detail,"caption":move.name + " " + move.cost + "E","action":"chooseSkin","args":[skin.id]})
    if store_page > 0:
        menu.buttons.push({"label":"PREVIOUS","action":"previousStorePage"})
    if store_page < store_pages - 1:
        menu.buttons.push({"label":"NEXT","action":"nextStorePage"})
    menu.buttons.push({"label":"BACK TO TITLE","action":"openTitle"})

action nextStorePage:
    stop when status != "store"
    store_page = min(store_pages - 1, store_page + 1)
    call renderStore

action previousStorePage:
    stop when status != "store"
    store_page = max(0, store_page - 1)
    call renderStore

action chooseSkin(id):
    stop when status != "store"
    valid_skin = skins.any(s => s.id == id)
    stop when valid_skin != true
    selected_skin = skins.find(s => s.id == id)
    owned = profile.owned.any(s => s == id)
    if !owned:
        if profile.coins < selected_skin.cost:
            sound.play("menu_denied")
            menu.note = "MORE COINS NEEDED - BEAT A CITY TO EARN"
            stop
        profile.coins -= selected_skin.cost
        profile.owned.push(id)
        sound.play("menu_buy")
    profile.skin = id
    monster.sprite = id + "/idle"
    call resetCombat
    call renderStore

# A saved seed + city number recreates each layout on retry. Enemy counts,
# armor and firing rates grow to bounded limits so later cities stay playable.
action generateLevel:
    difficulty = min(level, 12)
    city_seed = profile.seed + level * 1009
    buildings = []
    soldiers = []
    tanks = []
    aircraft = []
    for index in [0, 1, 2, 3, 4]:
        jitter = level == 1 ? 0 : random(-5, 5, city_seed + index)
        tower_sprite = pick(["tower/blue", "tower/rust"], city_seed + index + 20)
        armor = min(6, 3 + (difficulty - difficulty % 3) / 3)
        buildings.push({"x":62 + index * 62 + jitter,"y":110,"sprite":tower_sprite,"scale":2,"hp":armor})
    for index in [0, 1, 2, 3, 4, 5]:
        if index < min(6, 2 + difficulty):
            soldier_x = level == 1 ? 110 + index * 106 : random(85, 350, city_seed + 50 + index)
            soldiers.push({"x":soldier_x,"y":170,"sprite":"soldier","scale":2,"visible":true,"hp":1})
    for index in [0, 1, 2, 3]:
        if index < min(4, 1 + difficulty):
            tank_x = level == 1 ? 170 + index * 168 : random(140, 348, city_seed + 70 + index)
            tanks.push({"x":tank_x,"y":174,"sprite":"tank","scale":2,"visible":true,"hp":2})
    if level >= 3:
        aircraft.push({"x":310,"y":78,"sprite":"helicopter","scale":2,"vx":-0.8,"hp":2,"visible":true,"kind":"helicopter"})
    if level >= 5:
        aircraft.push({"x":40,"y":45,"sprite":"plane","scale":2,"vx":1.8,"hp":3,"visible":true,"kind":"plane"})
    if level >= 8:
        aircraft.push({"x":140,"y":85,"sprite":"helicopter","scale":2,"vx":1,"hp":2,"visible":true,"kind":"helicopter"})
    fire_rate = max(24, 64 - difficulty * 4)
    tank_rate = max(40, 100 - difficulty * 5)

action start:
    music.stop
    reset monster
    level = profile.level
    call generateLevel
    call resetSupplies
    call resetCombat
    monster.sprite = profile.skin + "/idle"
    score = 0
    reward = 0
    health = 100
    destroyed = 0
    clock = 0
    cooldown = 0
    flash = 0
    shots = []
    dust = []
    menu = null
    status = "playing"
    music.play "monster_city"
    sound.play("monster_roar")

action completeLevel:
    stop when status != "playing"
    stop when destroyed != buildings.length
    status = "won"
    call clearCombat
    call clearPowers
    crates = []
    reward = 50 + level * 10 + (score - score % 10) / 10
    profile.coins = min(999999, profile.coins + reward)
    profile.best_score = max(profile.best_score, score)
    profile.level = min(9999, level + 1)
    music.stop
    sound.play("monster_victory")
    menu = {"title":"CITY CONQUERED","subtitle":"EARNED " + reward + " COINS - TOTAL " + profile.coins,"note":"HELICOPTERS CITY 3 - PLANES CITY 5","buttons":[{"label":"NEXT CITY " + profile.level,"action":"start"},{"label":"MONSTER SHOP","action":"openStore"},{"label":"TITLE SCREEN","action":"openTitle"}]}

action smash:
    stop when status != "playing"
    stop when cooldown > 0
    stop when defending == true
    cooldown = 12
    flash = 6
    monster.sprite = profile.skin + "/punch"
    sound.play("monster_smash")
    for building in buildings:
        if building.hp > 0 && abs((building.x + 16) - (monster.x + monster.scale * 8)) < 52:
            dust.push({"x":building.x + 6,"y":120,"sprite":"dust","scale":2,"life":12})
            call damageBuilding building, 1
    for soldier in soldiers:
        if soldier.hp > 0 && abs(soldier.x - (monster.x + monster.scale * 8)) < 45:
            call damageSoldier soldier
    for tank in tanks:
        if tank.hp > 0 && abs((tank.x + 16) - (monster.x + monster.scale * 8)) < 52:
            call damageTank tank, 1
    for flyer in aircraft:
        if flyer.hp > 0 && abs((flyer.x + 16) - (monster.x + monster.scale * 8)) < 52 && flyer.y > 70:
            call damageFlyer flyer, 1
    if destroyed == buildings.length:
        call completeLevel

action tick(input):
    stop when status != "playing"
    clock += 1
    cooldown = max(0, cooldown - 1)
    flash = max(0, flash - 1)
    defending = input.defend == true
    if input.left == true:
        if defending != true:
            monster.x = clamp(monster.x - move_speed, 0, move_limit)
        monster.flip = true
    if input.right == true:
        if defending != true:
            monster.x = clamp(monster.x + move_speed, 0, move_limit)
        monster.flip = false
    monster.sprite = profile.skin + "/idle"
    if (input.left == true || input.right == true) && defending != true:
        monster.sprite = profile.skin + "/walk"
        if clock % 12 == 0:
            sound.play("monster_stomp")
    if flash > 0:
        monster.sprite = profile.skin + "/punch"
    call applyStance
    call tickSupplies
    call updatePowers
    call applyStance
    if input.special == true && special_held != true:
        call useSpecial
    stop when status != "playing"
    special_held = input.special == true
    call updateCombat
    stop when status != "playing"
    if input.smash == true:
        call smash
    stop when status != "playing"
    for soldier in soldiers:
        if soldier.hp > 0 && stun_ticks == 0:
            soldier.flip = soldier.x > monster.x
            if abs(soldier.x - monster.x) > 65:
                soldier.x += soldier.x > monster.x ? -0.35 : 0.35
            if clock % fire_rate == 0 && shots.length < 64:
                sound.play("monster_rifle")
                shots.push({"x":soldier.x,"y":166,"sprite":"bullet","scale":1,"vx":soldier.x > monster.x ? -3 : 3,"life":140,"damage":2})
    for tank in tanks:
        if tank.hp > 0 && stun_ticks == 0:
            tank.flip = tank.x > monster.x
            if clock % tank_rate == 0 && shots.length < 64:
                sound.play("monster_cannon")
                shots.push({"x":tank.x + 12,"y":160,"sprite":"shell","scale":1,"vx":tank.x > monster.x ? -2 : 2,"life":180,"damage":5})
    for flyer in aircraft:
        if flyer.hp > 0 && stun_ticks == 0:
            flyer.x += flyer.vx
            flyer.flip = flyer.vx < 0
            if flyer.x < 0 || flyer.x > 350:
                flyer.vx = 0 - flyer.vx
            if clock % 75 == 0 && shots.length < 64:
                sound.play("monster_cannon")
                shots.push({"x":flyer.x + 16,"y":flyer.y + 12,"sprite":"shell","scale":1,"vx":0,"vy":2.5,"life":100,"damage":flyer.kind == "plane" ? 7 : 4})
    for shot in shots:
        shot.x += shot.vx
        if shot.vy > 0:
            shot.y += shot.vy
        shot.life -= 1
        if shot.life > 0 && shot.x > monster.x + 8 && shot.x < monster.x + monster.scale * 16 - 6 && shot.y > monster.y && shot.y < monster.y + monster.scale * stance_height:
            incoming = shot.damage
            if power == "shield":
                incoming = 0
            if power == "giant":
                incoming = (shot.damage + 1 - ((shot.damage + 1) % 2)) / 2
            if power == "speed":
                dodge = random(1, 100, city_seed + clock * 31 + shot.x)
                if dodge <= 65:
                    incoming = 0
            if guard_ticks > 0:
                incoming = min(incoming, 1)
            if defending == true && incoming > 0:
                incoming = max(1, (incoming + 9 - ((incoming + 9) % 10)) / 10)
            if incoming > 0:
                health = max(0, health - incoming)
                if defending != true:
                    sound.play("monster_damage")
                if defending == true && clock - last_block_sound >= 6:
                    sound.play("combat_block")
                    last_block_sound = clock
            shot.life = 0
    shots = shots.filter(s => s.life > 0 && s.x > 0 && s.x < 384 && s.y < 194)
    for puff in dust:
        puff.y -= 1
        puff.life -= 1
    dust = dust.filter(p => p.life > 0)
    stop when status != "playing"
    call advancePowerClock
    call advanceCombat
    call applyStance
    if health <= 0:
        call clearCombat
        call clearPowers
        crates = []
        status = "gameover"
        music.stop
        sound.play("monster_gameover")
        menu = {"title":"MONSTER DOWN","subtitle":"COINS SAFE - TRY THIS CITY AGAIN","note":"KEEP MOVING AND SMASH THE ARMY","buttons":[{"label":"RETRY CITY " + level,"action":"start"},{"label":"MONSTER SHOP","action":"openStore"},{"label":"TITLE SCREEN","action":"openTitle"}]}
