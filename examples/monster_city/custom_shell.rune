#!RUNE
# A regular Rune-Web page wraps the same pixel game and can keep its own state.
import "monster_city.rune"

@App
shell = arcade

@Page/arcade
title = Monster City — custom Rune-Web shell
logic = arcade
style = arcade
view:
    main .cabinet:
        h1 "MONSTER CITY / CUSTOM CABINET"
        p "The canvas is embedded in a normal Rune-Web page."
        button click=toggleHelp "Toggle instructions"
        if show_help:
            p "Arrow keys to move. Space to smash. Enter to start. Down/S to block. X for special. P to pause. M to toggle sound."
        canvas data-rune-pixel=true tabindex=0 aria-label="Monster City game"
        nav data-pixel-menu=true aria-label="Game menu"
        button data-pixel-start=true "Start rampage"
        button data-pixel-action="openStore" "Monster shop"
        button data-pixel-action="openTitle" "Title screen"
        p data-pixel-save=true
        button data-pixel-pause=true "Pause"
        button data-pixel-mute=true aria-pressed=false aria-label="Mute game audio" "Sound on"
        button data-pixel-input="defend" aria-label="Duck and block" aria-pressed=false "BLOCK"
        button data-pixel-input="special" aria-label="Use skin special" "SPECIAL"
        p data-pixel-energy=true
        button data-pixel-fullscreen=true "Fullscreen"

@Logic/arcade
state:
    show_help = false
action toggleHelp:
    show_help = !show_help

@Style/arcade
body { margin: 0; background: #16202a; color: #e8eadb; font-family: monospace; }
.cabinet { max-width: 1000px; margin: 32px auto; padding: 20px; }
canvas { display: block; image-rendering: pixelated; max-width: 100%; margin: 20px 0; background: #111824; }
button { margin: 8px; padding: 12px; cursor: pointer; background: #b5ef77; color: #16202a; border: 0; }
