#!RUNE
import "monster_city.rune"

@Test/MonsterWeb/Document
run:
    req = { path: "/" }
    page = test-request req
    assert page.status == 200
    assert page.headers["content-type"] contains "text/html"
    assert page.text contains "<canvas"
    assert page.text contains "data-rune-pixel"
    assert page.text contains "__RunePixelRuntime.boot"

@Test/MonsterWeb/Head
run:
    req = { method: "HEAD", path: "/" }
    page = test-request req
    assert page.status == 200
    assert page.text == ""

@Test/MonsterWeb/UnknownPage
run:
    req = { path: "/missing" }
    page = test-request req
    assert page.status == 404
