# All layouts are authored and connected. Depth two has two crypt variants.
@Map/courtyard
spawn = {"x":1.5,"y":1.5,"angle":0}
floor = stone/moss
sky = {"seed":731,"zenith":"#202c55","horizon":"#bd8b83","cloud":"#c0bdcf","speed":0.35}
legend = {
    "#": {"wall":"stone/moss_wall"},
    ".": {},
    "P": {"wall":"stone/pillar"},
    "X": {"wall":"stone/cracked"}
}
grid:
    "#############"
    "#...........#"
    "#..P.....P..#"
    "#...........#"
    "#....#X#....#"
    "#....X.X....#"
    "#...........#"
    "#....X.X....#"
    "#....#X#....#"
    "#...........#"
    "#..P.....P..#"
    "#...........#"
    "#############"

@Map/crypt_a
