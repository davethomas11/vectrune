@Logic/miners
state:
    menu = ""
    menu_page = 0
    menu_hidden = true
    menu_title = ""
    menu_body = ""
    menu_footer = ""
    menu_one = ""
    menu_two = ""
    menu_three = ""
    menu_one_help = ""
    menu_two_help = ""
    menu_three_help = ""
    menu_one_locked = false
    menu_two_locked = false
    menu_three_locked = false
    owned = {"hand_pick":true,"training_blade":true,"work_clothes":true,"none":true,"stone_pick":false,"copper_blade":false,"copper_mail":false,"heart_charm":false,"copper_pick":false}
    equipment = {"tool":"hand_pick","weapon":"training_blade","armor":"work_clothes","charm":"none"}
    armor = 0
    mining_rate = 18
    gear_summary = ""
    tool_label = ""
    weapon_label = ""
    armor_label = ""
    charm_label = ""
    items = [
        {"id":"hand_pick","name":"Hand pick","slot":"tool","effect":"Mine every 18 ticks"},
        {"id":"training_blade","name":"Training blade","slot":"weapon","effect":"Strike 4 / Skill 8"},
        {"id":"work_clothes","name":"Work clothes","slot":"armor","effect":"No damage reduction"},
        {"id":"stone_pick","name":"Stone pick","slot":"tool","effect":"Mine every 9 ticks"},
        {"id":"copper_blade","name":"Copper blade","slot":"weapon","effect":"Strike 9 / Skill 15"},
        {"id":"copper_mail","name":"Copper mail","slot":"armor","effect":"Reduce incoming damage by 3"},
        {"id":"heart_charm","name":"Heart charm","slot":"charm","effect":"+20 maximum health; rest to heal"},
        {"id":"copper_pick","name":"Copper pick","slot":"tool","effect":"Mine every 6 ticks"},
        {"id":"none","name":"No charm","slot":"charm","effect":"Base maximum health 60"}
    ]
    recipes = [
        {"id":"stone_pick","name":"Stone pick","timber":2,"stone":3,"copper":0,"requires":"","effect":"Tool: mine twice as fast"},
        {"id":"copper_blade","name":"Copper blade","timber":1,"stone":0,"copper":2,"requires":"","effect":"Weapon: strike 9 / skill 15"},
        {"id":"copper_mail","name":"Copper mail","timber":0,"stone":4,"copper":3,"requires":"","effect":"Armor: reduce damage by 3"},
        {"id":"heart_charm","name":"Heart charm","timber":2,"stone":0,"copper":2,"requires":"","effect":"Charm: +20 maximum health"},
        {"id":"copper_pick","name":"Copper pick","timber":0,"stone":2,"copper":3,"requires":"stone_pick","effect":"Tool: mine every 6 ticks"},
        {"id":"herb_bundle","name":"Herb bundle","timber":2,"stone":1,"copper":0,"requires":"","effect":"+2 herbs, up to 6 carried"}
    ]

action reset_inventory:
    menu = ""
    menu_page = 0
    owned = {"hand_pick":true,"training_blade":true,"work_clothes":true,"none":true,"stone_pick":false,"copper_blade":false,"copper_mail":false,"heart_charm":false,"copper_pick":false}
    equipment = {"tool":"hand_pick","weapon":"training_blade","armor":"work_clothes","charm":"none"}
    armor = 0
    max_health = 60
    mining_rate = 18

action inventory:
    stop when status != "playing"
    if tutorial_step != "":
        notice = "Finish practice or press G to skip before opening your backpack."
        call refresh_ui
        stop
    if menu != "":
        call close_menu
        stop
    if phase != "explore" && phase != "player":
        notice = "Finish defending before opening your backpack."
        call refresh_ui
        stop
    menu = "inventory"
    menu_page = 0
    call refresh_ui

action workbench:
    stop when status != "playing"
    call camp_check
    if camp_locked:
        notice = "Crafting needs the camp workbench. Press B to return."
        notice_ticks = 120
        call refresh_ui
        stop
    menu = "craft"
    menu_page = 0
    call refresh_ui

action close_menu:
    menu = ""
    menu_page = 0
    guard_held = true
    dodge_held = true
    jump_held = true
    call refresh_ui

action menu_next:
    stop when menu == "" || menu == "inventory"
    menu_page = (menu_page + 1) % (menu == "craft" ? 2 : 3)
    call refresh_ui

action menu_previous:
    stop when menu == "" || menu == "inventory"
    menu_page = (menu_page + (menu == "craft" ? 1 : 2)) % (menu == "craft" ? 2 : 3)
    call refresh_ui

action menu_choose(choice):
    stop when menu == "" || choice < 0 || choice > 2 || choice != floor(choice)
    if menu == "inventory":
        if choice == 0:
            menu = "equipment"
            menu_page = 0
            call refresh_ui
            stop
        if choice == 1:
            call workbench
            stop
        call close_menu
        stop
    if menu == "craft":
        call craft menu_page * 3 + choice
        call refresh_ui
        stop
    call equip_item menu_page * 3 + choice
    call refresh_ui

action menu_one_action:
    call menu_choose 0

action menu_two_action:
    call menu_choose 1

action menu_three_action:
    call menu_choose 2

action craft(index):
    stop when status != "playing"
    if index < 0 || index >= recipes.length || index != floor(index):
        notice = "Choose a listed recipe."
        stop
    call camp_check
    if camp_locked:
        notice = "Return to the camp workbench to craft."
        stop
    recipe = recipes[index]
    if recipe.id != "herb_bundle" && owned[recipe.id]:
        notice = recipe.name + " already crafted. Equip it from your backpack."
        stop
    if recipe.requires != "" && !owned[recipe.requires]:
        notice = "Craft the stone pick before upgrading to a copper pick."
        stop
    if recipe.id == "herb_bundle" && herbs > 4:
        notice = "Herb pouch is full. Use herbs before crafting another bundle."
        stop
    if timber < recipe.timber || stone < recipe.stone || copper < recipe.copper:
        notice = recipe.name + " needs " + recipe.timber + " timber, " + recipe.stone + " stone, " + recipe.copper + " copper."
        stop
    timber -= recipe.timber
    stone -= recipe.stone
    copper -= recipe.copper
    if recipe.id == "herb_bundle":
        herbs += 2
        notice = "Crafted 2 herbs. Carried: " + herbs + "/6."
        stop
    owned[recipe.id] = true
    for item in items:
        if item.id == recipe.id:
            equipment[item.slot] = item.id
    pick = !!owned.stone_pick
    blade = !!owned.copper_blade
    call equipment_stats
    notice = recipe.name + " crafted and equipped. " + recipe.effect

action equip_item(index):
    stop when status != "playing"
    if phase != "explore" || menu != "equipment":
        notice = "Change equipment outside combat."
        stop
    if index < 0 || index >= items.length || index != floor(index):
        notice = "Choose an equipment item."
        stop
    item = items[index]
    if !owned[item.id]:
        notice = item.name + " is not crafted yet."
        stop
    equipment[item.slot] = item.id
    call equipment_stats
    notice = item.name + " equipped. " + item.effect

action equipment_stats:
    armor = equipment.armor == "copper_mail" ? 3 : 0
    max_health = equipment.charm == "heart_charm" ? 80 : 60
    health = min(health, max_health)
    mining_rate = equipment.tool == "copper_pick" ? 6 : (equipment.tool == "stone_pick" ? 9 : 18)
    for equipped_item in items:
        if equipment[equipped_item.slot] == equipped_item.id:
            if equipped_item.slot == "tool":
                tool_label = equipped_item.name
            if equipped_item.slot == "weapon":
                weapon_label = equipped_item.name
            if equipped_item.slot == "armor":
                armor_label = equipped_item.name
            if equipped_item.slot == "charm":
                charm_label = equipped_item.name
    gear_summary = tool_label + " | " + weapon_label + " | " + armor_label + " | " + charm_label

action refresh_inventory:
    call equipment_stats
    menu_hidden = menu == ""
    menu_one_locked = false
    menu_two_locked = false
    menu_three_locked = false
    menu_title = "BACKPACK"
    menu_body = "Timber " + timber + " | Stone " + stone + " | Copper " + copper + " | Herbs " + herbs + "/6"
    menu_footer = "1 EQUIPMENT | 2 WORKBENCH | 3 CLOSE"
    menu_one = "Equipment slots"
    menu_two = "Camp workbench"
    menu_three = "Close backpack"
    menu_one_help = "Inspect four slots and swap crafted gear."
    menu_two_help = camp_locked ? "Return to camp with B to use the workbench." : "Six recipes for tools, combat gear and herbs."
    menu_three_help = "Resume your expedition."
    if menu == "inventory":
        menu_body = menu_body + " | HP " + health + "/" + max_health + " | " + gear_summary
        menu_two_locked = camp_locked
    if menu == "equipment":
        menu_title = "EQUIPMENT " + (menu_page + 1) + "/3"
        menu_body = gear_summary + " | Select a crafted item to equip it. Combat gear is locked during encounters."
        menu_footer = "1/2/3 EQUIP | N NEXT | V PREV | I CLOSE"
    if menu == "craft":
        menu_title = "CAMP WORKBENCH " + (menu_page + 1) + "/2"
        menu_footer = "1/2/3 CRAFT | N NEXT | V PREV | I CLOSE"
    menu_choices = []
    menu_locks = []
    menu_helps = []
    if menu == "craft" || menu == "equipment":
        for offset in range(0, 3):
            slot_index = menu_page * 3 + offset
            label = "Empty"
            locked = true
            item_help = ""
            if menu == "craft":
                entry = recipes[slot_index]
                label = entry.name + ": " + entry.timber + "W " + entry.stone + "S " + entry.copper + "C"
                item_help = entry.effect
                if entry.requires != "":
                    item_help = item_help + " (requires a crafted stone pick)"
                locked = camp_locked || timber < entry.timber || stone < entry.stone || copper < entry.copper || (entry.requires != "" && !owned[entry.requires]) || (entry.id == "herb_bundle" ? herbs > 4 : !!owned[entry.id])
                if entry.id != "herb_bundle" && owned[entry.id]:
                    label = entry.name + " - CRAFTED"
                if locked && !owned[entry.id]:
                    item_help = item_help + " / Need " + max(0, entry.timber - timber) + " more timber, " + max(0, entry.stone - stone) + " stone, " + max(0, entry.copper - copper) + " copper."
                if entry.id == "herb_bundle" && herbs > 4:
                    item_help = "Herb pouch full. Use herbs before crafting another bundle."
            if menu == "equipment" && slot_index < items.length:
                entry = items[slot_index]
                item_help = entry.effect
                label = entry.name + " / " + entry.slot
                locked = phase != "explore" || !owned[entry.id]
                if !owned[entry.id]:
                    label = label + " - NOT CRAFTED"
                if equipment[entry.slot] == entry.id:
                    label = label + " - EQUIPPED"
                    locked = true
            menu_choices.push(label)
            menu_locks.push(locked)
            menu_helps.push(item_help)
        menu_one = menu_choices[0]
        menu_two = menu_choices[1]
        menu_three = menu_choices[2]
        menu_one_locked = menu_locks[0]
        menu_two_locked = menu_locks[1]
        menu_three_locked = menu_locks[2]
        menu_one_help = menu_helps[0]
        menu_two_help = menu_helps[1]
        menu_three_help = menu_helps[2]
    if menu != "":
        ui.objective = menu_title
        ui.prompt = menu_footer
        ui.notice = ""
        ui.panel = {"title":menu_title,"body":menu_body,"choices":[menu_one,menu_two,menu_three],"selected":0,"footer":notice}
        if menu == "craft":
            ui.panel.body = menu_page == 0 ? "PICK: 2x mining | BLADE: 9/15 damage | MAIL: -3 incoming damage. W timber / S stone / C copper." : "CHARM: +20 max HP | PICK: 3x mining, needs stone pick | HERBS: +2, carry 6. W timber / S stone / C copper."
        if menu == "equipment":
            ui.panel.body = gear_summary + " | Crafted items can be swapped outside battle."
