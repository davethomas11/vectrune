#!RUNE

@App
name = Greeting API
type = REST
port = 3000
swagger = true

@Schema/Greeting
name = string
enthusiastic = bool

@Route/GET /health
description = Check that the API is running
run:
    respond 200 "OK"

@Route/GET /greetings/{name}
description = Read a name from the URL
run:
    result = { name: name }
    respond 200 result

@Route/POST /greetings
description = Validate and echo a greeting
expect = Greeting
run:
    parse-json
    validate body #Greeting
    respond 201 body
