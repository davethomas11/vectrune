@Style/teaching-site
tokens:
    bg = #f3f7f4
    panel = rgba(255, 255, 255, 0.88)
    panel-strong = #142f35
    text = #193a3f
    text-soft = #526c6c
    border = #d5e3dd
    brand = #285f64
    brand-dark = #173e44
    success-bg = #ecfdf3
    success-border = #86efac
    info-bg = #eaf5f2
    info-border = #a9cfca
    shadow = inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 16px 42px rgba(26, 67, 66, 0.065)
    code-inline-bg = #e9f2ee
    code-inline-text = #285b60
    beginner-bg = #e2f3e8
    beginner-text = #245f45
    practical-bg = #e3f1ef
    practical-text = #285f64
    advanced-bg = #fff0e8
    advanced-text = #a5432e
    syntax-comment = #9db5b7
    syntax-string = #ffc1ad
    syntax-escape = #fcd34d
    syntax-keyword = #d7c5ff
    syntax-builtin = #86ddd3
    syntax-function = #9bc6ef
    syntax-property = #edf8f5
    syntax-operator = #f1c58c
    syntax-qualifier = #a5b4fc
    syntax-number = #ace1b4
    syntax-interpolation = #ffd29c
    accent = #ed7d62
    accent-ink = #a5432e
    brand-gradient = linear-gradient(160deg, #3b7c7e 0%, #23565e 70%, #1b454d 100%)
    brand-gradient-hover = linear-gradient(160deg, #438a8b 0%, #2c6870 70%, #23545d 100%)
presets:
    card-surface:
        background = linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.78))
        border = 1px solid rgba(255, 255, 255, 0.95)
        round = 24px
        box-shadow = {shadow}
        padding = 2rem
        backdrop-filter = blur(10px)

    sub-card:
        background = linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(244, 250, 246, 0.75))
        border = 1px solid {border}
        round = 16px
        padding = 1.2rem
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.9)

    button-primary:
        background = {brand-gradient}
        color = white
        padding = 0.85rem 1.35rem
        round = 12px
        text-decoration = none
        font-weight = 700
        display = inline-block
        border = 1px solid rgba(27, 70, 75, 0.15)
        cursor = pointer
        transition = background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 6px 16px rgba(29, 79, 82, 0.2)

    button-secondary:
        background = linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(239, 248, 243, 0.8))
        color = {brand}
        padding = 0.85rem 1.35rem
        round = 12px
        text-decoration = none
        font-weight = 700
        display = inline-block
        border = 1px solid #c6dcd4
        cursor = pointer
        transition = all 0.2s ease
        box-shadow = inset 0 1px 0 white, 0 3px 10px rgba(28, 72, 69, 0.04)

rules:
    .skip-link:
        position = fixed
        top = 0.5rem
        left = 0.5rem
        z-index = 100
        padding = 0.75rem 1rem
        background = {brand-dark}
        color = white
        border-radius = 8px
        transform = translateY(-200%)

    .skip-link:focus:
        transform = translateY(0)

    .content-area h1:
        font-size = clamp(1.75rem, 3vw, 2.25rem)
        line-height = 1.2
        scroll-margin-top = 6rem

    #content:
        scroll-margin-top = 5rem

    .language-summary:
        min-height = 44px
        padding = 0.6rem
        color = {brand}
        font-size = 0.85rem
        font-weight = 600
        cursor = pointer

    .site-header .language-control .language-selector:
        position = absolute
        right = 0
        top = calc(100% + 0.35rem)
        z-index = 30
        min-width = 160px
        display = flex
        flex-direction = column
        align-items = stretch
        padding = 0.5rem
        background = white
        border = 1px solid {border}
        border-radius = 8px
        box-shadow = 0 8px 24px rgba(26, 67, 66, 0.12)

    .language-control .language-label, .language-control .language-sep:
        display = none

    .quickstart-browser:
        margin-bottom = 1.5rem

    .showcase-intro h1:
        margin = 0.5rem 0 0.75rem

    .showcase-intro .lead:
        margin = 0.75rem 0

    .showcase-try:
        margin = 0.75rem 0 0
        font-weight = 600

    .showcase-notes > summary:
        min-height = 44px
        padding = 0.5rem 0
        cursor = pointer
        font-weight = 600

    .sandbox-advanced > summary:
        min-height = 44px
        padding = 0.6rem 0.75rem
        cursor = pointer
        color = {brand}
        border = 1px solid {border}
        border-radius = 8px

    .installation-method:
        padding = 0.75rem 1rem
        border = 1px solid {border}
        border-radius = 8px
        margin = 0.5rem 0

    .installation-method summary:
        cursor = pointer
        min-height = 44px
        padding = 0.5rem 0
        font-weight = 600

    .quickstart-steps:
        padding-left = 1.5rem

    .quickstart-steps > li:
        padding-left = 0.5rem
        margin = 1.5rem 0

    .command-block:
        min-width = 0
        margin = 0.75rem 0

    .command-copy:
        min-height = 44px
        padding = 0.5rem 0.75rem
        border = 1px solid {border}
        border-radius = 8px
        background = white
        color = {brand}
        cursor = pointer

    .command-block pre:
        margin-top = 0.5rem

    *:
        box-sizing = border-box

    html:
        scroll-behavior = smooth

    body:
        margin = 0
        font-family = Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
        background = radial-gradient(900px 600px at 100% 0%, rgba(169, 216, 201, 0.28), transparent), radial-gradient(700px 500px at 0% 25rem, rgba(244, 178, 150, 0.16), transparent), linear-gradient(180deg, #fbfcf9, {bg} 70rem)
        color = {text}
        line-height = 1.6
        -webkit-font-smoothing = antialiased

    .site-shell:
        min-height = 100vh
        padding-bottom = 1.5rem

    .built-with-tag:
        position = static
        margin = 1.5rem auto
        width = fit-content
        display = flex
        align-items = center
        gap = 0.65rem
        max-width = calc(100% - 2rem)
        min-height = 44px
        padding = 0.65rem 0.9rem
        border = 1px solid rgba(160, 203, 190, 0.4)
        border-radius = 14px
        background = linear-gradient(160deg, rgba(40, 84, 88, 0.95), rgba(21, 53, 60, 0.97))
        color = #edf8f2
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.17), 0 6px 22px rgba(26, 63, 63, 0.19)
        font-size = 0.82rem
        font-weight = 600
        line-height = 1.35
        text-decoration = none
        backdrop-filter = blur(14px)

    .built-with-tag:hover:
        background = {brand-gradient-hover}
        color = white

    .built-with-compact:
        display = none

    .brand-logo, .footer-brand img:
        filter = contrast(1.1)

    .built-with-tag:focus-visible:
        outline = 2px solid {brand}
        outline-offset = 3px

    .dev-banner:
        display = flex
        align-items = center
        justify-content = center
        gap = 0.75rem
        flex-wrap = wrap
        padding = 0.45rem 1.5rem
        background = linear-gradient(100deg, #f9e9df, #e5f1e9)
        color = #345556
        font-size = 0.8rem
        font-weight = 600
        text-align = center
        border-bottom = 1px solid rgba(36, 83, 79, 0.07)

    .dev-banner-badge:
        background = #27555b
        color = #fff0e4
        padding = 0.15rem 0.6rem
        round = 999px
        font-size = 0.65rem
        letter-spacing = 0.09em
        text-transform = uppercase

    .dev-banner-link:
        color = {accent-ink}
        text-decoration = underline
        font-weight = 700

    .site-header:
        position = sticky
        top = 0
        z-index = 30
        background = #fcfdfa
        color = {text}
        padding = 0.5rem max(1.5rem, calc((100vw - 1280px) / 2))
        min-height = 70px
        display = grid
        grid-template-columns = 1fr auto 1fr
        align-items = center
        gap = 1.5rem
        border-bottom = 1px solid {border}

    .brand-name:
        font-size = 1.55rem
        line-height = 1.1
        letter-spacing = -0.055em
        color = {brand-dark}
        white-space = nowrap

    .eyebrow:
        display = inline-block
        margin = 0 0 0.35rem
        font-size = 0.72rem
        font-weight = 700
        letter-spacing = 0.1em
        text-transform = uppercase
        color = #527b75

    .site-nav:
        display = flex
        align-items = center
        gap = 0.4rem

    .menu-category-label, .navigation-toggle:
        min-height = 44px
        padding = 0.65rem 0.85rem
        border = 0
        border-radius = 8px
        background = transparent
        color = {brand-dark}
        font: inherit
        font-size = 0.9rem
        font-weight = 700
        list-style = none
        cursor = pointer
        display = flex
        justify-content = space-between
        align-items = center
        gap = 0.65rem

    .menu-category-label::-webkit-details-marker:
        display = none

    .menu-category-label::after:
        content = '""'
        height = 0.42rem
        width = 0.42rem
        border-right = 1.5px solid currentColor
        border-bottom = 1.5px solid currentColor
        transform = translateY(-0.12rem) rotate(45deg)

    .menu-category[open] .menu-category-label::after:
        transform = translateY(0.12rem) rotate(225deg)

    .menu-category-label:hover, .menu-category[open] .menu-category-label, .menu-category:has([aria-current="page"], [aria-current="location"]) .menu-category-label, .navigation-toggle:hover:
        background = #eaf3ee

    .menu-category-label:focus-visible:
        outline = 2px solid {brand}
        outline-offset = 2px

    .menu-panel:
        position = absolute
        inset = 100% 0 auto
        max-height = calc(100dvh - 76px)
        overflow-y = auto
        overscroll-behavior = contain
        background = #fcfdfa
        border-block = 1px solid {border}
        box-shadow = 0 24px 36px rgba(14, 44, 42, 0.18)

    .menu-panel-inner:
        display = grid
        grid-template-columns = repeat(2, minmax(0, 1fr))
        align-items = start
        gap = 2rem
        max-width = 1240px
        margin = 0 auto
        padding = 1.75rem 2rem 2rem

    .menu-panel-inner.menu-panel-learn:
        grid-template-columns = repeat(4, minmax(0, 1fr))

    .menu-panel-inner.menu-panel-games:
        grid-template-columns = minmax(0, 2fr) minmax(240px, 1fr)

    .menu-panel-games .nav-group:
        display = grid
        grid-template-columns = repeat(2, minmax(0, 1fr))
        align-items = start
        column-gap = 0.7rem

    .menu-panel-games h3:
        grid-column = 1 / -1

    .game-preview:
        min-width = 0
        overflow = hidden
        border = 1px solid {border}
        border-radius = 12px
        background = #eaf3ee

    .game-gallery:
        max-width = 46rem
        margin-inline = auto

    .game-gallery h2:
        margin = 0 0 1rem

    .game-preview-slide:
        display = grid
        color = {brand-dark}
        text-decoration = none

    .game-preview-slide[hidden], .game-preview-controls[hidden], .game-preview:not([data-preview-ready]) .game-preview-slide:not(:first-child):
        display = none

    .game-preview-slide img:
        display = block
        width = 100%
        height = auto
        aspect-ratio = 16 / 9
        object-fit = cover
        image-rendering = pixelated
        background = #132b33

    .game-preview-slide strong:
        padding = 0.7rem 0.9rem

    .game-preview-slide:hover strong:
        text-decoration = underline

    .game-preview-controls:
        display = flex
        align-items = center
        flex-wrap = wrap
        gap = 0.3rem
        border-top = 1px solid {border}
        padding = 0.3rem 0.55rem

    .game-preview-controls button:
        min-height = 44px
        min-width = 44px
        border = 0
        border-radius = 6px
        background = transparent
        color = {brand-dark}
        font = inherit
        font-weight = 700
        cursor = pointer

    .game-preview-controls button:hover:
        background = #dcece4

    .game-preview-controls .game-preview-step:
        font-size = 1.4rem

    .game-preview-count:
        color = {text-soft}
        font-size = 0.8rem
        font-variant-numeric = tabular-nums

    .game-preview-controls .game-preview-toggle:
        margin-left = auto
        padding-inline = 0.45rem
        font-size = 0.8rem

    .game-preview-slide:focus-visible:
        outline-offset = -4px

    .game-preview-status:
        position = absolute
        width = 1px
        height = 1px
        overflow = hidden
        clip-path = inset(50%)

    .header-actions:
        display = flex
        justify-content = flex-end
        align-items = center

    .language-selector:
        display = flex
        align-items = center
        gap = 0.5rem
        font-size = 0.8rem

    .language-control:
        position = relative
        min-width = 0
        max-width = 100%

    .language-help:
        display = grid
        gap = 0.4rem
        font-size = 0.85rem
        line-height = 1.5

    .language-help a:
        color = {brand}
        text-underline-offset = 3px

    .language-help strong:
        color = {brand-dark}

    .application-guide li:
        margin-bottom = 0.65rem

    .language-label:
        color = {text-soft}
        font-weight = 600
        font-size = 0.76rem
        padding-left = 0.2rem

    .language-link:
        color = #466966
        text-decoration = none
        padding = 0.25rem 0.35rem
        border-radius = 5px
        transition = all 0.2s ease
        cursor = pointer

    .language-link:hover:
        background = #e6f1eb
        color = {brand-dark}

    .language-link.active, .language-link[aria-current=page]:
        color = {brand}
        font-weight = 700
        background = #e4f2ec

    .language-sep:
        color = #94ada6
        font-size = 0.7rem

    .card:
        use = (card-surface)
        margin-bottom = 1.75rem

    .hero:
        display = grid
        grid-template-columns = minmax(0, 1.15fr) minmax(0, 1fr)
        gap = clamp(1.5rem, 5vw, 4.5rem)
        align-items = center
        padding = clamp(1.5rem, 5.4vw, 5rem)
        border-radius = 22px
        background = radial-gradient(ellipse at 92% 0%, #28615e, transparent 66%), #102f36
        color = #e2eeea

    .content-area .hero h1:
        margin = 0 0 1.1rem
        color = #fffdfa
        font-size = clamp(2.6rem, 4.5vw, 4.25rem)
        line-height = 1.04
        letter-spacing = -0.066em
        text-wrap = balance

    .hero-copy > .eyebrow:
        color = #aee1c8
        margin-bottom = 1rem

    .hero-copy .lead:
        color = #e2eeea

    .lead:
        max-width = 60ch
        font-size = 1.02rem
        line-height = 1.75

    .hero .cta:
        background = #bdf0d1
        color = #143937
        box-shadow = none

    .hero .cta:hover:
        background = #dbfae7

    .hero .secondary-cta:
        background = transparent
        color = #fffdfa
        border-color = #86a6a0
        box-shadow = none

    .hero .secondary-cta:hover:
        background = #225155

    .hero a:focus-visible:
        outline-color = #bdf0d1

    .hero-preview:
        background = #10292e
        border = 1px solid #47736f
        border-radius = 14px
        overflow = hidden
        box-shadow = 0 20px 35px rgba(2, 21, 25, 0.3)
        font-family = ui-monospace, SFMono-Regular, Consolas, monospace

    .hero-preview-title:
        display = flex
        justify-content = space-between
        align-items = center
        padding = 0.8rem 1.15rem
        color = #e0eeeb
        background = #193a3e
        border-bottom = 1px solid #365b5a
        font-size = 0.8rem

    .hero-format:
        color = #aee1c8

    .hero-preview-code:
        margin = 0
        padding = clamp(1rem, 3vw, 2rem)
        overflow-x = auto
        border = 0
        border-radius = 0
        background = transparent
        box-shadow = none
        color = #e6f2ed
        font-size = clamp(0.85rem, 1.55vw, 1.08rem)
        line-height = 1.7

    .hero-preview-code code:
        font-family = inherit
        color = inherit
        padding = 0
        background = none

    .hero-preview-code span:
        display = block

    .hero-code-heading:
        color = #aee1c8
        font-weight = 700

    .hero-code-route:
        margin-top = 1rem

    .hero-code-indent:
        padding-left = 2ch
        color = #ffceba

    .home-showcase .section-heading:
        margin-bottom = 1rem

    .home-showcase h2, .home-showcase p:
        margin = 0

    .home-showcase p:
        color = {text-soft}

    .home-showcase-grid:
        display = grid
        grid-template-columns = repeat(2, minmax(0, 1fr))
        gap = 1.25rem

    .examples-more:
        display = inline-flex
        align-items = center
        min-height = 44px
        margin-top = 0.65rem

    .showcase-tile:
        position = relative
        display = grid
        align-content = end
        isolation = isolate
        overflow = hidden
        min-height = clamp(10rem, 22vw, 18rem)
        padding = clamp(1rem, 2.1vw, 1.6rem)
        border-radius = 14px
        background = #18363d
        color = white
        text-decoration = none
        font-size = clamp(1.12rem, 2vw, 1.7rem)
        line-height = 1.22

    .showcase-tile img, .showcase-tile::after:
        position = absolute
        inset = 0
        width = 100%
        height = 100%
        z-index = -1

    .showcase-tile img:
        object-fit = cover
        image-rendering = pixelated

    .showcase-tile::after:
        content = '""'
        background = linear-gradient(0deg, rgba(6, 18, 24, 0.92), transparent 70%)

    .showcase-tile strong:
        color = #102f36
        -webkit-text-stroke = 2.6px #fffdfa
        paint-order = stroke fill

    .showcase-tile strong::after:
        content = '"↗"'
        padding-left = 0.6rem

    .showcase-tile:hover strong:
        text-decoration = underline
        text-underline-offset = 0.18em

    .hero-actions:
        display = flex
        flex-wrap = wrap
        gap = 0.9rem
        margin-top = 1.25rem

    .cta:
        use = (button-primary)

    .cta:hover:
        background = {brand-gradient-hover}
        transform = translateY(-1px)
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 8px 20px rgba(29, 79, 82, 0.22)

    .cta:active:
        transform = translateY(1px)
        box-shadow = inset 0 1px 4px rgba(14, 52, 57, 0.16)

    .secondary-cta:
        use = (button-secondary)

    .secondary-cta:hover:
        background = #e7f2ec
        border = 1px solid #9bbfb2

    .section-heading:
        margin-bottom = 1.25rem

    .section-heading h2:
        margin = 0.15rem 0 0.5rem
        letter-spacing = -0.035em
        line-height = 1.2
        color = {brand-dark}

    .section-copy:
        margin-bottom = 0
        color = {text-soft}

    .install-section:
        margin-bottom = 2rem

    .install-section h3:
        margin = 0 0 0.75rem
        color = {text}

    .install-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem

    .install-card:
        background = rgba(235, 245, 239, 0.65)
        border = 1px solid {border}
        round = 12px
        padding = 1.25rem 1.25rem 1rem
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.9)

    .install-card h4:
        margin = 0 0 0.6rem
        font-size = 1rem
        color = {text}

    .content-area p a:not([class]), .content-area li a:not([class]), .content-link:
        color = {brand}
        text-decoration = underline
        text-underline-offset = 3px
        font-weight = 600

    .content-area p a:not([class]):hover, .content-area li a:not([class]):hover, .content-link:hover:
        color = {brand-dark}
        text-decoration-thickness = 2px

    .steps-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(220px, 100%), 1fr))
        gap = 1rem

    .tour-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem
        margin-bottom = 1.25rem

    .walkthrough-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(260px, 100%), 1fr))
        gap = 1rem

    .examples-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem

    .next-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(260px, 100%), 1fr))
        gap = 1rem

    .step-card:
        use = (sub-card)

    .tour-card:
        use = (sub-card)

    .walkthrough-card:
        use = (sub-card)

    .example-card:
        use = (sub-card)
        display = flex
        flex-direction = column
        align-items = flex-start

    .next-card:
        use = (sub-card)

    .next-card ul:
        margin = 0
        padding-left = 1.25rem

    .step-number:
        display = inline-flex
        align-items = center
        justify-content = center
        width = 2rem
        height = 2rem
        border-radius = 999px
        background = linear-gradient(145deg, #fce5d7, #fff2e7)
        color = {accent-ink}
        font-weight = 800
        border = 1px solid #efdbc9

    .page:
        max-width = 1200px
        margin = 0 auto
        padding = 0

    .page > section:
        margin-bottom = 2.5rem

    .document-toc:
        display = flex
        flex-wrap = wrap
        gap = 0.65rem

    .page section[id]:
        scroll-margin-top = 6rem

    .document-toc a:
        padding = 0.55rem 0.85rem
        font-size = 0.9rem

    .document-sample:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(300px, 100%), 1fr))
        gap = 1.25rem

    .document-sample > div:
        min-width = 0

    .document-sample h4:
        margin = 0.75rem 0 0.5rem
        color = {text-soft}
        font-size = 0.82rem
        letter-spacing = 0.04em

    .document-note:
        color = {text-soft}
        font-size = 0.92rem

    .document-rules li:
        margin-bottom = 0.65rem

    .sandbox-container:
        display = flex
        flex-wrap = wrap
        gap = 1.5rem
        margin-top = 1.5rem

    .editor-pane, .output-pane:
        flex = 1 1 300px
        min-width = 0
        display = flex
        flex-direction = column

    .editor-actions:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        align-items = center

    .sandbox-edit-status:
        margin = 0.75rem 0 0
        padding = 0.65rem 0.85rem
        background = #fff0e8
        color = {accent-ink}
        border = 1px solid #efc9b9
        border-radius = 10px
        font-size = 0.88rem
        font-weight = 600

    .code-editor[data-pending-changes=true]:
        border-color = {accent}
        box-shadow = 0 0 0 1px {accent}

    .code-editor:
        position = relative
        height = 300px
        min-height = 12rem
        resize = vertical
        overflow = hidden
        border = 1px solid rgba(106, 159, 153, 0.45)
        border-radius = 12px
        background = {panel-strong}
        margin-bottom = 1rem
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 8px 20px rgba(22, 61, 62, 0.08)

    .syntax-editor:
        position = absolute
        inset = 0
        width = 100%
        height = 100%
        background = transparent
        color = white
        caret-color = white
        padding = 1rem
        border = 0
        border-radius = 0
        resize = none
        font-family = Consolas, "SFMono-Regular", Menlo, Monaco, monospace
        font-size = 1rem
        line-height = 1.6
        tab-size = 4
        white-space = pre
        overflow = auto

    .editor-highlight:
        display = none
        position = absolute
        inset = 0
        margin = 0
        padding = 1rem
        border = 0
        border-radius = 0
        overflow = hidden
        pointer-events = none
        background = transparent
        color = #e2e8f0
        font-family = Consolas, "SFMono-Regular", Menlo, Monaco, monospace
        font-size = 1rem
        line-height = 1.6
        tab-size = 4
        white-space = pre

    .editor-highlight code:
        font-family = inherit
        font-size = inherit
        line-height = inherit

    .highlight-ready .editor-highlight:
        display = block

    .highlight-ready .syntax-editor:
        color = transparent
        -webkit-text-fill-color = transparent

    .syntax-editor::placeholder:
        color = {syntax-comment}
        -webkit-text-fill-color = {syntax-comment}

    .syntax-editor::selection:
        background = rgba(110, 188, 169, 0.35)

    .code-editor:focus-within:
        outline = 2px solid {brand}
        outline-offset = 2px

    .terminal:
        background = linear-gradient(145deg, #1b3e43, #142f35)
        color = #b3e2db
        padding = 1rem
        round = 12px
        font-family = monospace
        min-height = 300px
        white-space = pre-wrap
        overflow-y = auto
        border = 1px solid rgba(128, 182, 172, 0.25)
        overflow-wrap = anywhere
        overflow-x = auto

    .sandbox-hints:
        margin-top = 1.5rem
        padding = 0.75rem 1rem
        background = #edf6ef
        border-left = 3px solid #9dcbb3
        round = 4px

    h3:
        margin-top = 0.65rem
        margin-bottom = 0.5rem

    p:
        color = {text-soft}
        white-space = pre-wrap

    li:
        color = {text-soft}
        white-space = pre-wrap

    strong:
        color = {text}

    code:
        font-family = Consolas, "SFMono-Regular", Menlo, Monaco, monospace
        background = {code-inline-bg}
        color = {code-inline-text}
        padding = 0.15rem 0.32rem
        border-radius = 5px

    pre:
        margin = 0.85rem 0 0
        background = {panel-strong}
        color = #e2e8f0
        padding = 1rem
        border-radius = 12px
        overflow-x = auto
        border = 1px solid rgba(128, 182, 172, 0.25)
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.06)

    pre code:
        background = transparent
        color = inherit
        padding = 0

    .code-block:
        display = block
        white-space = pre

    .callout:
        margin-top = 1rem
        padding = 1rem 1.1rem
        round = 14px
        border = 1px solid transparent

    .callout-success:
        background = {success-bg}
        border = 1px solid {success-border}

    .callout-info:
        background = {info-bg}
        border = 1px solid {info-border}

    .tag:
        display = inline-block
        margin-bottom = 0.45rem
        padding = 0.2rem 0.55rem
        border-radius = 999px
        font-size = 0.78rem
        font-weight = 700
        letter-spacing = 0.02em

    .tag-beginner:
        background = {beginner-bg}
        color = {beginner-text}

    .tag-practical:
        background = {practical-bg}
        color = {practical-text}

    .tag-advanced:
        background = {advanced-bg}
        color = {advanced-text}

    .site-footer:
        display = flex
        flex-wrap = wrap
        justify-content = space-between
        align-items = start
        gap = 1.5rem 3rem
        color = {text-soft}
        padding = 2rem 1rem
        font-size = 0.85rem
        max-width = 1400px
        margin = 0 auto
        border-top = 1px solid rgba(42, 91, 87, 0.1)

    .footer-identity p:
        margin = 0.5rem 0 0

    .code-block .token.comment:
        color = {syntax-comment}

    .code-block .token.shebang:
        color = {syntax-comment}

    .code-block .token.string:
        color = {syntax-string}

    .code-block .token.escape:
        color = {syntax-escape}

    .code-block .token.keyword:
        color = {syntax-keyword}
        font-weight = 700

    .code-block .token.block-keyword:
        color = {syntax-keyword}
        font-weight = 700

    .code-block .token.builtin:
        color = {syntax-builtin}

    .code-block .token.command:
        color = {syntax-builtin}

    .code-block .token.function:
        color = {syntax-function}

    .code-block .token.section-id:
        color = {syntax-function}

    .code-block .token.url:
        color = {syntax-function}

    .code-block .token.section-type:
        color = {syntax-property}
        font-weight = 600

    .code-block .token.property:
        color = {syntax-property}
        font-weight = 600

    .code-block .token.section-punctuation:
        color = {syntax-operator}

    .code-block .token.record-marker:
        color = {syntax-operator}

    .code-block .token.punctuation:
        color = {syntax-operator}

    .code-block .token.operator:
        color = {syntax-operator}

    .code-block .token.section-qualifier:
        color = {syntax-qualifier}

    .code-block .token.parameters:
        color = {syntax-qualifier}

    .code-block .token.flag:
        color = {syntax-qualifier}

    .code-block .token.number:
        color = {syntax-number}

    .code-block .token.constant:
        color = {syntax-number}

    .code-block .token.placeholder:
        color = {syntax-number}

    .code-block .token.interpolation:
        color = {syntax-interpolation}
        font-weight = 700

    .code-block .token.tag:
        color = {syntax-builtin}

    .code-block .token.attribute:
        color = {syntax-qualifier}

    .code-block .token.selector:
        color = {syntax-function}

    .code-block .token.type:
        color = {syntax-number}

    .builtin-syntax-box code:
        background = transparent
        color = inherit
        padding = 0

    .app-layout:
        display = flex
        flex-direction = column
        min-height = 100vh

    .app-body:
        display = flex
        flex = 1
        max-width = 1440px
        margin = 0 auto
        width = 100%

    .nav-group:
        min-width = 0

    .nav-group h3:
        margin = 0 0 0.4rem 0.6rem
        font-size = 0.75rem
        text-transform = uppercase
        color = #52706f
        letter-spacing = 0.07em

    .nav-link:
        text-decoration = none
        min-height = 44px
        display = block
        width = 100%
        text-align = left
        padding = 0.65rem 0.8rem
        background = transparent
        border = none
        border-radius = 10px
        color = #3e6260
        font-size = 0.88rem
        cursor = pointer
        transition = all 0.2s
        font-family = inherit

    .nav-link:hover:
        background = rgba(232, 243, 236, 0.9)

    .nav-link[aria-current="page"], .nav-link[aria-current="location"]:
        background = #e2eee7
        color = {brand-dark}
        font-weight = 700

    .content-area:
        flex = 1
        min-width = 0
        padding = 2.5rem 2rem
        max-width = none

    .reference-shell:
        margin-top = 1.5rem

    .reference-controls:
        background = linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(249, 253, 250, 0.8))
        border = 1px solid {border}
        border-radius = 18px
        padding = 1.25rem
        margin-bottom = 2rem
        box-shadow = {shadow}

    .search-input:
        width = 100%
        padding = 0.85rem 1.15rem
        border = 1px solid #c6dad1
        border-radius = 10px
        font-size = 1rem
        font-family = inherit
        background = rgba(249, 253, 250, 0.9)
        color = {text}
        outline = none
        transition = border-color 0.2s

    .search-input:focus:
        border-color = {brand}
        background = #ffffff
        box-shadow = 0 0 0 3px rgba(52, 112, 106, 0.1)

    .category-pills:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        margin-top = 1rem

    .pill:
        background = rgba(255, 255, 255, 0.78)
        border = 1px solid #d3e3da
        padding = 0.4rem 0.85rem
        border-radius = 20px
        font-size = 0.82rem
        font-weight = 600
        color = #496d66
        cursor = pointer
        transition = all 0.2s
        font-family = inherit
        box-shadow = inset 0 1px 0 white

    .pill:hover:
        background = #e9f3ed
        color = {text}

    .pill.active:
        background = {brand-gradient}
        border-color = #30656a
        color = #ffffff
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 3px 10px rgba(40, 95, 100, 0.12)

    .builtin-cards-grid:
        display = grid
        grid-template-columns = repeat(auto-fill, minmax(min(320px, 100%), 1fr))
        gap = 1.25rem
        margin-bottom = 3rem

    .builtin-card:
        background = linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(247, 252, 249, 0.88))
        border = 1px solid {border}
        border-radius = 18px
        padding = 1.25rem
        display = flex
        flex-direction = column
        justify-content = space-between
        box-shadow = 0 4px 12px rgba(15, 23, 42, 0.04)
        transition = transform 0.2s, box-shadow 0.2s

    .builtin-card:hover:
        transform = translateY(-2px)
        box-shadow = {shadow}

    .builtin-card-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.75rem

    .builtin-name:
        margin = 0
        font-size = 1.15rem
        color = {brand}
        font-family = monospace

    .category-badge:
        font-size = 0.72rem
        font-weight = 700
        text-transform = uppercase
        padding = 0.2rem 0.55rem
        border-radius = 4px
        letter-spacing = 0.04em
        background = #edf4ef
        color = #496b63

    .cat-diagnostics:
        background = #fef3c7
        color = #b45309

    .cat-http:
        background = #e1f0ee
        color = #285f64

    .cat-data:
        background = #dcfce7
        color = #15803d

    .cat-schema:
        background = #f3e8ff
        color = #7e22ce

    .cat-memory:
        background = #e0e7ff
        color = #4338ca

    .cat-io:
        background = #fff0e5
        color = #a5432e

    .cat-context:
        background = #ccfbf1
        color = #0f766e

    .cat-websocket:
        background = #fce7f3
        color = #be185d

    .builtin-summary:
        font-size = 0.92rem
        color = {text-soft}
        margin = 0 0 1rem 0
        line-height = 1.5

    .builtin-syntax-box:
        background = {panel-strong}
        color = #b3e2db
        padding = 0.6rem 0.85rem
        border-radius = 6px
        font-family = monospace
        font-size = 0.82rem
        margin-bottom = 1rem
        overflow-x = auto
        white-space = nowrap

    .builtin-card-actions:
        display = flex
        justify-content = flex-end

    .load-sandbox-btn:
        background = #edf7f0
        border = 1px solid #bedbca
        color = {brand}
        padding = 0.45rem 0.85rem
        border-radius = 6px
        font-size = 0.85rem
        font-weight = 600
        cursor = pointer
        transition = all 0.2s
        font-family = inherit

    .load-sandbox-btn:hover:
        background = {brand}
        color = #ffffff
        border-color = {brand}

    .pulse-highlight:
        animation = pulse-border 1.2s ease-in-out

    .empty-results:
        grid-column = 1 / -1
        text-align = center
        padding = 3rem
        background = {panel}
        border = 1px solid {border}
        border-radius = 12px
        color = {text-soft}

    .interactive-reference-sandbox:
        margin-top = 2rem
        border-top = 2px dashed {border}
        padding-top = 2.5rem

    .site-header .navigation-toggle:
        display = none

    .page, .hero > *, .install-grid > *, .steps-grid > *, .tour-grid > *, .walkthrough-grid > *, .examples-grid > *, .next-grid > *, .builtin-card:
        min-width = 0

    .content-area, .site-header, .site-footer:
        overflow-wrap = anywhere

    pre, .code-block, .builtin-syntax-box:
        overflow-wrap = normal

    .editor-actions, .language-selector, .builtin-card-header:
        flex-wrap = wrap
        gap = 0.5rem

    .nav-link, .language-link, .pill, .load-sandbox-btn:
        min-height = 44px

    .language-link:
        display = inline-flex
        align-items = center

    .example-picker:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        margin-bottom = 1.5rem

    .example-card .secondary-cta:
        margin-top = auto
        font-family = inherit
        font-size = 1rem

    .example-preview:
        display = block
        box-sizing = border-box
        width = 100%
        height = 560px
        border = 1px solid {border}
        border-radius = 12px
        background = {panel}

    .example-game-panel:
        position = relative

    .web-example[data-game=true]:not([data-load-state=ready]) .example-preview:
        pointer-events = none

    .game-loader:
        position = absolute
        inset = 0
        z-index = 1
        display = flex
        align-items = flex-start
        justify-content = center
        padding = 56px 24px
        border = 1px solid #34435d
        border-radius = 12px
        background = #10182e
        text-align = center

    .game-loader-card:
        max-width = 400px

    .game-loader strong:
        display = block
        font-size = 24px
        color = #58efd5

    .game-load-status:
        color = #b8c8d9
        margin = 12px 0 20px

    .game-load-progress:
        display = block
        width = 160px
        max-width = 100%
        height = 6px
        margin = 0 auto
        accent-color = #58efd5

    .game-load-retry:
        margin-top = 20px
        min-height = 44px
        padding = 10px 18px
        border = 1px solid #58efd5
        border-radius = 6px
        background = #18233b
        color = #e1f5ef
        cursor = pointer

    .web-example[data-load-state=ready] .game-loader, .game-load-retry[hidden], .game-load-progress[hidden]:
        display = none !important

    .space-invaders-page .example-preview:
        height = clamp(400px, 85svh, 720px)
        box-sizing = border-box

    .studio-page .example-preview:
        height = clamp(480px, 85svh, 860px)
        box-sizing = border-box

    .iframe-fullscreen:
        touch-action = none
        overscroll-behavior = none
        user-select = none
        -webkit-user-select = none
        position = fixed !important
        top = 0 !important
        left = 0 !important
        width = 100vw !important
        height = 100dvh !important
        z-index = 999999 !important
        border = none !important
        border-radius = 0 !important
        margin = 0 !important
        max-width = none !important
        background = #020308 !important

    .iframe-fullscreen-host:
        backdrop-filter = none !important
        -webkit-backdrop-filter = none !important

    body.has-iframe-fullscreen:
        overflow = hidden !important

    .example-source:
        margin-top = 1.25rem
        min-width = 0

    .example-tabs:
        display = flex
        gap = 0.5rem
        border-bottom = 1px solid {border}
        margin-bottom = 1rem

    .example-tabs button:
        min-height = 44px
        padding = 0.65rem 1rem
        border = 0
        border-bottom = 3px solid transparent
        background = transparent
        color = {text-soft}
        font = inherit
        font-weight = 600
        cursor = pointer

    .example-tabs button[aria-selected=true]:
        border-bottom-color = {brand}
        color = {brand}

    .example-tabs button:focus-visible:
        outline = 2px solid {brand}
        outline-offset = -2px

    .web-example[data-game=true] .example-source:
        margin-top = 0

    .web-example[data-game=true] .example-source > summary:
        display = none

    .web-example[data-game=true][data-active-tab=game] .example-source-panel, .web-example[data-game=true][data-active-tab=source] .example-game-panel:
        display = none

    .source-tools, .source-actions:
        display = flex
        align-items = center
        flex-wrap = wrap
        gap = 0.75rem
        margin = 0.5rem 0

    .source-filter:
        flex = 1
        min-width = 0
        padding = 0.7rem
        border = 1px solid {border}
        border-radius = 8px
        font = inherit

    .source-count:
        font-variant-numeric = tabular-nums

    .source-actions button:
        min-height = 44px
        padding = 0.5rem 0.75rem
        border = 1px solid {border}
        border-radius = 8px
        background = {panel}
        color = {brand}
        cursor = pointer

    .source-filter:focus-visible, .source-actions button:focus-visible, .source-file summary:focus-visible, .example-code:focus-visible:
        outline = 2px solid {brand}
        outline-offset = 3px

    .source-file:
        margin-top = 0.5rem
        border = 1px solid {border}
        border-radius = 12px
        padding = 0 1rem
        background = rgba(255, 255, 255, 0.72)

    .source-file[open]:
        padding-bottom = 0.75rem

    .example-source summary, .source-file summary:
        min-height = 44px
        padding = 0.65rem 0
        cursor = pointer
        color = {brand}
        font-weight = 700

    .source-file summary:
        font-family = ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace
        font-size = 0.92rem
        overflow-wrap = anywhere

    .example-code:
        max-height = 32rem
        overflow = auto

    .api-request-row:
        flex-wrap = wrap

    .api-request-row select:
        min-width = 0
        max-width = 100%

    .request-path:
        width = 100%
        margin-top = 0.75rem
        padding = 0.6rem
        border = 1px solid {border}
        border-radius = 6px
        font-family = monospace
        font-size = 1rem

    .graphql-console label:
        display = block
        margin = 0.75rem 0 0.4rem
        font-weight = 600

    .code-editor.query-editor:
        height = 16rem

    .code-editor.variables-editor:
        height = 9rem
        min-height = 6rem

    .graphql-execute:
        margin-top = 1rem

    .graphql-schema:
        margin = 1rem 0

    .graphql-schema summary:
        cursor = pointer
        padding = 0.5rem 0
        color = {brand}
        font-weight = 600

    .graphql-schema pre:
        max-height = 20rem
        overflow = auto

    a:focus-visible, button:focus-visible, select:focus-visible:
        outline = 2px solid {brand}
        outline-offset = 3px

    .brand:
        display = flex
        align-items = center
        gap = 0.8rem
        min-width = 0
        max-width = 360px
        color = inherit
        text-decoration = none

    .brand-logo:
        display = block
        width = 48px
        height = 48px
        flex-shrink = 0
        border-radius = 50%
        mix-blend-mode = multiply

    .header-actions .language-selector:
        gap = 0.15rem
        padding = 0.2rem 0.35rem
        background = rgba(255, 255, 255, 0.62)
        border = 1px solid rgba(200, 219, 211, 0.7)
        border-radius = 12px

    .builtin-card:hover, .example-card:hover:
        border-color = #adcfc0
        box-shadow = inset 0 1px 0 white, 0 12px 28px rgba(39, 87, 76, 0.09)

    .footer-brand:
        display = flex
        align-items = center
        gap = 0.5rem
        color = {brand-dark}

    .footer-brand img:
        border-radius = 50%
        mix-blend-mode = multiply

# Responsive overrides are emitted after base rules, in the order below.
    .developer-nav:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        margin = 0 0 1.5rem
        padding = 0.75rem
        background = {info-bg}
        border = 1px solid {info-border}
        border-radius = 16px

    .developer-nav a:
        padding = 0.65rem 0.8rem
        min-height = 44px
        border-radius = 10px
        color = {brand-dark}
        text-decoration = none
        font-weight = 600

    .developer-nav a[aria-current=page]:
        background = {brand-dark}
        color = white

    .developer-nav a:hover:
        text-decoration = underline

    .developer-page .card h2:
        scroll-margin-top = 2rem

    .developer-page .command-block:
        min-width = 0
        max-width = 100%

    .releases-page:
        max-width = 54rem

    .release-archive-header h1:
        margin-top = 0

    .release-list:
        list-style = none
        padding = 0
        margin = 0

    .release-entry:
        display = grid
        grid-template-columns = minmax(8.25rem, 1fr) minmax(0, 4fr)
        align-items = start
        gap = 1rem 1.5rem
        padding = clamp(1rem, 3vw, 1.5rem)
        margin-bottom = 0.8rem
        scroll-margin-top = 6rem

    .release-entry-meta:
        display = grid
        gap = 0.2rem
        color = {text-soft}
        font-size = 0.83rem
        font-variant-numeric = tabular-nums

    .release-entry h2:
        font-size = 1.2rem
        line-height = 1.2
        margin = 0
        color = {brand-dark}

    .release-entry-body p:
        margin = 0

    .release-entry-body a:
        display = inline-flex
        align-items = center
        min-height = 44px

responsive:
    (max-width: 1000px):
        .dev-banner-badge:
            display = none

    (max-width: 900px):
        .site-header:
            grid-template-columns = minmax(0, 1fr) auto auto
            min-height = 64px
            padding = 0.4rem 1rem
            gap = 0.4rem

        .language-prefix:
            display = none

        .language-summary:
            padding-inline = 0.35rem

        .site-header .navigation-toggle:
            display = flex

        .menu-icon:
            height = 12px
            width = 15px
            border-block = 2px solid currentColor
            background = linear-gradient(currentColor, currentColor) center / 100% 2px no-repeat

        .navigation-toggle[aria-expanded="true"] .menu-icon:
            border-color = transparent
            background = linear-gradient(45deg, transparent 44%, currentColor 44%, currentColor 56%, transparent 56%), linear-gradient(-45deg, transparent 44%, currentColor 44%, currentColor 56%, transparent 56%)

        .site-nav:
            display = none
            position = absolute
            inset = 100% 0 auto
            max-height = calc(100dvh - 105px)
            overflow-y = auto
            overscroll-behavior = contain
            background = #fcfdfa
            border-block = 1px solid {border}
            padding = 0.5rem 1rem 1rem
            box-shadow = 0 18px 28px rgba(14, 44, 42, 0.16)

        .site-header[data-mobile-menu="true"] .site-nav:
            display = block

        .menu-category:
            border-bottom = 1px solid {border}

        .menu-category-label:
            min-height = 52px

        .menu-panel:
            position = static
            max-height = none
            overflow = visible
            border = 0
            box-shadow = none

        .menu-panel-inner, .menu-panel-inner.menu-panel-learn, .menu-panel-inner.menu-panel-games:
            grid-template-columns = minmax(0, 1fr)
            gap = 0.9rem
            padding = 0.85rem 0.5rem 1rem

        .menu-panel-games .game-preview:
            display = none

        .hero:
            grid-template-columns = minmax(0, 1fr)
            gap = 1.5rem

        .content-area:
            width = 100%
            padding = 1.5rem

        .page:
            padding = 0

    (max-width: 640px):
        .release-entry:
            grid-template-columns = minmax(0, 1fr)
            gap = 0.65rem

        .release-entry-meta:
            display = flex
            align-items = baseline
            flex-wrap = wrap
            gap = 0.3rem 0.65rem

        .developer-nav:
            display = none

        .built-with-tag:
            padding = 0.55rem 0.7rem
            gap = 0.4rem
            font-size = 0.72rem

        .built-with-label:
            position = absolute
            width = 1px
            height = 1px
            overflow = hidden
            clip-path = inset(50%)
            white-space = nowrap

        .built-with-compact:
            display = inline

        .dev-banner:
            padding = 0.4rem 0.75rem
            gap = 0.35rem 0.65rem
            font-size = 0.75rem

        .site-header:
            padding = 0.5rem 1rem
            min-height = 64px
            align-items = center

        .brand-name:
            font-size = 1.25rem

        .brand-logo:
            width = 36px
            height = 36px

        .header-actions:
            width = auto
            margin-left = auto

        .language-selector:
            gap = 0.25rem

        .nav-link:
            padding = 0.6rem 0.5rem

        .content-area:
            padding = 1.25rem 0.75rem

        .card:
            padding = 1.25rem
            border-radius = 18px
            margin-bottom = 1.25rem

        .hero, .sandbox-container:
            gap = 1rem

        .space-invaders-page .example-preview:
            border = 2px solid #00ff88
            border-radius = 12px
            box-shadow = 0 0 25px rgba(0, 255, 136, 0.2)

        .studio-page .example-preview:
            border = 2px solid #00e5ff
            border-radius = 12px
            box-shadow = 0 0 25px rgba(0, 229, 255, 0.2)

        .features-grid:
            display = grid
            grid-template-columns = repeat(auto-fit, minmax(220px, 1fr))
            gap = 1rem
            margin = 1.25rem 0 1.5rem 0

        .feature-card:
            background = {panel-strong}
            border = 1px solid rgba(0, 255, 136, 0.2)
            border-radius = 8px
            padding = 1rem

        .feature-card h3:
            font-size = 1.05rem
            color = #00ff88
            margin = 0 0 0.5rem 0

        .feature-card p:
            font-size = 0.88rem
            color = {text-soft}
            margin = 0
            line-height = 1.5

        .content-area .hero h1:
            font-size = clamp(2rem, 9vw, 3.45rem)

        .home-showcase-grid:
            grid-template-columns = minmax(0, 1fr)
            gap = 0.8rem

        .showcase-tile:
            min-height = 11rem

        .hero-actions > a:
            flex = 1 1 auto
            padding-inline = 0.9rem
            text-align = center

        .reference-controls, .builtin-card, .install-card:
            padding = 1rem

        .syntax-editor:
            font-size = 1rem

        .site-footer:
            padding = 1rem

    (max-width: 380px):
        .navigation-toggle:
            justify-content = center
            width = 44px
            padding-inline = 0

        .menu-label:
            position = absolute
            width = 1px
            height = 1px
            overflow = hidden
            clip-path = inset(50%)

    (prefers-reduced-motion: reduce):
        html:
            scroll-behavior = auto

        *, *::before, *::after:
            transition = none !important

        .cta, .secondary-cta, .nav-link, .pill, .language-link, .builtin-card:
            transition = none

        .cta:hover, .cta:active, .builtin-card:hover:
            transform = none
