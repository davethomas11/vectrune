@Style/teaching-site
tokens:
    bg = #f3f7f4
    panel = rgba(255, 255, 255, 0.88)
    panel-strong = #142f35
    text = #193a3f
    text-soft = #526c6c
    border = #d5e3dd
    brand = #285f64
    brand-dark = #173e44
    success-bg = #ecfdf3
    success-border = #86efac
    info-bg = #eaf5f2
    info-border = #a9cfca
    shadow = inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 16px 42px rgba(26, 67, 66, 0.065)
    code-inline-bg = #e9f2ee
    code-inline-text = #285b60
    hero-panel-bg = rgba(248, 253, 250, 0.78)
    hero-panel-border = #d1e3da
    beginner-bg = #e2f3e8
    beginner-text = #245f45
    practical-bg = #e3f1ef
    practical-text = #285f64
    advanced-bg = #fff0e8
    advanced-text = #a5432e
    syntax-comment = #9db5b7
    syntax-string = #ffc1ad
    syntax-escape = #fcd34d
    syntax-keyword = #d7c5ff
    syntax-builtin = #86ddd3
    syntax-function = #9bc6ef
    syntax-property = #edf8f5
    syntax-operator = #f1c58c
    syntax-qualifier = #a5b4fc
    syntax-number = #ace1b4
    syntax-interpolation = #ffd29c
    accent = #ed7d62
    accent-ink = #a5432e
    brand-gradient = linear-gradient(160deg, #3b7c7e 0%, #23565e 70%, #1b454d 100%)
    brand-gradient-hover = linear-gradient(160deg, #438a8b 0%, #2c6870 70%, #23545d 100%)
presets:
    card-surface:
        background = linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.78))
        border = 1px solid rgba(255, 255, 255, 0.95)
        round = 24px
        box-shadow = {shadow}
        padding = 2rem
        backdrop-filter = blur(10px)

    sub-card:
        background = linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(244, 250, 246, 0.75))
        border = 1px solid {border}
        round = 16px
        padding = 1.2rem
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.9)

    button-primary:
        background = {brand-gradient}
        color = white
        padding = 0.85rem 1.35rem
        round = 12px
        text-decoration = none
        font-weight = 700
        display = inline-block
        border = 1px solid rgba(27, 70, 75, 0.15)
        cursor = pointer
        transition = background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 6px 16px rgba(29, 79, 82, 0.2)

    button-secondary:
        background = linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(239, 248, 243, 0.8))
        color = {brand}
        padding = 0.85rem 1.35rem
        round = 12px
        text-decoration = none
        font-weight = 700
        display = inline-block
        border = 1px solid #c6dcd4
        cursor = pointer
        transition = all 0.2s ease
        box-shadow = inset 0 1px 0 white, 0 3px 10px rgba(28, 72, 69, 0.04)

rules:
    *:
        box-sizing = border-box

    html:
        scroll-behavior = smooth

    body:
        margin = 0
        font-family = Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
        background = radial-gradient(900px 600px at 100% 0%, rgba(169, 216, 201, 0.28), transparent), radial-gradient(700px 500px at 0% 25rem, rgba(244, 178, 150, 0.16), transparent), linear-gradient(180deg, #fbfcf9, #f3f7f4 70rem)
        color = {text}
        line-height = 1.6
        -webkit-font-smoothing = antialiased

    .site-shell:
        min-height = 100vh
        padding-bottom = calc(5rem + env(safe-area-inset-bottom, 0px))

    .built-with-tag:
        position = fixed
        right = max(1rem, env(safe-area-inset-right, 0px))
        bottom = max(1rem, env(safe-area-inset-bottom, 0px))
        z-index = 20
        display = flex
        align-items = center
        gap = 0.65rem
        max-width = calc(100% - 2rem)
        min-height = 44px
        padding = 0.65rem 0.9rem
        border = 1px solid rgba(160, 203, 190, 0.4)
        border-radius = 14px
        background = linear-gradient(160deg, rgba(40, 84, 88, 0.95), rgba(21, 53, 60, 0.97))
        color = #edf8f2
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.17), 0 6px 22px rgba(26, 63, 63, 0.19)
        font-size = 0.82rem
        font-weight = 600
        line-height = 1.35
        text-decoration = none
        backdrop-filter = blur(14px)

    .built-with-tag:hover:
        background = {brand-gradient-hover}
        color = white

    .built-with-compact:
        display = none

    .brand-logo, .hero-logo, .footer-brand img:
        filter = contrast(1.1)

    .built-with-tag:focus-visible:
        outline = 2px solid {brand}
        outline-offset = 3px

    .dev-banner:
        display = flex
        align-items = center
        justify-content = center
        gap = 0.75rem
        flex-wrap = wrap
        padding = 0.45rem 1.5rem
        background = linear-gradient(100deg, #f9e9df, #e5f1e9)
        color = #345556
        font-size = 0.8rem
        font-weight = 600
        text-align = center
        border-bottom = 1px solid rgba(36, 83, 79, 0.07)

    .dev-banner-badge:
        background = #27555b
        color = #fff0e4
        padding = 0.15rem 0.6rem
        round = 999px
        font-size = 0.65rem
        letter-spacing = 0.09em
        text-transform = uppercase

    .dev-banner-link:
        color = {accent-ink}
        text-decoration = underline
        font-weight = 700

    .site-header:
        position = sticky
        top = 0
        z-index = 10
        background = rgba(249, 253, 250, 0.86)
        color = {text}
        padding = 1rem 2rem
        display = grid
        grid-template-columns = minmax(180px, 1fr) minmax(0, 2fr) minmax(260px, 1fr)
        align-items = center
        justify-content = space-between
        gap = 1rem
        flex-wrap = wrap
        backdrop-filter = blur(20px) saturate(150%)
        -webkit-backdrop-filter = blur(20px) saturate(150%)
        border-bottom = 1px solid rgba(42, 91, 87, 0.1)
        box-shadow = 0 5px 24px rgba(37, 80, 77, 0.04)

    .brand h1:
        margin = 0
        font-size = 1.65rem
        line-height = 1.12
        letter-spacing = -0.045em
        color = {brand-dark}

    .subtitle:
        margin = 0.35rem 0 0
        color = {text-soft}
        font-size = 0.82rem
        line-height = 1.45
        max-width = 32ch

    .eyebrow:
        display = inline-block
        margin = 0 0 0.35rem
        font-size = 0.72rem
        font-weight = 700
        letter-spacing = 0.1em
        text-transform = uppercase
        color = #527b75

    .site-nav:
        display = flex
        flex-wrap = wrap
        gap = 0.25rem
        justify-content = center

    .site-nav a:
        color = #345c5e
        text-decoration = none
        font-weight = 600
        opacity = 1
        font-size = 0.86rem
        padding = 0.4rem 0.65rem
        border-radius = 10px
        transition = background 0.2s ease, color 0.2s ease

    .header-actions:
        display = flex
        align-items = center
        gap = 0.5rem

    .language-selector:
        display = flex
        align-items = center
        gap = 0.5rem
        font-size = 0.8rem

    .language-control:
        min-width = 0
        max-width = 100%

    .language-help:
        display = flex
        flex-wrap = wrap
        gap = 0.3rem 0.8rem
        margin-top = 0.45rem
        font-size = 0.72rem
        line-height = 1.5

    .language-help a:
        color = {brand}
        text-underline-offset = 3px

    .application-guide li:
        margin-bottom = 0.65rem

    .language-label:
        color = {text-soft}
        font-weight = 600
        font-size = 0.76rem
        padding-left = 0.2rem

    .language-link:
        color = #466966
        text-decoration = none
        padding = 0.25rem 0.35rem
        border-radius = 5px
        transition = all 0.2s ease
        cursor = pointer

    .language-link:hover:
        background = #e6f1eb
        color = {brand-dark}

    .language-link.active, .language-link[aria-current=page]:
        color = {brand}
        font-weight = 700
        background = #e4f2ec

    .language-sep:
        color = #94ada6
        font-size = 0.7rem

    .card:
        use = (card-surface)
        margin-bottom = 1.75rem

    .hero:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(280px, 100%), 1fr))
        gap = 1.75rem
        align-items = start
        position = relative
        overflow = hidden
        isolation = isolate

    .hero h2:
        margin-top = 0
        font-size = clamp(2.15rem, 4vw, 3.5rem)
        line-height = 1.07
        letter-spacing = -0.055em
        color = {brand-dark}
        margin-bottom = 1.2rem

    .lead:
        max-width = 60ch
        font-size = 1.02rem
        line-height = 1.75

    .hero-panel:
        background = linear-gradient(155deg, rgba(255, 255, 255, 0.88), rgba(231, 245, 236, 0.65))
        border = 1px solid #d2e3d8
        round = 16px
        padding = 1.25rem
        box-shadow = inset 0 1px 0 white, 0 10px 28px rgba(43, 88, 77, 0.05)
        backdrop-filter = blur(12px)

    .hero-panel h3:
        margin-top = 0
        margin = 0
        color = {brand-dark}
        letter-spacing = -0.025em

    .hero-panel ul:
        margin = 0
        padding-left = 1.25rem

    .hero-actions:
        display = flex
        flex-wrap = wrap
        gap = 0.9rem
        margin-top = 1.25rem

    .cta:
        use = (button-primary)

    .cta:hover:
        background = {brand-gradient-hover}
        transform = translateY(-1px)
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 8px 20px rgba(29, 79, 82, 0.22)

    .cta:active:
        transform = translateY(1px)
        box-shadow = inset 0 1px 4px rgba(14, 52, 57, 0.16)

    .secondary-cta:
        use = (button-secondary)

    .secondary-cta:hover:
        background = #e7f2ec
        border = 1px solid #9bbfb2

    .section-heading:
        margin-bottom = 1.25rem

    .section-heading h2:
        margin = 0.15rem 0 0.5rem
        letter-spacing = -0.035em
        line-height = 1.2
        color = {brand-dark}

    .section-copy:
        margin-bottom = 0
        color = {text-soft}

    .install-section:
        margin-bottom = 2rem

    .install-section h3:
        margin = 0 0 0.75rem
        color = {text}

    .install-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem

    .install-card:
        background = rgba(235, 245, 239, 0.65)
        border = 1px solid {border}
        round = 12px
        padding = 1.25rem 1.25rem 1rem
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.9)

    .install-card h4:
        margin = 0 0 0.6rem
        font-size = 1rem
        color = {text}

    .content-link:
        color = {brand}
        text-decoration = none
        font-weight = 600

    .steps-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(220px, 100%), 1fr))
        gap = 1rem

    .tour-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem
        margin-bottom = 1.25rem

    .walkthrough-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(260px, 100%), 1fr))
        gap = 1rem

    .examples-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem

    .next-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(260px, 100%), 1fr))
        gap = 1rem

    .step-card:
        use = (sub-card)

    .tour-card:
        use = (sub-card)

    .walkthrough-card:
        use = (sub-card)

    .example-card:
        use = (sub-card)
        display = flex
        flex-direction = column
        align-items = flex-start

    .next-card:
        use = (sub-card)

    .next-card ul:
        margin = 0
        padding-left = 1.25rem

    .step-number:
        display = inline-flex
        align-items = center
        justify-content = center
        width = 2rem
        height = 2rem
        border-radius = 999px
        background = linear-gradient(145deg, #fce5d7, #fff2e7)
        color = {accent-ink}
        font-weight = 800
        border = 1px solid #efdbc9

    .page:
        max-width = 1200px
        margin = 0 auto
        padding = 0

    .page > section:
        margin-bottom = 2.5rem

    .document-toc:
        display = flex
        flex-wrap = wrap
        gap = 0.65rem

    .page section[id]:
        scroll-margin-top = 12rem

    .document-toc a:
        padding = 0.55rem 0.85rem
        font-size = 0.9rem

    .document-sample:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(300px, 100%), 1fr))
        gap = 1.25rem

    .document-sample > div:
        min-width = 0

    .document-sample h4:
        margin = 0.75rem 0 0.5rem
        color = {text-soft}
        font-size = 0.82rem
        letter-spacing = 0.04em

    .document-note:
        color = {text-soft}
        font-size = 0.92rem

    .document-rules li:
        margin-bottom = 0.65rem

    .sandbox-container:
        display = flex
        flex-wrap = wrap
        gap = 1.5rem
        margin-top = 1.5rem

    .editor-pane, .output-pane:
        flex = 1 1 300px
        min-width = 0
        display = flex
        flex-direction = column

    .editor-actions:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        align-items = center

    .sandbox-edit-status:
        margin = 0.75rem 0 0
        padding = 0.65rem 0.85rem
        background = #fff0e8
        color = {accent-ink}
        border = 1px solid #efc9b9
        border-radius = 10px
        font-size = 0.88rem
        font-weight = 600

    .code-editor[data-pending-changes=true]:
        border-color = {accent}
        box-shadow = 0 0 0 1px {accent}

    .code-editor:
        position = relative
        height = 300px
        min-height = 12rem
        resize = vertical
        overflow = hidden
        border = 1px solid rgba(106, 159, 153, 0.45)
        border-radius = 12px
        background = {panel-strong}
        margin-bottom = 1rem
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 8px 20px rgba(22, 61, 62, 0.08)

    .syntax-editor:
        position = absolute
        inset = 0
        width = 100%
        height = 100%
        background = transparent
        color = white
        caret-color = white
        padding = 1rem
        border = 0
        border-radius = 0
        resize = none
        font-family = Consolas, "SFMono-Regular", Menlo, Monaco, monospace
        font-size = 1rem
        line-height = 1.6
        tab-size = 4
        white-space = pre
        overflow = auto

    .editor-highlight:
        display = none
        position = absolute
        inset = 0
        margin = 0
        padding = 1rem
        border = 0
        border-radius = 0
        overflow = hidden
        pointer-events = none
        background = transparent
        color = #e2e8f0
        font-family = Consolas, "SFMono-Regular", Menlo, Monaco, monospace
        font-size = 1rem
        line-height = 1.6
        tab-size = 4
        white-space = pre

    .editor-highlight code:
        font-family = inherit
        font-size = inherit
        line-height = inherit

    .highlight-ready .editor-highlight:
        display = block

    .highlight-ready .syntax-editor:
        color = transparent
        -webkit-text-fill-color = transparent

    .syntax-editor::placeholder:
        color = {syntax-comment}
        -webkit-text-fill-color = {syntax-comment}

    .syntax-editor::selection:
        background = rgba(110, 188, 169, 0.35)

    .code-editor:focus-within:
        outline = 2px solid {brand}
        outline-offset = 2px

    .terminal:
        background = linear-gradient(145deg, #1b3e43, #142f35)
        color = #b3e2db
        padding = 1rem
        round = 12px
        font-family = monospace
        min-height = 300px
        white-space = pre-wrap
        overflow-y = auto
        border = 1px solid rgba(128, 182, 172, 0.25)
        overflow-wrap = anywhere
        overflow-x = auto

    .sandbox-hints:
        margin-top = 1.5rem
        padding = 0.75rem 1rem
        background = #edf6ef
        border-left = 3px solid #9dcbb3
        round = 4px

    h3:
        margin-top = 0.65rem
        margin-bottom = 0.5rem

    p:
        color = {text-soft}
        white-space = pre-wrap

    li:
        color = {text-soft}
        white-space = pre-wrap

    strong:
        color = {text}

    code:
        font-family = Consolas, "SFMono-Regular", Menlo, Monaco, monospace
        background = {code-inline-bg}
        color = {code-inline-text}
        padding = 0.15rem 0.32rem
        border-radius = 5px

    pre:
        margin = 0.85rem 0 0
        background = {panel-strong}
        color = #e2e8f0
        padding = 1rem
        border-radius = 12px
        overflow-x = auto
        border = 1px solid rgba(128, 182, 172, 0.25)
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.06)

    pre code:
        background = transparent
        color = inherit
        padding = 0

    .code-block:
        display = block
        white-space = pre

    .callout:
        margin-top = 1rem
        padding = 1rem 1.1rem
        round = 14px
        border = 1px solid transparent

    .callout-success:
        background = {success-bg}
        border = 1px solid {success-border}

    .callout-info:
        background = {info-bg}
        border = 1px solid {info-border}

    .tag:
        display = inline-block
        margin-bottom = 0.45rem
        padding = 0.2rem 0.55rem
        border-radius = 999px
        font-size = 0.78rem
        font-weight = 700
        letter-spacing = 0.02em

    .tag-beginner:
        background = {beginner-bg}
        color = {beginner-text}

    .tag-practical:
        background = {practical-bg}
        color = {practical-text}

    .tag-advanced:
        background = {advanced-bg}
        color = {advanced-text}

    .site-footer:
        text-align = center
        color = {text-soft}
        padding = 2rem 1rem 1rem
        font-size = 0.85rem
        max-width = 1400px
        margin = 0 auto
        border-top = 1px solid rgba(42, 91, 87, 0.1)

    .code-block .token.comment:
        color = {syntax-comment}

    .code-block .token.shebang:
        color = {syntax-comment}

    .code-block .token.string:
        color = {syntax-string}

    .code-block .token.escape:
        color = {syntax-escape}

    .code-block .token.keyword:
        color = {syntax-keyword}
        font-weight = 700

    .code-block .token.block-keyword:
        color = {syntax-keyword}
        font-weight = 700

    .code-block .token.builtin:
        color = {syntax-builtin}

    .code-block .token.command:
        color = {syntax-builtin}

    .code-block .token.function:
        color = {syntax-function}

    .code-block .token.section-id:
        color = {syntax-function}

    .code-block .token.url:
        color = {syntax-function}

    .code-block .token.section-type:
        color = {syntax-property}
        font-weight = 600

    .code-block .token.property:
        color = {syntax-property}
        font-weight = 600

    .code-block .token.section-punctuation:
        color = {syntax-operator}

    .code-block .token.record-marker:
        color = {syntax-operator}

    .code-block .token.punctuation:
        color = {syntax-operator}

    .code-block .token.operator:
        color = {syntax-operator}

    .code-block .token.section-qualifier:
        color = {syntax-qualifier}

    .code-block .token.parameters:
        color = {syntax-qualifier}

    .code-block .token.flag:
        color = {syntax-qualifier}

    .code-block .token.number:
        color = {syntax-number}

    .code-block .token.constant:
        color = {syntax-number}

    .code-block .token.placeholder:
        color = {syntax-number}

    .code-block .token.interpolation:
        color = {syntax-interpolation}
        font-weight = 700

    .code-block .token.tag:
        color = {syntax-builtin}

    .code-block .token.attribute:
        color = {syntax-qualifier}

    .code-block .token.selector:
        color = {syntax-function}

    .code-block .token.type:
        color = {syntax-number}

    .builtin-syntax-box code:
        background = transparent
        color = inherit
        padding = 0

    .app-layout:
        display = flex
        flex-direction = column
        min-height = 100vh

    .app-body:
        display = flex
        flex = 1
        max-width = 1440px
        margin = 0 auto
        width = 100%

    .sidebar:
        width = 232px
        flex = 0 0 232px
        padding = 2.5rem 1.25rem
        border-right = 1px solid rgba(36, 87, 83, 0.08)
        background = linear-gradient(180deg, rgba(255, 255, 255, 0.4), transparent 50rem)

    .sidebar h3:
        margin = 0 0 0.5rem 0.5rem
        font-size = 0.68rem
        text-transform = uppercase
        color = #6c8983
        letter-spacing = 0.1em

    .nav-group:
        margin-bottom = 1.5rem

    .nav-link:
        display = block
        width = 100%
        text-align = left
        padding = 0.65rem 0.8rem
        background = transparent
        border = none
        border-radius = 10px
        color = #3e6260
        font-size = 0.88rem
        cursor = pointer
        transition = all 0.2s
        font-family = inherit

    .nav-link:hover:
        background = rgba(232, 243, 236, 0.9)

    .nav-link.active:
        background = {brand-gradient}
        color = white
        font-weight = 600
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 4px 12px rgba(30, 82, 82, 0.12)

    .nav-link.active:hover:
        background = {brand-gradient-hover}

    .content-area:
        flex = 1
        min-width = 0
        padding = 2.5rem 2rem
        max-width = none

    .reference-shell:
        margin-top = 1.5rem

    .reference-controls:
        background = linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(249, 253, 250, 0.8))
        border = 1px solid {border}
        border-radius = 18px
        padding = 1.25rem
        margin-bottom = 2rem
        box-shadow = {shadow}

    .search-input:
        width = 100%
        padding = 0.85rem 1.15rem
        border = 1px solid #c6dad1
        border-radius = 10px
        font-size = 1rem
        font-family = inherit
        background = rgba(249, 253, 250, 0.9)
        color = {text}
        outline = none
        transition = border-color 0.2s

    .search-input:focus:
        border-color = {brand}
        background = #ffffff
        box-shadow = 0 0 0 3px rgba(52, 112, 106, 0.1)

    .category-pills:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        margin-top = 1rem

    .pill:
        background = rgba(255, 255, 255, 0.78)
        border = 1px solid #d3e3da
        padding = 0.4rem 0.85rem
        border-radius = 20px
        font-size = 0.82rem
        font-weight = 600
        color = #496d66
        cursor = pointer
        transition = all 0.2s
        font-family = inherit
        box-shadow = inset 0 1px 0 white

    .pill:hover:
        background = #e9f3ed
        color = {text}

    .pill.active:
        background = {brand-gradient}
        border-color = #30656a
        color = #ffffff
        box-shadow = inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 3px 10px rgba(40, 95, 100, 0.12)

    .builtin-cards-grid:
        display = grid
        grid-template-columns = repeat(auto-fill, minmax(min(320px, 100%), 1fr))
        gap = 1.25rem
        margin-bottom = 3rem

    .builtin-card:
        background = linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(247, 252, 249, 0.88))
        border = 1px solid {border}
        border-radius = 18px
        padding = 1.25rem
        display = flex
        flex-direction = column
        justify-content = space-between
        box-shadow = 0 4px 12px rgba(15, 23, 42, 0.04)
        transition = transform 0.2s, box-shadow 0.2s

    .builtin-card:hover:
        transform = translateY(-2px)
        box-shadow = {shadow}

    .builtin-card-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.75rem

    .builtin-name:
        margin = 0
        font-size = 1.15rem
        color = {brand}
        font-family = monospace

    .category-badge:
        font-size = 0.72rem
        font-weight = 700
        text-transform = uppercase
        padding = 0.2rem 0.55rem
        border-radius = 4px
        letter-spacing = 0.04em
        background = #edf4ef
        color = #496b63

    .cat-diagnostics:
        background = #fef3c7
        color = #b45309

    .cat-http:
        background = #e1f0ee
        color = #285f64

    .cat-data:
        background = #dcfce7
        color = #15803d

    .cat-schema:
        background = #f3e8ff
        color = #7e22ce

    .cat-memory:
        background = #e0e7ff
        color = #4338ca

    .cat-io:
        background = #fff0e5
        color = #a5432e

    .cat-context:
        background = #ccfbf1
        color = #0f766e

    .cat-websocket:
        background = #fce7f3
        color = #be185d

    .builtin-summary:
        font-size = 0.92rem
        color = {text-soft}
        margin = 0 0 1rem 0
        line-height = 1.5

    .builtin-syntax-box:
        background = {panel-strong}
        color = #b3e2db
        padding = 0.6rem 0.85rem
        border-radius = 6px
        font-family = monospace
        font-size = 0.82rem
        margin-bottom = 1rem
        overflow-x = auto
        white-space = nowrap

    .builtin-card-actions:
        display = flex
        justify-content = flex-end

    .load-sandbox-btn:
        background = #edf7f0
        border = 1px solid #bedbca
        color = {brand}
        padding = 0.45rem 0.85rem
        border-radius = 6px
        font-size = 0.85rem
        font-weight = 600
        cursor = pointer
        transition = all 0.2s
        font-family = inherit

    .load-sandbox-btn:hover:
        background = {brand}
        color = #ffffff
        border-color = {brand}

    .pulse-highlight:
        animation = pulse-border 1.2s ease-in-out

    .empty-results:
        grid-column = 1 / -1
        text-align = center
        padding = 3rem
        background = {panel}
        border = 1px solid {border}
        border-radius = 12px
        color = {text-soft}

    .interactive-reference-sandbox:
        margin-top = 2rem
        border-top = 2px dashed {border}
        padding-top = 2.5rem

    .navigation-toggle:
        display = none

    .page, .hero > *, .install-grid > *, .steps-grid > *, .tour-grid > *, .walkthrough-grid > *, .examples-grid > *, .next-grid > *, .builtin-card:
        min-width = 0

    .content-area, .site-header, .site-footer:
        overflow-wrap = anywhere

    pre, .code-block, .builtin-syntax-box:
        overflow-wrap = normal

    .editor-actions, .language-selector, .builtin-card-header:
        flex-wrap = wrap
        gap = 0.5rem

    .nav-link, .language-link, .site-nav a, .pill, .load-sandbox-btn:
        min-height = 44px

    .language-link, .site-nav a:
        display = inline-flex
        align-items = center

    .example-picker:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        margin-bottom = 1.5rem

    .example-card .secondary-cta:
        margin-top = auto
        font-family = inherit
        font-size = 1rem

    .example-preview:
        display = block
        width = 100%
        height = 560px
        border = 1px solid {border}
        border-radius = 12px
        background = {panel}

    .example-source:
        margin-top = 1.25rem

    .example-source summary, .source-file summary:
        min-height = 44px
        padding = 0.65rem 0
        cursor = pointer
        color = {brand}
        font-weight = 700

    .example-code:
        max-height = 32rem
        overflow = auto

    .api-request-row:
        flex-wrap = wrap

    .api-request-row select:
        min-width = 0
        max-width = 100%

    .request-path:
        width = 100%
        margin-top = 0.75rem
        padding = 0.6rem
        border = 1px solid {border}
        border-radius = 6px
        font-family = monospace
        font-size = 1rem

    .graphql-console label:
        display = block
        margin = 0.75rem 0 0.4rem
        font-weight = 600

    .code-editor.query-editor:
        height = 16rem

    .code-editor.variables-editor:
        height = 9rem
        min-height = 6rem

    .graphql-execute:
        margin-top = 1rem

    .graphql-schema:
        margin = 1rem 0

    .graphql-schema summary:
        cursor = pointer
        padding = 0.5rem 0
        color = {brand}
        font-weight = 600

    .graphql-schema pre:
        max-height = 20rem
        overflow = auto

    a:focus-visible, button:focus-visible, select:focus-visible:
        outline = 2px solid {brand}
        outline-offset = 3px

    .brand:
        display = flex
        align-items = center
        gap = 0.8rem
        min-width = 0
        max-width = 360px
        color = inherit
        text-decoration = none

    .brand-copy:
        min-width = 0

    .brand-logo:
        display = block
        width = 64px
        height = 64px
        flex-shrink = 0
        border-radius = 50%
        mix-blend-mode = multiply

    .brand .eyebrow:
        color = #547c79
        font-size = 0.62rem
        letter-spacing = 0.11em
        margin-bottom = 0.25rem

    .site-nav a:hover:
        background = rgba(40, 95, 100, 0.07)
        color = {brand-dark}

    .header-actions .language-selector:
        gap = 0.15rem
        padding = 0.2rem 0.35rem
        background = rgba(255, 255, 255, 0.62)
        border = 1px solid rgba(200, 219, 211, 0.7)
        border-radius = 12px

    .card.hero:
        background = radial-gradient(ellipse at 100% 0%, rgba(242, 177, 145, 0.15), transparent 65%), linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(247, 253, 248, 0.82))
        border = 1px solid rgba(255, 255, 255, 0.98)

    .hero::before:
        content = '""'
        position = absolute
        width = 20rem
        height = 20rem
        right = -10rem
        top = -12rem
        border-radius = 50%
        background = radial-gradient(circle, rgba(237, 125, 98, 0.18), rgba(255, 255, 255, 0) 70%)
        pointer-events = none

    .hero > *:
        position = relative
        z-index = 1

    .hero-copy > .eyebrow:
        padding = 0.35rem 0.65rem
        background = #fff0e7
        border = 1px solid #f1dbcd
        border-radius = 999px
        color = {accent-ink}
        font-size = 0.65rem
        letter-spacing = 0.06em
        margin-bottom = 1rem

    .hero-panel-heading:
        display = flex
        align-items = center
        gap = 0.65rem
        margin-bottom = 0.8rem

    .hero-logo:
        width = 72px
        height = 72px
        flex-shrink = 0
        border-radius = 50%
        mix-blend-mode = multiply

    .hero-panel li:
        margin-bottom = 0.5rem
        font-size = 0.92rem

    .hero-panel li::marker:
        color = {accent}

    .hero-lab-link:
        display = inline-block
        margin-top = 1rem
        font-size = 0.9rem
        text-underline-offset = 4px

    .hero-lab-link:hover:
        text-decoration = underline

    .builtin-card:hover, .example-card:hover:
        border-color = #adcfc0
        box-shadow = inset 0 1px 0 white, 0 12px 28px rgba(39, 87, 76, 0.09)

    .footer-brand:
        display = flex
        align-items = center
        justify-content = center
        gap = 0.5rem
        color = {brand-dark}

    .footer-brand img:
        border-radius = 50%
        mix-blend-mode = multiply

# Responsive overrides are emitted after base rules, in the order below.
responsive:
    (max-width: 1000px):
        .page section[id]:
            scroll-margin-top = 1rem

        .site-header:
            display = flex
            position = static
            padding = 1.25rem 1.5rem
            gap = 0.75rem 1.5rem

        .site-nav:
            width = 100%
            gap = 0.25rem 1.25rem

        .app-body:
            flex-direction = column

        .sidebar:
            flex = none
            width = 100%
            display = none
            grid-template-columns = repeat(3, minmax(0, 1fr))
            gap = 1rem
            padding = 1.25rem 1.5rem
            border-right = 0
            border-bottom = 1px solid {border}

        .navigation-toggle:
            display = flex
            align-items = center
            justify-content = space-between
            width = 100%
            min-height = 52px
            padding = 0.75rem 1.5rem
            border = 0
            border-bottom = 1px solid {border}
            background = {panel}
            color = {text}
            font-size = inherit
            font-family = inherit
            font-weight = 600
            text-align = left
            cursor = pointer

        .app-body[data-navigation-open="true"] .sidebar:
            display = grid

        .nav-group:
            margin = 0
            min-width = 0

        .content-area:
            width = 100%
            padding = 1.5rem

        .page:
            padding = 0

    (max-width: 640px):
        .built-with-tag:
            padding = 0.55rem 0.7rem
            gap = 0.4rem
            font-size = 0.72rem

        .built-with-label:
            position = absolute
            width = 1px
            height = 1px
            overflow = hidden
            clip-path = inset(50%)
            white-space = nowrap

        .built-with-compact:
            display = inline

        .dev-banner:
            padding = 0.65rem 1rem
            gap = 0.35rem 0.65rem
            font-size = 0.75rem

        .site-header:
            padding = 1rem
            align-items = flex-start

        .brand h1:
            font-size = 1.5rem

        .subtitle:
            font-size = 0.82rem

        .site-nav:
            gap = 0.25rem
            justify-content = flex-start

        .brand-logo:
            width = 52px
            height = 52px

        .header-actions:
            width = 100%

        .language-selector:
            gap = 0.25rem

        .sidebar:
            grid-template-columns = repeat(2, minmax(0, 1fr))
            padding = 1rem
            gap = 1rem 0.5rem

        .nav-link:
            padding = 0.6rem 0.5rem

        .content-area:
            padding = 1.25rem 0.75rem

        .card:
            padding = 1.25rem
            border-radius = 18px
            margin-bottom = 1.25rem

        .hero, .sandbox-container:
            gap = 1rem

        .hero h2:
            font-size = clamp(2rem, 7vw, 2.6rem)

        .hero-actions > a:
            width = 100%
            text-align = center

        .reference-controls, .builtin-card, .install-card, .hero-panel:
            padding = 1rem

        .syntax-editor:
            font-size = 1rem

        .site-footer:
            padding = 1rem

    (prefers-reduced-motion: reduce):
        html:
            scroll-behavior = auto

        .cta, .secondary-cta, .nav-link, .pill, .language-link, .site-nav a, .builtin-card:
            transition = none

        .cta:hover, .cta:active, .builtin-card:hover:
            transform = none

