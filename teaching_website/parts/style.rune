@Style/teaching-site
tokens:
    bg = #f3f6fb
    panel = #ffffff
    panel-strong = #0f172a
    text = #172033
    text-soft = #5b6578
    border = #d8e1ee
    brand = #2563eb
    brand-dark = #1d4ed8
    success-bg = #ecfdf3
    success-border = #86efac
    info-bg = #eff6ff
    info-border = #93c5fd
    shadow = 0 18px 45px rgba(15, 23, 42, 0.08)
    code-inline-bg = #eef2ff
    code-inline-text = #1e3a8a
    hero-panel-bg = #f8fbff
    hero-panel-border = #cfe0ff
    beginner-bg = #dcfce7
    beginner-text = #166534
    practical-bg = #dbeafe
    practical-text = #1d4ed8
    advanced-bg = #f3e8ff
    advanced-text = #7e22ce
    syntax-comment = #94a3b8
    syntax-string = #f9a8d4
    syntax-escape = #fcd34d
    syntax-keyword = #c084fc
    syntax-builtin = #38bdf8
    syntax-function = #60a5fa
    syntax-property = #f8fafc
    syntax-operator = #fbbf24
    syntax-qualifier = #a5b4fc
    syntax-number = #86efac
    syntax-interpolation = #fdba74
presets:
    card-surface:
        background = {panel}
        border = 1px solid {border}
        round = 18px
        box-shadow = {shadow}
        padding = 2rem

    sub-card:
        background = #fcfdff
        border = 1px solid {border}
        round = 14px
        padding = 1rem 1.1rem

    button-primary:
        background = {brand}
        color = white
        padding = 0.85rem 1.35rem
        round = 10px
        text-decoration = none
        font-weight = 700
        display = inline-block
        border = none
        cursor = pointer
        transition = all 0.2s ease
        box-shadow = 0 4px 6px rgba(37, 99, 235, 0.2)

    button-secondary:
        background = #f8fbff
        color = {brand}
        padding = 0.85rem 1.35rem
        round = 10px
        text-decoration = none
        font-weight = 700
        display = inline-block
        border = 1px solid #bfd4ff
        cursor = pointer
        transition = all 0.2s ease
rules:
    *:
        box-sizing = border-box

    html:
        scroll-behavior = smooth

    body:
        margin = 0
        font-family = Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
        background = linear-gradient(180deg, #eef4ff 0%, var(--bg) 220px)
        color = {text}
        line-height = 1.6

    .site-shell:
        min-height = 100vh

    .dev-banner:
        display = flex
        align-items = center
        justify-content = center
        gap = 0.75rem
        flex-wrap = wrap
        padding = 0.6rem 1.5rem
        background = linear-gradient(90deg, #f59e0b 0%, #f97316 100%)
        color = #1c1203
        font-size = 0.92rem
        font-weight = 600
        text-align = center

    .dev-banner-badge:
        background = rgba(28, 18, 3, 0.85)
        color = #fde68a
        padding = 0.15rem 0.6rem
        round = 999px
        font-size = 0.72rem
        letter-spacing = 0.1em
        text-transform = uppercase

    .dev-banner-link:
        color = #1c1203
        text-decoration = underline
        font-weight = 700

    .site-header:
        position = sticky
        top = 0
        z-index = 10
        background = rgba(15, 23, 42, 0.92)
        color = white
        padding = 1rem 2rem
        display = flex
        align-items = center
        justify-content = space-between
        gap = 1.5rem
        flex-wrap = wrap
        backdrop-filter = blur(10px)

    .brand h1:
        margin = 0
        font-size = 2rem

    .subtitle:
        margin = 0.35rem 0 0
        color = rgba(255, 255, 255, 0.78)

    .eyebrow:
        display = inline-block
        margin = 0 0 0.35rem
        font-size = 0.78rem
        font-weight = 700
        letter-spacing = 0.12em
        text-transform = uppercase
        color = #7dd3fc

    .site-nav:
        display = flex
        flex-wrap = wrap
        gap = 1rem

    .site-nav a:
        color = white
        text-decoration = none
        font-weight = 600
        opacity = 0.92

    .header-actions:
        display = flex
        align-items = center
        gap = 1rem

    .language-selector:
        display = flex
        align-items = center
        gap = 0.5rem
        font-size = 0.95rem

    .language-label:
        color = rgba(255, 255, 255, 0.92)
        font-weight = 600

    .language-link:
        color = rgba(255, 255, 255, 0.7)
        text-decoration = none
        padding = 0.25rem 0.4rem
        border-radius = 5px
        transition = all 0.2s ease
        cursor = pointer

    .language-link:hover:
        background = rgba(255, 255, 255, 0.1)
        color = white

    .language-link.active:
        color = #60a5fa
        font-weight = 700
        background = rgba(96, 165, 250, 0.1)

    .language-sep:
        color = rgba(255, 255, 255, 0.5)

    .card:
        use = (card-surface)
        margin-bottom = 1.75rem

    .hero:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(280px, 100%), 1fr))
        gap = 2rem
        align-items = start

    .hero h2:
        margin-top = 0
        font-size = clamp(2rem, 5vw, 3.25rem)
        line-height = 1.12

    .lead:
        max-width = 60ch

    .hero-panel:
        background = {hero-panel-bg}
        border = 1px solid {hero-panel-border}
        round = 16px
        padding = 1.25rem 1.3rem

    .hero-panel h3:
        margin-top = 0

    .hero-panel ul:
        margin = 0
        padding-left = 1.25rem

    .hero-actions:
        display = flex
        flex-wrap = wrap
        gap = 0.9rem
        margin-top = 1.25rem

    .cta:
        use = (button-primary)

    .cta:hover:
        background = {brand-dark}
        transform = translateY(-1px)
        box-shadow = 0 6px 10px rgba(37, 99, 235, 0.3)

    .cta:active:
        transform = translateY(1px)
        box-shadow = 0 2px 4px rgba(37, 99, 235, 0.2)

    .secondary-cta:
        use = (button-secondary)

    .secondary-cta:hover:
        background = #eef4ff
        border = 1px solid {brand}

    .section-heading:
        margin-bottom = 1.25rem

    .section-heading h2:
        margin = 0.15rem 0 0.5rem

    .section-copy:
        margin-bottom = 0
        color = {text-soft}

    .install-section:
        margin-bottom = 2rem

    .install-section h3:
        margin = 0 0 0.75rem
        color = {text}

    .install-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem

    .install-card:
        background = {bg}
        border = 1px solid {border}
        round = 12px
        padding = 1.25rem 1.25rem 1rem

    .install-card h4:
        margin = 0 0 0.6rem
        font-size = 1rem
        color = {text}

    .content-link:
        color = {brand}
        text-decoration = none
        font-weight = 600

    .steps-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(220px, 100%), 1fr))
        gap = 1rem

    .tour-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem
        margin-bottom = 1.25rem

    .walkthrough-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(260px, 100%), 1fr))
        gap = 1rem

    .examples-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(240px, 100%), 1fr))
        gap = 1rem

    .next-grid:
        display = grid
        grid-template-columns = repeat(auto-fit, minmax(min(260px, 100%), 1fr))
        gap = 1rem

    .step-card:
        use = (sub-card)

    .tour-card:
        use = (sub-card)

    .walkthrough-card:
        use = (sub-card)

    .example-card:
        use = (sub-card)

    .next-card:
        use = (sub-card)

    .next-card ul:
        margin = 0
        padding-left = 1.25rem

    .step-number:
        display = inline-flex
        align-items = center
        justify-content = center
        width = 2rem
        height = 2rem
        border-radius = 999px
        background = #dbeafe
        color = {brand-dark}
        font-weight = 800

    .page:
        max-width = 1200px
        margin = 0 auto
        padding = 2rem 1rem

    .page > section:
        margin-bottom = 2.5rem

    .sandbox-container:
        display = flex
        flex-wrap = wrap
        gap = 1.5rem
        margin-top = 1.5rem

    .editor-pane, .output-pane:
        flex = 1 1 300px
        min-width = 0
        display = flex
        flex-direction = column

    #sandbox-editor:
        width = 100%
        height = 300px
        background = {panel-strong}
        color = white
        padding = 1rem
        round = 12px
        font-family = monospace
        border = 1px solid rgba(148, 163, 184, 0.2)
        resize = vertical
        margin-bottom = 1rem

    .terminal:
        background = #1e293b
        color = #38bdf8
        padding = 1rem
        round = 12px
        font-family = monospace
        min-height = 300px
        white-space = pre-wrap
        overflow-y = auto
        border = 1px solid rgba(148, 163, 184, 0.1)
        overflow-wrap = anywhere
        overflow-x = auto

    .sandbox-hints:
        margin-top = 1.5rem
        padding = 0.75rem 1rem
        background = #f8fafc
        border-left = 4px solid {brand}
        round = 4px

    h3:
        margin-top = 0.65rem
        margin-bottom = 0.5rem

    p:
        color = {text-soft}
        white-space = pre-wrap

    li:
        color = {text-soft}
        white-space = pre-wrap

    strong:
        color = {text}

    code:
        font-family = Consolas, "SFMono-Regular", Menlo, Monaco, monospace
        background = {code-inline-bg}
        color = {code-inline-text}
        padding = 0.15rem 0.32rem
        border-radius = 5px

    pre:
        margin = 0.85rem 0 0
        background = {panel-strong}
        color = #e2e8f0
        padding = 1rem
        border-radius = 12px
        overflow-x = auto
        border = 1px solid rgba(148, 163, 184, 0.28)

    pre code:
        background = transparent
        color = inherit
        padding = 0

    .code-block:
        display = block
        white-space = pre

    .callout:
        margin-top = 1rem
        padding = 1rem 1.1rem
        round = 14px
        border = 1px solid transparent

    .callout-success:
        background = {success-bg}
        border = 1px solid {success-border}

    .callout-info:
        background = {info-bg}
        border = 1px solid {info-border}

    .tag:
        display = inline-block
        margin-bottom = 0.45rem
        padding = 0.2rem 0.55rem
        border-radius = 999px
        font-size = 0.78rem
        font-weight = 700
        letter-spacing = 0.02em

    .tag-beginner:
        background = {beginner-bg}
        color = {beginner-text}

    .tag-practical:
        background = {practical-bg}
        color = {practical-text}

    .tag-advanced:
        background = {advanced-bg}
        color = {advanced-text}

    .site-footer:
        text-align = center
        color = #6b7280
        padding = 1rem 0 2rem
        font-size = 0.95rem

    .code-block .token.comment:
        color = {syntax-comment}

    .code-block .token.shebang:
        color = {syntax-comment}

    .code-block .token.string:
        color = {syntax-string}

    .code-block .token.escape:
        color = {syntax-escape}

    .code-block .token.keyword:
        color = {syntax-keyword}
        font-weight = 700

    .code-block .token.block-keyword:
        color = {syntax-keyword}
        font-weight = 700

    .code-block .token.builtin:
        color = {syntax-builtin}

    .code-block .token.command:
        color = {syntax-builtin}

    .code-block .token.function:
        color = {syntax-function}

    .code-block .token.section-id:
        color = {syntax-function}

    .code-block .token.url:
        color = {syntax-function}

    .code-block .token.section-type:
        color = {syntax-property}
        font-weight = 600

    .code-block .token.property:
        color = {syntax-property}
        font-weight = 600

    .code-block .token.section-punctuation:
        color = {syntax-operator}

    .code-block .token.record-marker:
        color = {syntax-operator}

    .code-block .token.punctuation:
        color = {syntax-operator}

    .code-block .token.operator:
        color = {syntax-operator}

    .code-block .token.section-qualifier:
        color = {syntax-qualifier}

    .code-block .token.parameters:
        color = {syntax-qualifier}

    .code-block .token.flag:
        color = {syntax-qualifier}

    .code-block .token.number:
        color = {syntax-number}

    .code-block .token.constant:
        color = {syntax-number}

    .code-block .token.placeholder:
        color = {syntax-number}

    .code-block .token.interpolation:
        color = {syntax-interpolation}
        font-weight = 700

    .app-layout:
        display = flex
        flex-direction = column
        min-height = 100vh

    .app-body:
        display = flex
        flex = 1
        max-width = 1400px
        margin = 0 auto
        width = 100%

    .sidebar:
        width = 250px
        flex = 0 0 250px
        padding = 2rem 1.5rem
        border-right = 1px solid {border}
        background = transparent

    .sidebar h3:
        margin = 0 0 0.5rem 0.5rem
        font-size = 0.85rem
        text-transform = uppercase
        color = {text-soft}
        letter-spacing = 0.05em

    .nav-group:
        margin-bottom = 1.5rem

    .nav-link:
        display = block
        width = 100%
        text-align = left
        padding = 0.5rem 0.75rem
        background = transparent
        border = none
        border-radius = 6px
        color = {text}
        font-size = 0.95rem
        cursor = pointer
        transition = all 0.2s

    .nav-link:hover:
        background = #e2e8f0

    .nav-link.active:
        background = {brand}
        color = white
        font-weight = 600

    .nav-link.active:hover:
        background = {brand-dark}

    .content-area:
        flex = 1
        min-width = 0
        padding = 2rem 3rem
        max-width = 1100px

    .reference-shell:
        margin-top = 1.5rem

    .reference-controls:
        background = {panel}
        border = 1px solid {border}
        border-radius = 12px
        padding = 1.25rem
        margin-bottom = 2rem
        box-shadow = {shadow}

    .search-input:
        width = 100%
        padding = 0.85rem 1.15rem
        border = 1px solid {border}
        border-radius = 8px
        font-size = 1rem
        font-family = inherit
        background = #f8fafc
        color = {text}
        outline = none
        transition = border-color 0.2s

    .search-input:focus:
        border-color = {brand}
        background = #ffffff

    .category-pills:
        display = flex
        flex-wrap = wrap
        gap = 0.5rem
        margin-top = 1rem

    .pill:
        background = #f1f5f9
        border = 1px solid #e2e8f0
        padding = 0.4rem 0.85rem
        border-radius = 20px
        font-size = 0.82rem
        font-weight = 600
        color = {text-soft}
        cursor = pointer
        transition = all 0.2s

    .pill:hover:
        background = #e2e8f0
        color = {text}

    .pill.active:
        background = {brand}
        border-color = {brand}
        color = #ffffff

    .builtin-cards-grid:
        display = grid
        grid-template-columns = repeat(auto-fill, minmax(min(320px, 100%), 1fr))
        gap = 1.25rem
        margin-bottom = 3rem

    .builtin-card:
        background = {panel}
        border = 1px solid {border}
        border-radius = 12px
        padding = 1.25rem
        display = flex
        flex-direction = column
        justify-content = space-between
        box-shadow = 0 4px 12px rgba(15, 23, 42, 0.04)
        transition = transform 0.2s, box-shadow 0.2s

    .builtin-card:hover:
        transform = translateY(-2px)
        box-shadow = {shadow}

    .builtin-card-header:
        display = flex
        justify-content = space-between
        align-items = center
        margin-bottom = 0.75rem

    .builtin-name:
        margin = 0
        font-size = 1.15rem
        color = {brand}
        font-family = monospace

    .category-badge:
        font-size = 0.72rem
        font-weight = 700
        text-transform = uppercase
        padding = 0.2rem 0.55rem
        border-radius = 4px
        letter-spacing = 0.04em
        background = #f1f5f9
        color = #475569

    .cat-diagnostics:
        background = #fef3c7
        color = #b45309

    .cat-http:
        background = #dbeafe
        color = #1d4ed8

    .cat-data:
        background = #dcfce7
        color = #15803d

    .cat-schema:
        background = #f3e8ff
        color = #7e22ce

    .cat-memory:
        background = #e0e7ff
        color = #4338ca

    .cat-io:
        background = #ffedd5
        color = #c2410c

    .cat-context:
        background = #ccfbf1
        color = #0f766e

    .cat-websocket:
        background = #fce7f3
        color = #be185d

    .builtin-summary:
        font-size = 0.92rem
        color = {text-soft}
        margin = 0 0 1rem 0
        line-height = 1.5

    .builtin-syntax-box:
        background = #0f172a
        color = #38bdf8
        padding = 0.6rem 0.85rem
        border-radius = 6px
        font-family = monospace
        font-size = 0.82rem
        margin-bottom = 1rem
        overflow-x = auto
        white-space = nowrap

    .builtin-card-actions:
        display = flex
        justify-content = flex-end

    .load-sandbox-btn:
        background = #eff6ff
        border = 1px solid #bfdbfe
        color = {brand}
        padding = 0.45rem 0.85rem
        border-radius = 6px
        font-size = 0.85rem
        font-weight = 600
        cursor = pointer
        transition = all 0.2s

    .load-sandbox-btn:hover:
        background = {brand}
        color = #ffffff
        border-color = {brand}

    .pulse-highlight:
        animation = pulse-border 1.2s ease-in-out

    .empty-results:
        grid-column = 1 / -1
        text-align = center
        padding = 3rem
        background = {panel}
        border = 1px solid {border}
        border-radius = 12px
        color = {text-soft}

    .interactive-reference-sandbox:
        margin-top = 2rem
        border-top = 2px dashed {border}
        padding-top = 2.5rem

    .navigation-toggle:
        display = none

    .page, .hero > *, .install-grid > *, .steps-grid > *, .tour-grid > *, .walkthrough-grid > *, .examples-grid > *, .next-grid > *, .builtin-card:
        min-width = 0

    .content-area, .site-header, .site-footer:
        overflow-wrap = anywhere

    pre, .code-block, .builtin-syntax-box:
        overflow-wrap = normal

    .editor-actions, .language-selector, .builtin-card-header:
        flex-wrap = wrap
        gap = 0.5rem

    .nav-link, .language-link, .site-nav a, .pill, .load-sandbox-btn:
        min-height = 44px

    .language-link, .site-nav a:
        display = inline-flex
        align-items = center

# Responsive overrides are emitted after base rules, in the order below.
responsive:
    (max-width: 1000px):
        .site-header:
            position = static
            padding = 1.25rem 1.5rem
            gap = 0.75rem 1.5rem

        .site-nav:
            width = 100%
            gap = 0.25rem 1.25rem

        .app-body:
            flex-direction = column

        .sidebar:
            flex = none
            width = 100%
            display = none
            grid-template-columns = repeat(3, minmax(0, 1fr))
            gap = 1rem
            padding = 1.25rem 1.5rem
            border-right = 0
            border-bottom = 1px solid {border}

        .navigation-toggle:
            display = flex
            align-items = center
            justify-content = space-between
            width = 100%
            min-height = 52px
            padding = 0.75rem 1.5rem
            border = 0
            border-bottom = 1px solid {border}
            background = {panel}
            color = {text}
            font-size = inherit
            font-family = inherit
            font-weight = 600
            text-align = left
            cursor = pointer

        .app-body[data-navigation-open="true"] .sidebar:
            display = grid

        .nav-group:
            margin = 0
            min-width = 0

        .content-area:
            width = 100%
            padding = 1.5rem

        .page:
            padding = 0

    (max-width: 640px):
        .dev-banner:
            padding = 0.65rem 1rem
            gap = 0.35rem 0.65rem
            font-size = 0.85rem

        .site-header:
            padding = 1rem
            align-items = flex-start

        .brand h1:
            font-size = 1.75rem

        .subtitle:
            font-size = 0.95rem

        .site-nav:
            gap = 0.25rem 1rem

        .header-actions:
            width = 100%

        .language-selector:
            gap = 0.25rem

        .sidebar:
            grid-template-columns = repeat(2, minmax(0, 1fr))
            padding = 1rem
            gap = 1rem 0.5rem

        .nav-link:
            padding = 0.6rem 0.5rem

        .content-area:
            padding = 1.25rem 0.75rem

        .card:
            padding = 1.25rem
            border-radius = 14px
            margin-bottom = 1.25rem

        .hero, .sandbox-container:
            gap = 1rem

        .hero h2:
            font-size = clamp(1.75rem, 7vw, 2.5rem)

        .hero-actions > a:
            width = 100%
            text-align = center

        .reference-controls, .builtin-card, .install-card, .hero-panel:
            padding = 1rem

        #sandbox-editor:
            font-size = 1rem

        .site-footer:
            padding = 1rem

