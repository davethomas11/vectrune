    feature_split_title = "Splitting Worm Chains"
    feature_split_desc = "Blasting any body segment spawns a new mushroom obstacle and promotes the trailing segment into an independent head."
    feature_field_title = "State Generators & Templates"
    feature_field_desc = "Staggered mushroom rows and 10-segment worm chains are generated declaratively using local templates, inc steps, and all modifiers."
    feature_fx_title = "Particle Emitters & Synth Audio"
    feature_fx_desc = "emitter state declarations and sound actions trigger real-time particle bursts and Web Audio retro sound effects."
    feature_controls_title = "2D Player Zone & D-Pad"
