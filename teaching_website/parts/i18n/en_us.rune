    feature_multitrack_title = "Multitrack Visual Sequencing"
    feature_multitrack_desc = "Compose lead melodies, arpeggios, pulsing bass, and percussion with readable bar-by-bar note notation and tempo control."
    feature_storage_title = "Save and restore arrangements"
    feature_storage_desc = "SAVE and LOAD keep an arrangement in this browser. In the embedded preview, storage may last only for the current session; export a file to keep your song."
    feature_export_title = "Export your song"
    feature_export_desc = "EXPORT .RUNE downloads the song’s @Music code. It is separate from the complete Studio application and its source files."
    instructions_title = "How to Use"
    instructions_songs = "Choose a preset, press PLAY to listen, and STOP to finish. Select an editing voice and use the piano roll or STRIP view to edit notes."
    instructions_storage = "SAVE stores the current arrangement in the browser; LOAD restores it. EXPORT .RUNE downloads your song code as a file. Keep that export before leaving or reloading the preview."
    try_it = "Choose a preset and press PLAY, then STOP. Select a voice and click a note to edit your arrangement."
}

