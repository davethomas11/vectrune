Guide {
    syntax = "Reading the syntax"
    run_locally = "Run locally"
    how_it_works = "How this example works"
    project_setup = "To run the complete example, install Vectrune and Git first. Clone the repository once; keep the imported parts folder with the main file."
    clone_cmd = "git clone https://github.com/davethomas11/vectrune.git\ncd vectrune"
    project_folder = "Run these commands from the repository root. If you already have a checkout, skip cloning and open a terminal at its root."
}

RestGuide {
    title = "REST applications"
    intro = "Define HTTP endpoints with @Route and execute their steps in run:. REST apps can also host Rune-Web pages, static files, and WebSocket hooks."
    syntax_1 = "@App selects type = REST. port sets the listening port; the CLI can override it with --port."
    syntax_2 = "@Route/GET /hello names a method and path. Use POST, PUT, PATCH, or DELETE for other endpoints."
    syntax_3 = "run: contains ordered steps. respond 200 sends an HTTP status and payload; @Schema and validate can check incoming data."
    run = "Save this source as rest.rune, start the server, then request /hello."
    note = "Try the example below in the browser, or use the GET, POST, and validation tutorials in the sidebar."
}

GraphqlGuide {
    title = "GraphQL applications"
    intro = "Describe object shapes with @Schema and expose query or mutation fields with @GraphQL sections. The native server accepts GraphQL operations at /graphql."
    syntax_1 = "@App type = GraphQL starts the GraphQL server. @Schema/Greeting declares the fields of the Greeting object."
    syntax_2 = "@GraphQL/Query/Greeting declares query resolvers returning Greeting. Each resolver name ends with : and its indented steps return data."
    syntax_3 = "@GraphQL/Mutation/Greeting declares mutations. Arguments use name: type inside parentheses and become variables available to the resolver."
    run = "Save this source as graphql.rune. Open http://127.0.0.1:3000/ for the native GraphQL playground, or POST operations to /graphql."
    note = "The source uses the native @Schema and @GraphQL forms. The browser sandbox also understands @Type, @Query, and @Mutation shorthand; use the forms above for native servers."
    operation = "Query and mutation syntax"
}

StaticGuide {
    title = "Static applications"
    intro = "Serve an existing directory of HTML, images, scripts, and other assets. A Static app serves files directly; it does not compile Rune-Web pages on each request."
    syntax_1 = "@App type = STATIC selects the file server. port chooses the HTTP port."
    syntax_2 = "root = public serves the public directory relative to the working directory. Run the command from the project directory."
    syntax_3 = "A directory request serves its index.html. Put public/index.html in place before starting the server."
    run = "Save the config as static.rune beside a public folder containing index.html, then open http://127.0.0.1:3000/."
    note = "To publish Rune-Web as static files, first export the page with -o html and copy its referenced assets into your output directory."
}

SocketGuide {
    title = "WebSockets in REST apps"
    intro = "WebSockets are a feature of REST applications. Use @Websocket to mount a persistent connection and respond to connection and message events."
    syntax_1 = "Keep @App type = REST. @Websocket/chat mounts the WebSocket endpoint at /chat."
    syntax_2 = "on_connect:, on_message:, and on_disconnect: contain the steps for each event. The received message is available as body."
    syntax_3 = "ws.broadcast /chat body sends the message to every connected client on /chat. Use ws.send when targeting a single connection."
    run = "Save this source as websocket.rune and connect a WebSocket client to ws://127.0.0.1:3000/chat. Open two clients to try broadcasting."
    note = "This example needs the native server. WebSocket is not a standalone @App type, and the browser sandbox does not run native socket hooks."
}

WebGuide {
    title = "Rune-Web applications"
    intro = "Author HTML views, reactive state, actions, and styles in Rune. Rune-Web is an @Frontend mode hosted by a REST app, and can also be exported as static HTML."
    syntax_1 = "@Frontend type = rune-web mounts the frontend. path = %ROOT% mounts at /; page = home selects @Page/home."
    syntax_2 = "@Logic/counter defines state and actions. The page selects it with logic = counter; click=increment() calls the action."
    syntax_3 = "@Page/home contains a view: tree, where indentation nests elements. @Style/site supplies rules; reusable views use @Component/Name."
    run = "Save as rune-web.rune. Run the server, or export a self-contained page with -o html."
    note = "The counter below is compiled from the repository example. Expand its source to see a complete UI with styles and actions."
}

Localization {
    title = "Localization in Rune-Web"
    intro = "Keep translated copy in named @I18N bundles, then reference the same keys in every view. This site uses English, Spanish, and French bundles written in Rune."
    bundles_title = "Define and use translation keys"
    bundles = "An @I18N/locale section contains named groups such as Common. Use %i18n.Common.hello% in text or attributes. You can also use the expression {i18n.Common.hello}. Keep matching groups and keys in every bundle; missing keys have no automatic English fallback."
    select_title = "Choose a locale"
    select = "locale = en_us on @Frontend sets the default bundle. On the native server, ?locale=es selects another defined bundle for that request. Locale names must match your @I18N section names exactly."
    local_title = "Use the same links locally and in production"
    local = "locale_paths maps bundles to explicit server paths. In this example, /es/ and /fr/ work when running the Rune app locally. For static hosting, export each locale path to its own index.html and copy the site assets; a static host does not process ?locale= parameters."
    contribute_title = "Help finish a translation"
    contribute = "The teaching site’s translation files live in teaching_website/parts/i18n. Update the matching keys in en_us.rune, es.rune, and fr.rune. Keep Rune keywords, builtin names, file paths, and example source code unchanged."
}

Tutorial {
    get_title = "Handling GET requests"
    get_intro = "Declare a GET route and return structured data with respond. Choose an endpoint below and send a request to test it."
    post_title = "Handling POST requests"
    post_intro = "Use @Schema and expect to describe incoming fields. Parse the JSON body, validate it, and respond with a 201 status."
    validation_title = "Validation and schemas"
    validation_intro = "Validate the shape of a JSON body against @Schema, then check business rules with validate expressions. Try a negative price to see an error."
}

BuiltinSummary {
    summarize = "Group counts, totals, averages, medians, distinct counts, and first/last values in one line."
    log = "Log a diagnostic message with expanded placeholders."
    respond = "Send an HTTP status and response body."
    return = "Return a value from a handler or resolver."
    parse_json = "Parse JSON text into objects or lists."
    validate = "Check a schema or enforce a condition."
    memory_set = "Store a value in shared runtime memory."
    memory_get = "Read a value from shared runtime memory."
    memory_clear = "Clear all shared memory entries."
    memory_del = "Delete one shared memory entry."
    csv_read = "Read CSV rows as a list of objects."
    csv_append = "Append a record to a CSV file."
    csv_write = "Write a list of records to a CSV file."
    is_set = "Check whether a variable or nested path exists."
    delete = "Remove a variable or nested property."
    ws_broadcast = "Send a message to connected WebSocket clients on a channel."
    load_rune = "Load another Rune document from a file or directory."
    to_number = "Convert a value to a number."
    to_string = "Convert a value to text."
    to_bool = "Convert a value to a boolean."
    uuid_v4 = "Generate a random version 4 UUID."
    now = "Get the current UTC time."
}

DynamicAi {
    saved = "Save a page with ?generation=cafe-v1 and revisit that URL after a restart. Use ?cache=off for a fresh preview without changing saved versions. Use a new key to save a different version. API responses remain live."
    timing = "Set response_target_seconds in @App to recommend how quickly the AI should respond. The thinking screen shows this advisory target; timeout_seconds remains the hard deadline."
    progress = "While a page is being generated, Vectrune shows a thinking screen with rotating messages and elapsed time. Cached pages open immediately; failures show a manual retry button. The server logs generation timings and cache hits."
    demos_title = "Try a CLI demo"
    demos_body = "Install and sign in to the matching CLI, then run one example at a time. Each uses the CLI default model."
    nav = "Dynamic AI sites"
    eyebrow = "Experimental application type"
    title = "Dynamic AI sites"
    intro = "Describe a website in Rune and let an AI engine generate its HTML pages and JSON APIs. Use Ollama locally, or a signed-in Codex or Copilot CLI."
    syntax_1 = "@App type = dynamic-ai-web selects the AI server. engine chooses ollama, codex, or copilot; model selects a compatible model."
    syntax_2 = "@Site and @Content describe the site, while @Data supplies grounding records. @Page describes a complete generated HTML page at its path."
    syntax_3 = "@Route/METHOD /path describes a JSON response rather than a run: block. The engine receives path parameters, query and JSON body alongside the public site data."
    native_title = "Run with the native CLI"
    native_body = "Dynamic AI sites need a running server and the selected engine. Static hosting and the teaching browser sandbox do not run AI providers. Generated endpoints return data; persistence and transactions require separate application logic."
    engines_title = "Choose your engine"
    engines_body = "Ollama uses its local generation API and defaults to phi4. Codex and Copilot use their authenticated CLIs in temporary workspaces with generation-only controls. When changing engines, remove model = phi4 or choose a model supported by that engine."
    behavior = "Pages are cached briefly; APIs are generated on each request. Configure cache_seconds, timeout_seconds and max_concurrent in @App. Invalid generated HTML or JSON returns an error. AI content varies by model."
}

RuneWebGuide {
    group = "Rune-Web guide"
    live = "Live example"
    local = "Run this lesson locally"
    shared = "Each example is a complete Rune-Web app and imports parts/style.rune. Open the source below to inspect both files. Demo data stays in this browser and resets when the preview reloads."
    components_title = "Components and props"
    components_intro = "Compose a page from reusable @Component views. Workshop cards share a layout while their content comes from props."
    components_syntax = "props: [title, level, note?] declares required inputs and an optional note. Pass values by name at each component call; use ?? for a fallback."
    components_behavior = "@Frontend selects the @Page entry point. The page composes WorkshopCard twice; each instance receives its own prop values. Components are view reuse, not separate backend routes."
    components_try = "Compare the two cards and open their source. Give the first card a note, then run the app locally to see the override."
    forms_title = "State and forms"
    forms_intro = "Build a workshop pass whose preview follows your name and session. state: supplies the starting values; braces read them in text and attributes."
    forms_syntax = "A change handler calls setGuest(this.value) or setSession(this.value). Named @Logic actions assign the new values, and the reactive runtime updates the view."
    forms_behavior = "Change fires when a text edit is committed, such as leaving the field. This is explicit event handling; <-> is not a general input-value binding. The pass is a local preview and does not submit a reservation."
    forms_try = "Change Guest to your name and leave the field. Choose Studio and watch both values appear on your pass."
    actions_title = "Actions and lists"
    actions_intro = "Build a useful packing checklist with add, pack, unpack and remove actions. Array state drives a repeated view and an empty-list message."
    actions_syntax = "@Logic defines named actions with parameters. items.push(...) adds a record, a for loop updates the matching item, and items.filter it.id != id removes it."
    actions_behavior = "for item in items: repeats a view; if items.length == 0: handles the empty case. Conditional expressions choose Packed text and the done class. Keep stable record IDs rather than treating list positions as identity."
    actions_try = "Add Snacks, pack and unpack it, then remove all items to reveal the empty state. The source is the complete small app."
    views_title = "Views and selection bindings"
    views_intro = "Switch between a trip summary and itinerary using state, match and small components. This is a view switch inside one page."
    views_syntax = "bindings: .active <-> tab connects a selector to selection state. A button with {.active when 'schedule'} gets an active class and assigns tab on click."
    views_behavior = "match tab: chooses which component to render. This selection does not create URL routes, browser history or a full accessible tab widget; the demo uses ordinary navigation buttons."
    views_try = "Choose Schedule, then Summary. Notice the active button and content change together without reloading the page."
    styles_title = "Styles and responsive layout"
    styles_intro = "Give a reading shelf a responsive grid using @Style tokens, presets and rules. The entire presentation is authored in Rune."
    styles_syntax = "tokens: names shared values; presets: groups reusable declarations. .panel uses the panel preset, and style = guide attaches the named style to the page."
    styles_behavior = "Selector rules include focus-visible states and a grid that fits the available width. Token references such as {brand} keep colors consistent. These are styling declarations, not reactive application state."
    styles_try = "Resize the preview or your browser. Open parts/style.rune below, change the brand token, and export locally to try your own palette."
}

Developer {
    group = "Developer"
    start = "Developer quickstart"
    cli = "CLI reference"
    testing = "Testing Rune"
    quality = "Code quality"
    ci = "Continuous integration"
    release = "What’s new in 0.3.1"
    badge = "Developer tools · 0.3.1"
    start_intro = "Go from an installed CLI to five passing Rune tests. The downloadable starter includes a real API, reusable fixtures, and a GitHub Actions workflow."
    install_title = "1. Install or upgrade"
    install_text = "Install Vectrune 0.3.1 or newer. On macOS or Linux with Homebrew, use the commands below. Windows and other platforms can download a binary from GitHub Releases, extract it, and add its folder to PATH. Restart your terminal after changing PATH."
    releases = "Download a release"
    download_title = "2. Download the tested starter"
    download = "Download developer starter (.zip)"
    extract = "Extract the ZIP and open a terminal inside the extracted folder. On Windows use Extract All; on macOS open the ZIP; on Linux use unzip. Keep app.rune and api.test.rune together."
    run_title = "3. Check it and run the tests"
    expected = "Expected: 5 passed, 0 failed. Test requests run in process, so port 3000 does not need to be free. doctor may still report its availability as advice."
    next = "Next: change an assertion and try test --watch, then restore it to see the suite recover."
    cli_intro = "Inspect the installation, check source, run tests, and format code from one CLI. These commands use the native Rune parser and router."
    doctor_text = "doctor reports the running executable and version, PATH shadowing, resolved imports, project errors, and configured port availability. It does not execute startup code."
    check_text = "check validates imports, routes, references, test fixtures, and Rune-Web props. Command-typo warnings include suggestions. Use --deny-warnings in CI."
    format_text = "fmt tidies section headers, top-level assignments, and run/setup/teardown indentation. Views, styles, and embedded source are preserved. The formatter checks parsed meaning before writing; --check never writes."
    test_text = "test runs @Test sections through the real native router without opening a port. A directory is one application/suite; a file loads only that file and its imports. Filters are case-sensitive name substrings."
    json_title = "Reports and exit codes"
    json_text = "--json emits a report with schema_version = 1. Exit 0 means success, 1 means a project/test/formatting failure, and 2 means invalid CLI usage. Watch mode emits one JSON object per line, with run and watching events."
    testing_intro = "Write tests in the same language as your application. This suite covers health, validation failures, fresh memory, and a create → fetch → update workflow."
    fixtures_title = "Setup, fixtures, and teardown"
    fixtures_text = "@TestSuite setup runs before every test. fixtures = [User] selects @TestFixture/User. Order: suite setup → named fixture setup → test setup → run. Teardown reverses that order. Fixture variables are available to the test."
    isolation_title = "Isolation and failure behavior"
    isolation_text = "Rune memory is reset and application startup reruns for each test. Assertion, setup, startup, and teardown failures fail the test. Cleanup runs after setup/assertion failure or timeout and has a separate bounded budget. Abrupt termination cannot guarantee cleanup. External files and databases are not rolled back."
    watch_title = "Keep the feedback loop open"
    watch_text = "Watch mode reruns after Rune source, imports, or JSON/YAML/CSV fixture edits. It handles atomic saves, missing imports, and later repairs. Stop with Ctrl-C; the exit status reflects the last completed run while waiting."
    quality_intro = "Keep formatting and diagnostics in your normal edit → check → test loop."
    diagnostics_title = "Find the failing statement"
    diagnostics_text = "Test failures identify file, line, column, source, and actual/expected values. Command-typo warnings point to the statement and suggest a likely builtin. Section-level checks identify the relevant declaration. Full expression typing remains future work."
    opaque_title = "Preserve authored content"
    opaque_text = "The formatter keeps view/CSS blocks and embedded text intact. It formats the entry file and its imports, validates all changes before writing, and refuses changes that alter the parsed document. Review the diff as with any formatter."
    ci_intro = "Copy this workflow into .github/workflows/rune.yml in your project. It is also included in the starter. The example uses an Ubuntu x86-64 runner and pins the CLI to 0.3.1."
    ci_text = "The pipeline checks installation, formatting, static diagnostics, and tests. JSON reports are suitable for tools; nonzero exits fail the job. Cache tooling is not required."
    release_intro = "A complete developer loop: diagnose the installation, lint source, format safely, and test APIs in Rune."
    release_text = "0.3.1 adds source-aware failures and command suggestions, suite and fixture hooks, test watch mode with recovery, a conservative formatter, versioned JSON reports, and this downloadable starter. Startup and teardown failures now fail tests reliably."
    upgrade_title = "Upgrade and verify"
    upgrade_text = "Homebrew users can update and upgrade. Other platforms should replace the old binary with 0.3.1 from Releases. doctor shows the executable actually running so you can spot an older binary on PATH."
    cmd_1 = "brew install davethomas11/vectrune/vectrune\nvectrune --version"
    cmd_2 = "vectrune doctor .\nvectrune fmt . --check\nvectrune check . --deny-warnings\nvectrune test ."
    cmd_3 = "vectrune doctor .\nvectrune doctor app.rune --json"
    cmd_4 = "vectrune check . --deny-warnings"
    cmd_5 = "vectrune fmt .\nvectrune fmt . --check"
    cmd_6 = "vectrune test . --list\nvectrune test . --filter User\nvectrune test . --timeout 5\nvectrune test . --watch"
    cmd_7 = "vectrune test . --json\nvectrune test . --watch --json"
    cmd_8 = "vectrune test . --watch\nvectrune test . --filter UserLifecycle --timeout 5"
    cmd_9 = "vectrune check . --deny-warnings\nvectrune test . --json"
    cmd_10 = "vectrune fmt . --check\nvectrune fmt ."
    cmd_11 = "brew update\nbrew upgrade vectrune\nvectrune --version\nvectrune doctor ."
}
