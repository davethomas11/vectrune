DocumentSyntax {
    nav = "Document Syntax"
    eyebrow = "Language essentials"
    title = "Rune document syntax"
    intro = "A Rune file can be a structured data document on its own. Start with sections, add key-value pairs, and use records or series when you need more than one item."
    contents = "On this page"
    sections_title = "Sections"
    sections_body = "Start a section with @ followed by its name. The lines below belong to that section until the next @ header. A slash in the header creates a nested path: @Guide/Author places Author inside Guide."
    sections_note = "#!RUNE is an optional file marker. The JSON beside each example is generated from that exact source by the Vectrune CLI."
    values_title = "Key-value pairs"
    values_body = "A key-value pair (KV) gives a field a name and a value: key = value. Plain text can be written without quotes. Numbers and true or false become numeric and boolean values in the exported document."
    values_note = "Each pair belongs to the current section, or to the current record after a + marker. Use = for a value; use : for a series."
    records_title = "Records"
    records_body = "Use + to begin a new record: a group of fields describing one item. Put the first field after +, then indent its remaining fields. Another + begins another record in the same section."
    records_note = "Records export as a list under the section’s record key. A blank line makes them easier to read; the + marker starts the next item."
    series_title = "Series"
    series_body = "A series is an ordered list. Write a name followed by a colon, then indent one item per line. The steps below become a list of strings, in the same order."
    series_note = "Indentation groups the items under steps:. In application sections, run: uses this same series shape for executable steps; these checklist items are just data."
    objects_title = "Objects and inline lists"
    objects_body = "Use a JSON-style object when a field needs named subfields. For a compact list of simple values, use parentheses with spaces between items. Use a series when you want a longer, readable list."
    objects_note = "The object’s field names and text values use double quotes. The parenthesized features list contains two separate string values."
    rules_title = "A few rules to remember"
    rule_sections = "Keep @ section headers at the start of the line. Use / to name nested sections."
    rule_comments = "A line beginning with # is a comment. Use full-line comments to explain your document."
    rule_indent = "Use consistent spaces to indent series items and the continuation fields of records."
    rule_records = "Put section-wide values before the first +. Following key-value pairs belong to the current record until a new record or section begins."
    data_title = "Documents can stand on their own"
    data_body = "You do not need @App, a server, or a run: block to describe data. Sections such as @Notebook and @Entry are your own names. Application sections such as @Route add runtime behavior when you build an app."
    try_title = "Try a document"
    try_body = "Change the notebook title or a completion value, or add another + record. Press Run to see the new document. The editor will flag edits that have not been applied."
    try_formats = "Choose JSON, YAML, or XML, then run or export the document. The AST button shows the parser’s internal structure."
    export_title = "Use the same syntax locally"
    export_body = "Save a document as notes.rune, then choose an output format with -o. The CLI also handles the series and inline-list examples above."
    next_link = "Explore the skateboarder document →"
    json_label = "JSON output"
    tour_link = "Learn document syntax: sections, key-value pairs, and records →"
}

