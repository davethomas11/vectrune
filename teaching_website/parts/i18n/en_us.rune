DynamicAi {
    saved = "Save a page with ?generation=cafe-v1 and revisit that URL after a restart. Use ?cache=off for a fresh preview without changing saved versions. Use a new key to save a different version. API responses remain live."
    timing = "Set response_target_seconds in @App to recommend how quickly the AI should respond. The thinking screen shows this advisory target; timeout_seconds remains the hard deadline."
    progress = "While a page is being generated, Vectrune shows a thinking screen with rotating messages and elapsed time. Cached pages open immediately; failures show a manual retry button. The server logs generation timings and cache hits."
    demos_title = "Try a CLI demo"
    demos_body = "Install and sign in to the matching CLI, then run one example at a time. Each uses the CLI default model."
    nav = "Dynamic AI sites"
    eyebrow = "Experimental application type"
    title = "Dynamic AI sites"
    intro = "Describe a website in Rune and let an AI engine generate its HTML pages and JSON APIs. Use Ollama locally, or a signed-in Codex or Copilot CLI."
    syntax_1 = "@App type = dynamic-ai-web selects the AI server. engine chooses ollama, codex, or copilot; model selects a compatible model."
    syntax_2 = "@Site and @Content describe the site, while @Data supplies grounding records. @Page describes a complete generated HTML page at its path."
    syntax_3 = "@Route/METHOD /path describes a JSON response rather than a run: block. The engine receives path parameters, query and JSON body alongside the public site data."
    native_title = "Run with the native CLI"
    native_body = "Dynamic AI sites need a running server and the selected engine. Static hosting and the teaching browser sandbox do not run AI providers. Generated endpoints return data; persistence and transactions require separate application logic."
    engines_title = "Choose your engine"
    engines_body = "Ollama uses its local generation API and defaults to phi4. Codex and Copilot use their authenticated CLIs in temporary workspaces with generation-only controls. When changing engines, remove model = phi4 or choose a model supported by that engine."
    behavior = "Pages are cached briefly; APIs are generated on each request. Configure cache_seconds, timeout_seconds and max_concurrent in @App. Invalid generated HTML or JSON returns an error. AI content varies by model."
}

RuneWebGuide {
    group = "Rune-Web guide"
    live = "Live example"
    local = "Run this lesson locally"
    shared = "Each example is a complete Rune-Web app and imports parts/style.rune. Open the source below to inspect both files. Demo data stays in this browser and resets when the preview reloads."
    components_title = "Components and props"
    components_intro = "Compose a page from reusable @Component views. Workshop cards share a layout while their content comes from props."
    components_syntax = "props: [title, level, note?] declares required inputs and an optional note. Pass values by name at each component call; use ?? for a fallback."
    components_behavior = "@Frontend selects the @Page entry point. The page composes WorkshopCard twice; each instance receives its own prop values. Components are view reuse, not separate backend routes."
    components_try = "Compare the two cards and open their source. Give the first card a note, then run the app locally to see the override."
    forms_title = "State and forms"
    forms_intro = "Build a workshop pass whose preview follows your name and session. state: supplies the starting values; braces read them in text and attributes."
    forms_syntax = "A change handler calls setGuest(this.value) or setSession(this.value). Named @Logic actions assign the new values, and the reactive runtime updates the view."
    forms_behavior = "Change fires when a text edit is committed, such as leaving the field. This is explicit event handling; <-> is not a general input-value binding. The pass is a local preview and does not submit a reservation."
    forms_try = "Change Guest to your name and leave the field. Choose Studio and watch both values appear on your pass."
    actions_title = "Actions and lists"
    actions_intro = "Build a useful packing checklist with add, pack, unpack and remove actions. Array state drives a repeated view and an empty-list message."
    actions_syntax = "@Logic defines named actions with parameters. items.push(...) adds a record, a for loop updates the matching item, and items.filter it.id != id removes it."
    actions_behavior = "for item in items: repeats a view; if items.length == 0: handles the empty case. Conditional expressions choose Packed text and the done class. Keep stable record IDs rather than treating list positions as identity."
    actions_try = "Add Snacks, pack and unpack it, then remove all items to reveal the empty state. The source is the complete small app."
    views_title = "Views and selection bindings"
    views_intro = "Switch between a trip summary and itinerary using state, match and small components. This is a view switch inside one page."
    views_syntax = "bindings: .active <-> tab connects a selector to selection state. A button with {.active when 'schedule'} gets an active class and assigns tab on click."
    views_behavior = "match tab: chooses which component to render. This selection does not create URL routes, browser history or a full accessible tab widget; the demo uses ordinary navigation buttons."
    views_try = "Choose Schedule, then Summary. Notice the active button and content change together without reloading the page."
    styles_title = "Styles and responsive layout"
    styles_intro = "Give a reading shelf a responsive grid using @Style tokens, presets and rules. The entire presentation is authored in Rune."
    styles_syntax = "tokens: names shared values; presets: groups reusable declarations. .panel uses the panel preset, and style = guide attaches the named style to the page."
    styles_behavior = "Selector rules include focus-visible states and a grid that fits the available width. Token references such as {brand} keep colors consistent. These are styling declarations, not reactive application state."
    styles_try = "Resize the preview or your browser. Open parts/style.rune below, change the brand token, and export locally to try your own palette."
}
