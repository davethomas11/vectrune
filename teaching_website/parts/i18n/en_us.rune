    csv_append = "Append a record to a CSV file."
    csv_write = "Write a list of records to a CSV file."
    is_set = "Check whether a variable or nested path exists."
    delete = "Remove a variable or nested property."
    ws_broadcast = "Send a message to connected WebSocket clients on a channel."
    load_rune = "Load another Rune document from a file or directory."
