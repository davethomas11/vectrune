    try_it = "Press PLAY NOW, move with WASD or the arrow keys, and fire with Space. On a phone, use the on-screen D-pad and FIRE."
}

Studio {
    badge = "8-Bit DAW & Synth"
    title = "Rune Studio: 8-Bit Chiptune DAW"
