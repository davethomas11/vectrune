SpaceInvaders {
    badge = "Retro Arcade Game"
    title = "VectRaiders: Defend the Vector Grid"
    description = "Defend the grid in a playable arcade game built with Rune-Web."
    play_label = "Play VectRaiders"
    feature_loop_title = "Real-Time Game Loop"
    feature_loop_desc = "timer: tick 40ms runs an automated 25fps game loop ticker directly into reactive state without manual setInterval or requestAnimationFrame boilerplate."
    feature_keys_title = "Declarative Keybindings"
    feature_keys_desc = "keys: maps keyboard events (ArrowLeft, ArrowRight, Space) directly to named actions with automatic browser scroll prevention."
    feature_math_title = "2D Spatial Primitives"
    feature_math_desc = "collide(bullet, alien, 22, 18) and clamp(x, min, max) provide reusable spatial game abilities with concise syntax."
    feature_reactive_title = "Deep Reactive State"
    feature_reactive_desc = "Mutating bullet positions or alien states triggers fast DOM frame updates with high-contrast retro neon CRT aesthetics."
    instructions_title = "Controls"
    instructions_keyboard = "A / ◀: Move Left • D / ▶: Move Right • Space: Fire Laser"
    instructions_mobile = "Touch and hold the on-screen arcade buttons to glide and fire on any mobile device or tablet."
    try_it = "Press PLAY NOW, then move with A/D or the arrow keys and fire with Space. Touch controls are below the arena."
}

VectWorms {
    badge = "Retro Arcade Game"
    title = "VectWorms: Purge the Mushroom Grid"
