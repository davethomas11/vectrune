    edit_hint = "Modifiez le code, puis appuyez sur Exécuter pour appliquer les modifications."
    run = "Exécuter"
    run_changes = "Appliquer les modifications"
    pending_changes = "Modifications non appliquées. Appuyez sur Exécuter pour les appliquer."
}
Footer {
    copyright = "© 2026 Projet Vectrune - aperçu du site d'enseignement"
