RestGuide {
    title = "Applications REST"
    intro = "Définissez des points de terminaison HTTP avec @Route et leurs étapes dans run:. Les applications REST peuvent aussi héberger des pages Rune-Web, des fichiers statiques et des hooks WebSocket."
    syntax_1 = "@App sélectionne type = REST. port définit le port ; le CLI peut le remplacer avec --port."
    syntax_2 = "@Route/GET /hello indique la méthode et le chemin. Utilisez POST, PUT, PATCH ou DELETE pour les autres points de terminaison."
    syntax_3 = "run: contient des étapes ordonnées. respond 200 envoie un statut HTTP et des données ; @Schema et validate permettent de vérifier les données reçues."
    run = "Enregistrez ce code dans rest.rune, démarrez le serveur, puis appelez /hello."
    note = "Essayez cet exemple dans le navigateur ou suivez les tutoriels GET, POST et validation du menu."
}

GraphqlGuide {
    title = "Applications GraphQL"
    intro = "Décrivez les objets avec @Schema et exposez des requêtes ou mutations avec des sections @GraphQL. Le serveur natif accepte les opérations sur /graphql."
    syntax_1 = "@App type = GraphQL démarre le serveur. @Schema/Greeting déclare les champs de l’objet Greeting."
    syntax_2 = "@GraphQL/Query/Greeting déclare des requêtes renvoyant Greeting. Chaque nom se termine par : et ses étapes indentées renvoient des données."
    syntax_3 = "@GraphQL/Mutation/Greeting déclare les mutations. Les arguments utilisent nom: type entre parenthèses et deviennent des variables du résolveur."
    run = "Enregistrez le code dans graphql.rune. Ouvrez http://127.0.0.1:3000/ pour l’explorateur GraphQL ou envoyez les opérations en POST sur /graphql."
    note = "Ce code utilise les formes natives @Schema et @GraphQL. Le bac à sable comprend aussi @Type, @Query et @Mutation ; utilisez les formes ci-dessus pour le serveur natif."
    operation = "Syntaxe des requêtes et mutations"
}

StaticGuide {
    title = "Applications statiques"
    intro = "Servez un dossier de fichiers HTML, images, scripts et autres ressources. Une application statique sert les fichiers directement sans compiler les pages Rune-Web à chaque requête."
    syntax_1 = "@App type = STATIC sélectionne le serveur de fichiers. port choisit le port HTTP."
    syntax_2 = "root = public sert le dossier public relatif au répertoire de travail. Lancez la commande depuis le dossier du projet."
    syntax_3 = "Une requête de dossier sert son index.html. Créez public/index.html avant de démarrer le serveur."
    run = "Enregistrez la configuration dans static.rune à côté d’un dossier public contenant index.html, puis ouvrez http://127.0.0.1:3000/."
    note = "Pour publier Rune-Web sous forme statique, exportez d’abord la page avec -o html et copiez les ressources référencées dans le dossier de sortie."
}

SocketGuide {
    title = "WebSockets dans les applications REST"
    intro = "WebSocket est une fonctionnalité des applications REST. Utilisez @Websocket pour une connexion persistante et pour traiter les événements de connexion et les messages."
    syntax_1 = "Conservez @App type = REST. @Websocket/chat monte le point de terminaison WebSocket sur /chat."
    syntax_2 = "on_connect:, on_message: et on_disconnect: contiennent les étapes de chaque événement. Le message reçu est disponible dans body."
    syntax_3 = "ws.broadcast /chat body envoie le message à tous les clients connectés sur /chat. Utilisez ws.send pour une seule connexion."
    run = "Enregistrez ce code dans websocket.rune et connectez un client à ws://127.0.0.1:3000/chat. Ouvrez deux clients pour tester la diffusion."
    note = "Cet exemple nécessite le serveur natif. WebSocket n’est pas un type @App autonome et le bac à sable n’exécute pas les hooks de sockets natifs."
}

WebGuide {
    title = "Applications Rune-Web"
    intro = "Écrivez les vues HTML, l’état réactif, les actions et les styles en Rune. Rune-Web est un mode @Frontend hébergé par une application REST et peut être exporté en HTML statique."
    syntax_1 = "@Frontend type = rune-web monte l’interface. path = %ROOT% la place sur / ; page = home sélectionne @Page/home."
    syntax_2 = "@Logic/counter définit l’état et les actions. La page le sélectionne avec logic = counter ; click=increment() appelle l’action."
    syntax_3 = "@Page/home contient un arbre view: où l’indentation imbrique les éléments. @Style/site fournit les règles ; les vues réutilisables utilisent @Component/Name."
    run = "Enregistrez le fichier dans rune-web.rune. Démarrez le serveur ou exportez la page avec -o html."
    note = "Le compteur ci-dessous est compilé depuis l’exemple du dépôt. Ouvrez son code pour voir une interface complète avec styles et actions."
}

Localization {
    title = "Localisation dans Rune-Web"
    intro = "Conservez les traductions dans des ensembles @I18N, puis référencez les mêmes clés dans chaque vue. Ce site utilise des ensembles anglais, espagnol et français écrits en Rune."
    bundles_title = "Définir et utiliser les clés"
    bundles = "Une section @I18N/langue contient des groupes comme Common. Utilisez %i18n.Common.hello% dans le texte ou les attributs, ou l’expression {i18n.Common.hello}. Conservez les mêmes groupes et clés partout ; les clés manquantes ne reviennent pas automatiquement à l’anglais."
    select_title = "Choisir une langue"
    select = "locale = en_us dans @Frontend définit l’ensemble par défaut. Sur le serveur natif, ?locale=es en sélectionne un autre pour cette requête. Les noms doivent correspondre exactement aux sections @I18N."
    local_title = "Utiliser les mêmes liens en local et en production"
    local = "locale_paths associe les ensembles à des chemins du serveur. Ici, /es/ et /fr/ fonctionnent lorsque l’application tourne en local. Pour un hébergement statique, exportez chaque chemin vers son index.html et copiez les ressources ; un hébergeur statique ne traite pas ?locale=."
    contribute_title = "Contribuer à une traduction"
    contribute = "Les traductions du site sont dans teaching_website/parts/i18n. Mettez à jour les clés correspondantes dans en_us.rune, es.rune et fr.rune. Conservez les mots-clés Rune, noms des fonctions, chemins et codes d’exemple."
}

Tutorial {
    get_title = "Traiter les requêtes GET"
    get_intro = "Déclarez une route GET et renvoyez des données avec respond. Choisissez un point de terminaison et envoyez une requête pour le tester."
    post_title = "Traiter les requêtes POST"
    post_intro = "Utilisez @Schema et expect pour décrire les champs reçus. Analysez le corps JSON, validez-le et répondez avec le statut 201."
    validation_title = "Validation et schémas"
    validation_intro = "Validez la structure du corps JSON avec @Schema, puis vérifiez les règles avec des expressions validate. Essayez un prix négatif pour voir une erreur."
}

BuiltinSummary {
    summarize = "Regroupez effectifs, sommes, moyennes, médianes, valeurs distinctes et premières ou dernières valeurs en une ligne."
    log = "Journalise un message de diagnostic avec les valeurs interpolées."
    respond = "Envoie un statut HTTP et un corps de réponse."
    return = "Renvoie une valeur depuis un gestionnaire ou résolveur."
    parse_json = "Convertit du texte JSON en objets ou listes."
    validate = "Vérifie un schéma ou impose une condition."
    memory_set = "Stocke une valeur dans la mémoire partagée."
    memory_get = "Lit une valeur dans la mémoire partagée."
    memory_clear = "Efface toutes les entrées de mémoire partagée."
    memory_del = "Supprime une entrée de mémoire partagée."
    csv_read = "Lit les lignes CSV sous forme de liste d’objets."
    csv_append = "Ajoute un enregistrement dans un fichier CSV."
    csv_write = "Écrit une liste d’enregistrements dans un fichier CSV."
    is_set = "Vérifie l’existence d’une variable ou d’un chemin imbriqué."
    delete = "Supprime une variable ou une propriété imbriquée."
    ws_broadcast = "Envoie un message aux clients WebSocket d’un canal."
    load_rune = "Charge un autre document Rune depuis un fichier ou dossier."
    to_number = "Convertit une valeur en nombre."
    to_string = "Convertit une valeur en texte."
    to_bool = "Convertit une valeur en booléen."
    uuid_v4 = "Génère un UUID aléatoire de version 4."
    now = "Obtient l’heure UTC actuelle."
}

DynamicAi {
    saved = "Enregistrez une page avec ?generation=cafe-v1 et retrouvez cette URL après un redémarrage. Utilisez ?cache=off pour un nouvel aperçu sans modifier les versions enregistrées. Une nouvelle clé enregistre une autre version. Les API restent actives."
    timing = "Définissez response_target_seconds dans @App pour recommander un délai à l’IA. L’écran d’attente affiche cet objectif indicatif ; timeout_seconds reste la limite stricte."
    progress = "Pendant la génération, Vectrune affiche un écran d’attente avec des messages et le temps écoulé. Les pages en cache s’ouvrent immédiatement ; les erreurs proposent un bouton pour réessayer. Le serveur journalise les durées et les accès au cache."
    demos_title = "Essayer une démo CLI"
    demos_body = "Installez la CLI correspondante et connectez-vous, puis lancez un exemple à la fois. Chacun utilise le modèle par défaut de sa CLI."
    nav = "Sites IA dynamiques"
    eyebrow = "Type d’application expérimental"
    title = "Sites IA dynamiques"
    intro = "Décrivez un site en Rune et laissez un moteur IA générer ses pages HTML et API JSON. Utilisez Ollama en local ou une CLI Codex ou Copilot authentifiée."
    syntax_1 = "@App type = dynamic-ai-web sélectionne le serveur IA. engine choisit ollama, codex ou copilot ; model sélectionne un modèle compatible."
    syntax_2 = "@Site et @Content décrivent le site et @Data fournit les données de référence. @Page décrit une page HTML complète générée sur son chemin."
    syntax_3 = "@Route/METHOD /chemin décrit une réponse JSON plutôt qu’un bloc run:. Le moteur reçoit les paramètres de chemin, la requête et le corps JSON avec les données publiques du site."
    native_title = "Exécuter avec le CLI natif"
    native_body = "Les sites IA dynamiques nécessitent un serveur et le moteur choisi. L’hébergement statique et le bac à sable du navigateur n’exécutent pas les fournisseurs IA. Les points de terminaison génèrent des données ; la persistance et les transactions nécessitent une logique distincte."
    engines_title = "Choisissez le moteur"
    engines_body = "Ollama utilise son API locale et phi4 par défaut. Codex et Copilot utilisent leurs CLI authentifiées dans des espaces temporaires avec des contrôles de génération. En changeant de moteur, retirez model = phi4 ou choisissez un modèle compatible."
    behavior = "Les pages sont brièvement mises en cache ; les API sont générées à chaque requête. Configurez cache_seconds, timeout_seconds et max_concurrent dans @App. Un HTML ou JSON invalide produit une erreur. Le contenu varie selon le modèle."
}

RuneWebGuide {
    group = "Guide Rune-Web"
    live = "Exemple interactif"
    local = "Lancer cette leçon localement"
    shared = "Chaque exemple est une application Rune-Web complète et importe parts/style.rune. Ouvrez le code pour consulter les deux fichiers. Les données restent dans ce navigateur et sont réinitialisées au rechargement de l’aperçu."
    components_title = "Composants et props"
    components_intro = "Composez une page avec des vues @Component réutilisables. Les cartes d’ateliers partagent une structure et reçoivent leur contenu par les props."
    components_syntax = "props: [title, level, note?] déclare les entrées obligatoires et une note facultative. Passez les valeurs par nom et utilisez ?? pour une valeur par défaut."
    components_behavior = "@Frontend choisit la @Page initiale. La page utilise WorkshopCard deux fois avec des props distinctes. Un composant réutilise une vue ; il ne crée pas une route serveur indépendante."
    components_try = "Comparez les cartes et ouvrez leur code. Ajoutez une note à la première et lancez l’application localement pour voir la différence."
    forms_title = "État et formulaires"
    forms_intro = "Créez un pass d’atelier dont l’aperçu suit votre nom et votre session. state: fournit les valeurs initiales ; les accolades les lisent dans le texte et les attributs."
    forms_syntax = "Le gestionnaire change appelle setGuest(this.value) ou setSession(this.value). Les actions @Logic affectent les valeurs et le moteur réactif actualise la vue."
    forms_behavior = "change se déclenche lorsque la modification est validée, par exemple en quittant le champ. Les événements sont explicites ; <-> ne lie pas généralement la valeur des champs. Le pass est un aperçu local sans réservation."
    forms_try = "Remplacez Guest par votre nom et quittez le champ. Choisissez Studio et observez votre pass."
    actions_title = "Actions et listes"
    actions_intro = "Créez une liste de voyage avec ajout, rangement et suppression. Un tableau d’état pilote la vue répétée et le message de liste vide."
    actions_syntax = "@Logic définit des actions paramétrées. items.push(...) ajoute un enregistrement, une boucle for modifie l’élément correspondant et items.filter it.id != id le supprime."
    actions_behavior = "for item in items: répète une vue ; if items.length == 0: gère le cas vide. Les expressions conditionnelles choisissent le texte Packed et la classe done. Utilisez des identifiants stables pour les éléments."
    actions_try = "Ajoutez Snacks, rangez-le puis annulez ce choix. Supprimez tous les éléments pour voir le cas vide. Le code contient la petite application complète."
    views_title = "Vues et liaisons de sélection"
    views_intro = "Passez du résumé d’un voyage à son programme avec l’état, match et de petits composants. Les vues restent dans une seule page."
    views_syntax = "bindings: .active <-> tab relie un sélecteur à l’état de sélection. Un bouton avec {.active when 'schedule'} reçoit la classe active et affecte tab au clic."
    views_behavior = "match tab: choisit le composant à afficher. Cette sélection ne crée ni routes URL, ni historique, ni widget complet d’onglets accessibles ; la démo utilise des boutons de navigation ordinaires."
    views_try = "Choisissez Schedule puis Summary. Le bouton actif et le contenu changent ensemble sans recharger la page."
    styles_title = "Styles et mise en page adaptative"
    styles_intro = "Créez une étagère en grille adaptative avec les tokens, presets et rules de @Style. Toute la présentation est écrite en Rune."
    styles_syntax = "tokens: nomme les valeurs communes ; presets: regroupe les déclarations réutilisables. .panel utilise le preset panel et style = guide applique le style à la page."
    styles_behavior = "Les règles comprennent focus-visible et une grille ajustée à la largeur disponible. Les références comme {brand} harmonisent les couleurs. Ce sont des styles, pas un état réactif."
    styles_try = "Redimensionnez l’aperçu ou le navigateur. Ouvrez parts/style.rune, modifiez brand et exportez localement pour essayer votre palette."
}
