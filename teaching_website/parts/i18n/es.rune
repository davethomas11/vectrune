SpaceInvaders {
    badge = "Juego Retro Arcade"
    title = "VectRaiders: Defiende la Cuadrícula Vectorial"
    description = "Defiende la cuadrícula en un juego de arcade creado con Rune-Web."
    play_label = "Jugar VectRaiders"
    feature_loop_title = "Bucle de juego en tiempo real"
    feature_loop_desc = "timer = tick 40ms ejecuta un bucle a 25 fps directamente sobre el estado reactivo sin necesidad de setInterval o requestAnimationFrame."
    feature_keys_title = "Asignación de teclas declarativa"
    feature_keys_desc = "keys: mapea teclas (ArrowLeft, ArrowRight, Space) directamente a acciones con prevención automática de desplazamiento."
    feature_math_title = "Primitivas espaciales 2D"
    feature_math_desc = "collide(bullet, alien, 22, 18) y clamp(x, min, max) proporcionan habilidades espaciales concisas y reutilizables."
    feature_reactive_title = "Estado reactivo profundo"
    feature_reactive_desc = "Modificar balas o extraterrestres actualiza el DOM de forma fluida con estética retro neón CRT."
    instructions_title = "Controles"
    instructions_keyboard = "A / ◀: Izquierda • D / ▶: Derecha • Espacio: Disparar"
    instructions_mobile = "Toca y mantén los botones arcade en pantalla para desplazarte y disparar en móviles y tabletas."
    try_it = "Pulsa PLAY NOW, muévete con A/D o las flechas y dispara con Espacio. Los controles táctiles están debajo del juego."
}

VectWorms {
    badge = "Juego Retro Arcade"
    title = "VectWorms: Purga el Campo de Hongos"
    description = "Limpia la cuadrícula de hongos en este juego de arcade de Rune-Web."
    play_label = "Jugar VectWorms"
    feature_split_title = "División de Cadenas"
    feature_split_desc = "Destruir un segmento genera un nuevo hongo y convierte al segmento siguiente en una nueva cabeza independiente."
    feature_field_title = "Generadores de Estado"
    feature_field_desc = "Las filas de hongos y los 10 segmentos se generan declarativamente usando plantillas locales, inc y modificadores all."
    feature_fx_title = "Partículas y Audio Sintetizado"
    feature_fx_desc = "Las declaraciones emitter y acciones sound activan explosiones de partículas y efectos Web Audio en tiempo real."
    feature_controls_title = "Zona 2D y Cruceta Arcade"
    feature_controls_desc = "Movimiento en 4 direcciones dentro de la zona del jugador con teclado WASD/Flechas o cruceta táctil en pantalla."
    instructions_title = "Controles"
    instructions_keyboard = "WASD / Flechas: Mover en 4 direcciones • Espacio: Disparar"
    instructions_mobile = "Usa la cruceta táctil y el botón de disparo en móviles o tabletas."
    try_it = "Pulsa PLAY NOW, usa WASD o las flechas y dispara con Espacio. En el móvil, usa la cruceta y FIRE."
}

Studio {
    badge = "DAW y Sintetizador 8-Bit"
    title = "Rune Studio: DAW Chiptune 8-Bit"
    description = "Compón una pista de 8 bits en tu navegador, edita las notas y exporta tu canción como código .rune."
    feature_chiptune_title = "Sintetizador Chiptune Web Audio"
    feature_chiptune_desc = "Escucha ondas cuadradas, líneas de bajo triangulares y percusión de ruido blanco en tiempo real con envolventes ADSR y frecuencias configurables."
    feature_multitrack_title = "Secuenciador Multipista Visual"
    feature_multitrack_desc = "Compón melodías solistas, arpegios, bajos pulsantes y percusión con notación compás por compás y control de tempo."
    feature_storage_title = "Guardar y restaurar arreglos"
    feature_storage_desc = "SAVE y LOAD guardan un arreglo en este navegador. En la vista integrada, los datos pueden durar solo la sesión actual; exporta un archivo para conservar tu canción."
    feature_export_title = "Exportar tu canción"
    feature_export_desc = "EXPORT .RUNE descarga el código @Music de tu canción. Es independiente de la aplicación Studio completa y sus archivos fuente."
    instructions_title = "Cómo usar"
    instructions_songs = "Elige una canción, pulsa PLAY para escucharla y STOP para terminar. Selecciona una voz y edita notas en el piano roll o la vista STRIP."
    instructions_storage = "SAVE guarda el arreglo en el navegador y LOAD lo restaura. EXPORT .RUNE descarga el código de la canción. Conserva ese archivo antes de salir o recargar la vista."
    try_it = "Elige una canción y pulsa PLAY y luego STOP. Selecciona una voz y haz clic en una nota para editarla."
}

Reference {
    search_label = "Buscar funciones"
    eyebrow = "Biblioteca estándar"
    title = "Referencia de funciones integradas"
    intro = "Explora la sintaxis y los ejemplos de funciones integradas. Filtra por categoría o busca y carga un ejemplo en el entorno del navegador."
    search = "Buscar funciones (log, csv, memory, validate)…"
    all = "Todas"
    diagnostics = "Diagnóstico"
    http = "HTTP"
    data = "Datos y JSON"
    schema = "Esquemas"
    memory = "Memoria"
    io = "E/S y CSV"
    context = "Contexto"
    websocket = "WebSockets"
    playground = "Área de pruebas"
    try_title = "Prueba funciones en el navegador"
    try_body = "Carga un ejemplo de arriba o edita el código de abajo para ver el resultado."
    empty = "No hay funciones que coincidan."
    reset = "Restablecer filtros"
    load = "Cargar en el entorno"
}

Guide {
    syntax = "Cómo leer la sintaxis"
    run_locally = "Ejecutar localmente"
    how_it_works = "Cómo funciona este ejemplo"
    project_setup = "Para ejecutar el ejemplo completo, instala Vectrune y Git. Clona el repositorio una vez y conserva la carpeta parts junto al archivo principal."
    clone_cmd = "git clone https://github.com/davethomas11/vectrune.git\ncd vectrune"
    project_folder = "Ejecuta estos comandos desde la raíz del repositorio. Si ya tienes una copia, abre una terminal en su raíz y omite la clonación."
}

RestGuide {
    title = "Aplicaciones REST"
    intro = "Define endpoints HTTP con @Route y ejecuta sus pasos en run:. Las aplicaciones REST también pueden alojar páginas Rune-Web, archivos estáticos y hooks WebSocket."
    syntax_1 = "@App selecciona type = REST. port indica el puerto; el CLI puede sustituirlo con --port."
    syntax_2 = "@Route/GET /hello indica el método y la ruta. Usa POST, PUT, PATCH o DELETE para otros endpoints."
    syntax_3 = "run: contiene pasos ordenados. respond 200 envía un estado HTTP y datos; @Schema y validate permiten comprobar los datos recibidos."
    run = "Guarda este código como rest.rune, inicia el servidor y solicita /hello."
    note = "Prueba el ejemplo de abajo en el navegador o usa los tutoriales GET, POST y validación del menú."
}

GraphqlGuide {
    title = "Aplicaciones GraphQL"
    intro = "Describe objetos con @Schema y expón consultas o mutaciones con secciones @GraphQL. El servidor nativo acepta operaciones en /graphql."
    syntax_1 = "@App type = GraphQL inicia el servidor. @Schema/Greeting declara los campos del objeto Greeting."
    syntax_2 = "@GraphQL/Query/Greeting declara consultas que devuelven Greeting. Cada nombre termina en : y sus pasos indentados devuelven datos."
    syntax_3 = "@GraphQL/Mutation/Greeting declara mutaciones. Los argumentos usan nombre: tipo entre paréntesis y quedan disponibles como variables."
    run = "Guarda el código como graphql.rune. Abre http://127.0.0.1:3000/ para el explorador GraphQL o envía operaciones POST a /graphql."
    note = "El código usa las formas nativas @Schema y @GraphQL. El entorno del navegador también entiende @Type, @Query y @Mutation; usa las formas anteriores para servidores nativos."
    operation = "Sintaxis de consultas y mutaciones"
}

StaticGuide {
    title = "Aplicaciones estáticas"
    intro = "Sirve un directorio de HTML, imágenes, scripts y otros archivos. Una aplicación estática sirve archivos directamente y no compila páginas Rune-Web en cada solicitud."
    syntax_1 = "@App type = STATIC selecciona el servidor de archivos. port elige el puerto HTTP."
    syntax_2 = "root = public sirve el directorio public relativo al directorio de trabajo. Ejecuta el comando desde el directorio del proyecto."
    syntax_3 = "Una solicitud de directorio sirve su index.html. Crea public/index.html antes de iniciar el servidor."
    run = "Guarda la configuración como static.rune junto a una carpeta public con index.html y abre http://127.0.0.1:3000/."
    note = "Para publicar Rune-Web como archivos estáticos, exporta primero la página con -o html y copia los archivos referenciados al directorio de salida."
}

SocketGuide {
    title = "WebSockets en aplicaciones REST"
    intro = "WebSocket es una función de las aplicaciones REST. Usa @Websocket para crear una conexión persistente y responder a eventos de conexión y mensajes."
    syntax_1 = "Mantén @App type = REST. @Websocket/chat monta el endpoint WebSocket en /chat."
    syntax_2 = "on_connect:, on_message: y on_disconnect: contienen los pasos de cada evento. El mensaje recibido está disponible en body."
    syntax_3 = "ws.broadcast /chat body envía el mensaje a todos los clientes conectados a /chat. Usa ws.send para una sola conexión."
    run = "Guarda el código como websocket.rune y conecta un cliente a ws://127.0.0.1:3000/chat. Abre dos clientes para probar la difusión."
    note = "Este ejemplo necesita el servidor nativo. WebSocket no es un tipo @App independiente y el entorno del navegador no ejecuta hooks de sockets nativos."
}

WebGuide {
    title = "Aplicaciones Rune-Web"
    intro = "Escribe vistas HTML, estado reactivo, acciones y estilos en Rune. Rune-Web es un modo @Frontend alojado por una aplicación REST y también se exporta como HTML estático."
    syntax_1 = "@Frontend type = rune-web monta la interfaz. path = %ROOT% la sitúa en /; page = home selecciona @Page/home."
    syntax_2 = "@Logic/counter define estado y acciones. La página lo selecciona con logic = counter; click=increment() llama a la acción."
    syntax_3 = "@Page/home contiene un árbol view: donde la indentación anida elementos. @Style/site aporta reglas; las vistas reutilizables usan @Component/Name."
    run = "Guarda el archivo como rune-web.rune. Ejecuta el servidor o exporta la página con -o html."
    note = "El contador de abajo se compila desde el ejemplo del repositorio. Abre su código para ver una interfaz completa con estilos y acciones."
}

Localization {
    title = "Localización en Rune-Web"
    intro = "Guarda las traducciones en paquetes @I18N y referencia las mismas claves en cada vista. Este sitio usa paquetes en inglés, español y francés escritos en Rune."
    bundles_title = "Definir y usar claves de traducción"
    bundles = "Una sección @I18N/idioma contiene grupos como Common. Usa %i18n.Common.hello% en texto o atributos. También puedes usar la expresión {i18n.Common.hello}. Mantén los mismos grupos y claves en cada paquete; las claves ausentes no recurren automáticamente al inglés."
    select_title = "Elegir un idioma"
    select = "locale = en_us en @Frontend elige el paquete predeterminado. En el servidor nativo, ?locale=es selecciona otro paquete para esa solicitud. Los nombres deben coincidir exactamente con las secciones @I18N."
    local_title = "Usar los mismos enlaces localmente y en producción"
    local = "locale_paths asigna paquetes a rutas del servidor. En este ejemplo, /es/ y /fr/ funcionan al ejecutar la aplicación localmente. En alojamiento estático, exporta cada ruta a su propio index.html y copia los recursos; un servidor estático no procesa ?locale=."
    contribute_title = "Ayudar a completar una traducción"
    contribute = "Las traducciones del sitio están en teaching_website/parts/i18n. Actualiza las claves correspondientes en en_us.rune, es.rune y fr.rune. Mantén las palabras clave, nombres de funciones, rutas y código de ejemplo de Rune."
}

Tutorial {
    get_title = "Gestionar solicitudes GET"
    get_intro = "Declara una ruta GET y devuelve datos con respond. Elige un endpoint de abajo y envía una solicitud para probarlo."
    post_title = "Gestionar solicitudes POST"
    post_intro = "Usa @Schema y expect para describir los campos recibidos. Analiza el cuerpo JSON, valídalo y responde con el estado 201."
    validation_title = "Validación y esquemas"
    validation_intro = "Valida el cuerpo JSON con @Schema y comprueba las reglas con expresiones validate. Prueba un precio negativo para ver un error."
}

BuiltinSummary {
    summarize = "Agrupa recuentos, totales, promedios, medianas, valores distintos y primeros o últimos valores en una línea."
    log = "Registra un mensaje de diagnóstico con valores interpolados."
    respond = "Envía un estado HTTP y un cuerpo de respuesta."
    return = "Devuelve un valor desde un manejador o resolutor."
    parse_json = "Convierte texto JSON en objetos o listas."
    validate = "Comprueba un esquema o exige una condición."
    memory_set = "Guarda un valor en la memoria compartida."
    memory_get = "Lee un valor de la memoria compartida."
    memory_clear = "Borra todas las entradas de memoria compartida."
    memory_del = "Elimina una entrada de memoria compartida."
    csv_read = "Lee filas CSV como una lista de objetos."
    csv_append = "Añade un registro a un archivo CSV."
    csv_write = "Escribe una lista de registros en un archivo CSV."
    is_set = "Comprueba si existe una variable o ruta anidada."
    delete = "Elimina una variable o propiedad anidada."
    ws_broadcast = "Envía un mensaje a los clientes WebSocket de un canal."
    load_rune = "Carga otro documento Rune desde un archivo o directorio."
    to_number = "Convierte un valor en número."
    to_string = "Convierte un valor en texto."
    to_bool = "Convierte un valor en booleano."
    uuid_v4 = "Genera un UUID aleatorio de versión 4."
    now = "Obtiene la hora UTC actual."
}

DynamicAi {
    saved = "Guarda una página con ?generation=cafe-v1 y vuelve a esa URL después de reiniciar. Usa ?cache=off para una vista nueva sin modificar versiones guardadas. Usa otra clave para guardar una versión diferente. Las respuestas de API siguen siendo en vivo."
    timing = "Configura response_target_seconds en @App para recomendar cuánto debe tardar la IA. La pantalla de espera muestra este objetivo orientativo; timeout_seconds sigue siendo el límite estricto."
    progress = "Mientras se genera una página, Vectrune muestra una pantalla de espera con mensajes y tiempo transcurrido. Las páginas en caché se abren al instante; los errores ofrecen un botón para reintentar. El servidor registra los tiempos de generación y los aciertos de caché."
    demos_title = "Prueba una demo de CLI"
    demos_body = "Instala la CLI correspondiente e inicia sesión; ejecuta un ejemplo a la vez. Cada uno usa el modelo predeterminado de la CLI."
    nav = "Sitios de IA dinámicos"
    eyebrow = "Tipo de aplicación experimental"
    title = "Sitios de IA dinámicos"
    intro = "Describe un sitio en Rune y deja que un motor de IA genere sus páginas HTML y API JSON. Usa Ollama localmente o una sesión autenticada de Codex o Copilot CLI."
    syntax_1 = "@App type = dynamic-ai-web selecciona el servidor de IA. engine elige ollama, codex o copilot; model selecciona un modelo compatible."
    syntax_2 = "@Site y @Content describen el sitio y @Data aporta los registros. @Page describe una página HTML completa generada en su ruta."
    syntax_3 = "@Route/METHOD /ruta describe una respuesta JSON en lugar de un bloque run:. El motor recibe parámetros de ruta, consulta y cuerpo JSON junto con los datos públicos del sitio."
    native_title = "Ejecutar con el CLI nativo"
    native_body = "Los sitios de IA dinámicos necesitan un servidor y el motor elegido. El alojamiento estático y el entorno del navegador no ejecutan proveedores de IA. Los endpoints generan datos; la persistencia y las transacciones requieren lógica independiente."
    engines_title = "Elige el motor"
    engines_body = "Ollama usa su API local y phi4 de forma predeterminada. Codex y Copilot usan sus CLI autenticados en directorios temporales con controles de generación. Al cambiar de motor, elimina model = phi4 o elige un modelo compatible."
    behavior = "Las páginas se almacenan brevemente en caché; las API se generan en cada solicitud. Configura cache_seconds, timeout_seconds y max_concurrent en @App. El HTML o JSON no válido produce un error. El contenido varía según el modelo."
}

RuneWebGuide {
    group = "Guía de Rune-Web"
    live = "Ejemplo en vivo"
    local = "Ejecuta esta lección localmente"
    shared = "Cada ejemplo es una aplicación Rune-Web completa e importa parts/style.rune. Abre el código para ver ambos archivos. Los datos de demostración permanecen en este navegador y se reinician al recargar la vista previa."
    components_title = "Componentes y props"
    components_intro = "Compón una página con vistas @Component reutilizables. Las tarjetas de talleres comparten estructura y reciben su contenido mediante props."
    components_syntax = "props: [title, level, note?] declara entradas obligatorias y una nota opcional. Pasa valores por nombre al invocar el componente y usa ?? para un valor predeterminado."
    components_behavior = "@Frontend elige la @Page inicial. La página usa WorkshopCard dos veces con props diferentes. Los componentes reutilizan vistas; no crean rutas de servidor independientes."
    components_try = "Compara las tarjetas y abre su código. Añade una nota a la primera y ejecuta la aplicación localmente para ver el cambio."
    forms_title = "Estado y formularios"
    forms_intro = "Crea un pase de taller cuya vista previa sigue tu nombre y sesión. state: proporciona los valores iniciales; las llaves los muestran en texto y atributos."
    forms_syntax = "El evento change llama a setGuest(this.value) o setSession(this.value). Las acciones de @Logic asignan los valores y el sistema reactivo actualiza la vista."
    forms_behavior = "change se dispara al confirmar una edición, por ejemplo al salir del campo. Es manejo explícito de eventos; <-> no enlaza de forma general los valores de entrada. El pase es local y no envía una reserva."
    forms_try = "Cambia Guest por tu nombre y sal del campo. Elige Studio y observa los valores en el pase."
    actions_title = "Acciones y listas"
    actions_intro = "Crea una lista de equipaje con acciones para añadir, marcar y eliminar. Un array de estado controla la vista repetida y el mensaje de lista vacía."
    actions_syntax = "@Logic define acciones con parámetros. items.push(...) añade un registro; un bucle for actualiza el elemento y items.filter it.id != id lo elimina."
    actions_behavior = "for item in items: repite una vista; if items.length == 0: muestra el caso vacío. Las expresiones condicionales eligen el texto Packed y la clase done. Usa identificadores estables para los registros."
    actions_try = "Añade Snacks, márcalo y desmárcalo; elimina todos los elementos para ver el estado vacío. El código contiene la aplicación completa."
    views_title = "Vistas y enlaces de selección"
    views_intro = "Alterna entre el resumen de un viaje y su itinerario mediante estado, match y componentes pequeños. Son vistas de una sola página."
    views_syntax = "bindings: .active <-> tab conecta un selector con el estado de selección. Un botón con {.active when 'schedule'} recibe la clase activa y asigna tab al pulsarlo."
    views_behavior = "match tab: elige el componente que se muestra. La selección no crea rutas URL, historial ni un widget completo de pestañas accesibles; la demo usa botones de navegación normales."
    views_try = "Elige Schedule y después Summary. El botón activo y el contenido cambian juntos sin recargar la página."
    styles_title = "Estilos y diseño adaptable"
    styles_intro = "Da a una estantería una cuadrícula adaptable con tokens, presets y rules de @Style. Toda la presentación se escribe en Rune."
    styles_syntax = "tokens: nombra valores compartidos; presets: agrupa declaraciones reutilizables. .panel utiliza el preset panel y style = guide aplica el estilo a la página."
    styles_behavior = "Las reglas incluyen focus-visible y una cuadrícula ajustada al espacio disponible. Referencias como {brand} mantienen colores coherentes. Son declaraciones de estilo, no estado reactivo."
    styles_try = "Cambia el tamaño de la vista previa o del navegador. Abre parts/style.rune, modifica brand y exporta localmente para probar tu paleta."
}

Developer {
    group = "Desarrollo"
    start = "Inicio para desarrolladores"
    cli = "Referencia de CLI"
    testing = "Pruebas en Rune"
    quality = "Calidad del código"
    ci = "Integración continua"
    release = "Novedades de 0.3.2"
    badge = "Herramientas de desarrollo · 0.3.2"
    start_intro = "Pasa de instalar la CLI a ejecutar cinco pruebas Rune correctas. El proyecto descargable incluye una API real, fixtures reutilizables y un flujo de GitHub Actions."
    install_title = "1. Instala o actualiza"
    install_text = "Instala Vectrune 0.3.2 o posterior. En macOS o Linux con Homebrew, usa los comandos siguientes. En Windows y otras plataformas, descarga el binario desde GitHub Releases, extráelo y añade su carpeta a PATH. Reinicia la terminal tras cambiar PATH."
    releases = "Descargar una versión"
    download_title = "2. Descarga el proyecto probado"
    download = "Descargar proyecto de desarrollo (.zip)"
    extract = "Extrae el ZIP y abre una terminal en la carpeta extraída. En Windows usa Extraer todo; en macOS abre el ZIP; en Linux usa unzip. Conserva app.rune y api.test.rune juntos."
    run_title = "3. Comprueba y ejecuta las pruebas"
    expected = "Resultado esperado: 5 passed, 0 failed. Las solicitudes de prueba se ejecutan dentro del proceso: el puerto 3000 no necesita estar libre. doctor puede informar sobre su disponibilidad."
    next = "Después, cambia una aserción y prueba test --watch. Restáurala para ver cómo se recupera la suite."
    cli_intro = "Inspecciona la instalación, comprueba el código, ejecuta pruebas y aplica formato desde una sola CLI. Los comandos usan el analizador y el router nativos de Rune."
    doctor_text = "doctor muestra el ejecutable y la versión, posibles conflictos en PATH, imports resueltos, errores del proyecto y disponibilidad del puerto configurado. No ejecuta código de inicio."
    check_text = "check valida imports, rutas, referencias, fixtures y props de Rune-Web. Los avisos de comandos mal escritos incluyen sugerencias. Usa --deny-warnings en CI."
    format_text = "fmt normaliza cabeceras, asignaciones de nivel superior e indentación de run/setup/teardown. Conserva vistas, estilos y código incrustado. Verifica el significado antes de escribir; --check no modifica archivos."
    test_text = "test ejecuta pruebas nativas HTTP/SSR y de lógica JavaScript de Rune-Web juntas sin abrir un puerto. Usa --type native o --type logic para elegir un motor. Un directorio es una aplicación/suite; un archivo carga solo sus imports. Los filtros distinguen mayúsculas y buscan fragmentos del nombre."
    json_title = "Informes y códigos de salida"
    json_text = "--json genera un informe con schema_version = 1. La salida 0 indica éxito; 1, un fallo de proyecto/pruebas/formato; 2, uso incorrecto de CLI. El modo watch emite un objeto JSON por línea con eventos run y watching."
    testing_intro = "Escribe pruebas en el mismo lenguaje que tu aplicación. Esta suite cubre salud, errores de validación, memoria nueva y un flujo de crear → consultar → actualizar."
    fixtures_title = "Preparación, fixtures y limpieza"
    fixtures_text = "El setup de @TestSuite se ejecuta antes de cada prueba. fixtures = [User] selecciona @TestFixture/User. Orden: setup de suite → fixtures → setup de prueba → run. Teardown invierte el orden. La prueba puede usar variables del fixture."
    isolation_title = "Aislamiento y fallos"
    isolation_text = "La memoria Rune se reinicia y la aplicación vuelve a iniciarse para cada prueba. Los fallos de aserción, setup, inicio o teardown hacen fallar la prueba. La limpieza se ejecuta tras fallos o timeout con un límite separado. Una interrupción abrupta no garantiza la limpieza. Los archivos y bases de datos externos no se revierten."
    watch_title = "Mantén abierto el ciclo de pruebas"
    watch_text = "Watch vuelve a ejecutar tras cambios en Rune, imports o fixtures JSON/YAML/CSV. Admite guardados atómicos, imports ausentes y reparaciones posteriores. Ctrl-C termina; mientras espera, el código de salida refleja la última ejecución completada."
    quality_intro = "Integra el formato y los diagnósticos en tu ciclo de editar → comprobar → probar."
    diagnostics_title = "Encuentra la instrucción que falla"
    diagnostics_text = "Los errores de prueba muestran archivo, línea, columna, código y valores reales/esperados. Los avisos de comandos señalan la instrucción y sugieren un builtin. Las comprobaciones de sección identifican la declaración. El tipado completo de expresiones llegará más adelante."
    opaque_title = "Conserva el contenido escrito"
    opaque_text = "El formateador conserva vistas, CSS y texto incrustado. Formatea el archivo de entrada y sus imports, valida todos los cambios antes de escribir y rechaza cambios que alteren el documento analizado. Revisa el diff."
    ci_intro = "Copia este flujo en .github/workflows/rune.yml de tu proyecto. También viene en el proyecto descargable. Usa Ubuntu x86-64 y fija la CLI en 0.3.2."
    ci_text = "El pipeline comprueba instalación, formato, diagnósticos y pruebas. Los informes JSON sirven para otras herramientas; una salida distinta de cero hace fallar el trabajo. No requiere herramientas de caché."
    release_intro = "Prueba la lógica cliente de Rune-Web junto con las APIs nativas directamente desde la CLI."
    release_text = "0.3.2 integra QuickJS en vectrune test. Las pruebas de lógica reutilizan el intérprete de acciones de producción con estado aislado, almacenamiento, descargas, portapapeles y audio simulados, y límites de tiempo que interrumpen la ejecución. No necesitan Node ni navegador. Rune Studio incluye 12 pruebas nativas y de lógica con 53 aserciones."
    upgrade_title = "Actualiza y verifica"
    upgrade_text = "Con Homebrew, actualiza e instala la nueva versión. En otras plataformas, sustituye el binario por 0.3.2 desde Releases. doctor muestra el ejecutable real para detectar versiones antiguas en PATH."
    cmd_1 = "brew install davethomas11/vectrune/vectrune\nvectrune --version"
    cmd_2 = "vectrune doctor .\nvectrune fmt . --check\nvectrune check . --deny-warnings\nvectrune test ."
    cmd_3 = "vectrune doctor .\nvectrune doctor app.rune --json"
    cmd_4 = "vectrune check . --deny-warnings"
    cmd_5 = "vectrune fmt .\nvectrune fmt . --check"
    cmd_6 = "vectrune test . --list\nvectrune test . --filter User\nvectrune test . --timeout 5\nvectrune test . --watch"
    cmd_7 = "vectrune test . --json\nvectrune test . --watch --json"
    cmd_8 = "vectrune test . --watch\nvectrune test . --filter UserLifecycle --timeout 5"
    cmd_9 = "vectrune check . --deny-warnings\nvectrune test . --json"
    cmd_10 = "vectrune fmt . --check\nvectrune fmt ."
    cmd_11 = "brew update\nbrew upgrade vectrune\nvectrune --version\nvectrune doctor ."
    boundary_title = "Mantén las pruebas fuera de producción"
    boundary_text = "Usa .test.rune para pruebas, fixtures y hooks de suite. Los imports de directorios omiten estos archivos y los imports explícitos desde archivos de aplicación se rechazan. Las pruebas pueden importar código de aplicación y otros helpers de prueba explícitos. Los imports de directorios siempre omiten pruebas; vectrune test las descubre aparte. Los paquetes Lambda también las excluyen."
    logic_title = "Pruebas de lógica JavaScript · 0.3.2"
    logic_text = "Usa type = logic y page = studio para probar las acciones reales de Rune-Web. invoke llama a una acción con argumentos JSON opcionales; assert comprueba el estado, los valores derivados o los efectos simulados. Ambos motores se ejecutan juntos por defecto. Cada prueba de lógica usa un entorno JavaScript nuevo, con setup y teardown opcionales."
    logic_limits = "Este primer motor admite acciones síncronas. DOM y diseño, temporizadores, tareas asíncronas, red simulada y fixtures de lógica compartidos quedan pendientes. Usa el script Playwright para interacciones reales del navegador. Los ejemplos siguientes se ejecutan desde el repositorio de Vectrune."
    cmd_12 = "vectrune test examples/rune_studio\nvectrune test examples/rune_studio --type logic --json"
}

