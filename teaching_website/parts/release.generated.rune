# Generated from teaching_website/release.json. Do not edit.
@Logic/teaching
state:
    release_info = {"version":"0.3.10","locales":{"en_us":{"intro":"Play Marble Run and Dog Walker, two arcade games built with Pixel 3D.","summary":"This release adds sphere, cylinder, and ramp models. The Marble Run demo lets you compare resolutions, palettes, and frame rates and try the experimental WebGL renderer on supported devices. Dog Walker showcases 3D tethers, and the teaching site adds expandable navigation and a release history."},"es":{"intro":"Juega a Marble Run y Dog Walker, dos juegos arcade creados con Pixel 3D.","summary":"Esta versión incorpora modelos de esferas, cilindros y rampas. La demo de Marble Run permite comparar resoluciones, paletas y frecuencias de imagen y probar el renderizado experimental WebGL en dispositivos compatibles. Dog Walker muestra las cuerdas 3D y el sitio incorpora navegación desplegable y un historial de versiones."},"fr":{"intro":"Jouez à Marble Run et Dog Walker, deux jeux d’arcade créés avec Pixel 3D.","summary":"Cette version ajoute des modèles de sphères, de cylindres et de rampes. La démo Marble Run permet de comparer les résolutions, les palettes et les cadences et d’essayer le rendu WebGL expérimental sur les appareils compatibles. Dog Walker présente les attaches 3D, et le site propose une navigation déroulante et un historique des versions."}},"releases":[{"tag":"v0.3.10","date":"2026-11-19","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.10","summary":"Marble Run showcases Pixel 3D spheres, cylinders, and ramps, with selectable resolutions, palettes, frame rates, and experimental WebGL rendering. Dog Walker introduces a breakable leash powered by 3D tethers. The teaching site adds expandable navigation and a release history.","current":true},{"tag":"v0.3.9","date":"2026-11-19","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.9","summary":"Added portable Rune syntax, persistent game and app storage, and a simpler path to hosting Rune-Web applications.","current":false},{"tag":"v0.3.8","date":"2026-11-18","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.8","summary":"Added fetch and fetch-json, reusable @Values, and improved parity between Rune-Web and the native runtime.","current":false},{"tag":"v0.3.7","date":"2026-11-18","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.7","summary":"Added offline CLI and language manuals to release archives and improved API contract handling. Starfall gained mobile fullscreen and Home Screen launch support.","current":false},{"tag":"v0.3.6","date":"2026-11-18","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.6","summary":"Introduced Starfall Protocol and chunked Pixel 3D worlds. Game showcases gained separate play and source tabs.","current":false},{"tag":"v0.3.5","date":"2026-11-17","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.5","summary":"Introduced Skybound 2 and the Pixel 3D platform runtime, including voxel worlds and cinematic cameras. The teaching site gained searchable language and library references.","current":false},{"tag":"v0.3.4","date":"2026-11-15","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.4","summary":"Introduced Rune Crypt and declarative keyboard, controller, and touch profiles for Pixel 3D games.","current":false},{"tag":"v0.3.3","date":"2026-11-14","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.3","summary":"Introduced the Pixel 3D hybrid engine and Vect Breach, with three sectors, mobile aiming, and landscape fullscreen. The same cycle added Monster City and native pixel audio.","current":false},{"tag":"v0.3.2","date":"2026-11-12","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.2","summary":"Shipped embedded JavaScript logic tests for Rune applications.","current":false},{"tag":"v0.3.1","date":"2026-11-12","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.1","summary":"Added developer checks, fixtures, watch mode, formatting, isolated tests, and localized developer guides.","current":false},{"tag":"v0.2.21","date":"2026-11-12","status":"tag","url":"https://github.com/davethomas11/vectrune/tree/v0.2.21","summary":"Added the doctor and check commands and native Rune test support.","current":false},{"tag":"v0.2.20","date":"2026-11-12","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.20","summary":"Repaired teaching-site locale navigation, preserved source formatting, and made recursively imported files browsable in examples.","current":false},{"tag":"v0.2.19","date":"2026-11-12","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.19","summary":"Added Rune Studio’s MIDI piano roll, polyphonic chords, song time signatures, and instrument racks. Audio timing was decoupled from the editor updates.","current":false},{"tag":"v0.2.18","date":"2026-11-09","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.18","summary":"Added an interactive step sequencer, active note and track highlighting, and fullscreen support for embedded Rune Studio.","current":false},{"tag":"v0.2.17","date":"2026-11-09","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.17","summary":"Added Rune Studio note editor panels and improved mobile and fullscreen layouts.","current":false},{"tag":"v0.2.16","date":"2026-11-09","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.16","summary":"Introduced Rune Studio, an 8-bit music workstation with a visual editor, preloaded songs, and browser storage.","current":false},{"tag":"v0.2.15","date":"2026-11-08","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.15","summary":"Music tracks gained multiline series for one bar per line and inline annotations.","current":false},{"tag":"v0.2.14","date":"2026-11-08","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.14","summary":"Added programmable sound synthesis and an 8-bit music sequencer. VectRaiders and VectWorms gained original tunes.","current":false},{"tag":"v0.2.13","date":"2026-11-08","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.13","summary":"Added the Rune-Web optimizer, with lazy route chunks, background preloading, and path-based navigation.","current":false},{"tag":"v0.2.12","date":"2026-11-07","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.12","summary":"Added route-specific SEO metadata, favicon support, and pre-rendered social card previews.","current":false},{"tag":"v0.2.11","date":"2026-11-07","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.11","summary":"Added VectWorms, Web Audio synthesis, declarative particle effects, and local templates.","current":false},{"tag":"v0.2.10","date":"2026-11-06","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.10","summary":"Added state generators and a compact syntax for declaring actions in Rune-Web.","current":false},{"tag":"v0.2.9","date":"2026-11-06","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.9","summary":"Expanded Rune-Web styling with multiple presets, CSS shorthands, token opacity, and nesting. VectRaiders gained improved mobile controls and sizing.","current":false},{"tag":"v0.2.8","date":"2026-11-05","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.8","summary":"Introduced Rune-Web game abilities and the arcade game later named VectRaiders. Also expanded dynamic AI teaching examples.","current":false},{"tag":"v0.2.7","date":"2026-11-04","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.7","summary":"Introduced one-line grouped reports with summarize, including median, distinct, first, and last aggregations. Updated the teaching site and browser examples.","current":false},{"tag":"v0.2.6","date":"2026-11-03","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.6","summary":"Added type conversions, UUID generation, and timestamps. Improved the standalone browser sandbox and release builds.","current":false},{"tag":"v0.2.5","date":"2026-05-10","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.5","summary":"Fixed the shell and PowerShell release-bump scripts so version updates target the package version without changing dependency versions.","current":false},{"tag":"v0.2.4","date":"2026-05-09","status":"tag","url":"https://github.com/davethomas11/vectrune/tree/v0.2.4","summary":"An intermediate version bump in the 0.2.x release-script history.","current":false},{"tag":"v0.2.3","date":"2026-05-10","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.3","summary":"Added Rune-Web memory bindings and reactive updates over WebSockets, alongside improvements to the release tooling.","current":false},{"tag":"v0.2.2","date":"2026-05-09","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.2","summary":"Added the .vect scripting language, the .vectrune natural-language engine, and file-watch hot reload. Updated the browser sandbox.","current":false},{"tag":"v0.2.1","date":"2026-05-06","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.1","summary":"Added Rune-Web localization, translated the teaching site, and introduced editor syntax highlighting for Rune.","current":false},{"tag":"v0.2.0","date":"2026-05-05","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.2.0","summary":"Introduced Rune-Web with reactive state, components, and styles. The same development cycle added WebSocket support and expanded multi-file and Swagger support.","current":false},{"tag":"v0.1.5","date":"2026-03-05","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.1.5","summary":"Improved host and port configuration and removed incidental parser output.","current":false},{"tag":"v0.1.4","date":"2026-03-04","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.1.4","summary":"Began AWS Lambda runtime work and added Zig-based Linux cross-compilation tooling.","current":false},{"tag":"v0.1.3","date":"2026-02-18","status":"tag","url":"https://github.com/davethomas11/vectrune/tree/v0.1.3","summary":"Added support for Gemini to Vectrune.","current":false},{"tag":"v0.1.2","date":"2026-02-09","status":"tag","url":"https://github.com/davethomas11/vectrune/tree/v0.1.2","summary":"Added GraphQL support.","current":false},{"tag":"v0.1.1","date":"2026-02-07","status":"published","url":"https://github.com/davethomas11/vectrune/releases/tag/v0.1.1","summary":"Added command-line document merging. Early examples covered authentication and a generated frontend.","current":false}],"github_url":"https://github.com/davethomas11/vectrune/releases","current_url":"https://github.com/davethomas11/vectrune/releases/tag/v0.3.10"}
