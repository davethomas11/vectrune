@Component/WhatsNextSection
view:
    section #next .card:
        div .section-heading:
            h2 "%i18n.WhatsNext.headline%"
        div .next-grid:
            article .next-card:
                ul:
                    li "%i18n.WhatsNext.coming_1%"
                    li "%i18n.WhatsNext.coming_2%"
                    li "%i18n.WhatsNext.coming_3%"
            article .next-card:
                h3 "%i18n.WhatsNext.releases_title%"
                a .content-link href="{i18n.Common.base_path}releases" data-route-link=true click="navigate('releases')" "%i18n.Releases.title%"

