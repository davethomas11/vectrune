@Component/LanguageSelector
view:
    details .language-control:
        summary .language-summary "{i18n.Common.language_label} {i18n.Common.language_name}"
        div .language-selector:
            span .language-label "%i18n.Common.language_label%"
            a .language-link href="/{activePage == 'home' or activePage == 'es' or activePage == 'fr' ? '' : activePage}" aria-current="{i18n.Common.locale == 'en_us' ? 'page' : 'false'}" hreflang=en lang=en "English"
            span .language-sep " / "
            a .language-link href="/es/{activePage == 'home' or activePage == 'es' or activePage == 'fr' ? '' : activePage}" aria-current="{i18n.Common.locale == 'es' ? 'page' : 'false'}" hreflang=es lang=es "Español"
            span .language-sep " / "
            a .language-link href="/fr/{activePage == 'home' or activePage == 'es' or activePage == 'fr' ? '' : activePage}" aria-current="{i18n.Common.locale == 'fr' ? 'page' : 'false'}" hreflang=fr lang=fr "Français"
