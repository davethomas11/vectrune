@Component/QuickstartSection
view:
    section #quickstart .card:
        div .section-heading:
            p .eyebrow "%i18n.Quickstart.eyebrow%"
            h2 "%i18n.Quickstart.headline%"
            p .section-copy "%i18n.Quickstart.description%"
        div .quickstart-browser:
            a .cta href=#sandbox "%i18n.Quickstart.browser_title%"
            p "%i18n.Quickstart.browser_hint%"
        h3 "%i18n.Quickstart.install_title%"
        details .installation-method open=true name=installation:
            summary "%i18n.Quickstart.homebrew_title%"
            p:
                a href=https://brew.sh target=_blank rel="noopener noreferrer" "%i18n.Quickstart.homebrew_prerequisite%"
            CommandBlock code="{i18n.Quickstart.homebrew_cmd}"
        details .installation-method name=installation:
            summary "%i18n.Quickstart.windows_title%"
            p "%i18n.Quickstart.windows_desc%"
            ol:
                li "%i18n.Quickstart.windows_step1%"
                li "%i18n.Quickstart.windows_step2%"
                li "%i18n.Quickstart.windows_step3%"
            a .content-link href=https://github.com/davethomas11/vectrune/releases/latest target=_blank rel="noopener noreferrer" "%i18n.Quickstart.releases_link%"
        details .installation-method name=installation:
            summary "%i18n.Quickstart.linux_title%"
            p "%i18n.Quickstart.linux_hint%"
            a .content-link href=https://github.com/davethomas11/vectrune/releases/latest target=_blank rel="noopener noreferrer" "%i18n.Quickstart.releases_link%"
        details .installation-method name=installation:
            summary "%i18n.Quickstart.source_title%"
            p "%i18n.Quickstart.source_note%"
            CommandBlock code="{i18n.Quickstart.source_cmd}"
        ol .quickstart-steps:
            li:
                h3 "%i18n.Quickstart.steps_verify%"
                CommandBlock code="{i18n.Quickstart.steps_verify_cmd}"
                p "%i18n.Quickstart.version_result%"
                p .document-note "%i18n.Quickstart.local_binary%"
            li:
                h3 "%i18n.Quickstart.create_title%"
                p "%i18n.Quickstart.create_hint%"
                a .secondary-cta href=/assets/content/quickstart/app.rune download=app.rune "%i18n.Quickstart.download_example%"
                div .command-block .quickstart-source:
                    button .command-copy type=button data-copied="%i18n.Quickstart.command_copied%" data-failed="%i18n.Quickstart.command_failed%" "%i18n.Examples.copy_source%"
                    ExampleSource code="{raw ../../content/quickstart/app.rune}"
            li:
                h3 "%i18n.Quickstart.steps_run%"
                CommandBlock code="{i18n.Quickstart.steps_run_cmd}"
                p "%i18n.Quickstart.steps_run_note%"
            li:
                h3 "%i18n.Quickstart.steps_hit%"
                CommandBlock code="{i18n.Quickstart.steps_hit_cmd}"
                p "%i18n.Quickstart.steps_hit_result%"
                p .document-note "%i18n.Quickstart.stop_hint%"
        div .callout .callout-success:
            strong "%i18n.Quickstart.callout_title%"
            p "%i18n.Quickstart.callout_text%"

@Component/CommandBlock
props: [code]
view:
    div .command-block:
        button .command-copy type=button data-copied="%i18n.Quickstart.command_copied%" data-failed="%i18n.Quickstart.command_failed%" "%i18n.Quickstart.command_copy%"
        pre:
            code .code-block .language-shell "{code}"
