@Component/SidebarLayout
state:
    activePage = "home"
bindings:
    .active <-> activePage

view:
    div .app-layout:
        DevBanner
        TeachingHeader
        div .app-body:
            nav .sidebar:
                div .nav-group:
                    h3 "Introduction"
                    button .nav-link {.active when 'home'} "Overview"
                div .nav-group:
                    h3 "REST API"
                    button .nav-link {.active when 'rest_get'} "GET Requests"
                    button .nav-link {.active when 'rest_post'} "POST Requests"
                    button .nav-link {.active when 'rest_validation'} "Validation"
                div .nav-group:
                    h3 "GraphQL"
                    button .nav-link {.active when 'graphql'} "Overview"
                div .nav-group:
                    h3 "Web Sockets"
                    button .nav-link {.active when 'websocket'} "Overview"
                div .nav-group:
                    h3 "Rune Web"
                    button .nav-link {.active when 'rune_web'} "Overview"
            
            main .content-area:
                match activePage:
                    "home"            -> HomeContent
                    "rest_get"        -> RestGetPage
                    "rest_post"       -> RestPostPage
                    "rest_validation" -> RestValidationPage
                    "graphql"         -> GraphqlOverviewPage
                    "websocket"       -> WebsocketOverviewPage
                    "rune_web"        -> RuneWebOverviewPage
