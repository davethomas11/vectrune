@Component/SidebarLayout
state:
    activePage = "home"
    navigationOpen = false
bindings:
    .active <-> activePage

view:
    div .app-layout:
        DevBanner
        TeachingHeader
        div .app-body data-navigation-open="{navigationOpen}":
            button .navigation-toggle type=button click="navigationOpen = !navigationOpen" aria-expanded="{navigationOpen}" aria-controls=site-navigation:
                span "%i18n.Nav.browse%"
                span aria-hidden=true "☰"
            nav #site-navigation .sidebar aria-label="%i18n.Nav.aria%":
                div .nav-group:
                    h3 "%i18n.Nav.intro%"
                    button .nav-link {.active when 'home'} click="navigate('home')" "%i18n.Nav.overview%"
                    button .nav-link {.active when 'documents'} click="navigate('documents')" "%i18n.DocumentSyntax.nav%"
                    button .nav-link {.active when 'localization'} click="navigate('localization')" "%i18n.Nav.localization%"
                div .nav-group:
                    h3 "%i18n.Nav.applications%"
                    button .nav-link {.active when 'rest'} click="navigate('rest')" "%i18n.Nav.rest%"
                    button .nav-link {.active when 'static'} click="navigate('static')" "%i18n.Nav.static%"
                    button .nav-link {.active when 'graphql'} click="navigate('graphql')" "GraphQL"
                    button .nav-link {.active when 'dynamic_ai'} click="navigate('dynamic_ai')" "%i18n.DynamicAi.nav%"
                    button .nav-link {.active when 'rune_web'} click="navigate('rune_web')" "%i18n.Nav.rune_web%"
                    button .nav-link {.active when 'websocket'} click="navigate('websocket')" "%i18n.Nav.websockets%"
                div .nav-group:
                    h3 "%i18n.Nav.rest%"
                    button .nav-link {.active when 'rest_get'} click="navigate('rest_get')" "%i18n.Nav.get%"
                    button .nav-link {.active when 'rest_post'} click="navigate('rest_post')" "%i18n.Nav.post%"
                    button .nav-link {.active when 'rest_validation'} click="navigate('rest_validation')" "%i18n.Nav.validation%"
                div .nav-group:
                    h3 "%i18n.RuneWebGuide.group%"
                    button .nav-link {.active when 'web_components'} click="navigate('web_components')" "%i18n.RuneWebGuide.components_title%"
                    button .nav-link {.active when 'web_forms'} click="navigate('web_forms')" "%i18n.RuneWebGuide.forms_title%"
                    button .nav-link {.active when 'web_actions'} click="navigate('web_actions')" "%i18n.RuneWebGuide.actions_title%"
                    button .nav-link {.active when 'web_views'} click="navigate('web_views')" "%i18n.RuneWebGuide.views_title%"
                    button .nav-link {.active when 'web_styles'} click="navigate('web_styles')" "%i18n.RuneWebGuide.styles_title%"
                div .nav-group:
                    h3 "%i18n.Nav.reference%"
                    button .nav-link {.active when 'builtins'} click="navigate('builtins')" "%i18n.Nav.builtins%"
                div .nav-group:
                    h3 "%i18n.Nav.games%"
                    button .nav-link {.active when 'space_invaders'} click="navigate('space_invaders')" "Space Invaders"
                div .nav-group:
                    h3 "%i18n.Examples.lab_eyebrow%"
                    button .nav-link {.active when 'examples'} click="openExample('app')" "%i18n.Examples.lab_title%"
            
            main .content-area:
                match activePage:
                    "home"            -> HomeContent
                    "documents"       -> DocumentSyntaxPage
                    "localization"    -> LocalizationPage
                    "rest"            -> RestOverviewPage
                    "static"          -> StaticOverviewPage
                    "space_invaders"  -> SpaceInvadersPage
                    "examples"        -> ExampleLab
                    "builtins"        -> BuiltinReferencePage
                    "rest_get"        -> RestGetPage
                    "rest_post"       -> RestPostPage
                    "rest_validation" -> RestValidationPage
                    "graphql"         -> GraphqlOverviewPage
                    "websocket"       -> WebsocketOverviewPage
                    "rune_web"        -> RuneWebOverviewPage
                    "dynamic_ai"      -> DynamicAiWebPage
                    "web_components" -> RuneWebComponentsGuide
                    "web_forms" -> RuneWebFormsGuide
                    "web_actions" -> RuneWebActionsGuide
                    "web_views" -> RuneWebViewsGuide
                    "web_styles" -> RuneWebStylesGuide
