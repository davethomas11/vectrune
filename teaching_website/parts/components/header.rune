@Component/TeachingHeader
view:
    header .site-header data-mobile-menu=false:
        a .brand href="{i18n.Common.base_path}" data-route-link=true click="navigate('home')" aria-label="%i18n.Header.home_label%":
            img .brand-logo src=/assets/rune-logo.png width=44 height=44 alt="" decoding=async
            strong .brand-name "%i18n.Common.app_name%"
        button .navigation-toggle type=button aria-expanded=false aria-controls=site-navigation:
            span .menu-icon aria-hidden=true
            span .menu-label "%i18n.SiteMenu.menu%"
        nav #site-navigation .site-nav aria-label="%i18n.Nav.aria%":
            details .menu-category data-menu-category=learn name=site-sections:
                summary .menu-category-label "%i18n.SiteMenu.learn%"
                div .menu-panel:
                    div .menu-panel-inner .menu-panel-learn:
                        div .nav-group:
                            h3 "%i18n.Nav.intro%"
                            a .nav-link href="{i18n.Common.base_path}#quickstart" data-route-link=true click="navigate('home')" "%i18n.Header.nav_quickstart%"
                            a .nav-link href="{i18n.Common.base_path}#tour" data-route-link=true click="navigate('home')" "%i18n.Header.nav_tour%"
                            a .nav-link href="{i18n.Common.base_path}#walkthrough" data-route-link=true click="navigate('home')" "%i18n.Header.nav_walkthrough%"
                            a .nav-link href="{i18n.Common.base_path}#examples" data-route-link=true click="navigate('home')" "%i18n.Header.nav_examples%"
                            a .nav-link href="{i18n.Common.base_path}#next" data-route-link=true click="navigate('home')" "%i18n.Header.nav_next%"
                            a .nav-link href="{i18n.Common.base_path}" data-route-link=true aria-current="{activePage == 'home' ? 'page' : 'false'}" click="navigate('home')" "%i18n.Nav.overview%"
                            a .nav-link href="{i18n.Common.base_path}documents" data-route-link=true aria-current="{activePage == 'documents' ? 'page' : 'false'}" click="navigate('documents')" "%i18n.DocumentSyntax.nav%"
                            a .nav-link href="{i18n.Common.base_path}localization" data-route-link=true aria-current="{activePage == 'localization' ? 'page' : 'false'}" click="navigate('localization')" "%i18n.Nav.localization%"
                        div .nav-group:
                            h3 "%i18n.Nav.applications%"
                            a .nav-link href="{i18n.Common.base_path}rest" data-route-link=true aria-current="{activePage == 'rest' ? 'page' : 'false'}" click="navigate('rest')" "%i18n.Nav.rest%"
                            a .nav-link href="{i18n.Common.base_path}static" data-route-link=true aria-current="{activePage == 'static' ? 'page' : 'false'}" click="navigate('static')" "%i18n.Nav.static%"
                            a .nav-link href="{i18n.Common.base_path}graphql" data-route-link=true aria-current="{activePage == 'graphql' ? 'page' : 'false'}" click="navigate('graphql')" "GraphQL"
                            a .nav-link href="{i18n.Common.base_path}dynamic_ai" data-route-link=true aria-current="{activePage == 'dynamic_ai' ? 'page' : 'false'}" click="navigate('dynamic_ai')" "%i18n.DynamicAi.nav%"
                            a .nav-link href="{i18n.Common.base_path}rune_web" data-route-link=true aria-current="{activePage == 'rune_web' ? 'page' : 'false'}" click="navigate('rune_web')" "%i18n.Nav.rune_web%"
                            a .nav-link href="{i18n.Common.base_path}websocket" data-route-link=true aria-current="{activePage == 'websocket' ? 'page' : 'false'}" click="navigate('websocket')" "%i18n.Nav.websockets%"
                        div .nav-group:
                            h3 "%i18n.Nav.rest%"
                            a .nav-link href="{i18n.Common.base_path}rest_get" data-route-link=true aria-current="{activePage == 'rest_get' ? 'page' : 'false'}" click="navigate('rest_get')" "%i18n.Nav.get%"
                            a .nav-link href="{i18n.Common.base_path}rest_post" data-route-link=true aria-current="{activePage == 'rest_post' ? 'page' : 'false'}" click="navigate('rest_post')" "%i18n.Nav.post%"
                            a .nav-link href="{i18n.Common.base_path}rest_validation" data-route-link=true aria-current="{activePage == 'rest_validation' ? 'page' : 'false'}" click="navigate('rest_validation')" "%i18n.Nav.validation%"
                        div .nav-group:
                            h3 "%i18n.RuneWebGuide.group%"
                            a .nav-link href="{i18n.Common.base_path}web_components" data-route-link=true aria-current="{activePage == 'web_components' ? 'page' : 'false'}" click="navigate('web_components')" "%i18n.RuneWebGuide.components_title%"
                            a .nav-link href="{i18n.Common.base_path}web_forms" data-route-link=true aria-current="{activePage == 'web_forms' ? 'page' : 'false'}" click="navigate('web_forms')" "%i18n.RuneWebGuide.forms_title%"
                            a .nav-link href="{i18n.Common.base_path}web_actions" data-route-link=true aria-current="{activePage == 'web_actions' ? 'page' : 'false'}" click="navigate('web_actions')" "%i18n.RuneWebGuide.actions_title%"
                            a .nav-link href="{i18n.Common.base_path}web_views" data-route-link=true aria-current="{activePage == 'web_views' ? 'page' : 'false'}" click="navigate('web_views')" "%i18n.RuneWebGuide.views_title%"
                            a .nav-link href="{i18n.Common.base_path}web_styles" data-route-link=true aria-current="{activePage == 'web_styles' ? 'page' : 'false'}" click="navigate('web_styles')" "%i18n.RuneWebGuide.styles_title%"
            details .menu-category data-menu-category=developer name=site-sections:
                summary .menu-category-label "%i18n.Developer.group%"
                div .menu-panel:
                    div .menu-panel-inner .menu-panel-developer:
                        div .nav-group:
                            h3 "%i18n.Developer.group%"
                            a .nav-link href="{i18n.Common.base_path}developer" data-route-link=true aria-current="{activePage == 'developer' ? 'page' : 'false'}" click="navigate('developer')" "%i18n.Developer.start%"
                            a .nav-link href="{i18n.Common.base_path}developer_cli" data-route-link=true aria-current="{activePage == 'developer_cli' ? 'page' : 'false'}" click="navigate('developer_cli')" "%i18n.Developer.cli%"
                            a .nav-link href="{i18n.Common.base_path}developer_testing" data-route-link=true aria-current="{activePage == 'developer_testing' ? 'page' : 'false'}" click="navigate('developer_testing')" "%i18n.Developer.testing%"
                            a .nav-link href="{i18n.Common.base_path}developer_quality" data-route-link=true aria-current="{activePage == 'developer_quality' ? 'page' : 'false'}" click="navigate('developer_quality')" "%i18n.Developer.quality%"
                            a .nav-link href="{i18n.Common.base_path}developer_ci" data-route-link=true aria-current="{activePage == 'developer_ci' ? 'page' : 'false'}" click="navigate('developer_ci')" "%i18n.Developer.ci%"
                            a .nav-link href="{i18n.Common.base_path}developer_release" data-route-link=true aria-current="{activePage == 'developer_release' ? 'page' : 'false'}" click="navigate('developer_release')" "{i18n.Developer.release_heading} {release_info.version}"
                        div .nav-group:
                            h3 "%i18n.Nav.reference%"
                            a .nav-link href="{i18n.Common.base_path}releases" data-route-link=true aria-current="{activePage == 'releases' ? 'page' : 'false'}" click="navigate('releases')" "%i18n.Releases.title%"
                            a .nav-link href="{i18n.Common.base_path}docs/" "%i18n.SiteMenu.api_reference%"
                            a .nav-link href="{i18n.Common.base_path}builtins" data-route-link=true aria-current="{activePage == 'builtins' ? 'page' : 'false'}" click="navigate('builtins')" "%i18n.Nav.builtins%"
            details .menu-category data-menu-category=games name=site-sections:
                summary .menu-category-label "%i18n.Nav.games%"
                div .menu-panel:
                    div .menu-panel-inner .menu-panel-games:
                        div .nav-group:
                            h3 "%i18n.Nav.games%"
                            a .nav-link href="{i18n.Common.base_path}games" data-route-link=true aria-current="{activePage == 'games' or activePage == 'vectraiders' or activePage == 'space_invaders' ? 'page' : 'false'}" click="navigate('games')" "%i18n.Nav.vectraiders%"
                            a .nav-link href="{i18n.Common.base_path}vectworms" data-route-link=true aria-current="{activePage == 'vectworms' ? 'page' : 'false'}" click="navigate('vectworms')" "%i18n.Nav.vectworms%"
                            a .nav-link href="{i18n.Common.base_path}monster-city" data-route-link=true aria-current="{activePage == 'monster-city' ? 'page' : 'false'}" click="navigate('monster-city')" "%i18n.Nav.monster_city%"
                            a .nav-link href="{i18n.Common.base_path}vect-breach" data-route-link=true aria-current="{activePage == 'vect-breach' ? 'page' : 'false'}" click="navigate('vect-breach')" "%i18n.Nav.vect_breach%"
                            a .nav-link href="{i18n.Common.base_path}rune-crypt" data-route-link=true aria-current="{activePage == 'rune-crypt' ? 'page' : 'false'}" click="navigate('rune-crypt')" "%i18n.RuneCrypt.title%"
                            a .nav-link href="{i18n.Common.base_path}skybound-2" data-route-link=true aria-current="{activePage == 'skybound-2' ? 'page' : 'false'}" click="navigate('skybound-2')" "%i18n.SkyboundTwo.title%"
                            a .nav-link href="{i18n.Common.base_path}starfall" data-route-link=true aria-current="{activePage == 'starfall' ? 'page' : 'false'}" click="navigate('starfall')" "%i18n.Starfall.title%"
                            a .nav-link href="{i18n.Common.base_path}marble-run" data-route-link=true aria-current="{activePage == 'marble-run' ? 'page' : 'false'}" click="navigate('marble-run')" "%i18n.MarbleRun.title%"
                            a .nav-link href="{i18n.Common.base_path}dog-walker" data-route-link=true aria-current="{activePage == 'dog-walker' ? 'page' : 'false'}" click="navigate('dog-walker')" "%i18n.DogWalker.title%"
                        GamePreview
            details .menu-category data-menu-category=tools name=site-sections:
                summary .menu-category-label "%i18n.SiteMenu.tools%"
                div .menu-panel:
                    div .menu-panel-inner .menu-panel-tools:
                        div .nav-group:
                            h3 "%i18n.Nav.music%"
                            a .nav-link href="{i18n.Common.base_path}studio" data-route-link=true aria-current="{activePage == 'studio' or activePage == 'music' ? 'page' : 'false'}" click="navigate('studio')" "%i18n.Nav.studio%"
                        div .nav-group:
                            h3 "%i18n.Examples.lab_eyebrow%"
                            a .nav-link href="{i18n.Common.base_path}examples" data-route-link=true aria-current="{activePage == 'examples' ? 'page' : 'false'}" click="openExample('app')" "%i18n.Examples.lab_title%"
        div .header-actions:
            LanguageSelector
