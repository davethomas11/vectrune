@Component/HeroSection
view:
    section #hero .hero:
        div .hero-copy:
            p .eyebrow "%i18n.Hero.eyebrow%"
            h1 "%i18n.Hero.headline%"
            p .lead "%i18n.Hero.lead%"
            div .hero-actions:
                a .cta href=#sandbox "%i18n.Hero.cta_primary%"
                a .secondary-cta href=#quickstart "%i18n.Hero.cta_secondary%"
        div .hero-preview:
            div .hero-preview-title:
                span "app.rune"
                span .hero-format "REST"
            pre .hero-preview-code:
                code:
                    span .hero-code-heading "@App"
                    span "name = Example API"
                    span "type = REST"
                    span .hero-code-heading .hero-code-route "@Route/GET /health"
                    span "run:"
                    span .hero-code-indent "respond 200 \"OK\""

