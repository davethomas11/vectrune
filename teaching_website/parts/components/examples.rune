@Component/ExamplesSection
view:
    section #examples .card:
        div .section-heading:
            h2 "%i18n.Examples.headline%"
        div .examples-grid:
            article .example-card:
                h3 "%i18n.Examples.app_title%"
                p "%i18n.Examples.app_desc%"
                a .secondary-cta href="{i18n.Common.base_path}examples" data-route-link=true click="openExample('app')" "%i18n.Examples.run_label%"
            article .example-card:
                h3 "%i18n.Examples.skaters_title%"
                p "%i18n.Examples.skaters_desc%"
                a .secondary-cta href="{i18n.Common.base_path}examples" data-route-link=true click="openExample('skaters')" "%i18n.Examples.run_label%"
            article .example-card:
                h3 "%i18n.Examples.counter_title%"
                p "%i18n.Examples.counter_desc%"
                a .secondary-cta href="{i18n.Common.base_path}examples" data-route-link=true click="openExample('counter')" "%i18n.Examples.play_label%"
        a .content-link .examples-more href="{i18n.Common.base_path}examples" data-route-link=true click="openExample('app')" "%i18n.Hero.lab_link%"
