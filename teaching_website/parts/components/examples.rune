@Component/ExamplesSection
view:
    section #examples .card:
        div .section-heading:
            p .eyebrow "%i18n.Examples.eyebrow%"
            h2 "%i18n.Examples.headline%"
        div .examples-grid:
            article .example-card:
                span .tag .tag-beginner "%i18n.Examples.app_level%"
                h3 "%i18n.Examples.app_title%"
                p "%i18n.Examples.app_desc%"
                a .secondary-cta href=#app click="openExample('app')" "%i18n.Examples.run_label%"
            article .example-card:
                span .tag .tag-beginner "%i18n.Examples.skaters_level%"
                h3 "%i18n.Examples.skaters_title%"
                p "%i18n.Examples.skaters_desc%"
                a .secondary-cta href=#app click="openExample('skaters')" "%i18n.Examples.run_label%"
            article .example-card:
                span .tag .tag-practical "%i18n.Examples.user_api_level%"
                h3 "%i18n.Examples.user_api_title%"
                p "%i18n.Examples.user_api_desc%"
                a .secondary-cta href=#app click="openExample('users')" "%i18n.Examples.run_label%"
            article .example-card:
                span .tag .tag-practical "%i18n.Examples.graphql_level%"
                h3 "%i18n.Examples.graphql_title%"
                p "%i18n.Examples.graphql_desc%"
                a .secondary-cta href=#app click="openExample('graphql')" "%i18n.Examples.run_label%"
            article .example-card:
                span .tag .tag-advanced "%i18n.Examples.tic_level%"
                h3 "%i18n.Examples.tic_title%"
                p "%i18n.Examples.tic_desc%"
                a .secondary-cta href=#app click="openExample('tic')" "%i18n.Examples.play_label%"

            article .example-card:
                span .tag .tag-beginner "Rune-Web"
                h3 "%i18n.Examples.counter_title%"
                p "%i18n.Examples.counter_desc%"
                a .secondary-cta href=#app click="openExample('counter')" "%i18n.Examples.play_label%"

            article .example-card:
                span .tag .tag-advanced "%i18n.SpaceInvaders.badge%"
                h3 "%i18n.Examples.invaders_title%"
                p "%i18n.Examples.invaders_desc%"
                a .secondary-cta href=#app click="navigate('games')" "%i18n.SpaceInvaders.play_label%"

            article .example-card:
                span .tag .tag-advanced "%i18n.VectWorms.badge%"
                h3 "%i18n.Examples.worms_title%"
                p "%i18n.Examples.worms_desc%"
                a .secondary-cta href=#app click="navigate('vectworms')" "%i18n.VectWorms.play_label%"
