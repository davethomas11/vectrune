@Component/ExampleLab
state:
    selectedExample = "app"
bindings:
    .active <-> selectedExample
view:
    div .page .example-lab:
        div .section-heading:
            p .eyebrow "%i18n.Examples.lab_eyebrow%"
            h2 "%i18n.Examples.lab_title%"
            p "%i18n.Examples.lab_description%"
        nav .example-picker aria-label="%i18n.Lab.choose%":
            button .pill {.active when 'app'} click="openExample('app')" "%i18n.Lab.first%"
            button .pill {.active when 'skaters'} click="openExample('skaters')" "%i18n.Lab.document%"
            button .pill {.active when 'users'} click="openExample('users')" "%i18n.Lab.users%"
            button .pill {.active when 'graphql'} click="openExample('graphql')" "GraphQL"
            button .pill {.active when 'counter'} click="openExample('counter')" "%i18n.Lab.counter%"
            button .pill {.active when 'tic'} click="openExample('tic')" "%i18n.Lab.tic%"
            button .pill {.active when 'invaders'} click="openExample('invaders')" "%i18n.Lab.invaders%"
            button .pill {.active when 'worms'} click="openExample('worms')" "%i18n.Lab.worms%"
        match selectedExample:
            "app" -> FirstApiExample
            "skaters" -> DataDocumentExample
            "users" -> UserApiExample
            "graphql" -> GraphqlExample
            "counter" -> CounterExample
            "tic" -> TicTacToeExample
            "invaders" -> SpaceInvadersExample
            "worms" -> VectWormsExample

@Component/FirstApiExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.first_title%"
        p "%i18n.Examples.rest_hint%"
        SandboxSection code="{raw ../../../examples/app.rune}" show_output=true

@Component/UserApiExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.users%"
        p "%i18n.Examples.users_hint%"
        SandboxSection code="{raw ../../../examples/user_api.rune}" show_output=true

@Component/DataDocumentExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.document_title%"
        p "%i18n.Examples.data_hint%"
        SandboxSection code="{raw ../../../examples/skateboarders.rune}" show_output=true mode=data

@Component/GraphqlExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.graphql_title%"
        p "%i18n.Examples.graphql_hint%"
        SandboxSection code="{raw ../../../examples/book_graphql.rune}" show_output=true mode=graphql

@Component/CounterExample
view:
    WebExample title="{i18n.Lab.counter}" preview="{preview ../../../examples/counter.rune}" files="{sources ../../../examples/counter.rune}"

@Component/TicTacToeExample
view:
    WebExample title="{i18n.Lab.tic}" preview="{preview ../../../examples/tic_tac_toe/tic_tac_toe.rune}" files="{sources ../../../examples/tic_tac_toe/tic_tac_toe.rune}"

@Component/SpaceInvadersExample
view:
    div .space-invaders-page:
        WebExample title="{i18n.Lab.invaders_title}" preview="{preview ../../../examples/space_invaders/space_invaders.rune}" files="{sources ../../../examples/space_invaders/space_invaders.rune}"

@Component/VectWormsExample
view:
    div .space-invaders-page:
        WebExample title="{i18n.Lab.worms_title}" preview="{preview ../../../examples/vectworms/vectworms.rune}" files="{sources ../../../examples/vectworms/vectworms.rune}"

@Component/WebExample
props: [title, preview, files]
view:
    section .card .web-example:
        div .section-heading:
            span .tag .tag-practical "%i18n.Examples.live_preview%"
            h2 "{title}"
            p "%i18n.Examples.web_hint%"
        iframe .example-preview src="{preview}" title="{title}" allow="fullscreen; autoplay" allowfullscreen=true sandbox="allow-scripts allow-same-origin allow-downloads allow-modals"
        details .example-source open=true:
            summary "%i18n.Examples.source_label%"
            div .source-tools:
                input .source-filter type=search aria-label="%i18n.Examples.filter_files%" placeholder="%i18n.Examples.filter_files%"
                span .source-count role=status aria-live=polite
            p .source-empty hidden=true "%i18n.Examples.no_files%"
            for file in files:
                details .source-file:
                    summary "{file.path}"
                    div .source-actions:
                        button .source-copy type=button data-copied="%i18n.Examples.copied%" data-failed="%i18n.Examples.copy_failed%" "%i18n.Examples.copy_source%"
                        button .source-download type=button "%i18n.Examples.download_source%"
                    ExampleSource code="{file.code}"

@Component/ExampleSource
props: [code]
view:
    pre .example-code tabindex=0:
        code .code-block .language-rune "{code}"
