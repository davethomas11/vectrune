@Component/ExampleLab
state:
    selectedExample = "app"
bindings:
    .active <-> selectedExample
view:
    div .page .example-lab:
        div .section-heading:
            p .eyebrow "%i18n.Examples.lab_eyebrow%"
            h2 "%i18n.Examples.lab_title%"
            p "%i18n.Examples.lab_description%"
        nav .example-picker aria-label="%i18n.Lab.choose%":
            button .pill {.active when 'app'} click="openExample('app')" "%i18n.Lab.first%"
            button .pill {.active when 'skaters'} click="openExample('skaters')" "%i18n.Lab.document%"
            button .pill {.active when 'users'} click="openExample('users')" "%i18n.Lab.users%"
            button .pill {.active when 'graphql'} click="openExample('graphql')" "GraphQL"
            button .pill {.active when 'counter'} click="openExample('counter')" "%i18n.Lab.counter%"
            button .pill {.active when 'tic'} click="openExample('tic')" "%i18n.Lab.tic%"
            button .pill {.active when 'invaders'} click="openExample('invaders')" "%i18n.Lab.invaders%"
            button .pill {.active when 'worms'} click="openExample('worms')" "%i18n.Lab.worms%"
        match selectedExample:
            "app" -> FirstApiExample
            "skaters" -> DataDocumentExample
            "users" -> UserApiExample
            "graphql" -> GraphqlExample
            "counter" -> CounterExample
            "tic" -> TicTacToeExample
            "invaders" -> SpaceInvadersExample
            "worms" -> VectWormsExample

@Component/FirstApiExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.first_title%"
        p "%i18n.Examples.rest_hint%"
        SandboxSection code="{raw ../../../examples/app.rune}" show_output=true

@Component/UserApiExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.users%"
        p "%i18n.Examples.users_hint%"
        SandboxSection code="{raw ../../../examples/user_api.rune}" show_output=true

@Component/DataDocumentExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.document_title%"
        p "%i18n.Examples.data_hint%"
        SandboxSection code="{raw ../../../examples/skateboarders.rune}" show_output=true mode=data

@Component/GraphqlExample
view:
    section .example-workspace:
        h2 "%i18n.Lab.graphql_title%"
        p "%i18n.Examples.graphql_hint%"
        SandboxSection code="{raw ../../../examples/book_graphql.rune}" show_output=true mode=graphql

@Component/CounterExample
view:
    WebExample title="{i18n.Lab.counter}" preview="{preview ../../../examples/counter.rune}" main_file="counter.rune" source="{raw ../../../examples/counter.rune}"

@Component/TicTacToeExample
view:
    WebExample title="{i18n.Lab.tic}" preview="{preview ../../../examples/tic_tac_toe/tic_tac_toe.rune}" main_file="tic_tac_toe.rune" source="{raw ../../../examples/tic_tac_toe/tic_tac_toe.rune}" logic_source="{raw ../../../examples/tic_tac_toe/parts/logic.rune}" style_source="{raw ../../../examples/tic_tac_toe/parts/style.rune}"

@Component/SpaceInvadersExample
view:
    div .space-invaders-page:
        WebExample title="{i18n.Lab.invaders_title}" preview="{preview ../../../examples/space_invaders/space_invaders.rune}" main_file="space_invaders.rune" source="{raw ../../../examples/space_invaders/space_invaders.rune}" extra_file="parts/enemies.rune" extra_source="{raw ../../../examples/space_invaders/parts/enemies.rune}" logic_source="{raw ../../../examples/space_invaders/parts/logic.rune}" style_source="{raw ../../../examples/space_invaders/parts/style.rune}" sound_source="{raw ../../../examples/space_invaders/parts/sound.rune}"

@Component/VectWormsExample
view:
    div .space-invaders-page:
        WebExample title="{i18n.Lab.worms_title}" preview="{preview ../../../examples/vectworms/vectworms.rune}" main_file="vectworms.rune" source="{raw ../../../examples/vectworms/vectworms.rune}" extra_file="parts/field.rune" extra_source="{raw ../../../examples/vectworms/parts/field.rune}" logic_source="{raw ../../../examples/vectworms/parts/logic.rune}" style_source="{raw ../../../examples/vectworms/parts/style.rune}" sound_source="{raw ../../../examples/vectworms/parts/sound.rune}"

@Component/WebExample
props: [title, preview, source, main_file?, extra_file?, extra_source?, logic_source?, style_source?, sound_source?]
view:
    section .card .web-example:
        div .section-heading:
            span .tag .tag-practical "%i18n.Examples.live_preview%"
            h2 "{title}"
            p "%i18n.Examples.web_hint%"
        iframe .example-preview src="{preview}" title="{title}" sandbox=allow-scripts
        details .example-source open=true:
            summary "%i18n.Examples.source_label%"
            details .source-file:
                summary "{main_file ?? i18n.Lab.main_file}"
                ExampleSource code="{source}"
            if extra_source ?? false:
                details .source-file:
                    summary "{extra_file}"
                    ExampleSource code="{extra_source}"
            if logic_source ?? false:
                details .source-file:
                    summary "parts/logic.rune"
                    ExampleSource code="{logic_source}"
            if sound_source ?? false:
                details .source-file:
                    summary "parts/sound.rune"
                    ExampleSource code="{sound_source}"
            if style_source ?? false:
                details .source-file:
                    summary "parts/style.rune"
                    ExampleSource code="{style_source}"

@Component/ExampleSource
props: [code]
view:
    pre .example-code:
        code .code-block .language-rune "{code}"
