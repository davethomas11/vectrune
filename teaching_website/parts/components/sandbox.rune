@Component/SandboxSection
props: [code, show_output?, mode?]
view:
    section #sandbox .card data-show-output="{show_output ?? false}" data-sandbox-mode="{mode ?? 'api'}":
        div .section-heading:
            p .eyebrow "%i18n.Sandbox.interactive%"
            h2 "%i18n.Examples.sandbox_title%"
            p "%i18n.Examples.sandbox_hint%"
        
        div .sandbox-container:
            div .editor-pane:
                h3 "%i18n.Sandbox.code%"
                div .code-editor:
                    pre .editor-highlight aria-hidden=true:
                        code .code-block .language-rune
                    textarea #sandbox-editor .syntax-editor spellcheck=false wrap=off aria-label="%i18n.Sandbox.source_label%" placeholder="%i18n.Sandbox.placeholder%":
                        "{code}"
                div .editor-actions:
                    button #run-button .cta click="runSandbox(this)" data-run-label="%i18n.Sandbox.run%" data-changes-label="%i18n.Sandbox.run_changes%" "%i18n.Sandbox.run%"
                    button .secondary-cta .sandbox-reset type=button click="resetSandbox(this)" "%i18n.Sandbox.reset%"
                    if show_output ?? false:
                        details .sandbox-advanced:
                            summary "%i18n.Sandbox.advanced%"
                            div .editor-actions:
                                select #ast-format aria-label="%i18n.Sandbox.format%" style="padding:0.5rem; border-radius:4px; border:1px solid #d8e1ee;":
                                    option value="json" "JSON"
                                    option value="yaml" "YAML"
                                    option value="xml" "XML"
                                button #show-doc-button .secondary-cta click="showDoc(this)" "%i18n.Sandbox.show_document%"
                                button #show-ast-button .secondary-cta click="showAst(this)" "%i18n.Sandbox.show_ast%"
                p #sandbox-edit-status .sandbox-edit-status role=status aria-live=polite hidden=true "%i18n.Sandbox.pending_changes%"
            
            div .output-pane:
                h3 "%i18n.Sandbox.output%"
                GraphqlConsole
                div #sandbox-output .terminal:
                    "%i18n.Sandbox.idle%"
        div .sandbox-hints:
            p "%i18n.Sandbox.edit_hint%"
