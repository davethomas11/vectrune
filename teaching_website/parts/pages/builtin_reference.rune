@Component/BuiltinReferencePage
view:
    div .page:
        div .section-heading:
            p .eyebrow "%i18n.Reference.eyebrow%"
            h1 "%i18n.Reference.title%"
            p .section-copy "%i18n.Reference.intro%"

        div .reference-shell:
            div .reference-controls:
                label for=builtin-search "%i18n.Reference.search_label%"
                input #builtin-search .search-input type=search placeholder="%i18n.Reference.search%" oninput="filterBuiltins()"
                div .category-pills:
                    button .pill .active onclick="selectCategory('all', this)" "%i18n.Reference.all%"
                    button .pill onclick="selectCategory('diagnostics', this)" "%i18n.Reference.diagnostics%"
                    button .pill onclick="selectCategory('http', this)" "%i18n.Reference.http%"
                    button .pill onclick="selectCategory('data', this)" "%i18n.Reference.data%"
                    button .pill onclick="selectCategory('schema', this)" "%i18n.Reference.schema%"
                    button .pill onclick="selectCategory('memory', this)" "%i18n.Reference.memory%"
                    button .pill onclick="selectCategory('io', this)" "%i18n.Reference.io%"
                    button .pill onclick="selectCategory('context', this)" "%i18n.Reference.context%"
                    button .pill onclick="selectCategory('websocket', this)" "%i18n.Reference.websocket%"

            div #builtin-list .builtin-cards-grid:
                # Builtin cards dynamically populated & filterable via builtin-reference.js

            div .interactive-reference-sandbox:
                div .section-heading:
                    p .eyebrow "%i18n.Reference.playground%"
                    h3 "%i18n.Reference.try_title%"
                    p "%i18n.Reference.try_body%"
                SandboxSection code="{raw examples/builtin_reference_example.rune}" show_output=true
