@Component/SkyboundTwoPage
view:
    div .page .application-guide .space-invaders-page .skybound-two-page:
        section .card .showcase-intro:
            div .section-heading:
                span .tag .tag-advanced "%i18n.SkyboundTwo.badge%"
                h1 "%i18n.SkyboundTwo.title%"
                p .lead "%i18n.SkyboundTwo.description%"
            p .showcase-try "%i18n.SkyboundTwo.try_it%"
            a .secondary-cta href="/assets/games/skybound-2/index.html" target=_blank rel=noopener "%i18n.SkyboundTwo.standalone%"

        WebExample game=true title="{i18n.SkyboundTwo.title}" preview="/assets/games/skybound-2/index.html" files="{sources ../../../examples/skybound_2/skybound_2.rune}" show_heading=false

        section .card:
            h2 "%i18n.SkyboundTwo.controls_title%"
            p "%i18n.SkyboundTwo.controls%"
            p "%i18n.SkyboundTwo.objective%"
            p "%i18n.SkyboundTwo.device%"

        details .card .showcase-notes:
            summary "%i18n.SkyboundTwo.source_title%"
            p "%i18n.SkyboundTwo.source_text%"
            CommandBlock code="git clone https://github.com/davethomas11/rune.git\ncd rune"
            CommandBlock code="vectrune examples/skybound_2/skybound_2.rune -o html > skybound-2.html"
            CommandBlock code="vectrune test examples/skybound_2 --type logic"
            CommandBlock code="vectrune fmt examples/skybound_2 --line-width 100"
