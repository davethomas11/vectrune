@Component/RestValidationPage
view:
    div .page:
        div .section-heading:
            p .eyebrow "%i18n.Nav.rest%"
            h1 "%i18n.Tutorial.validation_title%"
            p "%i18n.Tutorial.validation_intro%"
            
        SandboxSection code="{raw examples/rest_api_validation_example.rune}" show_output=true
