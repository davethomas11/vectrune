@Component/RestValidationPage
view:
    div .page:
        div .section-heading:
            p .eyebrow "REST API"
            h2 "Validation & Schemas"
            p "Enforce structural integrity using @Schema and validate custom business constraints directly in your routes."
            
        SandboxSection show_output=true code="{raw examples/rest_api_validation_example.rune}"
