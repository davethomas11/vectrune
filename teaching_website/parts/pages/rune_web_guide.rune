view:
    RuneWebLesson title="{i18n.RuneWebGuide.forms_title}" intro="{i18n.RuneWebGuide.forms_intro}" syntax="{i18n.RuneWebGuide.forms_syntax}" behavior="{i18n.RuneWebGuide.forms_behavior}" try_it="{i18n.RuneWebGuide.forms_try}" filename="forms" preview="{preview ../../../examples/rune_web_guide/forms.rune}" files="{sources ../../../examples/rune_web_guide/forms.rune}"

