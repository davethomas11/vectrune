@Component/RuneWebLesson
props: [title, intro, syntax, behavior, try_it, filename, preview, files]
view:
    div .page .application-guide:
        section .card:
            p .eyebrow "%i18n.RuneWebGuide.group%"
            h1 "{title}"
            p .lead "{intro}"
            h3 "%i18n.Guide.syntax%"
            p "{syntax}"
            p "{behavior}"
            div .callout .callout-info:
                p "{try_it}"
            h3 "%i18n.RuneWebGuide.local%"
            pre:
                code .code-block .language-bash "cargo run -- examples/rune_web_guide/{filename}.rune\ncargo run -- examples/rune_web_guide/{filename}.rune -o html > index.html"
            p .document-note "%i18n.RuneWebGuide.shared%"
        WebExample title="{title}" preview="{preview}" files="{files}"

@Component/RuneWebComponentsGuide
view:
    RuneWebLesson title="{i18n.RuneWebGuide.components_title}" intro="{i18n.RuneWebGuide.components_intro}" syntax="{i18n.RuneWebGuide.components_syntax}" behavior="{i18n.RuneWebGuide.components_behavior}" try_it="{i18n.RuneWebGuide.components_try}" filename="components" preview="{preview ../../../examples/rune_web_guide/components.rune}" files="{sources ../../../examples/rune_web_guide/components.rune}"

