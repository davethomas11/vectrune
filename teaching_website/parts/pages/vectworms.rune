@Component/VectWormsPage
view:
    div .page .application-guide .space-invaders-page:
        section .card .showcase-intro:
            div .section-heading:
                span .tag .tag-advanced "%i18n.VectWorms.badge%"
                h1 "%i18n.VectWorms.title%"
                p .lead "%i18n.VectWorms.description%"

            p .showcase-try "%i18n.VectWorms.try_it%"

        WebExample title="{i18n.VectWorms.title}" preview="{preview ../../../examples/vectworms/vectworms.rune}" files="{sources ../../../examples/vectworms/vectworms.rune}" show_heading=false

        details .card .showcase-notes:
            summary "%i18n.Guide.how_it_works%"
            div .features-grid:
                article .feature-card:
                    h3 "🐛 %i18n.VectWorms.feature_split_title%"
                    p "%i18n.VectWorms.feature_split_desc%"
                article .feature-card:
                    h3 "🍄 %i18n.VectWorms.feature_field_title%"
                    p "%i18n.VectWorms.feature_field_desc%"
                article .feature-card:
                    h3 "🔊 %i18n.VectWorms.feature_fx_title%"
                    p "%i18n.VectWorms.feature_fx_desc%"
                article .feature-card:
                    h3 "🕹️ %i18n.VectWorms.feature_controls_title%"
                    p "%i18n.VectWorms.feature_controls_desc%"

            h3 "%i18n.VectWorms.instructions_title%"
            p "⌨️ %i18n.VectWorms.instructions_keyboard%"
            p "📱 %i18n.VectWorms.instructions_mobile%"

        RunExampleLocally example="vectworms"
