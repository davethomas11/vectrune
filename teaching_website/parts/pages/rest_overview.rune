@Component/RestOverviewPage
view:
    div .page .application-guide:
        section .card:
            p .eyebrow "%i18n.Nav.applications%"
            h2 "%i18n.RestGuide.title%"
            p .lead "%i18n.RestGuide.intro%"
            ExampleSource code="{raw ../../content/applications/rest.rune}"
            h3 "%i18n.Guide.syntax%"
            ul:
                li "%i18n.RestGuide.syntax_1%"
                li "%i18n.RestGuide.syntax_2%"
                li "%i18n.RestGuide.syntax_3%"
            h3 "%i18n.Guide.run_locally%"
            p "%i18n.RestGuide.run%"
            pre:
                code .code-block .language-bash "vectrune rest.rune\ncurl http://127.0.0.1:3000/hello"
            p .document-note "%i18n.RestGuide.note%"
        SandboxSection code="{raw ../../content/applications/rest.rune}" show_output=true
