@Component/DynamicAiWebPage
view:
    div .page .application-guide:
        section .card:
            p .eyebrow "%i18n.DynamicAi.eyebrow%"
            h1 "%i18n.DynamicAi.title%"
            p .lead "%i18n.DynamicAi.intro%"
            ExampleSource code="{raw ../../../examples/dynamic_ai_web.rune}"
            h3 "%i18n.Guide.syntax%"
            ul:
                li "%i18n.DynamicAi.syntax_1%"
                li "%i18n.DynamicAi.syntax_2%"
                li "%i18n.DynamicAi.syntax_3%"
            div .callout .callout-info:
                strong "%i18n.DynamicAi.native_title%"
                p "%i18n.DynamicAi.native_body%"
        section .card:
            h3 "%i18n.DynamicAi.engines_title%"
            p "%i18n.DynamicAi.engines_body%"
            h3 "%i18n.Guide.run_locally%"
            pre:
                code .code-block .language-bash "cargo run -- examples/dynamic_ai_web.rune --watch\n# http://127.0.0.1:3000/"
            p "%i18n.DynamicAi.behavior%"
            p "%i18n.DynamicAi.progress%"
            p "%i18n.DynamicAi.saved%"
            p "%i18n.DynamicAi.timing%"
            h3 "%i18n.DynamicAi.demos_title%"
            p "%i18n.DynamicAi.demos_body%"
            pre:
                code .code-block .language-bash "cargo run -- examples/dynamic_ai_web_codex.rune --watch\n# or\ncargo run -- examples/dynamic_ai_web_copilot.rune --watch"
