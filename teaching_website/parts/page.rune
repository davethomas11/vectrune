import "components"
import "i18n"
import "pages"
import "seo"

@Optimizer
dynamic_xhr = on
pre_load = true
chunk_path = /assets/routes

@Page/learn-vectrune
title = Learn Vectrune
style = teaching-site
logic = teaching
view:
    div .site-shell:
        SidebarLayout
        TeachingFooter
        BuiltWithTag
        script src="/assets/site-navigation.js?v=1"
        script src="/assets/command-copy.js?v=1"
        script src="/assets/source-explorer.js?v=1"
        script src="/assets/syntax-highlight.js?v=5"
        script src="/assets/sandbox.js?v=14"
        script src="/assets/builtin-reference.js?v=8"
